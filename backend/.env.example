# ==========================================================================
# UBOSS Sourcing - Backend environment template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# Every variable below is validated at boot by src/config/env.ts - the
# process refuses to start on an invalid or missing required value.
# ==========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=debug
# Public base URL of this API (used in webhook + payment-link callbacks)
API_PUBLIC_URL=http://localhost:4000

# --- Frontend origins (exact CORS allowlist, comma separated) ------------
ADMIN_WEB_ORIGIN=http://localhost:5173,http://localhost:4173
CUSTOMER_WEB_ORIGIN=http://localhost:5174,http://localhost:4174
# Base URL used when building customer-facing links in emails
CUSTOMER_WEB_PUBLIC_URL=http://localhost:5174
ADMIN_WEB_PUBLIC_URL=http://localhost:5173

# --- Database (XAMPP MariaDB 10.4 on 127.0.0.1:3306) ---------------------
# NOTE: MariaDB, not PostgreSQL. Prisma uses the `mysql` provider.
# XAMPP default root user has an empty password - set one before production.
DATABASE_URL="mysql://root@127.0.0.1:3306/uboss"
# Separate database used by integration tests. It is dropped and recreated.
TEST_DATABASE_URL="mysql://root@127.0.0.1:3306/uboss_test"
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# --- Sessions / tokens ---------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_COOKIE_SECRET=replace-with-48-random-bytes-base64url
ACCESS_TOKEN_SECRET=replace-with-48-random-bytes-base64url
REFRESH_TOKEN_SECRET=replace-with-48-random-bytes-base64url
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Cookie scope. Leave COOKIE_DOMAIN empty for localhost.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Encryption at rest (connector credentials, gateway secrets) ---------
# AES-256-GCM key, exactly 32 bytes, base64 encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# --- Queue / cache -------------------------------------------------------
# `database` = MariaDB-backed queue and rate limiter (no Redis needed).
# `redis`    = Redis-backed driver, requires REDIS_URL.
QUEUE_DRIVER=database
CACHE_DRIVER=memory
REDIS_URL=
# Worker tuning
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=60

# --- Exchange rates ------------------------------------------------------
# Where the daily price refresh reads rates from. {base} is replaced with the
# business base currency. The default is free and needs no API key; point it
# at your own mirror if this server cannot reach the internet.
FX_RATE_URL=https://open.er-api.com/v6/latest/{base}
FX_RATE_TIMEOUT_MS=10000

# --- Object storage ------------------------------------------------------
# `local` writes to STORAGE_LOCAL_DIR and serves via /media. `s3` uses the S3 vars.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=5242880

# --- Email ---------------------------------------------------------------
# `log` prints the rendered email to the structured log (development only).
EMAIL_DRIVER=log
EMAIL_FROM_NAME=UBOSS Sourcing
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Payments ------------------------------------------------------------
# Live gateway credentials are stored ENCRYPTED IN THE DATABASE via the admin
# Integrations screen, not here. These are the bootstrap/test values only.
# With no credentials configured the payment endpoints return
# PAYMENT_PROVIDER_NOT_CONFIGURED. There is no mock-success path.
PAYMENT_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe. The publishable key is public and goes to the browser; the secret key
# never leaves the server. Both must come from the same environment (pk_test_ with
# sk_test_). STRIPE_WEBHOOK_SECRET is the whsec_ value Stripe shows when you add
# the endpoint POST /webhooks/stripe - without it no payment can be verified, so
# no order would ever be confirmed.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_LINK_TTL_HOURS=72

# --- Business defaults (overridable from the business_profile table) -----
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Feature flags -------------------------------------------------------
# Self-registration stays OFF by default; admin invitation is the primary path.
# With it on, the storefront shows a "Create an account" form asking for name,
# email, mobile number and country. The account is created immediately but
# cannot sign in until the confirmation link in its email has been opened.
FEATURE_CUSTOMER_SELF_REGISTRATION=false
#
# ...and, once confirmed, until a member of staff approves it. Leave this on
# unless the storefront is genuinely open to the public: prices, purchasing
# limits and credit terms here are per customer, so an unreviewed account is a
# commercial decision, not just an inbox.
CUSTOMER_SELF_REGISTRATION_REQUIRES_APPROVAL=true
FEATURE_STOCK_RESERVATIONS=true
FEATURE_ORDER_APPROVALS=false
FEATURE_RECURRING_ORDERS=true
#
# Buy Later: one delivery, on a date the customer picks. Separate from the flag
# above because they are separate promises - a deployment can offer "deliver
# this next Tuesday" without offering a standing authority to charge.
FEATURE_SCHEDULED_ORDERS=true
#
# Whether EVERY published product may be put on a repeat purchase.
#
# ON: anything a customer can buy, they can also schedule. OFF: only products
# an administrator has ticked "eligible for repeat purchase" on the product
# form.
#
# On by default, because the per-product tick defaults to off and the two
# together meant a fresh install showed a repeat-purchase button that then
# refused every basket. Turn it off if you sell things you will not repeat -
# clearance lines, one-per-customer devices, anything sold against a single
# tender - and curate the list instead.
FEATURE_SCHEDULE_ANY_PRODUCT=true
#
# Autopay: charging a saved card while the customer is not there.
#
# OFF by default, and that default is the important part. Turning it on means
# this deployment takes money from people who are not present, so it should be
# a decision somebody made rather than a behaviour inherited by installing the
# software. It also needs Stripe connected - enrolment refuses without it
# rather than storing a card nothing could ever charge - and in production the
# process will not start with this on and no Stripe secret key.
FEATURE_SUBSCRIPTION_AUTOPAY=false

# --- Scheduled and recurring orders ---------------------------------------
#
# How far a total may drift from what the customer was last quoted before the
# charge needs re-confirming. Checked as a percentage AND as an absolute floor,
# and the more generous of the two wins - 5% of a small basket is a few paise,
# and holding a delivery over a rounding difference teaches customers to ignore
# the notification. A plan may override both; these are the defaults.
SCHEDULE_PRICE_TOLERANCE_PERCENT=5
SCHEDULE_PRICE_TOLERANCE_MINOR=500
#
# How long before a delivery a customer can no longer change or skip it. Inside
# this window the worker may already be pricing the order, and an edit would
# race the charge.
SCHEDULE_EDIT_CUTOFF_MINUTES=1440
#
# How far ahead delivery rows are created. They have to exist before a customer
# can skip or re-date one, so this is what makes "skip my next delivery" work at
# all. Kept short: a year of pre-built rows is a year of rows to rebuild
# whenever a plan changes.
SCHEDULE_MATERIALISE_AHEAD_DAYS=35
#
# How long before a charge the reminder goes out. MUST be longer than the edit
# cutoff above, or the reminder invites the customer to change an order that can
# no longer be changed - the process refuses to start otherwise.
SCHEDULE_REMINDER_LEAD_HOURS=48
#
# How many times one delivery's PAYMENT may be attempted. Counted apart from
# validation attempts: banks read repeated declines as a signal about the card,
# so a delivery held for lack of stock must not spend the card's budget.
SCHEDULE_MAX_PAYMENT_ATTEMPTS=3

# --- ERP order hand-off ----------------------------------------------------
#
# Where paid orders are sent. Empty means no ERP push, and that is a working
# state: orders are created, paid and fulfilled exactly as they are without it.
#
# The value is the NAME of an integration connection an administrator has
# created and activated in the Admin Panel - a name rather than an id because
# the id is a ULID nobody can type. That connection holds the base URL, the
# auth type and the encrypted credentials.
ERP_ORDER_CONNECTION_NAME=
#
# Appended to that connection's base URL. The request body is documented in
# PROJECT-GUIDE.md, so a deployment whose ERP wants a different shape puts a
# small translating proxy in front of it rather than changing this repository.
ERP_ORDER_PATH=/orders
#
# Asked whether the ERP can supply a set of SKUs, BEFORE a card is charged.
# Empty switches the pre-charge check off. Where it is set, an ERP that cannot
# be reached HOLDS the delivery rather than charging on an assumption.
ERP_STOCK_PATH=/stock/availability
#
# Where the ERP's own identifier for the created order is found in its response,
# as a dotted path (e.g. "data.order.id"). ERPs disagree about this more than
# about anything else, which is why it is configuration.
ERP_ORDER_REFERENCE_PATH=id
#
# The header the ERP reads an idempotency key from. The same key is sent on
# every retry of one order, so an ERP that honours it de-duplicates on its own
# side; one that does not is still covered by a unique index here.
ERP_IDEMPOTENCY_HEADER=Idempotency-Key
#
# How many times a paid order's ERP push is retried before it needs a person.
# Generous on purpose: every row being retried is an order somebody has already
# paid for, and the alternative to retrying is a customer whose money has gone
# and whose order the warehouse cannot see.
ERP_ORDER_MAX_ATTEMPTS=8
#
# Whether stock must be confirmed with the ERP before charging. On where an ERP
# is connected: charging for something the warehouse will refuse to ship is the
# worst of the available outcomes. No effect with no ERP configured.
ERP_VERIFY_STOCK_BEFORE_CHARGE=true

# --- The ERP connected under Settings -> ERP ------------------------------
#
# Everything above configures an ERP through environment variables: one address,
# fixed paths, set at deploy time. This block governs the other kind - a
# connection an administrator creates on a screen, whose base URL, endpoints,
# credentials and field names all live in the database. Nothing here names an
# ERP, because nothing in a deployment's configuration needs to.
#
# The two are not rivals. A paid order goes to the connection configured under
# Settings -> ERP if there is an active one, and falls through to the
# ERP_ORDER_* connector above if there is not.
#
# The master switch. Off means the screen says so, the routes refuse, no polling
# job is enqueued, and the inbound webhook endpoint 404s. Opt-in, because an
# installation that has not thought about this server reaching outbound to
# another system should not have that happening by default.
FEATURE_ERP_INTEGRATION=false
#
# How many connections may exist. One live is the ordinary case; the extras are
# room for a sandbox and a migration. Only ONE may be active at a time - that is
# enforced in the service, because MariaDB 10.4 has no partial index to do it.
ERP_MAX_CONNECTIONS=5
#
# Attempts at one ERP operation before it needs a person. Lower than
# ERP_ORDER_MAX_ATTEMPTS because these land on a server somebody else operates.
# The paid-but-unpushed case is exempt and uses the higher ceiling.
ERP_MAX_ATTEMPTS=6
#
# Records read from the ERP in a single sync, and per-record errors stored for
# one run. Both are ceilings on memory and on how long a worker slot is held,
# not business rules.
ERP_MAX_SYNC_RECORDS=5000
ERP_MAX_RECORD_ERRORS=50
#
# Consecutive failures before a connection is taken out of service and stops
# being polled. Without it, an ERP that has been off for a fortnight collects a
# failed poll every hour for a fortnight.
ERP_FAILURE_THRESHOLD=5
#
# Whether the ERP address may be on a private or loopback network.
#
# FALSE, and the configuration check REFUSES TO START a production process with
# it true. It exists for one case: a developer pointing a connection at a mock
# ERP on localhost:9000. On in production, it hands anybody who can save a
# connection a way to make this server fetch
# http://169.254.169.254/latest/meta-data/iam/security-credentials/ and read the
# instance's cloud credentials back out of a sync error message. An address an
# administrator typed is more likely to be right than one a stranger typed; it
# is not thereby right.
ALLOW_PRIVATE_ERP_TARGETS=false

# --- Autopay: a customer's standing authority to be charged ---------------
#
# Separate from FEATURE_SUBSCRIPTION_AUTOPAY, which governs whether a scheduled
# plan may charge a stored card. This one governs the customer's own limits: a
# ceiling per transaction, a threshold above which they want to be asked, and
# the consent that makes any of it lawful. Needs FEATURE_SUBSCRIPTION_AUTOPAY,
# which is what lets them save a card at all.
FEATURE_CUSTOMER_AUTOPAY=false
#
# The consent wording version a customer's stored acceptance is recorded
# against. Bumping it does not invalidate existing consent by itself; it is what
# lets you tell who agreed to which wording when a charge is disputed.
AUTOPAY_CONSENT_VERSION=v1
#
# A platform-wide ceiling on any single off-session charge, in minor units of
# the order's own currency. Applied on top of whatever the customer set, never
# instead of it. Zero means no platform ceiling. It is the operator's backstop
# against a pricing bug becoming a five-figure charge nobody authorised.
AUTOPAY_PLATFORM_MAX_MINOR=0

# --- Admin sign-in location ----------------------------------------------
#
# The Admin Panel asks the browser where the device is at every sign-in and
# stays closed until it is told, then rings the console bell with the place.
#
# IMPORTANT: the browser Geolocation API only exists in a secure context. An
# admin panel served over plain HTTP on anything but localhost can never
# satisfy this, and every member of staff would be locked out. Put the panel
# behind HTTPS, or set this to false.
#
# SELLING IN THE EU: set this to false. While it is on, a member of staff
# cannot work without handing over their precise position, which is
# employee monitoring - consent given to keep your job is not freely given
# under Art. 7(4) GDPR, and in Germany this also engages works-council
# co-determination under s.87(1) No.6 BetrVG. See docs/DATA-PROTECTION.md
# section 2.1 before leaving it on.
FEATURE_ADMIN_LOGIN_LOCATION=true
#
# Turns the coordinates into a place name. The one part of this that leaves
# the building, so it is a URL rather than a fixed host: point it at your own
# geocoder behind a firewall, or set it empty to switch the lookup off and
# have the notification show coordinates instead. {lat} and {lon} are
# substituted. The default is OpenStreetMap's, whose usage policy asks for no
# bulk querying — one lookup per admin sign-in is well inside it.
GEOCODE_REVERSE_URL=https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=14&lat={lat}&lon={lon}
GEOCODE_TIMEOUT_MS=5000

# --- Warehouse map -------------------------------------------------------
#
# The Warehouses screen in the admin panel draws your warehouses on a map.
#
# Empty is a working state, and it is the default: with no tile URL the screen
# plots the markers on a plain grid and everything else on it — the stock per
# warehouse, the low-stock counts, adding and editing — works exactly the same.
#
# Empty is also the private state. A tile request tells whoever serves it which
# part of the world is being looked at, and that is where your warehouses are.
# Nobody chose that on your behalf, so nothing is requested until you set this.
#
# Any XYZ raster tile service works; {z}/{x}/{y} are substituted by the
# browser. OpenStreetMap's own is:
#
#   MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
#
# If you point at theirs, read their tile usage policy first: attribution is
# required, and an installation with many staff is expected to run its own tile
# server or pay a commercial provider rather than lean on the volunteer one.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
#
# Turns a typed address into coordinates, for the "look up this address"
# button on a warehouse. The mirror of GEOCODE_REVERSE_URL and best-effort in
# the same way: if this is empty, unreachable or slow, the button simply
# reports that it found nothing and the coordinates stay typed by hand — it
# never blocks saving a warehouse. {query} is the URL-encoded address, and the
# timeout above is shared.
GEOCODE_FORWARD_URL=https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q={query}

# --- Storefront assistant ------------------------------------------------
#
# The chat widget on the storefront. The key is read here and used only by
# this process — the browser talks to /api/v1/assistant/chat and never sees
# it. Set no key at all and the feature is off end to end: the public config
# reports it unavailable and the storefront renders no chat button, so an
# unconfigured deployment has nothing broken on it.
#
# Set ONE of the two keys below. With one key set, that provider is used and
# ASSISTANT_PROVIDER can stay blank; set it only when both keys exist.
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=

# --- Google Gemini -------------------------------------------------------
# Key from https://aistudio.google.com/apikey
#
# IMPORTANT: check which tier the key is on, and read the number carefully.
# The binding free-tier limit is a DAILY one - measured at 20 requests per
# day per model on gemini-2.5-flash (quota
# GenerateRequestsPerDayPerProjectPerModel-FreeTier), not the per-minute rate
# people usually quote. Twenty questions is one afternoon of one visitor, so
# a free key is enough to try the widget and nothing more. Free-tier prompts
# may also be used by Google to improve their products, which is worth
# knowing for a box that customers type into. Enable billing on the Google
# Cloud project behind the key before opening this to real traffic.
#
# The daily quota is per model, so changing GEMINI_MODEL gets you a fresh
# allowance - useful while testing, not a way to run a store.
GEMINI_API_KEY=
# Stable and generally available, 1M-token input window. gemini-2.5-flash-lite
# is cheaper again; gemini-2.5-pro is more capable and slower. Reasoning is
# switched off in code regardless — see provider.gemini.ts.
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude ----------------------------------------------------
# Key from https://console.anthropic.com/ -> API keys
ANTHROPIC_API_KEY=
# claude-sonnet-5 or claude-haiku-4-5 cost less per reply; which tradeoff is
# right is a decision for whoever runs this deployment.
ANTHROPIC_MODEL=claude-opus-5

# --- Shared --------------------------------------------------------------
# Per-reply ceiling. A storefront answer is a few sentences; this is the last
# line of defence on cost, not a target. The prompt asks for about sixty words,
# so a normal reply finishes well inside 400.
ASSISTANT_MAX_TOKENS=400
# Messages one visitor may send in a conversation before it resets.
ASSISTANT_MAX_TURNS=20
# Replies one IP may request per five minutes.
ASSISTANT_RATE_LIMIT_PER_5MIN=20

# --- EU VAT number checking (VIES) ---------------------------------------
#
# The Commission's REST front door onto the twenty-seven national VAT
# registers. A URL rather than a fixed host, like the geocoder above: point
# it at your own proxy behind a firewall, or set it empty to switch checking
# off entirely.
#
# Switching it off breaks nothing. Every VAT number then reads as
# unverified, and an unverified number is CHARGED VAT rather than
# zero-rated - the safe direction, because it costs the customer cash flow
# where the other direction costs you the tax.
#
# {country} is the member state prefix (EL for Greece, not GR) and {number}
# the rest. See docs/EU-VAT.md section 4.
VIES_CHECK_URL=https://ec.europa.eu/taxation_customs/vies/rest-api/ms/{country}/vat/{number}
VIES_TIMEOUT_MS=10000

# --- Data protection -----------------------------------------------------
#
# How long personal data is kept, in days. 0 switches that sweep off.
# Art. 5(1)(e) GDPR requires a maximum, and a policy nothing enforces is not
# a policy - the worker deletes on this schedule on its own.
#
# These defaults are a defensible starting point, not advice. Match them to
# the retention schedule you publish in your privacy notice.
# See docs/DATA-PROTECTION.md section 2.2.
#
# Orders, payments and refunds are deliberately NOT swept: they carry a tax
# retention period of their own, and erasure pseudonymises them instead.

# Baskets nobody bought.
RETENTION_ABANDONED_CART_DAYS=90
# Storefront chat enquiries: a stranger's name, mobile, email and transcript.
RETENTION_ASSISTANT_CONVERSATION_DAYS=180
# The audit trail.
RETENTION_AUDIT_LOG_DAYS=730
# Delivered notifications, body and all. An order confirmation is the
# customer's name and delivery address written out in prose, so the outbox
# holds a second copy of what the order already records properly.
RETENTION_SENT_NOTIFICATION_DAYS=365
# Sign-in position, IP and user-agent, plus failed sign-in attempts. Keep
# this short wherever FEATURE_ADMIN_LOGIN_LOCATION is on.
RETENTION_SESSION_LOCATION_DAYS=90
# How long an Art. 15 personal-data bundle stays downloadable. The file is
# every fact held about one person, in one archive.
DATA_REQUEST_DOWNLOAD_TTL_HOURS=72

# --- Rate limits ---------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_15MIN=10
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=15
