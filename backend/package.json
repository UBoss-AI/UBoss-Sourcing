{
  "name": "uboss-backend",
  "version": "1.0.0",
  "private": true,
  "description": "UBOSS Sourcing backend API and worker (Fastify + TypeScript + Prisma + MariaDB)",
  "type": "module",
  "overrides": {
    "mariadb": "^3.5.4",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http/server.js",
    "start:worker": "node dist/worker/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:rotate-seed-passwords": "tsx src/seed/rotate-seed-passwords.cli.ts",
    "db:restore-seed-passwords": "tsx src/seed/restore-seed-passwords.cli.ts",
    "db:reference": "tsx src/seed/reference-data.cli.ts",
    "openapi:export": "tsx src/http/openapi-export.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "catalog:import": "tsx src/modules/catalog/sheet-import/import-product-sheet.cli.ts",
    "catalog:images": "tsx src/modules/catalog/product-images/attach-product-images.cli.ts",
    "catalog:prices": "tsx src/modules/catalog/provisional-price/set-provisional-prices.cli.ts",
    "catalog:group": "tsx src/modules/catalog/group-root-categories.cli.ts",
    "seed:demo-catalog": "tsx src/modules/catalog/demo-catalog/seed-demo-catalog.cli.ts",
    "seed:demo-quantity-tiers": "tsx src/seed/demo-quantity-tiers.cli.ts",
    "variants:audit": "tsx src/modules/catalog/variant-audit.cli.ts",
    "variants:demo": "tsx scripts/demo-variants.ts",
    "marketplace:sync": "tsx src/modules/catalog/marketplace-price.cli.ts"
  },
  "prisma": {
    "seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@aws-sdk/client-s3": "^3.1133.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@google/genai": "^2.21.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/polygon-to-line": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "argon2": "^0.45.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "topojson-client": "^3.1.0",
    "ulid": "^3.0.2",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "protobufjs": false,
    "@google/genai": false
  }
}
