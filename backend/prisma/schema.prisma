// ===========================================================================
// UBOSS Sourcing - data model
//
// Runs on: MariaDB 10.4.32 in development (XAMPP) and MariaDB 11.4 LTS in
// production. Prisma `mysql` provider - there is no separate MariaDB provider.
//
// THE TWO VERSIONS DIFFER IN WAYS THAT CHANGE BEHAVIOUR, NOT JUST SPEED. 10.4
// is not strict and truncates an over-long value; 11.4 rejects it. 11.4's
// default collation is utf8mb4_uca1400_ai_ci where every table here is
// utf8mb4_unicode_ci. `deploy/compat/` runs the production version locally so
// that gap is found on a laptop; docs/DATABASE-MIGRATION.md section 4 has the
// full list.
//
// MariaDB 10.4 constraints that shaped this schema. They are kept rather than
// undone - each is correct on both versions, and a migration to reverse one
// would buy nothing:
//   * No `FOR UPDATE SKIP LOCKED` (10.6+). Job/schedule claiming therefore uses
//     a lease pattern: conditional UPDATE + affectedRows check. See JobQueue
//     and RecurringSchedule lease* columns.
//   * No native UUID type (10.7+). Primary keys are ULIDs stored as CHAR(26):
//     lexicographically sortable, so InnoDB clustered-index inserts stay
//     append-only instead of fragmenting like UUIDv4.
//   * Server timezone here is Asia/Calcutta. Every instant is DATETIME(3) held
//     in UTC; wall-clock recurrence carries its own IANA `timezone` column.
//   * A MySQL UNIQUE index treats every NULL as distinct, so a nullable
//     variantId inside a composite unique would NOT prevent duplicate rows.
//     Wherever that matters we store `variantKey` - the variant ULID, or ''
//     for the base product - which is never null.
//
// Money is ALWAYS BigInt minor units (paise for INR). No Float anywhere.
// Tax rates are Decimal(9,6) percent. Rounding is half-up, applied per line.
// ===========================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ===========================================================================
// IDENTITY & ACCESS
// ===========================================================================

enum UserType {
  ADMIN
  CUSTOMER
  /// A person who works for a third-party logistics company.
  ///
  /// A THIRD audience rather than a flag on a customer, and the distinction is
  /// the whole tenant story. A seller is a CUSTOMER because the same person
  /// buys and sells; a courier's dispatcher is not a customer of this shop and
  /// must never be able to reach a cart, a price or a payment method. The
  /// guard checks this column and the token's own audience claim, so a
  /// credential minted for one surface cannot reach another.
  LOGISTICS
}

enum UserStatus {
  PENDING_INVITATION
  PENDING_APPROVAL
  ACTIVE
  DEACTIVATED
}

model User {
  id              String     @id @db.Char(26)
  type            UserType
  email           String     @db.VarChar(320)
  /// Lowercased/trimmed email. Uniqueness is enforced here, not on `email`.
  emailNormalized String     @unique(map: "uq_user_email_normalized") @db.VarChar(320)
  phone           String?    @db.VarChar(32)
  passwordHash    String?    @db.VarChar(255)
  status          UserStatus @default(PENDING_INVITATION)

  emailVerifiedAt DateTime? @db.DateTime(3)
  phoneVerifiedAt DateTime? @db.DateTime(3)

  /// An address the holder has asked to move to, not yet confirmed.
  ///
  /// Parked here rather than written over `email`, because `email` is what the
  /// account signs in with and what every order confirmation, payment link and
  /// invitation is sent to. Writing an unconfirmed address into it means one
  /// typo locks somebody out of their own purchasing account with no way back
  /// in — the confirmation link would go to the address that does not exist.
  ///
  /// `pendingEmailNormalized` exists for exactly one reason: to be checked
  /// against `emailNormalized` before the move is offered, so two accounts
  /// cannot both be moving to the same address and discover it at the moment
  /// the second one confirms. It is deliberately NOT unique — a collision here
  /// is a race to be refused politely, not a database error.
  pendingEmail           String? @db.VarChar(320)
  pendingEmailNormalized String? @db.VarChar(320)

  /// A telephone number the holder has asked to move to, not yet confirmed.
  ///
  /// Same rule as the address above, and worth stating plainly: this
  /// deployment has no SMS driver — `NotificationChannel` names SMS and
  /// nothing sends it — so the code that confirms this number is delivered to
  /// the account's verified email address. That proves control of the account,
  /// which is what stops somebody else changing the number; it does not prove
  /// control of the number itself. Wiring an SMS provider is what upgrades
  /// this, and the only thing that has to change is where the code is sent.
  pendingPhone String? @db.VarChar(32)

  /// Set when the account was opened with a system-issued temporary password.
  /// While it is true the session may sign in and do exactly one thing: choose
  /// a real password. Every other admin route refuses it.
  mustChangePassword         Boolean   @default(false)
  /// When that temporary password stops working. A password emailed in
  /// plaintext sits in an inbox forever otherwise; this is what stops it being
  /// a permanent key. Null once the holder has chosen their own.
  temporaryPasswordExpiresAt DateTime? @db.DateTime(3)

  /// TOTP secret, AES-256-GCM encrypted. Null until an admin enrols in MFA.
  mfaSecretEnc String?   @db.Text
  mfaEnabledAt DateTime? @db.DateTime(3)

  /// The highest TOTP counter this account has already spent.
  ///
  /// What stops a one-time password being a thirty-second password. Without
  /// it, a code read over somebody's shoulder - or read aloud to a caller
  /// claiming to be IT support - works again for the rest of its window.
  /// BigInt because it is a Unix-time division that outlives 2038.
  mfaLastCounter BigInt?

  /// SHA-256 of each UNUSED recovery code, as a JSON array of strings.
  ///
  /// Hashes rather than the codes, for the same reason a password is hashed:
  /// they are credentials. Each one is removed from the array as it is spent,
  /// so the length of the array is how many the account has left - which is
  /// the number the interface shows.
  mfaRecoveryCodeHashesJson Json?

  /// The language the interface is rendered in for this account, as a BCP-47
  /// primary subtag ("pl", "el", "nl"). Deliberately on `User` rather than on
  /// `CustomerProfile`: staff need it too, and a staff account has no profile
  /// row to hang it from.
  ///
  /// Null means "never chosen", which is not the same as English - the
  /// storefront falls back to what the browser asks for, and only a null here
  /// lets it. Writing "en" on signup would take that away from every account
  /// that has simply never opened the picker.
  ///
  /// Distinct from `preferredCountry`/`preferredCurrency` on the profile: those
  /// decide what a shopper is quoted in, this decides what language they read
  /// it in. A Polish buyer paying in euro is an ordinary case.
  preferredLanguage String? @db.VarChar(10)

  lastLoginAt      DateTime? @db.DateTime(3)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.DateTime(3)

  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)
  /// Soft delete. Transactional history keeps referencing the row.
  archivedAt DateTime? @db.DateTime(3)

  /// When an Art. 17 erasure rewrote this row. Distinct from `archivedAt`,
  /// which only means 'no longer in use': an archived account can be brought
  /// back, an erased one has nothing left to bring back. Set once and never
  /// cleared - it is the evidence the erasure happened.
  erasedAt DateTime? @db.DateTime(3)

  roles             UserRole[]
  sessions          Session[]
  authTokens        AuthToken[]
  customerProfile   CustomerProfile?
  auditLogs         AuditLog[]
  /// Which console notifications this member of staff has already opened.
  notificationReads AdminNotificationRead[]
  /// Console alerts they closed by hand. Kept pointing at the account after it
  /// is archived, and set to NULL only if the account is deleted outright -
  /// the record of what was resolved outlives whoever resolved it.
  notificationsResolved AdminNotification[] @relation("AdminNotificationResolver")

  /// Their place in a logistics organisation, where they work for one. At most
  /// one: a person drives for one carrier at a time, and a second membership
  /// would make "which tenant is this request for?" a question with two
  /// answers.
  logisticsMembership LogisticsPartnerUser?
  /// The audit rows they wrote, and the pings their phone sent. Both keep
  /// pointing at the account after it is archived - deleting somebody must not
  /// erase the record of what they did.
  logisticsAuditLogs  LogisticsAuditLog[]
  logisticsPings      LogisticsLocationPing[]

  @@index([type, status], map: "ix_user_type_status")
  @@index([createdAt], map: "ix_user_created_at")
  /// Created by 20260909233000_account_profile_contact_change_and_wishlist and
  /// never declared here, which is a worse state than either having it or not.
  ///
  /// The index existed in every database - the migration made it - but this
  /// file is what Prisma diffs against, so `migrate dev` would have generated
  /// `DROP INDEX ix_user_pending_email` as a tidy-up of something it thought
  /// nobody wanted. The contact-change check that reads it runs on every
  /// request to move an email address, against the users table.
  @@index([pendingEmailNormalized], map: "ix_user_pending_email")
  @@map("users")
}

model Role {
  id          String  @id @db.Char(26)
  key         String  @unique(map: "uq_role_key") @db.VarChar(64)
  name        String  @db.VarChar(128)
  description String? @db.VarChar(512)
  /// System roles cannot be renamed or deleted from the admin UI.
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @db.Char(26)
  /// Dotted resource.action, e.g. `product.publish`, `refund.create`.
  key         String  @unique(map: "uq_permission_key") @db.VarChar(96)
  description String? @db.VarChar(512)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Char(26)
  permissionId String @db.Char(26)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_role_permission_permission")
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Char(26)
  roleId       String   @db.Char(26)
  assignedById String?  @db.Char(26)
  assignedAt   DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId], map: "ix_user_role_role")
  @@map("user_roles")
}

model Session {
  id     String @id @db.Char(26)
  userId String @db.Char(26)

  /// SHA-256 of the refresh token. The raw token is returned once and never stored.
  refreshTokenHash String @unique(map: "uq_session_refresh_hash") @db.Char(64)
  /// Rotation family. Reuse of a revoked token revokes the whole family.
  familyId         String @db.Char(26)

  userAgent String? @db.VarChar(512)
  ipAddress String? @db.VarChar(45)

  /// Where the device said this sign-in happened, from the browser's
  /// Geolocation API. Admin sessions carry it because the console refuses to
  /// open until it is recorded; a customer session never has it.
  ///
  /// Six decimal places is roughly a tenth of a metre, which is finer than any
  /// browser fix and leaves no rounding to explain away.
  locationLatitude   Decimal?  @db.Decimal(9, 6)
  locationLongitude  Decimal?  @db.Decimal(9, 6)
  /// The radius the device claimed, in metres. A wifi fix is a few hundred, a
  /// GPS fix single digits - shown alongside the place so a coarse fix is not
  /// read as a precise one.
  locationAccuracyM  Int?
  /// The reverse-geocoded place, when a lookup was possible. Null falls back to
  /// the coordinates, which are always present whenever this section is filled.
  locationLabel      String?   @db.VarChar(255)
  /// The country that place is in, ISO-3166-1 alpha-2, when the geocoder named
  /// one. It is what the console prices for: a member of staff signing in from
  /// Germany is shown what a German customer pays, because that is the only
  /// market they can speak for. Null wherever no geocoder answered, and the
  /// console then quotes the seller's own country - the same fallback a
  /// shopper gets before they have given an address.
  locationCountry    String?   @db.Char(2)
  locationCapturedAt DateTime? @db.DateTime(3)

  /// When THIS session passed its second-factor challenge.
  ///
  /// Per session rather than per account, deliberately. `users.mfaEnabledAt`
  /// says the account HAS a second factor; this says the browser in front of
  /// us has presented it. Without the distinction, enrolling once would leave
  /// every future sign-in single-factor, which is not what a second factor is.
  ///
  /// Read by the logistics guard, which refuses every route but /auth/me,
  /// /auth/mfa/* and /auth/logout while it is null and the caller's role
  /// requires a challenge - the same shape as `mustChangePassword` and the
  /// admin location gate.
  mfaVerifiedAt DateTime? @db.DateTime(3)

  /// When THIS session last presented the seller password, and for whom.
  ///
  /// Exactly the same shape as `mfaVerifiedAt` above and for the same reason:
  /// `seller_members.passwordHash` says the lock EXISTS, this says the browser
  /// in front of us has opened it. Without the distinction, choosing a seller
  /// password once would leave every future sign-in walking straight into the
  /// Hub, which is not what a second lock is.
  ///
  /// The id is carried as well as the time because a person can sell for more
  /// than one business: unlocking one must not unlock the other, so the guard
  /// checks that this is the seller account the session was opened for.
  sellerUnlockedAt    DateTime? @db.DateTime(3)
  sellerUnlockedForId String?   @db.Char(26)

  expiresAt           DateTime  @db.DateTime(3)
  revokedAt           DateTime? @db.DateTime(3)
  revokedReason       String?   @db.VarChar(128)
  replacedBySessionId String?   @db.Char(26)

  /// When the SIGN-IN behind this family happened.
  ///
  /// `createdAt` is when this particular row was written, which a rotation
  /// resets every few minutes; this is set once at sign-in and carried into
  /// every replacement, exactly like `mfaVerifiedAt` above. It is what
  /// `SESSION_ABSOLUTE_TTL_SECONDS` is measured against, and it cannot be
  /// derived from the family's oldest row because housekeeping deletes rows
  /// that expired long ago - which on a long-lived family would quietly move
  /// the start of the clock forward and make the ceiling unreachable.
  ///
  /// Nullable only so that the migration adding it does not have to invent a
  /// value for sessions that already exist; those are treated as having no
  /// recorded start and are allowed to run out their refresh token normally.
  familyStartedAt DateTime? @db.DateTime(3)

  createdAt  DateTime @default(now()) @db.DateTime(3)
  lastUsedAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "ix_session_user_revoked")
  @@index([familyId], map: "ix_session_family")
  @@index([expiresAt], map: "ix_session_expires")
  @@map("sessions")
}

enum AuthTokenType {
  INVITATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// Confirming a NEW email address the holder has asked to move to. The
  /// address itself is parked in `users.pendingEmail` until this is consumed:
  /// an unverified address must never become the one the account signs in
  /// with, or a typo locks somebody out of their own purchasing account.
  EMAIL_CHANGE
  /// Confirming a new telephone number, the same way. See the note on
  /// `users.pendingPhone` for what actually carries the code today.
  PHONE_CHANGE
}

model AuthToken {
  id     String        @id @db.Char(26)
  userId String        @db.Char(26)
  type   AuthTokenType

  /// SHA-256 of a 32-byte random token. Single use, enforced via consumedAt.
  tokenHash String @unique(map: "uq_auth_token_hash") @db.Char(64)

  expiresAt   DateTime  @db.DateTime(3)
  consumedAt  DateTime? @db.DateTime(3)
  createdById String?   @db.Char(26)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt], map: "ix_auth_token_user_type")
  @@index([expiresAt], map: "ix_auth_token_expires")
  @@map("auth_tokens")
}

model LoginAttempt {
  id              String   @id @db.Char(26)
  emailNormalized String   @db.VarChar(320)
  userType        UserType
  ipAddress       String?  @db.VarChar(45)
  success         Boolean
  failureReason   String?  @db.VarChar(64)
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@index([emailNormalized, createdAt], map: "ix_login_attempt_email_time")
  @@index([ipAddress, createdAt], map: "ix_login_attempt_ip_time")
  @@map("login_attempts")
}

// ===========================================================================
// BUSINESS CONFIGURATION
// ===========================================================================

model BusinessProfile {
  /// Single-row table. This deployment serves exactly one business.
  id           String  @id @db.Char(26)
  legalName    String  @db.VarChar(255)
  displayName  String  @db.VarChar(255)
  logoMediaId  String? @db.Char(26)
  supportEmail String  @db.VarChar(320)
  supportPhone String? @db.VarChar(32)
  gstin        String? @db.VarChar(32)

  /// Whether product listings must satisfy GPSR Art. 19 before they publish.
  ///
  /// Off by default, because a deployment selling only outside the Union has
  /// no such obligation and turning it on would block every existing listing
  /// on a rule that does not apply to it.
  ///
  /// Turn it on to sell into the EU. The publish validator then refuses a
  /// product with no manufacturer, no identifier or no safety warning - and,
  /// where the manufacturer is established outside the Union, no responsible
  /// person inside it. Until then the same checks still run and are reported
  /// as warnings, so the gap is visible before it is enforced.
  gpsrEnforced Boolean @default(false)

  /// What the marketplace keeps when a seller's offer is bought, in basis
  /// points (250 = 2.50%).
  ///
  /// Basis points rather than a decimal percentage: a rate stored as 0.025
  /// comes back as 0.024999999 often enough that a settlement stops
  /// reconciling, and the figure people argue about is the one in the
  /// contract. Zero by default, and that default is the honest one — a
  /// deployment that has not decided what it charges must not quietly start
  /// charging something.
  ///
  /// This is the PLATFORM rate. `SellerAccount.commissionBasisPoints`
  /// overrides it per seller, which is why that column is nullable: a seller
  /// negotiated onto their own schedule keeps it when this moves.
  sellerCommissionBasisPoints Int @default(0) @db.SmallInt

  /// Whether a product marked as a medical device must carry its MDR
  /// identification before it publishes.
  ///
  /// Off by default and separate from `gpsrEnforced`, because the two are
  /// different obligations with different scopes: GPSR covers every consumer
  /// product, MDR covers devices only. A shop selling gloves alongside
  /// bandages may well need one and not the other.
  mdrEnforced Boolean @default(false)

  /// The seller's EU VAT identification number, e.g. "NL123456789B01".
  /// Art. 226(3) requires it on every invoice; its presence is also what
  /// switches EU VAT resolution on for this deployment.
  vatNumber String? @db.VarChar(32)

  /// The member state the business is established in for VAT. Decides which
  /// supplies are domestic, which are intra-Community, and which are exports.
  /// Null in a deployment that is not in the EU, and VAT resolution then never
  /// runs - the flat tax-class rate applies, as it always did.
  vatCountry String? @db.Char(2)

  /// Registered/invoice address. Shape validated by Zod at the API boundary.
  addressJson Json?

  currency      String @db.Char(3)
  /// IANA zone used for invoice dates, reports and schedule defaults.
  timezone      String @db.VarChar(64)
  invoicePrefix String @default("INV") @db.VarChar(16)
  orderPrefix   String @default("UB") @db.VarChar(16)

  policyLinksJson Json?

  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedById String?  @db.Char(26)

  logoMedia MediaAsset? @relation(fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@map("business_profile")
}

model TaxClass {
  id   String @id @db.Char(26)
  code String @unique(map: "uq_tax_class_code") @db.VarChar(32)
  name String @db.VarChar(128)

  /// Percent, e.g. 18.000000 for 18% GST. Decimal, never Float.
  ratePercent Decimal      @db.Decimal(9, 6)
  /// Which EU rate band this class falls in. Null means "this class has no EU
  /// meaning": the flat `ratePercent` above is used wherever it is sold, which
  /// is the correct behaviour for GST and for any deployment with no VAT rates
  /// configured. Set it and the rate becomes a lookup against the destination
  /// member state instead - see modules/tax/vat.service.ts.
  vatCategory VatCategory?

  /// true  = listed price already contains tax (extract it)
  /// false = tax is added on top of the listed price
  isInclusive Boolean @default(false)
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  products Product[]

  @@index([isActive], map: "ix_tax_class_active")
  @@map("tax_classes")
}

model ShippingMethod {
  id          String  @id @db.Char(26)
  code        String  @unique(map: "uq_shipping_method_code") @db.VarChar(32)
  name        String  @db.VarChar(128)
  description String? @db.VarChar(512)

  priceMinor     BigInt  @default(0)
  /// Order subtotal at or above which this method costs nothing. Null = never free.
  freeAboveMinor BigInt?

  /// Serviceable regions/postcodes. Null = everywhere.
  regionsJson Json?

  estimatedDaysMin Int?
  estimatedDaysMax Int?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([isActive, sortOrder], map: "ix_shipping_method_active")
  @@map("shipping_methods")
}

/// Keeping converted prices current, without ever converting at read time.
///
/// One row. The refresh job reads it, re-converts every price still flagged
/// `isAutoConverted`, and writes the results as ordinary price rows - so the
/// figure a shopper is quoted is still a stored one, and still the figure they
/// are charged. The rate is used at write time and never at display time; that
/// distinction is the reason this is a scheduled job and not a formula.
model CurrencyRateSync {
  id String @id @db.Char(26)

  /// Off until staff turn it on. A deployment that has never opened a second
  /// market must not start making outbound calls on a timer.
  isEnabled Boolean @default(false)

  /// Added on top of every converted figure, as a percentage.
  ///
  /// A buffer against the rate moving between refreshes, and against the spread
  /// the business actually pays to settle in another currency. Zero is legal
  /// and means "quote the mid-market rate".
  marginPercent Decimal @default(0.00) @db.Decimal(5, 2)

  /// How a converted figure is tidied: exact, whole, or charm. Mirrors the
  /// bulk pricing tool, so a scheduled run and a manual one agree.
  rounding String @default("charm") @db.VarChar(8)

  /// Abandon a run that would move any single price by more than this.
  ///
  /// A rate feed returning nonsense - a wrong base, a decimal shift, an error
  /// body parsed as data - is a catalogue-wide mispricing that nobody is
  /// watching for at 3am. The run refuses as a whole rather than writing part
  /// of it, and says so on the settings screen.
  maxDriftPercent Decimal @default(15.00) @db.Decimal(5, 2)

  lastRunAt      DateTime? @db.DateTime(3)
  /// ok | skipped | failed - what the settings screen reports.
  lastRunStatus  String?   @db.VarChar(16)
  lastRunMessage String?   @db.VarChar(512)
  lastRunUpdated Int       @default(0)

  // --- Which feed, and what it may be used for ---------------------------

  /// The adapter that fetches rates: "ecb" or "json".
  ///
  /// Defaults to `json` rather than to the ECB deliberately. A deployment
  /// upgrading into this feature had its rates coming from `FX_RATE_URL`, and
  /// changing where a live shop's prices come from as a side effect of running
  /// a migration is precisely the silent financial change the project rules
  /// forbid. A new deployment is pointed at the ECB by configuration instead.
  provider String @default("json") @db.VarChar(32)

  /// How old a stored rate set may be and still be shown on a page.
  ///
  /// THE THREE WINDOWS BELOW ARE SIZED BY THE ECB'S PUBLISHING CALENDAR, NOT
  /// BY INTUITION, AND THE ARITHMETIC IS WORTH WRITING DOWN BECAUSE THE
  /// OBVIOUS NUMBERS ARE ALL WRONG.
  ///
  /// A snapshot's age is measured from the provider's own date, and the ECB
  /// dates a document by the day. This system reads that as midnight UTC - the
  /// conservative reading, since publication is late afternoon CET, so a set
  /// always looks slightly older than it is rather than slightly fresher.
  ///
  /// So an ordinary weekend is not the fifty-odd hours it feels like:
  ///
  ///   Friday's document is dated Friday 00:00.
  ///   A shopper arrives Monday 09:00.       -> 81 hours.
  ///   A shopper arrives Monday 18:00.       -> 90 hours.
  ///
  /// Seventy-two hours - the number that looks right - therefore blanks every
  /// derived price on a Monday morning, every week. A week is the smallest
  /// window that survives a weekend plus a public holiday either side of it,
  /// and a figure this old is marked approximate wherever it is shown anyway.
  displayMaxAgeHours Int @default(168)

  /// How old a rate set may be and still have money taken against it.
  ///
  /// Separate from the display window and shorter, because the two are not the
  /// same risk: a catalogue page marked "approximate" that was converted from a
  /// three-day-old rate is honest, while a card charged on one is a figure
  /// nobody can reconcile afterwards. Past this, a checkout in a derived
  /// currency fails rather than guessing.
  ///
  /// Ninety-six hours, for the reason set out above: it has to clear the
  /// 90-hour Monday or derived-currency checkout breaks every weekend. A
  /// longer closure - Christmas, Easter - does block it, and that is the
  /// intended behaviour rather than a gap. A deployment that needs tighter
  /// rates than a daily reference feed can give should price those markets by
  /// hand, or use a settlement-rate provider, which is what the provider
  /// interface exists for.
  checkoutMaxAgeHours Int @default(96)

  /// Past this age the health check raises an operational alert, whether or not
  /// anything has yet failed to price.
  ///
  /// Deliberately the smallest of the three, so the ordering is: somebody is
  /// told (72h), then checkout stops (96h), then the catalogue stops (168h). An
  /// alert that fired at the same moment customers were affected would be a
  /// report rather than a warning.
  alertMaxAgeHours Int @default(72)

  /// How long a checkout quote holds its rate.
  ///
  /// Once a customer is shown a total, that total is what they are charged, and
  /// this is how long the system will still honour it. Nothing recomputes a
  /// price while a payment is in flight.
  quoteTtlSeconds Int @default(900)

  // --- Read-time derivation ----------------------------------------------

  /// Whether a currency with no price row of its own may be priced by
  /// converting the base-currency figure at read time.
  ///
  /// OFF by default, and that is a deliberate refusal to change an existing
  /// shop's behaviour underneath it. Until this is switched on, the rule stays
  /// exactly what it has always been: a SKU with no row in a currency is not
  /// sellable in it, full stop. Switching it on is a pricing decision an
  /// operator makes knowingly, and a derived figure is marked approximate
  /// everywhere it is shown.
  ///
  /// A manual row always wins. This only ever fills a gap.
  deriveMissingPrices Boolean @default(false)

  // --- Health ------------------------------------------------------------

  /// When a fetch last succeeded and last failed, kept apart so "it has been
  /// failing for six hours" is answerable without reading a log.
  lastSuccessAt DateTime? @db.DateTime(3)
  lastFailureAt DateTime? @db.DateTime(3)

  /// Drives the retry backoff, and reset to zero by any success. A worker that
  /// has failed eleven times in a row should not still be trying every hour.
  consecutiveFailures Int @default(0)

  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedById String?  @db.Char(26)

  @@map("currency_rate_sync")
}

/// Machine-translating the catalogue itself.
///
/// The interface catalogues ship with the product and are translated once, in
/// the repository. A shop's *own* products cannot be: every deployment sells
/// something different, and twenty products across seven languages is a
/// hundred and forty pieces of copy nobody will type. So the key lives here,
/// encrypted, and the panel does the work.
///
/// One row, like `CurrencyRateSync`.
model CatalogTranslationSync {
  id String @id @db.Char(26)

  /// DeepL auth key, encrypted at rest with `SECRETS_ENCRYPTION_KEY`. Null
  /// until somebody enters one, which is what keeps the feature switched off.
  apiKeyEncrypted String? @db.Text

  /// The last four characters of the key, so the panel can show *which* key is
  /// stored without being able to show the key.
  apiKeyHint String? @db.VarChar(8)

  lastRunAt         DateTime? @db.DateTime(3)
  /// ok | skipped | failed
  lastRunStatus     String?   @db.VarChar(16)
  lastRunMessage    String?   @db.VarChar(512)
  lastRunTranslated Int       @default(0)
  /// True while a run is in flight, so the panel can show progress and a
  /// second click cannot start an overlapping run.
  isRunning         Boolean   @default(false)

  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedById String?  @db.Char(26)

  @@map("catalog_translation_sync")
}

model FeatureFlag {
  id          String  @id @db.Char(26)
  key         String  @unique(map: "uq_feature_flag_key") @db.VarChar(96)
  enabled     Boolean @default(false)
  description String? @db.VarChar(512)

  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedById String?  @db.Char(26)

  @@map("feature_flags")
}

enum NotificationChannel {
  EMAIL
  SMS
}

model NotificationSetting {
  id       String @id @db.Char(26)
  /// e.g. `customer.invitation`, `order.confirmed`, `inventory.low_stock`.
  eventKey String @unique(map: "uq_notification_setting_event") @db.VarChar(96)
  name     String @db.VarChar(128)

  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  subjectTemplate String @db.VarChar(255)
  bodyTemplate    String @db.Text

  /// Extra internal recipients (Finance, Inventory Manager...) beyond the subject.
  internalRecipientsJson Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@map("notification_settings")
}

// ===========================================================================
// MEDIA
// ===========================================================================

model MediaAsset {
  id         String  @id @db.Char(26)
  /// Key inside the configured storage driver (local disk or S3).
  storageKey String  @unique(map: "uq_media_storage_key") @db.VarChar(512)
  url        String  @db.VarChar(1024)
  mimeType   String  @db.VarChar(128)
  sizeBytes  Int
  width      Int?
  height     Int?
  altText    String? @db.VarChar(512)
  /// SHA-256 of the bytes; lets repeat uploads reuse an existing asset.
  checksum   String? @db.Char(64)

  uploadedById String?  @db.Char(26)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  productMedia     ProductMedia[]
  variantMedia     ProductVariantMedia[]
  categoryImages   Category[]        @relation("CategoryImage")
  categoryBanners  Category[]        @relation("CategoryBanner")
  businessProfiles BusinessProfile[]

  @@index([checksum], map: "ix_media_checksum")
  @@map("media_assets")
}

// ===========================================================================
// CATALOG
//
// Public visibility requires status = ACTIVE **and** isPublished = true.
// Draft/inactive/unpublished rows stay admin-only. See the catalog module's
// single `publicProductWhere()` helper - no route builds this filter by hand.
// ===========================================================================

enum CatalogStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Category {
  id       String  @id @db.Char(26)
  parentId String? @db.Char(26)

  name        String  @db.VarChar(255)
  slug        String  @unique(map: "uq_category_slug") @db.VarChar(255)
  description String? @db.Text

  imageMediaId  String? @db.Char(26)
  bannerMediaId String? @db.Char(26)

  /// Materialised ancestor path (`/rootId/childId/`) + depth, so subtree reads
  /// and cycle checks are one indexed query instead of a recursive CTE
  /// (MariaDB 10.4 has recursive CTEs, but this keeps hot reads cheap).
  path  String @default("/") @db.VarChar(1024)
  depth Int    @default(0)

  sortOrder Int     @default(0)
  isActive  Boolean @default(false)

  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(512)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  archivedAt  DateTime? @db.DateTime(3)
  createdById String?   @db.Char(26)
  updatedById String?   @db.Char(26)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  couponCategories CouponCategory[]
  translations     CategoryTranslation[]

  /// The fields the listing wizard asks for in this category, and the drafts
  /// still being written against it. See the LISTING SCHEMA block at the end
  /// of this file.
  attributeDefinitions CategoryAttributeDefinition[]
  listingDrafts        SellerListingDraft[]

  imageMedia  MediaAsset? @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  bannerMedia MediaAsset? @relation("CategoryBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)

  @@index([parentId, sortOrder], map: "ix_category_parent_sort")
  @@index([isActive, archivedAt], map: "ix_category_active")
  /// The `length: 768` is not a choice; it is what the database actually has.
  ///
  /// `path` is VARCHAR(1024), which in utf8mb4 is 4096 bytes, and InnoDB's
  /// limit for one index column is 3072. MariaDB does not refuse the index -
  /// it silently shortens it to the 768 characters that fit and raises a
  /// warning nobody reads. Declaring the full column here instead meant
  /// `prisma migrate diff` reported this index as different on every run, and
  /// a `migrate dev` would have generated a pointless DROP and re-CREATE of it.
  @@index([path(length: 768)], map: "ix_category_path")
  @@map("categories")
}

model Product {
  id         String @id @db.Char(26)
  categoryId String @db.Char(26)

  name String @db.VarChar(255)
  slug String @unique(map: "uq_product_slug") @db.VarChar(255)
  sku  String @unique(map: "uq_product_sku") @db.VarChar(64)

  shortDescription String? @db.VarChar(1024)
  description      String? @db.Text
  /// Sanitised HTML only. Stored post-sanitisation; never rendered raw.
  descriptionHtml  String? @db.Text

  status      CatalogStatus @default(DRAFT)
  isPublished Boolean       @default(false)
  publishedAt DateTime?     @db.DateTime(3)
  /// Set when publication is scheduled ahead of time.
  publishFrom DateTime?     @db.DateTime(3)

  taxClassId     String @db.Char(26)
  basePriceMinor BigInt
  currency       String @db.Char(3)

  /// This price is a placeholder somebody still has to replace.
  ///
  /// Set by `catalog:prices`, which gives an imported product something to sell
  /// at before the real figure is known - a catalogue that cannot be added to a
  /// basket cannot be demonstrated, reviewed or tested end to end.
  ///
  /// It exists because the alternative is unanswerable. Without it, "which of
  /// these 223 prices did we make up?" has no answer once the run has finished,
  /// and a placeholder that cannot be found again is a placeholder that ships.
  /// Cleared automatically the moment an administrator sets a price by hand -
  /// see `updateProduct` - so it only ever marks figures nobody has confirmed.
  ///
  /// Deliberately NOT part of the public product select. It changes nothing a
  /// customer sees: the price displays and behaves exactly like any other. It
  /// is a note to the operator about their own catalogue.
  hasProvisionalPrice Boolean @default(false)

  /// The price is deliberately not published; the buyer is asked to request one.
  ///
  /// A B2B catalogue routinely lists items whose price is negotiated per
  /// account or per volume, and a supplier sheet that carries no price at all
  /// is the normal case rather than an unfinished draft. Without this, the
  /// only ways to list such an item are to invent a number or to leave it out
  /// of the catalogue, and both are worse than saying "ask us".
  ///
  /// It relaxes exactly one publication rule - the price-above-zero check -
  /// and tightens one behaviour: nothing priced on request can be added to a
  /// cart, bought instantly or put on a schedule, because there is no figure
  /// to charge. Default false, so a deployment that never sets it behaves
  /// exactly as it did before this column existed.
  isPriceOnRequest    Boolean @default(false)
  /// Optional strike-through / list price for display. Must be >= basePriceMinor.
  compareAtPriceMinor BigInt?

  isStockTracked   Boolean @default(true)
  reorderThreshold Int     @default(0)

  /// Listed, but not for sale right now.
  ///
  /// Not the same axis as `status`/`isPublished`, and confusing the two is the
  /// mistake this column exists to prevent. Unpublishing hides a product
  /// completely - its URL 404s and a customer who bookmarked it is simply
  /// lost. This keeps the listing and its specifications readable while
  /// refusing every purchase path, which is what "we make this, you cannot
  /// order it this week" actually means.
  ///
  /// Stock is a different answer again: out of stock is a fact about a
  /// warehouse, this is a decision about the product.
  isOrderable Boolean @default(true)

  /// Why it cannot be ordered, in the operator's own words, shown to the
  /// customer beside the "Currently unavailable" notice. Null shows the
  /// notice on its own rather than an empty sentence.
  unavailabilityReason String? @db.VarChar(255)

  /// How many pieces are in one carton of THIS product, or null for an item
  /// sold one at a time.
  ///
  /// The operator's shop has always sold by the carton, at one size set for
  /// the whole deployment - see `PIECES_PER_CARTON`. That is right for a
  /// consumables range that genuinely ships that way and wrong for everything
  /// else: a catalogue that also sells a cordless drill, a laptop and a pair
  /// of boots was quoting all three at five hundred times their price and
  /// telling the buyer "one carton has 500 pieces" underneath.
  ///
  /// So the carton became a fact about the PRODUCT. Null means this is sold
  /// as a piece, which is the default and what every new product gets. A
  /// figure means one purchasable unit contains that many pieces, and the
  /// storefront, the basket, the wishlist and the schedule quote all read the
  /// same column - there is no second answer for any of them to disagree with.
  ///
  /// It does NOT rewrite history. Every basket line, plan line and order line
  /// keeps the carton size it was agreed at, so a quantity on last year's
  /// invoice still means what it meant then.
  ///
  /// The backfill in the migration set it from each product's own
  /// `product_packaging.piecesPerOuterCarton`, so the range that was already
  /// described as cartoned behaves exactly as it did.
  piecesPerCarton Int?

  /// Purchasing rules enforced server-side on every cart mutation and at checkout.
  minOrderQty  Int  @default(1)
  maxOrderQty  Int?
  qtyIncrement Int  @default(1)

  isRecurringEligible Boolean @default(false)
  hasVariants         Boolean @default(false)

  /// The variant axes this product actually sells along, as an ordered list of
  /// template axis keys: `["size_system", "size", "colour"]`.
  ///
  /// The KEYS only. The labels, input types, units, suggestions and sort order
  /// all live in `src/domain/variants/` - one registry of 112 subcategory
  /// templates that the seller's matrix builder, the buyer's selector and the
  /// catalogue's facets all read. Copying an axis definition onto every
  /// product would mean a corrected label reaching the products listed after
  /// the correction and no others.
  ///
  /// NULL and `[]` both mean "this product declares no axes", and that is the
  /// ordinary case rather than an unfinished one. Every product that existed
  /// before this column behaves exactly as it did: a product with variants but
  /// no axes gets the free-form option picker the catalogue has always had -
  /// which is what keeps Medical Devices, where a hospital buyer chooses
  /// several sizes at once, working the way it works today.
  ///
  /// A key the product's template does not offer is ignored on read rather
  /// than failing, so removing an axis from a template cannot break a product
  /// already selling along it. See `resolveActiveAxes`.
  variantAxesJson Json?

  /// A catalogue entry that exists because a seller listed it, rather than
  /// because the operator stocks it.
  ///
  /// The difference it makes is where the price and the stock come from. A
  /// marketplace product has neither of its own - `basePriceMinor` is the
  /// lowest live offer and the buyer buys from a `SellerOffer` - so nothing
  /// may set a price on one directly. Default false, which is what every
  /// product that existed before the Seller Hub is, and they behave exactly as
  /// they did.
  isMarketplaceProduct Boolean @default(false)

  /// The seller who first described this item. Kept for the trail and for
  /// moderation - "who told us this is what a Class IIb pump is" has to have an
  /// answer - and NOT as ownership: once the product exists, any approved
  /// seller may offer it.
  createdBySellerAccountId String? @db.Char(26)

  /// Whether this has to travel refrigerated.
  ///
  /// A shipping restriction rather than a catalogue fact, and it is here
  /// because it belongs to the product: a reagent needs the cold chain from
  /// whichever building it leaves. What it is checked against is
  /// `WarehouseDeliveryZone.supportsColdChain` - a lane that cannot hold
  /// temperature cannot carry this, however near it is and however much of it
  /// the warehouse holds.
  ///
  /// Default false, so every product in a running deployment keeps behaving
  /// exactly as it did and no lane is narrowed by this column existing.
  requiresColdChain Boolean @default(false)

  weightGrams     Int?
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(512)

  /// Identity of the source-sheet product family this row came from.
  ///
  /// A SHA-256 of the normalised grouping fields, so re-importing the same
  /// workbook updates this product rather than creating a second one. Null for
  /// everything created by hand - and NULL being distinct under MySQL is
  /// precisely what lets every hand-made product leave it empty while the
  /// unique index still holds for imported ones.
  importFingerprint String? @unique(map: "uq_product_import_fingerprint") @db.Char(64)

  /// --- Product safety (GPSR Art. 19) ---
  ///
  /// Nullable, all of it, because a deployment that does not sell into the
  /// Union has no use for any of it and must not be forced to invent values.
  /// What turns these into a publication requirement is
  /// `business_profile.gpsrEnforced` - see the publish validator.

  /// Art. 19(a). Who made it.
  manufacturerId String? @db.Char(26)

  /// Art. 19(b). The responsible person inside the Union, required whenever
  /// the manufacturer is established outside it. This is the field an
  /// importing seller most often has no answer for, and the one a market
  /// surveillance authority asks for first.
  euResponsibleId String? @db.Char(26)

  /// Art. 19(c). Identifiers a buyer and an authority can both use.
  ///
  /// `gtin` is the barcode number - EAN-13, UPC-A or GTIN-14 - which is what
  /// a distributor's system matches on. `modelIdentifier` is the
  /// manufacturer's own type or model designation, which is what a recall
  /// notice names. The SKU on this row is ours and means nothing outside this
  /// installation, so neither of these can be derived from it.
  gtin            String? @db.VarChar(14)
  modelIdentifier String? @db.VarChar(64)

  /// Art. 19(d). Warnings and safety information.
  ///
  /// The base-language text. The translated versions live on
  /// `product_translations`, because "a language which can be easily
  /// understood" means the reader's, not the catalogue author's - a German
  /// hospital reading an English-only warning has not been warned.
  safetyWarnings     String? @db.Text
  safetyInstructions String? @db.Text

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  archivedAt  DateTime? @db.DateTime(3)
  createdById String?   @db.Char(26)
  updatedById String?   @db.Char(26)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  taxClass TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Restrict)

  /// Restrict on both: an operator named on a published listing cannot be
  /// deleted out from under it, because the listing would then be offering a
  /// product with no manufacturer named - which is the exact state Art. 19
  /// forbids. Retiring one means archiving it and repointing the products.
  /// Present only for a product somebody has marked as a medical device.
  /// The row's existence is the flag - a boolean here with the data elsewhere
  /// is one more pair of things that can disagree.
  deviceInfo ProductDeviceInfo?

  manufacturer  EconomicOperator? @relation("ProductManufacturer", fields: [manufacturerId], references: [id], onDelete: Restrict)
  euResponsible EconomicOperator? @relation("ProductEuResponsible", fields: [euResponsibleId], references: [id], onDelete: Restrict)

  variants            ProductVariant[]
  media               ProductMedia[]
  attributes          ProductAttribute[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  stockReservations   StockReservation[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  scheduleItems       RecurringScheduleItem[]
  substituteForItems  RecurringScheduleItem[]     @relation("ScheduleItemSubstitute")
  prices              ProductPrice[]
  translations        ProductTranslation[]
  wishlistItems       WishlistItem[]
  instructions        ProductInstruction[]
  countryRestrictions ProductCountryRestriction[]
  packagings          ProductPackaging[]
  importRecords       ProductImportRecord[]

  /// Every seller offering this item. Empty for a product the operator stocks
  /// themselves, which is every product that existed before the Seller Hub -
  /// see the SELLER HUB block at the end of this file for why the price lives
  /// on the offer rather than here.
  sellerOffers SellerOffer[]

  createdBySellerAccount SellerAccount? @relation(fields: [createdBySellerAccountId], references: [id], onDelete: SetNull)

  /// Present only on a product planted by the demonstration catalogue seed.
  /// Its absence is what makes a genuine product genuine - see the DEMO
  /// CATALOGUE block at the end of this file.
  demoEntry DemoCatalogEntry?

  @@index([isMarketplaceProduct, status], map: "ix_product_marketplace")
  @@index([createdBySellerAccountId], map: "ix_product_created_by_seller")
  @@index([categoryId, status, isPublished], map: "ix_product_category_visibility")
  @@index([status, isPublished, archivedAt], map: "ix_product_visibility")
  @@index([basePriceMinor], map: "ix_product_price")
  @@index([createdAt], map: "ix_product_created")
  @@index([name], map: "ix_product_name")
  @@index([manufacturerId], map: "ix_product_manufacturer")
  @@index([euResponsibleId], map: "ix_product_eu_responsible")
  /// A barcode is not unique in this table on purpose: two rows can legitimately
  /// carry one GTIN - the same item listed in two pack sizes under one code by
  /// a supplier who reuses them - and refusing that would block a real
  /// catalogue for a rule the standard does not actually impose on us.
  @@index([gtin], map: "ix_product_gtin")
  @@map("products")
}

model ProductVariant {
  id        String @id @db.Char(26)
  productId String @db.Char(26)

  sku  String @unique(map: "uq_variant_sku") @db.VarChar(64)
  name String @db.VarChar(255)

  /// The same two identifiers `Product` carries, per sellable SKU.
  ///
  /// A barcode belongs to the thing in the box, and two sizes of one product
  /// are two different things in two different boxes with two different
  /// barcodes. Reading them off the parent would hand a scanner the wrong
  /// number for every variant but one.
  gtin            String? @db.VarChar(14)
  modelIdentifier String? @db.VarChar(64)

  /// Selected option values, e.g. { "Size": "1L", "Pack": "12" }.
  ///
  /// Keyed by the template's axis key for anything the matrix builder created
  /// (`{ "size": "8", "colour": "Black" }`), and by whatever the author typed
  /// for a free-form variant. Both are read the same way - the resolver folds
  /// keys before comparing them - which is what lets one product page serve a
  /// template-driven shoe and a hand-written medical size side by side.
  optionsJson Json

  /// The deterministic identity of this combination.
  ///
  /// `colour:black|size:8|size_system:uk` - axes sorted by key, values case
  /// and punctuation folded. Computed by `optionSignature`, and the ONLY thing
  /// that can stop the same combination being stored twice: "Black" and
  /// "black" are two strings and one shoe, and two rows for one shoe is a
  /// resolver picking between them at random and a buyer seeing whichever the
  /// query planner returned.
  ///
  /// Empty string for a variant with no readable options, which is why the
  /// unique index below can exist at all - MariaDB treats every NULL in a
  /// UNIQUE index as distinct, so a nullable column here would enforce
  /// nothing. Exactly the trick `variantKey` plays elsewhere in this file.
  optionSignature String @default("") @db.VarChar(512)

  /// Absolute price for this variant. Null falls back to Product.basePriceMinor.
  priceMinor BigInt?

  /// Strike-through price for THIS size, where it differs from the family's.
  ///
  /// Must be at or above `priceMinor`; a "was" price below the "now" price is
  /// a discount claim that is false, and the validator refuses it rather than
  /// printing a negative saving.
  compareAtPriceMinor BigInt?

  /// --- Terms of trade, per sellable SKU ---
  ///
  /// All nullable, and null means "the product family's rule applies". That is
  /// what every row written before these columns existed says, so nothing
  /// changed for any of them. A variant overrides only where the seller
  /// genuinely trades differently in that size - a pallet quantity that is
  /// sold in tens while the single is sold in ones.
  minOrderQty  Int?
  qtyIncrement Int?
  maxOrderQty  Int?

  /// Working days between the order and dispatch, where this size is made or
  /// brought in to order. Null means the family's ordinary lead time.
  leadTimeDays Int?

  /// --- What is in one purchasable unit ---

  /// How many identical sellable units are supplied together - the 10 in "Pack
  /// of 10". Null or 1 is a single.
  ///
  /// NOT how many the buyer wants. That is the cart line's quantity, and
  /// conflating the two is how somebody ordering 3 of a Pack of 10 is sent
  /// three packets. See `domain/variants/commerce.ts`.
  multipackCount Int?

  /// What is inside ONE of those units - 500 g, 250 ml, 100 sheets.
  ///
  /// A decimal and a unit held apart, never a string: "500g" cannot be sorted,
  /// cannot be compared against "0.5 kg", and cannot be divided into a price
  /// per kilogram. Decimal rather than Float for the same reason money is
  /// BigInt - a net weight that is wrong in the seventh decimal place prints
  /// as wrong on a delivery note.
  netContentValue Decimal? @db.Decimal(18, 6)
  netContentUnit  String?  @db.VarChar(16)

  /// The amount a unit price is quoted against - "per 1 kg", "per 100 g".
  ///
  /// The seller's choice, because "per 100 g" and "per kg" are a factor of ten
  /// apart and a shopper comparing two listings has to see which is which. A
  /// sensible default is offered per unit family where this is null.
  unitPricingBaseValue Decimal? @db.Decimal(18, 6)
  unitPricingBaseUnit  String?  @db.VarChar(16)

  /// The manufacturer's own packaged unit, in their words - "Box of 100".
  /// Displayed, never parsed: it is a label on a carton, not a quantity this
  /// system does arithmetic with.
  manufacturerPackLabel String? @db.VarChar(64)

  /// --- Shipping, per sellable SKU ---
  ///
  /// A 10-pack and a single weigh different amounts and go in different boxes,
  /// so reading these off the product would quote one carrier price for both.
  /// Null falls back to the product's `weightGrams` and to whatever the
  /// fulfilment quote does today.
  shippingWeightGrams Int?
  shippingLengthMm    Int?
  shippingWidthMm     Int?
  shippingHeightMm    Int?
  /// The operator's own handling class - "fragile", "oversize", "hazmat".
  /// A label this system passes through; nothing here interprets it.
  shippingClass       String? @db.VarChar(32)

  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  archivedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  scheduleItems      RecurringScheduleItem[]
  substituteForItems RecurringScheduleItem[] @relation("ScheduleItemSubstituteVariant")
  prices             ProductPrice[]
  packagings         ProductPackaging[]
  importRecords      ProductImportRecord[]

  /// See `Product.importFingerprint`. This one is per source row.
  importFingerprint String? @unique(map: "uq_variant_import_fingerprint") @db.Char(64)

  sellerOffers SellerOffer[]
  media        ProductVariantMedia[]

  /// One row per combination, per product.
  ///
  /// The constraint the whole variant system rests on. Added only after the
  /// backfill in the same migration has given every existing row a signature,
  /// because a unique index applied to unnormalised data fails on the first
  /// duplicate and takes the deployment with it.
  @@unique([productId, optionSignature], map: "uq_variant_option_signature")
  @@index([productId, isActive, sortOrder], map: "ix_variant_product")
  @@map("product_variants")
}

/// A photograph of one particular size or colour.
///
/// Separate from `product_media` rather than a nullable column on it, because
/// the two are read at different times and by different queries: the gallery
/// loads the family's photographs on every product page, and these are pulled
/// in only once a buyer has narrowed to a variant. A nullable `variantId` on
/// the existing table would have meant every gallery read filtering rows it
/// never wants, and a change to a unique index that products already depend on.
///
/// A variant with no media of its own shows the family's. That is a fallback in
/// the reader, not a copy here: duplicating the family's photographs onto forty
/// rows means a replaced photograph reaching some of them.
model ProductVariantMedia {
  id        String @id @db.Char(26)
  variantId String @db.Char(26)
  mediaId   String @db.Char(26)

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "fk_variant_media_variant")
  media   MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Restrict, map: "fk_variant_media_asset")

  @@unique([variantId, mediaId], map: "uq_variant_media")
  @@index([variantId, sortOrder], map: "ix_variant_media_sort")
  @@map("product_variant_media")
}

model ProductMedia {
  id        String @id @db.Char(26)
  productId String @db.Char(26)
  mediaId   String @db.Char(26)

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId], map: "uq_product_media")
  @@index([productId, sortOrder], map: "ix_product_media_sort")
  @@map("product_media")
}

model ProductAttribute {
  id        String @id @db.Char(26)
  productId String @db.Char(26)

  name         String  @db.VarChar(128)
  value        String  @db.VarChar(512)
  sortOrder    Int     @default(0)
  /// Attributes drive faceted filtering when true.
  isFilterable Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name], map: "uq_product_attribute_name")
  @@index([name, value], map: "ix_product_attribute_lookup")
  @@map("product_attributes")
}

// ---------------------------------------------------------------------------
// PACKAGING
//
// How many of a thing are in a box, and how many boxes travel in a carton. A
// wholesale catalogue lives or dies on this: a hospital ordering "10" means
// ten cartons, and a system that reads it as ten pieces ships a two-hundredth
// of the order. The figures arrive on a supplier sheet as free text -
// "100Pcs x 20Box=2000Pcs", "inner -40 pcs/outer -160 pcs", "400Pcs" - so the
// raw text is kept beside whatever could be read out of it, and a row whose
// own arithmetic disagrees is flagged rather than quietly corrected.
// ---------------------------------------------------------------------------

/// How much of a packing description could be read, and whether it adds up.
enum PackingParseStatus {
  /// Every figure was read, and inner x packs = outer exactly.
  PARSED
  /// Some figures were read; the text genuinely does not contain the rest. A
  /// bare total with no breakdown is PARTIAL, not a failure.
  PARTIAL
  /// Read, but the multiplication in the source contradicts itself. Held for a
  /// person: correcting it silently is how a customer ends up disputing a
  /// quantity nobody can explain.
  NEEDS_REVIEW
  /// Nothing structured could be read. The raw text is all there is.
  UNPARSED
}

/// Which box a dimension describes.
enum PackDimensionKind {
  /// The pouch, blister or wrap around the item itself.
  PRIMARY_PACK
  /// The inner box those are packed into.
  INNER_BOX
  /// The shipping carton the inner boxes travel in.
  OUTER_CARTON
  /// The printed label artwork. Internal - a print specification rather than a
  /// product fact, and it is on this table only so the source column has
  /// somewhere honest to land. Never selected on a public read.
  STICKER_ARTWORK
}

/// How much of a dimension string could be read.
enum DimensionParseStatus {
  /// Numbers and a unit, both stated in the source.
  PARSED
  /// Numbers read, but the source never said millimetres or inches. Shown as
  /// written rather than given a unit nobody wrote down.
  UNIT_UNKNOWN
  /// Not confidently readable. The raw text is shown instead.
  UNPARSED
}

model ProductPackaging {
  id        String  @id @db.Char(26)
  productId String  @db.Char(26)
  variantId String? @db.Char(26)

  /// The variant ULID, or the empty string for the base product. Never null -
  /// see ProductPrice.variantKey for why a nullable column cannot carry this.
  variantKey String @default("") @db.VarChar(26)

  /// How it is packed - "Blister Pack", "Ribbon", "Peel Open Pouch".
  packingType String? @db.VarChar(128)

  /// The packing description exactly as the source wrote it. Always kept,
  /// whatever the parser made of it, because it is the only thing that can
  /// settle an argument about what the supplier actually said.
  packingRawText String? @db.VarChar(255)

  piecesPerInnerPack       Int?
  innerPacksPerOuterCarton Int?
  piecesPerOuterCarton     Int?

  /// What the source called them - "Box", "Pouch", "Pkt", "Carton". Displayed
  /// rather than a generic word, so the screen matches the paperwork.
  innerPackType String? @db.VarChar(64)
  outerPackType String? @db.VarChar(64)

  parseStatus PackingParseStatus @default(UNPARSED)

  /// Why it is PARTIAL or NEEDS_REVIEW, in a sentence an administrator can act
  /// on. Null when there is nothing to say.
  validationMessage String? @db.VarChar(512)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_product_packaging_product")
  variant    ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "fk_product_packaging_variant")
  dimensions ProductPackDimension[]

  /// One packing description per sellable SKU.
  @@unique([productId, variantKey], map: "uq_product_packaging_sku")
  @@index([variantId], map: "ix_product_packaging_variant")
  @@map("product_packaging")
}

model ProductPackDimension {
  id          String @id @db.Char(26)
  packagingId String @db.Char(26)

  kind PackDimensionKind

  /// As written in the source: "460*350*210 mm", "27 x 134", "15*12 inch pouch".
  rawText String @db.VarChar(255)

  /// The numbers, normalised to one separator: "460 x 350 x 210". Null when
  /// nothing could be read. Never invented - a two-number source stays two
  /// numbers rather than gaining a height.
  displayValue String? @db.VarChar(128)

  /// "mm", "inch" - only when the source actually said so. A unit nobody wrote
  /// down is not a unit, and guessing millimetres onto an inch measurement is
  /// a twenty-five-fold error.
  unit String? @db.VarChar(16)

  parseStatus DimensionParseStatus @default(UNPARSED)

  packaging ProductPackaging @relation(fields: [packagingId], references: [id], onDelete: Cascade, map: "fk_pack_dimension_packaging")

  @@unique([packagingId, kind], map: "uq_pack_dimension_kind")
  @@map("product_pack_dimensions")
}

// ---------------------------------------------------------------------------
// CATALOGUE IMPORT PROVENANCE
//
// Where a catalogue row came from, and the operator-internal columns that came
// with it. Deliberately a separate table from `products`: licence status,
// production capacity and a workflow state like "Working on it" are the
// operator's business and not the buyer's, and keeping them off the product
// makes that boundary structural instead of a filter somebody has to remember
// on every public read.
// ---------------------------------------------------------------------------

model ProductImportRecord {
  id         String  @id @db.Char(26)
  productId  String  @db.Char(26)
  variantId  String? @db.Char(26)
  variantKey String  @default("") @db.VarChar(26)

  /// SHA-256 of the normalised identity fields. Matches
  /// `ProductVariant.importFingerprint`; kept here too so provenance can be
  /// read without joining back through the SKU.
  fingerprint String @db.Char(64)

  sourceFileName String   @db.VarChar(255)
  sourceSheet    String   @db.VarChar(128)
  sourceRow      Int
  importedAt     DateTime @db.DateTime(3)

  /// Every column of the source row, exactly as read, keyed by column letter.
  /// The audit trail: it is what makes "the sheet said something else" a
  /// question with an answer.
  rawJson Json

  /// --- The identity fields, normalised, as the importer read them ---
  productCode String? @db.VarChar(128)

  /// The barcode as written, including any GS1 application identifier and its
  /// spacing: "(01) 0 8904379800013". A string, always - held as a number it
  /// loses its leading zero and its formatting in one step.
  gtinRaw String? @db.VarChar(64)

  /// Digits only, left-padded to 14 where the source gave a readable barcode.
  gtinNormalised String? @db.VarChar(14)

  genericName   String? @db.VarChar(255)
  modelSize     String? @db.VarChar(128)
  sterilisation String? @db.VarChar(128)
  brand         String? @db.VarChar(128)
  packingType   String? @db.VarChar(128)
  shelfLife     String? @db.VarChar(64)

  /// --- Operator-internal. Never returned on a public read. ---
  productionCapacityPerMonth String?   @db.VarChar(64)
  launchDate                 DateTime? @db.Date
  manufacturingLicenceStatus String?   @db.VarChar(64)
  testLicenceStatus          String?   @db.VarChar(64)

  /// The source workflow state - "Done", "Hold", "Working on it" - recorded as
  /// written. What it does to the listing is decided once, by the importer,
  /// and expressed in `Product.isOrderable`; nothing reads this string later to
  /// make a decision, so a new word appearing in the column cannot quietly
  /// change who is allowed to buy what.
  internalStatus String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_import_record_product")
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "fk_import_record_variant")

  /// One provenance row per sellable SKU.
  @@unique([productId, variantKey], map: "uq_import_record_sku")
  @@index([fingerprint], map: "ix_import_record_fingerprint")
  @@index([sourceFileName, sourceRow], map: "ix_import_record_source")
  @@map("product_import_records")
}

// ---------------------------------------------------------------------------
// ORDERING UNITS
// ---------------------------------------------------------------------------

/// The unit a buyer chose to order in.
///
/// Quantity is stored in pieces everywhere it is priced, reserved or shipped -
/// one unit of account, so no price, stock check or tax line has to know that
/// packs exist. This records what the buyer actually chose, so the cart, the
/// order and the schedule can each show "2 cartons" back to them rather than
/// "4,000", and so the conversion they were shown is the conversion they are
/// held to even if the packing is corrected afterwards.
enum OrderingUnit {
  PIECE
  INNER_PACK
  OUTER_CARTON
}

// ===========================================================================
// INVENTORY
//
// InventoryBalance is the fast read path; InventoryMovement is the append-only
// ledger and the source of truth. available = onHandQty - reservedQty, and a
// CHECK keeps both non-negative (MariaDB 10.4 does enforce CHECK - verified).
// Overselling is prevented with SELECT ... FOR UPDATE on the balance row
// inside the confirming transaction (no SKIP LOCKED on 10.4).
// ===========================================================================

/// Whether a warehouse is currently shipping, and how well.
///
/// Deliberately not the same axis as `isActive`, and confusing the two is the
/// mistake this enum exists to prevent. `isActive` answers "is this place part
/// of the business at all" - a retired warehouse is archived master data and
/// disappears from every picker. This answers "of the places that are, can
/// this one move a box today". A warehouse under a roof repair is thoroughly
/// active and cannot ship a thing.
enum WarehouseOperationalStatus {
  /// Running normally.
  OPERATIONAL
  /// Running, but not at full capacity - short staffed, one dock closed.
  LIMITED
  /// Temporarily not dispatching. Planned, and expected back.
  MAINTENANCE
  /// Not dispatching, and not by plan - a flood, a strike, a lost lease.
  SUSPENDED
}

/// Where a warehouse stands with the ERP that owns its stock figures.
///
/// A per-warehouse view, which is not the same thing as the per-connection
/// history in `SyncRun`: one ERP connection syncs many warehouses, and "when
/// did *Antwerp* last agree with the ERP" is the question somebody standing in
/// Antwerp asks. The run history answers "what did the last job do", which is
/// a different question with a different reader.
enum WarehouseErpSyncStatus {
  /// No sync has ever been attempted. The honest default.
  NEVER_SYNCED
  /// The last attempt succeeded.
  SYNCED
  /// An attempt is in flight, or one is queued.
  PENDING
  /// The last attempt failed. `erpSyncMessage` says what the connector said.
  FAILED
}

model InventoryLocation {
  id          String  @id @db.Char(26)
  code        String  @unique(map: "uq_inventory_location_code") @db.VarChar(32)
  name        String  @db.VarChar(128)
  addressJson Json?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  /// The country this warehouse is in. ISO-3166-1 alpha-2.
  ///
  /// A column with a foreign key rather than a field inside `addressJson`,
  /// because it is asked questions the JSON cannot answer: the console filters
  /// and searches on it, and the reference table is what already decides a
  /// country's currency, its interface language and whether it is inside the
  /// EU VAT area. A warehouse in a country the deployment has never heard of
  /// is a typo, and the FK is what catches it.
  ///
  /// Nullable only because warehouses existed before this column did. Every
  /// warehouse created through the panel has one - the API requires it.
  countryCode String? @db.Char(2)

  /// The IANA zone the people working here read a clock in, e.g.
  /// "Europe/Brussels".
  ///
  /// Not derivable from the country, which is the reason it is stored: Spain
  /// spans two zones, and every deployment with a warehouse in the Canaries
  /// and one in Madrid needs them to disagree. The same reasoning as
  /// `RecurringSchedule.timezone` - a wall-clock fact carries its own zone.
  timezone String? @db.VarChar(64)

  /// Can this place ship today? See the enum for why it is not `isActive`.
  operationalStatus WarehouseOperationalStatus @default(OPERATIONAL)

  /// This warehouse's identifier in the ERP, when one owns its stock.
  ///
  /// Master data a person enters, unlike the three fields below it, which the
  /// connector writes. Null means this warehouse is not mapped to anything.
  erpExternalId String? @db.VarChar(64)

  /// Written by whatever syncs with the ERP, through
  /// `PUT /admin/inventory/warehouses/:id/erp-status`. Never edited by hand on
  /// the warehouse form: a sync state somebody typed is a sync state that
  /// lies.
  erpSyncStatus  WarehouseErpSyncStatus @default(NEVER_SYNCED)
  erpLastSyncAt  DateTime?              @db.DateTime(3)
  /// What the connector said about the last attempt. Carries the reason on a
  /// FAILED, and a note like "412 SKUs reconciled" on a SYNCED.
  erpSyncMessage String?                @db.VarChar(512)

  /// Where this warehouse is, so the console can draw it on a map.
  ///
  /// Decimal rather than Float, for the same reason money is BigInt: a
  /// coordinate is a stored fact that has to read back exactly as it was
  /// written. Decimal(9,6) holds the full range of both axes at ~11cm, which
  /// is finer than any postal address resolves to.
  ///
  /// Nullable, and NULL is an ordinary state here rather than a missing value.
  /// Every warehouse in a deployment that is already running predates this
  /// column, and one whose address nobody has geocoded yet is still a
  /// warehouse holding stock. The map lists those separately instead of
  /// dropping them or inventing a position for them.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// How far this warehouse promises to deliver, in kilometres.
  ///
  /// The geofence. Everything a warehouse is allowed to serve is derived from
  /// this and its coordinates: a geodesic circle of this radius is intersected
  /// with the world's country boundaries, and what comes back is the list of
  /// countries it can reach. See `delivery-coverage.service.ts`.
  ///
  /// Per warehouse rather than per deployment, because the reach of a building
  /// is a fact about the building. A port warehouse with its own fleet covers
  /// 800 km; a city depot handing over to a courier covers 150. One number for
  /// the whole business would have to be the smallest of them, and every other
  /// warehouse would refuse deliveries it can make.
  ///
  /// Null means "use `DELIVERY_COVERAGE_RADIUS_KM`", the deployment-wide
  /// default - not "no radius" and not zero. That is what lets an operator
  /// raise the promise for every warehouse at once by changing one setting,
  /// and still override it on the two that are different.
  deliveryRadiusKm Int?

  /// How long a delivery from here takes, in days, as a range.
  ///
  /// Stored because it is what the buyer chooses between. When two warehouses
  /// both cover the buyer's country, the storefront shows both and the only
  /// things that separate them are when the box arrives and what it costs -
  /// so a warehouse with no lead time recorded has nothing to offer that
  /// screen, and the option list says so rather than inventing "3-5 days".
  ///
  /// A range and not a single figure, because a single figure is either a
  /// promise that gets broken or a padded one that loses the sale. Both null,
  /// or both set - the CHECK constraint holds that, and min may not exceed
  /// max.
  deliveryLeadTimeMinDays Int?
  deliveryLeadTimeMaxDays Int?

  /// What this warehouse charges to deliver, in minor units of its own
  /// currency.
  ///
  /// BigInt minor units, like every other amount in this system, and it
  /// crosses the API as a string. Per warehouse because that is the other half
  /// of the buyer's choice: Antwerp may be two days and 12 EUR where Gdańsk is
  /// five days and free, and which of those a buyer wants is not a decision
  /// this software gets to make for them.
  ///
  /// The currency is stored beside it rather than derived from the warehouse's
  /// country, for the same reason `ProductPrice` carries one: a warehouse in
  /// Poland may quote a delivery in euro, and a fee whose currency is guessed
  /// from geography is a fee that is wrong by a factor of four. Null fee means
  /// this warehouse has not priced delivery; the CHECK constraint keeps the
  /// pair together, so there is never an amount with no currency on it.
  deliveryFeeMinor    BigInt?
  deliveryFeeCurrency String? @db.Char(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  country          Country?                    @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  balances         InventoryBalance[]
  movements        InventoryMovement[]
  reservations     StockReservation[]
  schedules        RecurringSchedule[]
  exclusions       WarehouseCountryExclusion[]
  deliveryZones    WarehouseDeliveryZone[]
  fulfilmentQuotes FulfilmentQuote[]
  fulfilledOrders  Order[]                     @relation("OrderFulfilmentLocation")

  /// Consignments a logistics partner collects from this building.
  logisticsShipments LogisticsShipment[]
  logisticsPickups   LogisticsPickupRequest[]

  /// The map's own query: every active warehouse, ordered so the default
  /// comes first. Also serves the country filter on its leading column.
  @@index([isActive, countryCode], map: "ix_inventory_location_active_country")
  @@index([operationalStatus], map: "ix_inventory_location_operational")
  @@map("inventory_locations")
}

/// A country this warehouse will not deliver to, whatever the radius says.
///
/// The geofence is geometry and geometry knows nothing about business. A
/// 500 km circle around Antwerp reaches Luxembourg, and a deployment with no
/// customs paperwork for Luxembourg cannot ship there however near it is. So
/// the radius decides what is *reachable* and this table decides what is
/// *offered*, and the two are kept apart on purpose: raising the radius later
/// must not quietly re-open a country somebody deliberately closed.
///
/// **There is no foreign key to `countries`, and that is deliberate.** The
/// `countries` table is the list of markets this deployment prices in - forty
/// or so rows, each needing a currency. The radius is measured against the
/// world, all two hundred and forty-odd shapes of it, from
/// `domain/country-boundaries.ts`. An operator has to be able to close a
/// country the radius reaches whether or not they sell there today, and an FK
/// would make exactly the countries they most want to exclude the ones they
/// cannot name. The code is validated against the ISO list instead, in
/// `location.service.ts`.
///
/// One row per excluded country rather than a JSON array on the warehouse,
/// because the storefront asks the question from the other end - "which
/// warehouses may serve Belgium" - and that is an indexed lookup here and a
/// full scan with JSON parsing there.
model WarehouseCountryExclusion {
  id         String @id @db.Char(26)
  locationId String @db.Char(26)

  /// ISO 3166-1 alpha-2, upper case. Not an FK - see the model comment.
  ///
  /// Upper-cased and checked against the ISO list by `location.service.ts`, so
  /// nothing written through the API reaches this column in any other shape.
  /// `chk_warehouse_exclusion_country_shape` is the backstop for a direct SQL
  /// write, and it is worth knowing exactly how far it reaches: it rejects a
  /// code containing a digit or a symbol, and a single letter. It does **not**
  /// reject an alpha-3 - CHAR(2) truncates "DEU" to "DE" before any CHECK
  /// runs, which is Germany either way - and it does not reject lower case,
  /// because this column's collation is case-insensitive and `[A-Z]` therefore
  /// matches `de`. Neither matters: `de` and `DE` are the same value to the
  /// unique index and to every query that looks a code up here.
  countryCode String @db.Char(2)

  /// Why this country is closed, in the operator's own words.
  ///
  /// Optional, and worth having: "no CE paperwork" and "distributor holds
  /// exclusivity" are different reasons with different expiry dates, and the
  /// person who reads this row in a year is not the person who wrote it.
  reason String? @db.VarChar(256)

  createdAt DateTime @default(now()) @db.DateTime(3)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, countryCode], map: "uq_warehouse_exclusion_country")
  /// "Who may serve this country?" - the storefront's own query.
  @@index([countryCode], map: "ix_warehouse_exclusion_country")
  @@map("warehouse_country_exclusions")
}

/// A lane: somewhere this warehouse delivers to, and on what terms.
///
/// **This table, and not the radius, decides what a buyer is offered.** The
/// geofence on `inventory_locations` is geometry - a circle intersected with
/// country polygons - and it answers "what could a van physically reach". That
/// is a useful thing to draw on a map and a dangerous thing to sell against: a
/// 500 km circle around Antwerp reaches Luxembourg whether or not anybody has
/// appointed a carrier there, agreed a transit time, or priced the lane. So
/// checkout asks this table instead, and a warehouse with no zone covering the
/// destination is simply not offered - not because it is too far, but because
/// nobody has said what it would cost or when it would arrive.
///
/// Four things are stored together because a buyer weighs them together:
///
///   - **Who carries it and at what service level.** Two lanes to the same
///     postcode from the same building are an ordinary arrangement - a road
///     service at four days and an express one at two - and they are two rows.
///   - **How long it takes**, split into the time to get it out of the door
///     (`handlingDays`) and the time on the road (`transitMinDays` ..
///     `transitMaxDays`). Split because they fail differently: a bank holiday
///     delays the dispatch, a ferry delays the transit, and a single "5 to 7
///     days" figure cannot be corrected for either.
///   - **What it costs**, in minor units with its own currency column, like
///     every other amount in this schema.
///   - **What it can carry.** `supportsColdChain` is checked against
///     `products.requiresColdChain`; `maxWeightGrams` against the basket. A
///     lane that cannot take the goods is not an option however near it is.
///
/// **Postal codes are prefixes, and the column is never NULL.** An empty
/// string means the whole country, which is the common case and the one that
/// has to be expressible. It is `''` rather than NULL because MariaDB treats
/// every NULL in a UNIQUE index as distinct, so a nullable column here would
/// let the same warehouse hold two "whole of Belgium" lanes and the operator
/// would never find out which one priced their order.
model WarehouseDeliveryZone {
  id         String @id @db.Char(26)
  locationId String @db.Char(26)

  /// ISO 3166-1 alpha-2, upper case. Not an FK, for exactly the reason
  /// `WarehouseCountryExclusion.countryCode` is not one: this is measured
  /// against the world, and `countries` is the shorter list of markets the
  /// deployment prices in.
  countryCode String @db.Char(2)

  /// Which postcodes inside that country, as a comma-separated prefix list.
  ///
  /// `''` means the whole country. `'1,2,30'` means every postcode starting
  /// with 1, 2 or 30. Prefixes rather than ranges because postal codes are not
  /// numbers - "80-601" and "SW1A 1AA" both sort and subtract meaninglessly -
  /// and a prefix is the one operation that works on all of them. Compared
  /// after stripping spaces and hyphens and upper-casing both sides, so a
  /// buyer who types "sw1a 1aa" matches a lane written as "SW1".
  postalPrefixes String @default("") @db.VarChar(512)

  /// Who carries it, and how fast. Free text, because it is the operator's
  /// own arrangement and no enum this repository invented would survive
  /// contact with their contracts.
  carrierName  String @db.VarChar(64)
  serviceLevel String @db.VarChar(64)

  /// Days between the order being placed and the box leaving the building.
  handlingDays Int @default(1)

  /// Days on the road, as a range. Both columns, always - a minimum with no
  /// maximum is a promise with no end.
  transitMinDays Int
  transitMaxDays Int

  /// Whether the two figures above are counted in working days.
  ///
  /// True skips Saturdays and Sundays when the dates are projected. A weekend
  /// is not a universal fact, which is why this is a flag rather than an
  /// assumption: a deployment shipping in the Gulf keeps it false and counts
  /// calendar days rather than being handed the wrong weekend.
  usesBusinessDays Boolean @default(true)

  /// What this lane charges. BigInt minor units with its own currency, and the
  /// currency has to match the one the basket is quoted in or the lane is not
  /// offered - a fee converted at a rate this software chose would be an
  /// exchange-rate opinion printed as a price.
  shippingFeeMinor    BigInt  @default(0)
  shippingFeeCurrency String  @db.Char(3)
  /// Basket value at or above which the lane is free. Null = never free.
  freeAboveMinor      BigInt?

  /// What the lane can physically take.
  supportsColdChain Boolean @default(false)
  /// Null = no limit this operator has stated.
  maxWeightGrams    Int?

  /// Off without being deleted. An operator suspending a carrier for a month
  /// should not have to retype the lane afterwards.
  isActive Boolean @default(true)

  /// Which lane wins when several match the same postcode. Lower first.
  ///
  /// Both are still offered to the buyer - two service levels to one address
  /// is the whole point - and this only decides the order they are listed in
  /// within one warehouse.
  priority Int @default(0)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quotes   FulfilmentQuote[]

  /// One lane per warehouse, country, postcode set and service level. The
  /// service level is in the key because two of them to the same postcodes is
  /// the arrangement this table exists to express.
  @@unique([locationId, countryCode, postalPrefixes, serviceLevel], map: "uq_warehouse_zone_lane")
  /// "Who may serve this country?" - the checkout's own query.
  @@index([countryCode, isActive], map: "ix_warehouse_zone_country")
  @@index([locationId, isActive], map: "ix_warehouse_zone_location")
  @@map("warehouse_delivery_zones")
}

model InventoryBalance {
  id         String  @id @db.Char(26)
  productId  String  @db.Char(26)
  variantId  String? @db.Char(26)
  /// The variant ULID, or an empty string for the base product. Never null, so
  /// the composite unique below really blocks duplicates - a MySQL unique index
  /// treats every NULL as distinct and would happily allow two rows.
  variantKey String  @default("") @db.VarChar(26)
  locationId String  @db.Char(26)

  onHandQty   Int @default(0)
  reservedQty Int @default(0)

  /// Optimistic-locking counter, bumped on every write.
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, variantKey, locationId], map: "uq_inventory_balance_sku_location")
  @@index([locationId], map: "ix_inventory_balance_location")
  @@index([variantId], map: "ix_inventory_balance_variant")
  @@map("inventory_balances")
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION_COMMIT
  ORDER_CANCEL_RESTOCK
  RETURN_RESTOCK
  RETURN_QUARANTINE
  SYNC_CORRECTION
}

model InventoryMovement {
  id         String  @id @db.Char(26)
  productId  String  @db.Char(26)
  variantId  String? @db.Char(26)
  variantKey String  @default("") @db.VarChar(26)
  locationId String  @db.Char(26)

  type            InventoryMovementType
  /// Signed: positive adds to on-hand, negative removes. Never zero.
  quantityDelta   Int
  /// On-hand value immediately after this movement, for ledger reconciliation.
  resultingOnHand Int

  reason        String? @db.VarChar(512)
  referenceType String? @db.VarChar(48)
  referenceId   String? @db.Char(26)

  /// Optional caller-supplied key that makes a movement idempotent.
  ///
  /// The ledger is append-only and a movement is not reversible, so a retried
  /// ERP sync or a redelivered webhook posting the same delta twice would
  /// silently corrupt on-hand. A caller that can name its intent passes a key
  /// and the second insert collides here instead.
  ///
  /// Nullable, and MariaDB's treatment of NULL in a UNIQUE index is the point
  /// rather than a caveat: every movement written by hand or by an existing
  /// caller stays keyless and none of them collide with each other. Only
  /// callers that opt in get the guarantee.
  dedupeKey String? @unique(map: "uq_inventory_movement_dedupe") @db.VarChar(120)

  actorUserId String?   @db.Char(26)
  actorType   ActorType @default(SYSTEM)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId, variantKey, createdAt], map: "ix_inventory_movement_sku_time")
  @@index([referenceType, referenceId], map: "ix_inventory_movement_reference")
  @@index([createdAt], map: "ix_inventory_movement_time")
  /// "Has anything ever been booked against this warehouse?" - the question
  /// `deleteWarehouse` has to answer before it removes the row. Without an
  /// index the answer for a warehouse that has never been used costs a scan of
  /// the whole ledger, which is the one case where the answer is yes, delete
  /// it. Matches `ix_inventory_balance_location` on the balances beside it.
  @@index([locationId], map: "ix_inventory_movement_location")
  @@map("inventory_movements")
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

model StockReservation {
  id         String  @id @db.Char(26)
  productId  String  @db.Char(26)
  variantId  String? @db.Char(26)
  variantKey String  @default("") @db.VarChar(26)
  locationId String  @db.Char(26)

  cartId  String? @db.Char(26)
  orderId String? @db.Char(26)

  quantity Int
  status   ReservationStatus @default(ACTIVE)

  expiresAt     DateTime  @db.DateTime(3)
  committedAt   DateTime? @db.DateTime(3)
  releasedAt    DateTime? @db.DateTime(3)
  releaseReason String?   @db.VarChar(128)

  createdAt DateTime @default(now()) @db.DateTime(3)

  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  cart     Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order    Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt], map: "ix_reservation_sweep")
  @@index([orderId], map: "ix_reservation_order")
  @@index([cartId], map: "ix_reservation_cart")
  @@index([productId, variantKey, status], map: "ix_reservation_sku_status")
  /// Same question, same reason as `ix_inventory_movement_location`: a
  /// released reservation still points at the warehouse with `Restrict`, so
  /// the delete guard counts every status here, not only the live ones.
  @@index([locationId], map: "ix_reservation_location")
  @@map("stock_reservations")
}

// ===========================================================================
// CUSTOMERS
// ===========================================================================

model CustomerProfile {
  id     String @id @db.Char(26)
  userId String @unique(map: "uq_customer_profile_user") @db.Char(26)

  /// The name every other screen in the product uses: an order, an invoice, a
  /// delivery note, the greeting in the header.
  ///
  /// It stays the single canonical name even though `firstName`/`lastName`
  /// exist below, and it is COMPOSED from them whenever they are supplied —
  /// see `updateCustomer`. Two independent sources for "what is this person
  /// called" is how an invoice ends up disagreeing with a delivery note.
  fullName String @db.VarChar(255)

  /// The name captured in two parts, because that is how a person fills in a
  /// form and because a name split on the first space is not a name: "Van der
  /// Berg" and "Jean Paul" both come apart wrongly. Nullable, and legitimately
  /// so — accounts created by invitation, by import or by an administrator
  /// have only the one field, and guessing a split for them would be worse
  /// than leaving these empty and showing `fullName`.
  firstName String? @db.VarChar(120)
  lastName  String? @db.VarChar(120)

  organization String? @db.VarChar(255)
  department   String? @db.VarChar(128)
  /// What this person does, as they describe it. Distinct from `department`,
  /// which is where in the organisation the order is being placed from: "Head
  /// of Theatre Procurement" in "Surgical Services".
  jobTitle     String? @db.VarChar(128)
  phone        String? @db.VarChar(32)
  gstin        String? @db.VarChar(32)
  customerCode String? @unique(map: "uq_customer_code") @db.VarChar(32)

  /// The customer's EU VAT identification number, including the member state
  /// prefix, e.g. "DE811569869". Kept apart from `gstin`, which is the Indian
  /// registration: they are different identifiers under different laws, and a
  /// business can hold both.
  ///
  /// This one field decides whether a cross-border sale is zero-rated. That is
  /// why it is never taken on trust - see the three columns below.
  vatNumber String? @db.VarChar(32)

  /// What VIES said, and when. Null means never checked, which is not the same
  /// as invalid: a check that could not be made leaves this null and the sale
  /// is taxed rather than zero-rated, because Art. 138(1)(b) puts the burden of
  /// the customer's status on the seller.
  vatNumberValid     Boolean?
  vatNumberCheckedAt DateTime? @db.DateTime(3)
  /// The VIES consultation reference for the last successful check. Evidence
  /// under Art. 31 of Reg. 904/2010 that the seller relied on an official
  /// answer, which is what stands between a mis-zero-rated supply and the
  /// seller paying the tax themselves.
  vatNumberReference String?   @db.VarChar(64)

  /// Whether this account needs sign-off at all. The amounts that decide when
  /// live in `customer_limits`, one row per currency - see that model.
  requiresOrderApproval Boolean @default(false)

  internalNotes String? @db.Text

  /// Where the shopper says they are, and what they want to be quoted in.
  /// Asked once on first sign-in and changeable afterwards from the header.
  /// Null preferredCurrency means "not chosen yet" - the storefront then asks.
  preferredCountry  String?   @db.Char(2)
  preferredCurrency String?   @db.Char(3)
  localeChosenAt    DateTime? @db.DateTime(3)

  /// What the browser's geolocation resolved to, kept separately from the
  /// stated country so the two can be compared rather than one overwriting the
  /// other. Null when permission was refused or never asked.
  detectedCountry String?   @db.Char(2)
  detectedAt      DateTime? @db.DateTime(3)

  consentAcceptedAt DateTime? @db.DateTime(3)
  consentVersion    String?   @db.VarChar(32)

  invitedById String?   @db.Char(26)
  invitedAt   DateTime? @db.DateTime(3)
  activatedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  schedules RecurringSchedule[]

  paymentMethods CustomerPaymentMethod[]

  /// Their authority to be charged while nobody is watching. Self-service, and
  /// necessarily so: nobody can consent on somebody else's behalf to money
  /// leaving their account. The ERP itself is the business's, not theirs - see
  /// the ERP CONNECTIVITY block at the end of this file.
  autoPaySetting CustomerAutoPaySetting?

  couponRedemptions CouponRedemption[]
  limits            CustomerLimit[]
  wishlistItems     WishlistItem[]
  productInstructions ProductInstruction[]
  fulfilmentQuotes  FulfilmentQuote[]

  assistantConversations AssistantConversation[]

  /// Their place in a buyer organisation, which is what owns an ERP
  /// connection. At most one - see `BuyerOrganizationMember`, where the
  /// uniqueness is enforced and the reason for it is written down.
  organizationMembership BuyerOrganizationMember?

  /// Their place in a SELLER organisation, if they sell here as well as buy.
  /// At most one, on the same reasoning as the line above - see
  /// `SellerMember`. This is what makes "become a seller" reuse the existing
  /// login instead of minting a second account.
  sellerMembership SellerMember?

  @@index([organization], map: "ix_customer_organization")
  @@index([createdAt], map: "ix_customer_created")
  @@map("customer_profiles")
}

enum AddressKind {
  BILLING
  SHIPPING
  BOTH
}

model Address {
  id                String      @id @db.Char(26)
  customerProfileId String      @db.Char(26)
  kind              AddressKind @default(BOTH)

  label        String? @db.VarChar(64)
  contactName  String  @db.VarChar(255)
  contactPhone String  @db.VarChar(32)
  line1        String  @db.VarChar(255)
  line2        String? @db.VarChar(255)
  city         String  @db.VarChar(128)
  state        String  @db.VarChar(128)
  postalCode   String  @db.VarChar(16)
  country      String  @db.Char(2)

  /// Where this address actually is, when anybody has been able to work it out.
  ///
  /// Decimal(9,6) and nullable, exactly like `InventoryLocation.latitude` -
  /// same reasoning, same precision, and the same meaning for NULL: not a
  /// missing value but an ordinary state. Every address in a deployment that is
  /// already running predates this column, a geocoder can be unconfigured or
  /// simply having a bad afternoon, and an industrial estate that resolves to
  /// nothing is still somewhere a van can go.
  ///
  /// What it buys is the difference between an estimate and a quote. With no
  /// coordinates a fulfilment option can only be measured warehouse-to-nearest-
  /// border-of-the-destination-country, which is honest but coarse, and the
  /// storefront labels the result "Estimated". With them the same option is
  /// measured to the delivery point itself. Neither figure decides eligibility -
  /// the delivery zones do - but a buyer comparing two warehouses is entitled to
  /// the better number wherever it exists.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// The IANA zone this delivery point reads a clock in, e.g. "Europe/Brussels".
  ///
  /// Stored for the same reason `RecurringSchedule.timezone` and
  /// `InventoryLocation.timezone` are: a calendar day is a wall-clock fact and
  /// the server's own zone is not it. "Today plus seven days" evaluated for a
  /// buyer in Auckland is a different pair of dates from the same phrase
  /// evaluated in Asia/Calcutta, and the delivery is theirs rather than the
  /// server's.
  ///
  /// Nullable, and the caller falls back - the plan's own zone, then the store's.
  /// Never derived from the country, because a country is not a zone: Spain
  /// spans two of them and the United States spans six.
  timezone String? @db.VarChar(64)

  isDefaultBilling  Boolean @default(false)
  isDefaultShipping Boolean @default(false)

  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)
  /// Soft delete. Orders keep an independent JSON snapshot of the address as
  /// it was at checkout, so archiving here never rewrites order history.
  archivedAt DateTime? @db.DateTime(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  shippingSchedules RecurringSchedule[] @relation("ScheduleShippingAddress")
  billingSchedules  RecurringSchedule[] @relation("ScheduleBillingAddress")
  fulfilmentQuotes  FulfilmentQuote[]

  @@index([customerProfileId, archivedAt], map: "ix_address_customer")
  @@map("addresses")
}

// ===========================================================================
// CART
// ===========================================================================

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id                String  @id @db.Char(26)
  customerProfileId String? @db.Char(26)
  /// Opaque cookie token for a not-yet-signed-in visitor. Merged into the
  /// customer cart on login; checkout always requires an authenticated customer.
  guestToken        String? @unique(map: "uq_cart_guest_token") @db.Char(64)

  status   CartStatus @default(ACTIVE)
  currency String     @db.Char(3)

  /// The coupon the shopper has applied, if any. Held on the cart so it
  /// survives a page reload, and re-validated on every read - a coupon can
  /// expire, be disabled, or stop qualifying while the cart sits open.
  appliedCouponId String? @db.Char(26)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  expiresAt DateTime? @db.DateTime(3)

  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  appliedCoupon   Coupon?          @relation(fields: [appliedCouponId], references: [id], onDelete: SetNull)

  items            CartItem[]
  reservations     StockReservation[]
  orders           Order[]
  fulfilmentQuotes FulfilmentQuote[]

  @@index([customerProfileId, status], map: "ix_cart_customer_status")
  @@index([status, expiresAt], map: "ix_cart_sweep")
  @@map("carts")
}

model CartItem {
  id         String  @id @db.Char(26)
  cartId     String  @db.Char(26)
  productId  String  @db.Char(26)
  variantId  String? @db.Char(26)
  variantKey String  @default("") @db.VarChar(26)

  /// Whose offer this line is, when it is a seller's rather than the
  /// operator's own stock.
  ///
  /// NULL is not missing data: it means the operator sells it, which is what
  /// every row on a single-supplier deployment is. Making it required would
  /// mean inventing an offer for the operator, and the operator is not a seller
  /// - no commission, no settlement, no seller order number.
  sellerOfferId String? @db.Char(26)
  /// `sellerOfferId`, or '' for the operator's own stock. Never null, and the
  /// reason the unique index below works: MariaDB treats every NULL in a UNIQUE
  /// index as distinct, so a nullable column there would let the same operator
  /// SKU be added twice instead of bumping the quantity. Exactly the trick
  /// `variantKey` above plays, for exactly the same reason.
  sellerOfferKey String @default("") @db.VarChar(26)

  /// Always pieces. Every price, stock check, reservation and tax line reads
  /// this and nothing else, so adding pack ordering changed none of them.
  quantity Int

  /// What the buyer chose to count in, and the conversion they were shown.
  ///
  /// Three columns rather than a lookup, because the packing on the product can
  /// be corrected next week and "2 cartons" has to keep meaning the 4,000
  /// pieces it meant when they put it in the basket. Recomputing it later from
  /// the current packing is how a basket silently changes size.
  ///
  /// The defaults describe every row that existed before pack ordering did:
  /// counted in pieces, one piece to a piece.
  orderingUnit          OrderingUnit @default(PIECE)
  /// How many of `orderingUnit` they asked for. quantity = this x the snapshot.
  unitQuantity          Int          @default(1)
  /// Pieces in one `orderingUnit` at the moment it was chosen.
  piecesPerUnitSnapshot Int          @default(1)

  /// What the buyer needs done to THIS product, in their own words.
  ///
  /// Per line and not per order, because `Order.customerNote` answers a
  /// different question. That one is about the delivery - a gate code, a time
  /// window - and reaches everybody. This one is about one product, and on a
  /// basket holding nine lines from four sellers an order note saying "the
  /// blue one" identifies nothing and is read by three sellers it does not
  /// concern.
  ///
  /// NULL means no instruction was given, which is what every line placed
  /// before this column existed says. Never an empty string: the API turns a
  /// cleared box into NULL, so "" and "nothing" are not two ways of saying the
  /// same thing.
  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sellerOffer SellerOffer?    @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict, map: "fk_cart_item_seller_offer")

  /// One line per purchasable unit PER SELLER. Re-adding the same SKU from the
  /// same seller bumps quantity; the same product from two sellers is two
  /// lines, because they are two different things to buy at two prices out of
  /// two warehouses.
  @@unique([cartId, productId, variantKey, sellerOfferKey], map: "uq_cart_item_sku")
  @@index([productId], map: "ix_cart_item_product")
  @@index([sellerOfferId], map: "ix_cart_item_seller_offer")
  @@map("cart_items")
}

// ===========================================================================
// ORDERS
//
// OrderItem holds immutable snapshots (name, SKU, unit price, tax rate). Later
// catalog edits must never alter a historical order. All transitions go through
// the guarded state machine in src/domain/order-state-machine.ts and append a
// row to OrderStatusHistory.
// ===========================================================================

enum ActorType {
  SYSTEM
  ADMIN
  CUSTOMER
  PROVIDER
  /// A third-party carrier's own staff, acting inside the logistics portal.
  ///
  /// Added rather than folded into SYSTEM, because 'the system moved this
  /// shipment' and 'a named dispatcher at a named carrier moved it' are the
  /// two answers an operator most needs to tell apart after a bad delivery.
  LOGISTICS
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum OrderSource {
  ONE_TIME
  RECURRING
}

/// How an order's money was arrived at in the currency it was charged in.
///
/// Two members and no third. `MANUAL` means a person typed a price for this
/// currency; `CONVERTED` means the base-currency figure was converted at a
/// recorded rate. There is deliberately no "unknown" member: an order written
/// before this column existed simply has NULL, which is a different and more
/// honest statement than a value that claims to have been checked.
enum FxPriceSource {
  MANUAL
  CONVERTED
}

enum PaymentIntentMode {
  ONLINE
  PAYMENT_LINK
}

model Order {
  id          String @id @db.Char(26)
  /// Human-facing sequential-ish reference, e.g. UB-2026-000123.
  orderNumber String @unique(map: "uq_order_number") @db.VarChar(32)

  customerProfileId String  @db.Char(26)
  cartId            String? @db.Char(26)

  source               OrderSource @default(ONE_TIME)
  scheduleOccurrenceId String?     @unique(map: "uq_order_schedule_occurrence") @db.Char(26)

  status OrderStatus @default(DRAFT)

  currency        String @db.Char(3)
  /// Every amount is BigInt minor units. grandTotal = subtotal - discount + tax + shipping.
  subtotalMinor   BigInt @default(0)
  discountMinor   BigInt @default(0)
  taxMinor        BigInt @default(0)
  shippingMinor   BigInt @default(0)
  grandTotalMinor BigInt @default(0)
  /// Settled money, maintained only from verified provider events.
  paidMinor       BigInt @default(0)
  refundedMinor   BigInt @default(0)

  // --- How this order's currency was arrived at --------------------------
  //
  // A FROZEN RECORD, WRITTEN ONCE.
  //
  // Nothing recomputes any of this. When a rate moves, an order placed
  // yesterday keeps yesterday's number, yesterday's rate and yesterday's
  // rounding rule - which is the difference between a total somebody can be
  // shown the arithmetic for and a total nobody can explain. A refund reads
  // these columns; it never reads today's rates.
  //
  // All nullable, and null is the ordinary case: an order priced from a real
  // per-currency row that a person typed involved no conversion at all, and
  // inventing a rate of 1.0 for it would make "was this converted?"
  // unanswerable.

  /// How the figures above were arrived at.
  ///   MANUAL    - a price row a person entered for this currency.
  ///   CONVERTED - derived from the base-currency price at the rate below.
  /// Null on orders written before this existed.
  fxPriceSource FxPriceSource?

  /// The snapshot the rate came from. The audit join: from an order to the
  /// exact list a provider published on a date, and every rate in it.
  fxSnapshotId String? @db.Char(26)

  /// The authoritative currency the catalogue figure was held in, and what the
  /// order was worth in it. Kept beside the charged amount so a settlement in
  /// the base currency needs no reconstruction.
  fxBaseCurrency        String? @db.Char(3)
  fxBaseGrandTotalMinor BigInt?

  /// What the market said, and what this deployment quoted against it.
  ///
  /// Both, because they are different facts and a dispute needs each. The mid
  /// rate is the provider's; `fxRateUsed` is that rate with
  /// `fxAdjustmentPercent` applied, and is the number that actually produced
  /// the figures above.
  fxMidRate           Decimal? @db.Decimal(24, 12)
  fxRateUsed          Decimal? @db.Decimal(24, 12)
  fxAdjustmentPercent Decimal? @db.Decimal(5, 2)

  /// The provider's own date for the rate, and the provider's name. Copied
  /// rather than joined so an order stays readable after a snapshot is pruned.
  fxRateAsOf   DateTime? @db.DateTime(3)
  fxProvider   String?   @db.VarChar(32)

  /// Which rounding and conversion rules were in force.
  ///
  /// A version string, not the rules themselves. When the deployment changes
  /// its rounding from "charm" to "exact", every order already placed must
  /// still be explainable under the rules it was placed under, and a bare
  /// timestamp does not say which those were.
  fxPolicyVersion String? @db.VarChar(32)

  fxSnapshot ExchangeRateSnapshot? @relation(fields: [fxSnapshotId], references: [id], onDelete: SetNull)

  /// Address as captured at checkout. Independent of the Address rows.
  billingAddressJson  Json
  shippingAddressJson Json

  shippingMethodCode String?           @db.VarChar(32)
  shippingMethodName String?           @db.VarChar(128)
  paymentMode        PaymentIntentMode @default(ONLINE)

  /// --- Which warehouse this ships from, and what was promised ---
  ///
  /// Null on every order placed before fulfilment options existed, and on any
  /// order whose destination no warehouse published a lane for - the shipping
  /// method configured for the deployment still applies to those, exactly as
  /// it always did. This is additive: nothing here is required to place an
  /// order.
  ///
  /// Restrict on the warehouse, like every other table that points at one:
  /// deleting a building must not orphan the record of where an order was
  /// picked. The quote is Restrict for a stronger reason - it is the evidence
  /// of what the customer was shown before they agreed to pay, and the sweep
  /// that clears lapsed quotes must not be able to take it.
  fulfilmentLocationId String? @db.Char(26)
  fulfilmentQuoteId    String? @db.Char(26)

  /// The promise itself, copied out of the quote rather than joined to it.
  ///
  /// The same reasoning as `nameSnapshot` on an order line: a lane can be
  /// repriced or retired, and what the customer was told on the day cannot be
  /// allowed to change with it. `@db.Date` because a delivery date is a day.
  fulfilmentCarrier      String?   @db.VarChar(64)
  fulfilmentServiceLevel String?   @db.VarChar(64)
  fulfilmentDispatchDate DateTime? @db.Date
  fulfilmentDeliveryFrom DateTime? @db.Date
  fulfilmentDeliveryTo   DateTime? @db.Date

  /// What the customer chose at checkout when there was more than one gateway
  /// to choose from.
  ///
  /// A preference, not a routing rule. The gateway that actually takes the
  /// money is resolved at payment time from what the operator has connected,
  /// and is recorded on the payment transaction - which is the row to read to
  /// find out who was paid. This pair exists so that a customer who reloads
  /// the payment page, or comes back to it from an email hours later, is
  /// offered the same sheet they picked rather than silently dropped onto the
  /// default.
  ///
  /// Null means nothing was expressed: an order placed before this existed, a
  /// payment-link order, a deployment with a single gateway, or an API client
  /// that sent no choice.
  preferredPaymentProvider PaymentProviderKind?
  preferredPaymentMethod   PaymentMethodPreference?

  /// What the customer actually chose at checkout, in their own vocabulary.
  ///
  /// The pair above records which *gateway* was resolved; this records which
  /// *instrument* was asked for, which is the only one of the two the customer
  /// ever saw. They are kept apart because they answer different questions and
  /// change for different reasons: an operator who disconnects Razorpay
  /// changes the gateway an old order would resolve to, and must not thereby
  /// rewrite what the customer picked.
  ///
  /// Its own column rather than a third member of `PaymentMethodPreference`,
  /// because that is a physical `ENUM('ANY','UPI')` and widening it would mean
  /// a `MODIFY COLUMN` over every historical order to record something none of
  /// them expressed.
  preferredPaymentInstrument PaymentInstrumentKind?

  /// The saved card the customer picked at checkout, when they picked one.
  ///
  /// `SetNull`: removing a card must not remove the order it once paid for.
  /// The order keeps its instrument choice and simply stops naming an
  /// instrument that no longer exists, which is what the payment page then
  /// asks them to replace.
  preferredPaymentMethodId String?                @db.Char(26)
  preferredPaymentCard     CustomerPaymentMethod? @relation(fields: [preferredPaymentMethodId], references: [id], onDelete: SetNull, map: "fk_order_preferred_payment_method")

  /// Why this order was taxed the way it was, and under whose rates. Frozen
  /// here rather than recomputed, because rates change and VAT numbers get
  /// cancelled - and an invoice already issued must not start disagreeing with
  /// the order behind it.
  taxTreatment TaxTreatment @default(FLAT_RATE)
  /// The member state whose rates were applied. Null under FLAT_RATE.
  taxCountry   String?      @db.Char(2)

  /// Art. 226(3)-(4): both parties' VAT numbers as they stood at checkout. The
  /// buyer's is the one that justified a zero rate, so it has to survive any
  /// later edit to the customer record.
  sellerVatNumberSnapshot String? @db.VarChar(32)
  buyerVatNumberSnapshot  String? @db.VarChar(32)

  customerNote String? @db.Text
  internalNote String? @db.Text

  placedAt     DateTime? @db.DateTime(3)
  confirmedAt  DateTime? @db.DateTime(3)
  cancelledAt  DateTime? @db.DateTime(3)
  cancelReason String?   @db.VarChar(512)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  cart            Cart?           @relation(fields: [cartId], references: [id], onDelete: SetNull)

  fulfilmentLocation InventoryLocation? @relation("OrderFulfilmentLocation", fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  fulfilmentQuote    FulfilmentQuote?   @relation("OrderFulfilmentQuote", fields: [fulfilmentQuoteId], references: [id], onDelete: Restrict)

  /// The carrier-grade shipments raised against this order.
  ///
  /// Distinct from `shipments` above, which is the OPERATOR's own dispatch
  /// note. One order can produce several of these - one per seller, per
  /// warehouse or per parcel group - and each is assigned to a logistics
  /// partner independently.
  logisticsShipments LogisticsShipment[]

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  approvals      OrderApproval[]
  payments       PaymentTransaction[]
  paymentLinks   PaymentLink[]
  refunds        Refund[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]
  reservations   StockReservation[]
  paymentEvents  PaymentEvent[]
  occurrence     ScheduleOccurrence?  @relation(fields: [scheduleOccurrenceId], references: [id], onDelete: SetNull)

  couponRedemption CouponRedemption?
  invoices         Invoice[]
  erpPush          ErpOrderPush?

  /// The marketplace sellers with lines in this order, one group each. Empty
  /// for an order the operator fulfils themselves, which every order placed
  /// before the Seller Hub is. The buyer still has ONE order - see the ORDERS,
  /// SPLIT BY SELLER block at the end of this file.
  sellerOrderGroups SellerOrderGroup[]

  @@index([customerProfileId, createdAt], map: "ix_order_customer_time")
  @@index([status, createdAt], map: "ix_order_status_time")
  @@index([source, createdAt], map: "ix_order_source_time")
  @@index([placedAt], map: "ix_order_placed")
  /// "What is this warehouse due to pick?" - and the guard that makes
  /// retiring a warehouse a question the panel can answer.
  @@index([fulfilmentLocationId], map: "ix_order_fulfilment_location")
  @@index([fulfilmentQuoteId], map: "ix_order_fulfilment_quote")
  /// The audit join: every order priced from one published rate set.
  @@index([fxSnapshotId], map: "ix_order_fx_snapshot")
  @@map("orders")
}

model OrderItem {
  id        String  @id @db.Char(26)
  orderId   String  @db.Char(26)
  productId String  @db.Char(26)
  variantId String? @db.Char(26)

  /// Whose offer was bought, when it was a seller's rather than the operator's
  /// own stock. Null means the operator sold it. This is what
  /// `splitOrderToSellers` groups on, so a line without it never reaches a
  /// seller's queue — which is correct, because nobody else is owed anything
  /// for it.
  sellerOfferId String? @db.Char(26)

  /// --- Immutable snapshots taken at checkout ---
  nameSnapshot         String  @db.VarChar(255)
  skuSnapshot          String  @db.VarChar(64)
  variantNameSnapshot  String? @db.VarChar(255)
  taxClassCodeSnapshot String  @db.VarChar(32)
  imageUrlSnapshot     String? @db.VarChar(1024)

  unitPriceMinor BigInt
  /// Pieces, like everywhere else. The unit price is per piece.
  quantity       Int

  /// What the buyer ordered in, frozen with the rest of the line. An invoice
  /// that says 4,000 pieces where the buyer ordered 2 cartons is a dispute
  /// waiting to be had, and the packing it was worked out from may not survive
  /// to the day somebody asks.
  orderingUnit          OrderingUnit @default(PIECE)
  unitQuantity          Int          @default(1)
  piecesPerUnitSnapshot Int          @default(1)

  /// The buyer's special instruction for this line, frozen at checkout.
  ///
  /// A snapshot like everything else on this row, and for the same reason: the
  /// basket it was typed into is emptied the moment the order is placed, and
  /// the words somebody agreed to have to outlive it. Carried across from
  /// `CartItem.note` by the same positional join as `orderingUnit`.
  ///
  /// Read by the packing slip, by the seller's own order screen and by the
  /// admin order detail. Never by pricing - an instruction is something to be
  /// done, not something that changes what is charged.
  noteSnapshot String? @db.VarChar(500)

  lineSubtotalMinor BigInt
  taxRatePercent    Decimal @db.Decimal(9, 6)
  taxInclusive      Boolean @default(false)
  taxAmountMinor    BigInt
  discountMinor     BigInt  @default(0)
  lineTotalMinor    BigInt

  isRecurringEligibleSnapshot Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sellerOffer SellerOffer?    @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict, map: "fk_order_item_seller_offer")

  @@index([orderId], map: "ix_order_item_order")
  @@index([productId], map: "ix_order_item_product")
  @@index([sellerOfferId], map: "ix_order_item_seller_offer")
  @@map("order_items")
}

model OrderStatusHistory {
  id      String @id @db.Char(26)
  orderId String @db.Char(26)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  actorType   ActorType @default(SYSTEM)
  actorUserId String?   @db.Char(26)
  reason      String?   @db.VarChar(512)
  metaJson    Json?

  correlationId String?  @db.VarChar(64)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt], map: "ix_order_history_order_time")
  @@map("order_status_history")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrderApproval {
  id      String @id @db.Char(26)
  orderId String @db.Char(26)

  status         ApprovalStatus @default(PENDING)
  requiredReason String         @db.VarChar(255)
  thresholdMinor BigInt?

  decidedById String?   @db.Char(26)
  decidedAt   DateTime? @db.DateTime(3)
  comment     String?   @db.VarChar(512)

  createdAt DateTime @default(now()) @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "ix_order_approval_status")
  @@index([orderId], map: "ix_order_approval_order")
  @@map("order_approvals")
}

model IdempotencyRecord {
  id String @id @db.Char(26)

  /// Logical operation, e.g. `checkout.submit`, `payment.create`, `refund.create`.
  scope       String @db.VarChar(64)
  /// Client-supplied Idempotency-Key header value.
  key         String @db.VarChar(128)
  /// SHA-256 of the canonical request body. A replay with a DIFFERENT body under
  /// the same key is rejected rather than silently returning the old response.
  requestHash String @db.Char(64)

  status       String @db.VarChar(16)
  responseJson Json?
  httpStatus   Int?

  /// Scopes it to the caller, so two customers cannot collide on a shared key.
  ownerId String? @db.Char(26)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  expiresAt   DateTime  @db.DateTime(3)

  @@unique([scope, key], map: "uq_idempotency_scope_key")
  @@index([expiresAt], map: "ix_idempotency_expires")
  @@map("idempotency_records")
}

// ===========================================================================
// PAYMENTS
//
// Rules encoded here:
//   * No card data. Only provider references and tokenised mandates.
//   * PaymentEvent is append-only and uniquely keyed on providerEventId, which
//     is what makes duplicate webhook delivery a no-op.
//   * PaymentLink stores only a SHA-256 of the token, is bound to one order,
//     recipient and amount, expires, and is single use.
//   * Refund can never exceed captured minus already-refunded (enforced in the
//     service inside a transaction, plus a CHECK on non-negative amounts).
// ===========================================================================

enum PaymentProviderKind {
  RAZORPAY
  STRIPE
}

/// Which instruments to open a gateway's sheet on.
///
/// A request, never a restriction: the sheet still offers everything the
/// gateway supports, and what the customer actually paid with is read back
/// from the provider rather than assumed from this. `ANY` is stored rather
/// than left null so that "they were offered a choice and took the default" is
/// distinguishable from "no choice was ever recorded".
enum PaymentMethodPreference {
  ANY
  UPI
}

/// What the customer chose to pay with, in the words they were shown.
///
/// The storefront names instruments, never gateways: "Pay with Credit Card" is
/// a question a person can answer, "Razorpay or Stripe" is not. The mapping
/// from one of these to a gateway lives in `domain/payment-instrument.ts` and
/// nowhere else.
///
/// CREDIT_CARD and DEBIT_CARD are separate members even though every gateway
/// treats both as "card", because they are separate to the customer and
/// because a saved card is filed under the funding type the provider reported
/// for it. Which of the two a *new* card turns out to be is discovered after
/// it is entered, never assumed from which button was pressed.
enum PaymentInstrumentKind {
  CREDIT_CARD
  DEBIT_CARD
  UPI
}

enum PaymentMode {
  TEST
  LIVE
}

model PaymentProviderConnection {
  id       String              @id @db.Char(26)
  provider PaymentProviderKind
  mode     PaymentMode
  label    String              @db.VarChar(128)

  /// AES-256-GCM ciphertext. Decrypted only inside the payment infrastructure
  /// adapter; never returned by any API, never logged.
  credentialsEnc   String  @db.Text
  webhookSecretEnc String? @db.Text
  /// Non-secret display prefix for the admin UI, e.g. rzp_test_xxxx9f2a.
  credentialsMask  String? @db.VarChar(64)

  isActive Boolean @default(false)

  lastTestedAt    DateTime? @db.DateTime(3)
  lastTestStatus  String?   @db.VarChar(32)
  lastTestMessage String?   @db.VarChar(512)

  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  createdById String?  @db.Char(26)

  transactions PaymentTransaction[]
  events       PaymentEvent[]

  /// At most one connection per provider and mode.
  @@unique([provider, mode], map: "uq_payment_connection_provider_mode")
  @@index([isActive], map: "ix_payment_connection_active")
  @@map("payment_provider_connections")
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
}

model PaymentTransaction {
  id           String @id @db.Char(26)
  orderId      String @db.Char(26)
  connectionId String @db.Char(26)

  provider PaymentProviderKind
  mode     PaymentMode

  /// Provider-side identifiers. providerOrderId is created first;
  /// providerPaymentId arrives with authorisation or capture.
  providerOrderId   String? @db.VarChar(128)
  providerPaymentId String? @unique(map: "uq_payment_provider_payment_id") @db.VarChar(128)

  status PaymentTransactionStatus @default(CREATED)

  amountMinor   BigInt
  capturedMinor BigInt  @default(0)
  currency      String  @db.Char(3)
  method        String? @db.VarChar(48)

  failureCode    String? @db.VarChar(64)
  failureMessage String? @db.VarChar(512)

  /// Guards against creating two provider orders for one checkout attempt.
  idempotencyKey String @unique(map: "uq_payment_idempotency_key") @db.VarChar(128)

  /// Set when this attempt is a recurring auto-pay against a stored mandate.
  mandateReference String? @db.VarChar(128)

  authorizedAt DateTime? @db.DateTime(3)
  capturedAt   DateTime? @db.DateTime(3)
  failedAt     DateTime? @db.DateTime(3)
  /// Last time status was actively re-queried from the provider, which is how
  /// a UI timeout or a late webhook gets reconciled.
  reconciledAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  order      Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  connection PaymentProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  refunds Refund[]
  events  PaymentEvent[]

  @@index([orderId, createdAt], map: "ix_payment_order_time")
  @@index([status, createdAt], map: "ix_payment_status_time")
  @@index([providerOrderId], map: "ix_payment_provider_order")
  @@map("payment_transactions")
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

model PaymentEvent {
  id           String              @id @db.Char(26)
  provider     PaymentProviderKind
  connectionId String?             @db.Char(26)

  /// Provider event id, and the duplicate-delivery guard: a second webhook
  /// carrying the same id hits this unique index and is acknowledged without
  /// being reprocessed.
  providerEventId String @unique(map: "uq_payment_event_provider_id") @db.VarChar(191)
  eventType       String @db.VarChar(96)

  /// Signature is verified against the RAW body before the payload is parsed or
  /// trusted. False here means the event was rejected, never applied.
  signatureVerified Boolean @default(false)
  /// Raw request body, retained verbatim for dispute and audit. Card data never
  /// appears here; providers send references only.
  rawPayload        String  @db.LongText

  processingStatus WebhookProcessingStatus @default(RECEIVED)
  processingError  String?                 @db.VarChar(1024)

  orderId              String? @db.Char(26)
  paymentTransactionId String? @db.Char(26)

  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)

  /// When the attempt currently holding this row began.
  ///
  /// Separate from `receivedAt`, which records when the event first arrived
  /// and must not move. This is the claim: a row is applied by exactly one
  /// attempt at a time, and a later delivery of the same event may take it on
  /// only once this is either absent or older than the staleness ceiling in
  /// `payment.service.ts`. Without it two simultaneous retries of an event
  /// left FAILED would both reclaim it and both apply it.
  ///
  /// Null on rows written before this column existed, which reads as
  /// "claimable" - correct, because nothing is working on them.
  attemptStartedAt DateTime? @db.DateTime(3)

  connection         PaymentProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  order              Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentTransaction PaymentTransaction?        @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([processingStatus, receivedAt], map: "ix_payment_event_status_time")
  @@index([orderId], map: "ix_payment_event_order")
  @@index([receivedAt], map: "ix_payment_event_time")
  @@map("payment_events")
}

model PaymentLink {
  id      String @id @db.Char(26)
  orderId String @db.Char(26)

  /// SHA-256 of a 32-byte random token. The raw token exists only in the email.
  tokenHash String @unique(map: "uq_payment_link_token_hash") @db.Char(64)

  recipientEmail String  @db.VarChar(320)
  recipientName  String? @db.VarChar(255)

  /// Amount is locked at creation; a later order edit invalidates the link.
  amountMinor BigInt
  currency    String @db.Char(3)

  expiresAt DateTime  @db.DateTime(3)
  sentAt    DateTime? @db.DateTime(3)
  openedAt  DateTime? @db.DateTime(3)
  /// Single use: set the moment payment completes, after which the token fails.
  usedAt    DateTime? @db.DateTime(3)

  revokedAt     DateTime? @db.DateTime(3)
  revokedReason String?   @db.VarChar(255)

  /// When a link is resent, the old row points at the new one and stays invalid.
  supersededByLinkId String? @db.Char(26)

  createdById String   @db.Char(26)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt], map: "ix_payment_link_order")
  @@index([expiresAt, usedAt], map: "ix_payment_link_expiry")
  @@map("payment_links")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Refund {
  id                   String @id @db.Char(26)
  orderId              String @db.Char(26)
  paymentTransactionId String @db.Char(26)

  provider         PaymentProviderKind
  providerRefundId String?             @unique(map: "uq_refund_provider_id") @db.VarChar(128)

  amountMinor BigInt
  currency    String @db.Char(3)
  reason      String @db.VarChar(512)

  status RefundStatus @default(REQUESTED)

  requestedById String  @db.Char(26)
  approvedById  String? @db.Char(26)

  idempotencyKey String @unique(map: "uq_refund_idempotency_key") @db.VarChar(128)

  failureCode    String? @db.VarChar(64)
  failureMessage String? @db.VarChar(512)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  returnRequests ReturnRequest[]

  @@index([orderId, createdAt], map: "ix_refund_order_time")
  @@index([status, createdAt], map: "ix_refund_status_time")
  @@map("refunds")
}

// ===========================================================================
// RECURRING PURCHASES
//
// Duplicate protection is structural, not procedural: the worker inserts a
// ScheduleOccurrence row keyed unique on (scheduleId, plannedRunAt) BEFORE any
// side effect. A second worker, a retry, or a clock skew all collide on that
// index and stop. Order.scheduleOccurrenceId is itself unique, so one
// occurrence can never fan out into two orders.
//
// MariaDB 10.4 has no SKIP LOCKED, so due schedules are claimed with a lease:
//   UPDATE recurring_schedules
//      SET leaseOwner = ?, leaseExpiresAt = ?
//    WHERE id = ? AND (leaseExpiresAt IS NULL OR leaseExpiresAt < UTC_TIMESTAMP(3))
// and the worker proceeds only when affectedRows = 1.
// ===========================================================================

enum ScheduleStatus {
  /// Configured but not yet authorised. Nothing is ever charged from a DRAFT.
  ///
  /// The state a plan sits in between "the customer filled the form in" and
  /// "the customer read the review screen and confirmed". `nextRunAt` stays
  /// NULL here, which is what keeps a draft out of the worker's due query even
  /// if it somehow acquired a run date.
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  /// Ran to its natural end - the end date passed, or maxOccurrences was
  /// reached. Distinct from CANCELLED, which is somebody deciding to stop it,
  /// and the distinction belongs to the customer: "finished" and "you
  /// cancelled this" are not the same sentence.
  COMPLETED
  /// Auto-set after failureCount reaches maxFailures. Needs a human to resume.
  FAILED
}

enum ScheduleFrequency {
  EVERY_N_DAYS
  WEEKLY
  /// Every fortnight, on a fixed weekday.
  ///
  /// Not the same thing as EVERY_N_DAYS with intervalDays = 14, which counts
  /// forward from the last run and so drifts off the weekday whenever an
  /// occurrence is skipped or held. BIWEEKLY is anchored to the start date's
  /// week parity, so "alternate Tuesdays" stays on Tuesdays for ever.
  BIWEEKLY
  MONTHLY
  /// Every N calendar months, on the start date's day of the month.
  ///
  /// What "every two months", "quarterly", "every six months" and "yearly"
  /// are all stored as, with `intervalMonths` saying which. Not the same thing
  /// as EVERY_N_DAYS with 60, 90, 180 or 365: a quarter is not ninety days and
  /// a year is not 365 of them, so counting in days walks a standing order
  /// backwards through the calendar until it bills in the wrong month.
  ///
  /// N is 2 or more. One would be MONTHLY spelled a second way.
  EVERY_N_MONTHS
  /// Buy Later: one delivery, on one date, and then the plan is COMPLETED.
  ///
  /// Modelled as a frequency rather than its own table because everything
  /// else about it - revalidation, payment, ERP push, idempotency, the
  /// customer's management screen - is identical to a recurring occurrence.
  /// See `RecurringSchedule.kind`.
  ONE_TIME
}

/// Whether a plan repeats, or fires once and finishes.
///
/// Redundant with `frequency == ONE_TIME` on purpose. This is the column the
/// customer's scheduled-orders list filters and groups on, and a list query
/// should not have to know that one enum member out of five means something
/// structurally different from the other four.
enum ScheduleKind {
  ONE_TIME
  RECURRING
}

/// What to do when a scheduled product cannot be supplied.
///
/// The default is deliberately NEVER. Substituting one medical-supply SKU for
/// a near neighbour without being asked is the kind of helpfulness that ends
/// up in an incident report, so an occurrence that cannot be filled as
/// authorised is held and the customer is told.
enum SubstitutionPolicy {
  /// Hold the occurrence and notify. Never swap anything.
  NEVER
  /// Use the substitute saved against the schedule item, if one is set and is
  /// itself available. Falls back to holding - never to guessing.
  SAVED_PREFERENCE
}

/// Where a scheduled order is fulfilled from.
enum ScheduleFulfilmentRule {
  /// Let the inventory service pick, the way an ordinary checkout does.
  AUTO
  /// Always this warehouse. Held rather than moved even if another location
  /// has more stock, because somebody chose it for a reason.
  FIXED_LOCATION
}

enum SchedulePaymentMode {
  /// Charges a stored provider mandate/token without customer interaction.
  AUTO_PAY
  /// Emails an expiring single-use payment link to the approved payer.
  PAYMENT_LINK
}

model RecurringSchedule {
  id                String @id @db.Char(26)
  customerProfileId String @db.Char(26)

  name   String         @db.VarChar(128)
  status ScheduleStatus @default(ACTIVE)

  /// Repeats, or fires once (Buy Later). See the enum.
  kind ScheduleKind @default(RECURRING)

  /// The single instant a ONE_TIME plan fires, in UTC.
  ///
  /// Held as well as `nextRunAt` rather than instead of it: nextRunAt is the
  /// worker's mutable queue key and is cleared on pause, while this is the
  /// customer's stated intention and never changes once authorised. Losing it
  /// would mean a paused Buy Later could not be resumed to the date the
  /// customer actually asked for.
  runOnceAt DateTime? @db.DateTime(3)

  frequency    ScheduleFrequency
  /// Used when frequency = EVERY_N_DAYS. The doc calls out "every 7 days".
  intervalDays Int?
  /// Used when frequency = WEEKLY. 1 = Monday .. 7 = Sunday (ISO-8601).
  weekday      Int?
  /// Used when frequency = MONTHLY. 1..31, clamped to the last valid day.
  monthDay     Int?

  /// Used when frequency = EVERY_N_MONTHS. 2..24.
  ///
  /// No day column of its own: the day of the month comes from `startDate`.
  /// "Every three months" is a choice about spacing, and the date was settled
  /// when the customer picked their first delivery.
  intervalMonths Int?

  /// IANA zone the wall-clock run time is interpreted in. The server timezone
  /// is deliberately not trusted for this.
  timezone    String @db.VarChar(64)
  /// Local time-of-day for the run, minutes since local midnight.
  runAtMinute Int    @default(360)

  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  /// Optional cap on total orders produced. Null = until cancelled.
  maxOccurrences  Int?
  occurrenceCount Int       @default(0)

  /// Next planned instant, in UTC. Also the queue key the worker polls.
  nextRunAt DateTime? @db.DateTime(3)
  lastRunAt DateTime? @db.DateTime(3)

  paymentMode      SchedulePaymentMode
  /// Provider mandate/token reference for AUTO_PAY. Never a card number.
  ///
  /// Retained for the Razorpay e-mandate path and for plans created before
  /// stored payment methods existed. Stripe auto-pay uses `paymentMethodId`
  /// below, which carries the consent record with it.
  mandateReference String?              @db.VarChar(128)
  mandateProvider  PaymentProviderKind?
  /// Approved payer for PAYMENT_LINK mode.
  payerEmail       String?              @db.VarChar(320)

  /// The reusable instrument an AUTO_PAY plan charges off-session.
  ///
  /// Restrict on delete, not Cascade: a customer removing a card must not
  /// silently delete the schedule that depends on it. The service refuses the
  /// removal and names the plans instead, so the customer chooses.
  paymentMethodId String? @db.Char(26)

  shippingAddressId  String  @db.Char(26)
  billingAddressId   String  @db.Char(26)
  shippingMethodCode String? @db.VarChar(32)

  /// Explicit consent is required before activation, and is re-checked at every
  /// occurrence. Storing the version lets a policy change force re-consent.
  consentAcceptedAt             DateTime @db.DateTime(3)
  consentVersion                String   @db.VarChar(32)
  /// Occurrence total above which the run pauses for approval instead of charging.
  ///
  /// An absolute ceiling, set once. The two tolerance columns below are the
  /// relative test, applied against what the customer was last quoted; both
  /// are checked, and either one tripping holds the occurrence.
  repriceApprovalThresholdMinor BigInt?

  /// How far the total may move from the quoted amount before the charge needs
  /// re-confirming, as a percentage.
  ///
  /// Decimal, not Float: it is compared against money. Null means fall back to
  /// the deployment's `SCHEDULE_PRICE_TOLERANCE_PERCENT` setting.
  priceTolerancePercent Decimal? @db.Decimal(5, 2)
  /// The same test as an absolute floor, so a tolerance of 5% on a small
  /// basket does not hold an occurrence over a rounding difference. Whichever
  /// of the two is more generous wins.
  priceToleranceMinor   BigInt?

  /// How long before a run the plan stops accepting edits, in minutes.
  ///
  /// Edits inside this window would race the worker: the customer sees the
  /// old basket, the engine is already pricing the new one. Rejected with
  /// SCHEDULE_EDIT_CUTOFF_PASSED, which names the next date they can edit.
  editCutoffMinutes Int @default(1440)

  substitutionPolicy SubstitutionPolicy @default(NEVER)

  /// Where these orders ship from. NULL location with FIXED_LOCATION is
  /// refused at write time - the two columns are set together.
  fulfilmentRule      ScheduleFulfilmentRule @default(AUTO)
  inventoryLocationId String?                @db.Char(26)

  /// The cart the customer authorised, exactly as the review screen showed it.
  ///
  /// Kept for provenance, not for pricing. Every occurrence reprices against
  /// today's catalogue - this is what "what did they actually agree to" is
  /// answered from when a total is disputed months later, and what the
  /// tolerance check measures drift against.
  ///
  /// NULL on plans built from a product list rather than a cart, which is
  /// every plan created before Buy Later existed.
  cartSnapshotJson Json?
  sourceCartId     String? @db.Char(26)

  /// When the customer confirmed the review screen. NULL while DRAFT.
  activatedAt DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  failureCount Int @default(0)
  maxFailures  Int @default(3)

  pausedAt     DateTime? @db.DateTime(3)
  pausedReason String?   @db.VarChar(512)
  pausedById   String?   @db.Char(26)
  cancelledAt  DateTime? @db.DateTime(3)
  cancelReason String?   @db.VarChar(512)

  /// When the customer removed this finished plan from their own list.
  ///
  /// A soft delete, on the same reasoning as `AssistantConversation.hiddenAt`
  /// and with more at stake. This row is the record that a customer authorised
  /// recurring charges: `consentAcceptedAt`, `consentVersion`, the cart they
  /// agreed to, and every occurrence and order hanging off it. Somebody
  /// tidying a list is not a reason to destroy the evidence behind a charge
  /// that may be disputed months later - and `orders` is ON DELETE RESTRICT,
  /// so a real delete could not happen anyway once the plan has run.
  ///
  /// What the flag does guarantee is what was asked for: the plan is gone from
  /// every customer-facing read. Staff still see it, the GDPR export still
  /// discloses it, and erasure under Art. 17 remains a different act with its
  /// own route.
  ///
  /// Only ever set on a plan in a terminal status - CANCELLED or COMPLETED.
  /// Hiding a live authority to charge would mean money leaving an account for
  /// a plan the customer can no longer see, which is the one outcome this
  /// column must never enable; `hideSchedule` refuses anything else.
  hiddenAt DateTime? @db.DateTime(3)

  /// --- Worker lease (stands in for SKIP LOCKED on MariaDB 10.4) ---
  leaseOwner     String?   @db.VarChar(64)
  leaseExpiresAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  shippingAddress Address         @relation("ScheduleShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  billingAddress  Address         @relation("ScheduleBillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)

  paymentMethod     CustomerPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  inventoryLocation InventoryLocation?     @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)

  items       RecurringScheduleItem[]
  occurrences ScheduleOccurrence[]

  /// The worker's hot query: due, active, unleased.
  @@index([status, nextRunAt], map: "ix_schedule_due")
  @@index([customerProfileId, status], map: "ix_schedule_customer_status")
  @@index([leaseExpiresAt], map: "ix_schedule_lease")
  /// The customer's list: their plans, one-time separated from recurring.
  @@index([customerProfileId, kind, status], map: "ix_schedule_customer_kind")
  @@index([paymentMethodId], map: "ix_schedule_payment_method")
  @@index([inventoryLocationId], map: "ix_schedule_location")
  @@map("recurring_schedules")
}

model RecurringScheduleItem {
  id         String  @id @db.Char(26)
  scheduleId String  @db.Char(26)
  productId  String  @db.Char(26)
  variantId  String? @db.Char(26)
  variantKey String  @default("") @db.VarChar(26)

  /// Pieces. `quoteSchedule` prices this column and only this column.
  quantity Int

  /// The unit the plan was agreed in, and the conversion at that moment.
  ///
  /// It matters more here than in a basket: this line is charged again months
  /// from now by a worker with nobody watching, and a customer who agreed to
  /// "3 cartons a month" must keep being sent three cartons even if the carton
  /// is re-specified in between. Re-deriving the pieces at charge time would
  /// change the order without anybody agreeing to it.
  orderingUnit          OrderingUnit @default(PIECE)
  unitQuantity          Int          @default(1)
  piecesPerUnitSnapshot Int          @default(1)

  /// The one product the customer agreed may stand in for this line.
  ///
  /// Only ever consulted when the plan's `substitutionPolicy` is
  /// SAVED_PREFERENCE, and only for the exact SKU named here. There is no
  /// second choice and no category fallback, on purpose: a substitution the
  /// customer did not name is a substitution they did not authorise, and the
  /// engine holds the occurrence rather than reaching for something similar.
  substituteProductId  String? @db.Char(26)
  substituteVariantId  String? @db.Char(26)
  substituteVariantKey String  @default("") @db.VarChar(26)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  schedule RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  substituteProduct Product?        @relation("ScheduleItemSubstitute", fields: [substituteProductId], references: [id], onDelete: Restrict)
  substituteVariant ProductVariant? @relation("ScheduleItemSubstituteVariant", fields: [substituteVariantId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, productId, variantKey], map: "uq_schedule_item_sku")
  @@index([productId], map: "ix_schedule_item_product")
  @@index([substituteProductId], map: "ix_schedule_item_substitute")
  @@map("recurring_schedule_items")
}

/// The life of one billing cycle.
///
/// The order below is the order an occurrence actually moves through, and
/// `schedule-state.ts` is what enforces it - no service writes this column
/// directly, for the same reason no service writes `orders.status`.
///
/// PENDING, ORDER_CREATED and PAID predate this vocabulary and are retained
/// so rows written by the previous engine still read correctly. Nothing
/// writes them any more; `LEGACY_STATUSES` in schedule-state.ts lists them.
enum OccurrenceStatus {
  /// Materialised ahead of time so the customer has a row to skip, edit or
  /// cancel before it runs. Not yet touched by the worker.
  SCHEDULED
  /// Claimed by a worker and being revalidated - eligibility, prices, stock,
  /// limits, address, ERP mapping. No money has moved.
  AWAITING_VALIDATION
  /// Revalidated and priced. A charge has been started but not confirmed:
  /// either an off-session PaymentIntent is in flight, or a payment link is
  /// out with the payer.
  PAYMENT_PENDING
  /// Stripe needs the cardholder present - 3-D Secure, or a mandate the bank
  /// wants re-authenticated. The customer has been told; nothing retries on
  /// its own, because only they can clear it.
  ACTION_REQUIRED
  /// Paid, and the platform order is being created and fulfilled.
  PROCESSING
  /// Paid and the platform order exists, but the ERP has not accepted it.
  ///
  /// The most important state in this enum. The customer's money is taken and
  /// their order is real; only the ERP hand-off is outstanding. It retries
  /// under the SAME idempotency key and never re-charges. See ErpOrderPush.
  PAID_ERP_PENDING
  /// Everything done: paid, ordered, ERP notified, customer told.
  COMPLETED
  /// Deliberately not run: product unpublished, stock short, limit breached,
  /// or the customer skipped it.
  SKIPPED
  /// The customer or an administrator cancelled this cycle, or the whole plan
  /// was cancelled before it ran. Distinct from SKIPPED, which the engine
  /// also decides for itself.
  CANCELLED
  FAILED

  /// --- Retained for rows written before the statuses above existed ---
  PENDING
  ORDER_CREATED
  PAID
}

/// Where an order stands with the ERP.
enum ErpPushStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// Retries exhausted. A person has to look at it; nothing will retry again
  /// on its own, because a connector that has refused the same payload a
  /// dozen times will refuse the thirteenth.
  ABANDONED
}

/// A reusable payment instrument's usability.
enum StoredPaymentMethodStatus {
  ACTIVE
  /// Detached at the provider - by the customer here, or in the provider's
  /// own dashboard.
  DETACHED
  /// The card's expiry has passed, or the provider reported it unusable.
  EXPIRED
}

/// What a stored card's owner agreed to. See `CustomerPaymentMethod`.
///
/// Ordered narrowest first. OFF_SESSION implies everything CHECKOUT allows;
/// the reverse is emphatically not true, and `assertChargeable` is where that
/// asymmetry is enforced.
enum PaymentConsentScope {
  CHECKOUT
  OFF_SESSION
}

model ScheduleOccurrence {
  id         String @id @db.Char(26)
  scheduleId String @db.Char(26)

  /// The intended run instant in UTC. Combined with scheduleId this is the
  /// idempotency key for the whole recurring engine.
  plannedRunAt DateTime @db.DateTime(3)

  /// The zone `plannedRunAt` was computed in, copied off the plan when this
  /// occurrence was materialised.
  ///
  /// Stored per occurrence rather than read back off the plan, because a
  /// customer who moves country and changes their plan's timezone must not
  /// retroactively change what time last month's order was due. This is the
  /// zone the reminder and the customer's screen format against.
  timezone String @default("UTC") @db.VarChar(64)

  status OccurrenceStatus @default(SCHEDULED)

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime? @db.DateTime(3)
  nextRetryAt   DateTime? @db.DateTime(3)

  /// Payment attempts, counted separately from `attemptCount`.
  ///
  /// A validation failure that never reached Stripe must not consume a card's
  /// retry budget: banks read repeated declines as a signal about the card,
  /// and three "out of stock" holds followed by one real attempt should not
  /// look to them like four failed charges.
  paymentAttemptCount Int @default(0)

  /// Amount quoted to the customer in the reminder, so a reprice is detectable.
  quotedTotalMinor BigInt?
  actualTotalMinor BigInt?

  /// The provider's reference for the charge - a Stripe PaymentIntent id.
  ///
  /// Written before the charge is confirmed, so a crash mid-call leaves a
  /// reference to reconcile against rather than an unexplained gap. Never a
  /// client secret: those are fetched from Stripe on demand and never stored.
  paymentReference String? @db.VarChar(128)

  /// The ERP's own identifier for the order it accepted.
  ///
  /// Also on ErpOrderPush, which holds the retry state. Denormalised here
  /// because "what is this order called in the ERP" is asked by the customer's
  /// screen and by support, and neither should have to join through the push
  /// ledger to answer it.
  erpOrderReference String?        @db.VarChar(128)
  erpPushStatus     ErpPushStatus?

  /// The stable key every side effect of this occurrence is keyed on: the
  /// Stripe charge, the platform order, the ERP push, the inventory movement.
  ///
  /// Derived from scheduleId + plannedRunAt, so a retry recomputes the same
  /// value rather than minting a new one. Unique, so it cannot be reused
  /// across occurrences even by a bug.
  idempotencyKey String @unique(map: "uq_occurrence_idempotency") @db.VarChar(80)

  /// What the plan authorised, priced as at this occurrence.
  ///
  /// The evidence behind `actualTotalMinor`: line prices, discounts, tax and
  /// delivery as they were on the day. The order carries its own immutable
  /// snapshot too; this one also exists for occurrences that never became an
  /// order, which is exactly when somebody asks what the amount would have
  /// been.
  cartSnapshotJson Json?

  /// True when a person skipped this cycle, false when the engine did.
  ///
  /// Both end in SKIPPED, and the customer is owed a different sentence for
  /// each: "you skipped this" against "we could not supply this".
  skippedByUser Boolean @default(false)

  failureCode    String? @db.VarChar(64)
  failureMessage String? @db.VarChar(512)
  skipReason     String? @db.VarChar(512)

  /// When Stripe asked for the cardholder. Read by the reminder that chases
  /// an ACTION_REQUIRED occurrence before its window closes.
  actionRequiredAt DateTime? @db.DateTime(3)

  reminderSentAt DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  completedAt    DateTime? @db.DateTime(3)

  schedule RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  order    Order?
  erpPush  ErpOrderPush?

  /// The structural duplicate guard. Do not remove.
  @@unique([scheduleId, plannedRunAt], map: "uq_occurrence_schedule_run")
  @@index([status, nextRetryAt], map: "ix_occurrence_retry")
  @@index([plannedRunAt], map: "ix_occurrence_planned")
  /// The reminder sweep: upcoming, not yet reminded.
  @@index([status, plannedRunAt, reminderSentAt], map: "ix_occurrence_reminder")
  @@index([scheduleId, status], map: "ix_occurrence_schedule_status")
  @@map("schedule_occurrences")
}

/// A reusable payment instrument, plus the consent that makes it chargeable
/// while the customer is not there.
///
/// What is stored is deliberately the smallest set that works: Stripe's
/// customer id, its payment-method id, and the four display fields Stripe
/// itself returns for showing somebody which card they picked. No PAN, no
/// CVV, no expiry beyond the month and year already printed on every receipt,
/// and no client secret. A breach of this table yields nothing chargeable
/// without the deployment's own Stripe secret key.
///
/// The consent columns are not decoration. Charging off-session is only
/// lawful because the customer agreed to it for a stated purpose, and
/// `consentVersion` is what lets a change of terms force a fresh agreement
/// instead of quietly inheriting the old one. Stripe's own rules require the
/// same record.
model CustomerPaymentMethod {
  id                String              @id @db.Char(26)
  customerProfileId String              @db.Char(26)
  provider          PaymentProviderKind

  /// Stripe's Customer id (cus_...). One per customer per provider, reused
  /// across every plan they authorise.
  providerCustomerId      String  @db.VarChar(128)
  /// Stripe's PaymentMethod id (pm_...). The thing actually charged.
  providerPaymentMethodId String  @db.VarChar(128)
  /// The SetupIntent that produced it, kept for reconciliation with Stripe.
  setupIntentId           String? @db.VarChar(128)

  /// --- Display only. Stripe returns these; none of them can pay for anything.
  brand    String? @db.VarChar(32)
  last4    String? @db.VarChar(4)
  expMonth Int?
  expYear  Int?
  funding  String? @db.VarChar(16)
  /// The card's issuing country, which is what some tax and SCA rules turn on.
  country  String? @db.Char(2)

  status StoredPaymentMethodStatus @default(ACTIVE)

  /// --- Consent (the provider's requirement, and the law's) ---
  ///
  /// What the customer agreed to when this card was stored. The two scopes are
  /// not degrees of the same permission - they are different agreements, and
  /// conflating them is how a card someone saved to avoid retyping it ends up
  /// being charged in the night.
  ///
  /// CHECKOUT   - "keep this so I need not type it again", given at a checkout
  ///              with the customer present. Every charge against it is
  ///              on-session, and the customer sees each one happen.
  /// OFF_SESSION- "charge this while I am not here", given at auto-pay
  ///              enrolment. Strictly more than the above.
  ///
  /// `assertChargeable` refuses anything that is not OFF_SESSION, which is the
  /// single place that separation is enforced. Defaulted to OFF_SESSION so
  /// that every row written before this column existed - all of which were
  /// auto-pay enrolments - keeps exactly the meaning it was created with.
  consentScope      PaymentConsentScope @default(OFF_SESSION)
  consentAcceptedAt DateTime            @db.DateTime(3)
  consentVersion    String              @db.VarChar(32)
  /// Hashed, never the address itself: it is evidence that consent came from
  /// somewhere, and keeping the raw IP would make this table a worse thing to
  /// leak than it needs to be.
  consentIpHash     String?             @db.VarChar(64)
  consentUserAgent  String?             @db.VarChar(256)

  /// The customer's default for new plans. Enforced in the service, not the
  /// schema: a partial unique index on (customerProfileId) WHERE isDefault is
  /// not something MariaDB 10.4 offers.
  isDefault Boolean @default(false)

  detachedAt DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  schedules RecurringSchedule[]

  /// The auto-pay settings pointing at this instrument, if any. `SetNull` on
  /// the other side: removing a card must leave auto-pay without an instrument
  /// - which `assertAutoPayChargeable` then refuses - rather than deleting the
  /// customer's limits and preferences along with it.
  autoPaySettings CustomerAutoPaySetting[]

  /// Orders whose customer picked this card at checkout. `SetNull` on the
  /// other side: removing a card must leave the order standing.
  orders Order[]

  /// One row per instrument. A repeated SetupIntent confirmation collides here
  /// rather than giving the customer the same card twice.
  @@unique([provider, providerPaymentMethodId], map: "uq_payment_method_provider_ref")
  @@index([customerProfileId, status], map: "ix_payment_method_customer")
  @@map("customer_payment_methods")
}

/// One order's hand-off to the ERP, and the state of its retries.
///
/// A separate table from the order because it has a different lifetime: the
/// order is finished the moment it is paid, while this row can be retried for
/// hours afterwards and has to remember what it already sent. It is also the
/// answer to the single most dangerous case in the whole feature - money
/// taken, ERP silent - and that answer should not be three nullable columns
/// hanging off `orders`.
///
/// `orderId` is unique. That is the structural reason a retry cannot create a
/// second ERP order, and it does not depend on the retry code being careful.
model ErpOrderPush {
  id           String  @id @db.Char(26)
  orderId      String  @unique(map: "uq_erp_push_order") @db.Char(26)
  /// The occurrence that caused it, when a schedule did. NULL for an ordinary
  /// checkout pushed to the ERP.
  occurrenceId String? @unique(map: "uq_erp_push_occurrence") @db.Char(26)
  /// The legacy `integration_connections` row used, on an installation still
  /// configured through `ERP_ORDER_CONNECTION_NAME`. NULL once a connection is
  /// deleted; the ledger row outlives the configuration that made it.
  connectionId String? @db.Char(26)

  /// The `erp_connections` row used - the one an administrator configured
  /// under Settings -> ERP, which is the path every new installation takes.
  ///
  /// A second column rather than a reused one because the two point at two
  /// different tables, and a row that cannot say which kind it holds is a row
  /// nobody can safely join. At most one is set on any push; both NULL means no
  /// ERP was configured at all.
  erpConnectionId String? @db.Char(26)

  /// Sent to the ERP as its idempotency header, and unique here.
  ///
  /// The same value across every retry - that is the entire point. An ERP that
  /// honours the header de-duplicates on its side; one that does not is still
  /// protected by `orderId` above.
  idempotencyKey String @unique(map: "uq_erp_push_idempotency") @db.VarChar(80)

  status ErpPushStatus @default(PENDING)

  /// The ERP's identifier for the order it created.
  erpOrderReference String? @db.VarChar(128)

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime? @db.DateTime(3)
  nextRetryAt   DateTime? @db.DateTime(3)
  succeededAt   DateTime? @db.DateTime(3)

  lastErrorCode    String? @db.VarChar(64)
  lastErrorMessage String? @db.VarChar(1024)

  /// What was sent and what came back, for the argument that follows a
  /// disagreement about an order. Credentials are redacted before either is
  /// written.
  requestJson  Json?
  responseJson Json?

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  occurrence ScheduleOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  /// The retry sweep: due, not yet done.
  @@index([status, nextRetryAt], map: "ix_erp_push_retry")
  @@index([connectionId, createdAt], map: "ix_erp_push_connection_time")
  @@index([erpConnectionId, createdAt], map: "ix_erp_push_erp_connection_time")
  @@map("erp_order_pushes")
}

// ===========================================================================
// FULFILMENT AND AFTER-SALE
// ===========================================================================

// ===========================================================================
// FULFILMENT QUOTES
//
// What one warehouse offered for one basket, to one address, at one moment.
//
// A quote is a **frozen offer**, and freezing it is the whole reason the table
// exists. The alternative - recomputing at payment from ids the browser sends
// back - means the number on the review screen and the number charged are
// produced by two different runs against a catalogue and a stock ledger that
// moved in between. Whichever way that drifts, the customer is charged
// something nobody showed them.
//
// So every option the buyer is shown is written down: the price, the promised
// dates, the carrier, the warehouse, and the basket it was priced for.
// Choosing one hands back its id; checkout re-reads the row, re-checks that
// the world still supports it, and copies the promise onto the order. A quote
// that has expired or whose basket has changed is refused with a code the
// storefront turns into "these options have moved, here they are again" -
// never silently repriced.
// ===========================================================================

/// One warehouse's offer for one basket, frozen.
///
/// Rows are cheap and short-lived: one per eligible option per request, swept
/// once they expire unless an order points at them. A quote attached to an
/// order is kept for ever - it is the evidence of what the customer was shown
/// before they agreed to pay.
model FulfilmentQuote {
  id String @id @db.Char(26)

  customerProfileId String  @db.Char(26)
  /// The cart it was priced from, where there was one. Null for a quote taken
  /// against an explicit item list rather than the live cart.
  cartId            String? @db.Char(26)
  /// The delivery address it was priced to. Null where the buyer had only
  /// said which country they are in - see `isEstimate`.
  addressId         String? @db.Char(26)

  locationId String  @db.Char(26)
  /// The lane that produced the dates and the fee. SetNull rather than
  /// Restrict: an operator retiring a carrier must not be blocked by quotes,
  /// and the quote keeps its own frozen copy of every figure anyway.
  zoneId     String? @db.Char(26)

  /// Where it was going. The country is always known; the postcode only when
  /// an address was given.
  destinationCountry    String  @db.Char(2)
  destinationPostalCode String? @db.VarChar(16)

  /// True when this was priced from a country alone.
  ///
  /// The storefront labels such an option "Estimated" and asks for it again
  /// once an address is chosen. It is a real answer - a buyer comparing
  /// warehouses before they have typed an address deserves one - and it is
  /// never the answer checkout accepts: `assertQuoteUsable` refuses an
  /// estimate, because an estimate is a conversation and not an offer.
  isEstimate Boolean @default(false)

  /// The offer. BigInt minor units in one currency, like everywhere else.
  /// grandTotal = subtotal - discount + tax + shipping.
  currency        String @db.Char(3)
  subtotalMinor   BigInt @default(0)
  discountMinor   BigInt @default(0)
  taxMinor        BigInt @default(0)
  shippingMinor   BigInt @default(0)
  grandTotalMinor BigInt @default(0)

  /// The promise, as calendar dates in the warehouse's own zone.
  ///
  /// `@db.Date` and not an instant, deliberately: "arrives on the 18th" is a
  /// day, and storing it as midnight-somewhere is how a delivery date shows as
  /// the 17th to a third of the world. The same reasoning as
  /// `RecurringSchedule.startDate`.
  dispatchDate     DateTime @db.Date
  deliveryFromDate DateTime @db.Date
  deliveryToDate   DateTime @db.Date
  transitMinDays   Int
  transitMaxDays   Int
  handlingDays     Int      @default(0)

  /// Who was going to carry it, copied rather than joined. The lane can be
  /// edited or retired; what the customer was told cannot.
  carrierName  String @db.VarChar(64)
  serviceLevel String @db.VarChar(64)

  /// Kilometres from the warehouse to the destination - to the address itself
  /// where coordinates were known, and to the country's nearest border
  /// otherwise. Information for the buyer, never a rule: eligibility is the
  /// zone's business. Null where neither could be measured.
  distanceKm Decimal? @db.Decimal(9, 2)

  /// The basket this was priced for, as a digest.
  ///
  /// A quote is only valid for the basket it was taken against, and comparing
  /// digests is how checkout notices that somebody added a line in another tab
  /// between the review screen and Pay. SHA-256 over the sorted
  /// product/variant/quantity triples and the currency - see
  /// `basketDigest` in `warehouse-options.service.ts`.
  basketHash String @db.Char(64)
  /// The lines themselves, for the audit trail and for a support conversation
  /// months later about what exactly was offered.
  itemsJson  Json

  /// When it stops being an offer. Short - see FULFILMENT_QUOTE_TTL_MINUTES -
  /// because it holds a stock figure, and a stock figure is the fastest-moving
  /// input in this system.
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)

  customerProfile CustomerProfile        @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  cart            Cart?                  @relation(fields: [cartId], references: [id], onDelete: SetNull)
  address         Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  location        InventoryLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  zone            WarehouseDeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  orders Order[] @relation("OrderFulfilmentQuote")

  @@index([customerProfileId, createdAt], map: "ix_fulfilment_quote_customer")
  /// The sweep's own query: everything that has lapsed.
  @@index([expiresAt], map: "ix_fulfilment_quote_expiry")
  @@index([locationId], map: "ix_fulfilment_quote_location")
  @@index([cartId], map: "ix_fulfilment_quote_cart")
  @@index([addressId], map: "ix_fulfilment_quote_address")
  @@index([zoneId], map: "ix_fulfilment_quote_zone")
  @@map("fulfilment_quotes")
}

enum ShipmentStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED_TO_ORIGIN
}

model Shipment {
  id      String @id @db.Char(26)
  orderId String @db.Char(26)

  carrier        String  @db.VarChar(128)
  trackingNumber String? @db.VarChar(128)
  trackingUrl    String? @db.VarChar(1024)

  status ShipmentStatus @default(CREATED)

  /// Which order items and quantities went out in this shipment.
  itemsJson Json

  dispatchedAt DateTime? @db.DateTime(3)
  deliveredAt  DateTime? @db.DateTime(3)
  notes        String?   @db.VarChar(512)

  createdById String   @db.Char(26)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "ix_shipment_order")
  @@index([status, createdAt], map: "ix_shipment_status_time")
  @@index([trackingNumber], map: "ix_shipment_tracking")
  @@map("shipments")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTED
  COMPLETED
}

model ReturnRequest {
  id      String @id @db.Char(26)
  orderId String @db.Char(26)

  status ReturnStatus @default(REQUESTED)
  reason String       @db.VarChar(512)

  /// Requested items with quantity, plus the post-inspection sellable versus
  /// quarantined split that drives the restock movements.
  itemsJson Json

  requestedById String    @db.Char(26)
  decidedById   String?   @db.Char(26)
  decidedAt     DateTime? @db.DateTime(3)
  decisionNote  String?   @db.VarChar(512)

  refundId String? @db.Char(26)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "ix_return_order")
  @@index([status, createdAt], map: "ix_return_status_time")
  @@map("return_requests")
}

// ===========================================================================
// INTEGRATIONS (custom product/inventory API connector)
// ===========================================================================

enum IntegrationAuthType {
  NONE
  API_KEY_HEADER
  BEARER_TOKEN
  BASIC
}

enum SyncDirection {
  IMPORT
  EXPORT
  BIDIRECTIONAL
}

enum ConflictPolicy {
  EXTERNAL_WINS
  UBOSS_WINS
  FIELD_LEVEL
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

model IntegrationConnection {
  id      String @id @db.Char(26)
  name    String @db.VarChar(128)
  baseUrl String @db.VarChar(1024)

  authType        IntegrationAuthType @default(NONE)
  /// AES-256-GCM ciphertext. Never returned by any API.
  credentialsEnc  String?             @db.Text
  credentialsMask String?             @db.VarChar(64)

  /// External field -> UBOSS field mapping, validated at save time.
  fieldMappingJson Json
  direction        SyncDirection  @default(IMPORT)
  conflictPolicy   ConflictPolicy @default(EXTERNAL_WINS)

  /// Cron expression evaluated in the business timezone. Null = manual only.
  scheduleCron String? @db.VarChar(64)
  timeoutMs    Int     @default(15000)
  maxRetries   Int     @default(3)

  circuitState        CircuitState @default(CLOSED)
  circuitOpenedAt     DateTime?    @db.DateTime(3)
  consecutiveFailures Int          @default(0)

  isActive       Boolean   @default(false)
  lastSuccessAt  DateTime? @db.DateTime(3)
  lastTestedAt   DateTime? @db.DateTime(3)
  lastTestStatus String?   @db.VarChar(32)

  alertRecipientsJson Json?

  createdById String?  @db.Char(26)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  syncRuns SyncRun[]

  @@index([isActive], map: "ix_integration_active")
  @@map("integration_connections")
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

model SyncRun {
  id           String @id @db.Char(26)
  connectionId String @db.Char(26)

  status      SyncRunStatus @default(RUNNING)
  /// A dry run validates and reports without writing catalog rows.
  isDryRun    Boolean       @default(false)
  triggeredBy String        @db.VarChar(32)

  startedAt  DateTime  @default(now()) @db.DateTime(3)
  finishedAt DateTime? @db.DateTime(3)

  totalRecords Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)
  skippedCount Int @default(0)
  failureCount Int @default(0)

  summaryJson  Json?
  errorMessage String? @db.VarChar(1024)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  errors     SyncError[]

  @@index([connectionId, startedAt], map: "ix_sync_run_connection_time")
  @@index([status, startedAt], map: "ix_sync_run_status_time")
  @@map("sync_runs")
}

model SyncError {
  id        String @id @db.Char(26)
  syncRunId String @db.Char(26)

  /// External record identifier or row number, whichever the source provides.
  rowRef       String? @db.VarChar(128)
  field        String? @db.VarChar(128)
  errorCode    String  @db.VarChar(64)
  errorMessage String  @db.VarChar(1024)
  /// Offending record, with credentials and personal data already redacted.
  payloadJson  Json?

  createdAt DateTime @default(now()) @db.DateTime(3)

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId], map: "ix_sync_error_run")
  @@map("sync_errors")
}

// ===========================================================================
// BULK IMPORT / EXPORT
// ===========================================================================

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  DEAD
  CANCELLED
}

model ImportJob {
  id   String @id @db.Char(26)
  /// e.g. PRODUCTS, INVENTORY, CUSTOMERS.
  type String @db.VarChar(32)

  /// Uploaded CSV/XLSX in the storage driver.
  fileKey  String @db.VarChar(512)
  fileName String @db.VarChar(255)

  /// A dry run produces per-row validation results and writes nothing.
  isDryRun Boolean   @default(true)
  status   JobStatus @default(PENDING)

  totalRows   Int @default(0)
  validRows   Int @default(0)
  errorRows   Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)

  resultJson   Json?
  errorMessage String? @db.VarChar(1024)

  /// Set once a dry run is confirmed, linking preview to the real import.
  confirmedFromJobId String? @db.Char(26)

  createdById String    @db.Char(26)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  startedAt   DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  rowErrors ImportRowError[]

  @@index([type, status, createdAt], map: "ix_import_job_type_status")
  @@map("import_jobs")
}

model ImportRowError {
  id          String @id @db.Char(26)
  importJobId String @db.Char(26)

  rowNumber Int
  field     String? @db.VarChar(128)
  code      String  @db.VarChar(64)
  message   String  @db.VarChar(1024)
  rawJson   Json?

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, rowNumber], map: "ix_import_row_error_job")
  @@map("import_row_errors")
}

model ExportJob {
  id   String @id @db.Char(26)
  type String @db.VarChar(32)

  paramsJson Json
  status     JobStatus @default(PENDING)

  fileKey  String? @db.VarChar(512)
  fileName String? @db.VarChar(255)
  rowCount Int?

  /// Downloads go through a hashed, expiring token. The storage key is never
  /// handed to the browser directly.
  downloadTokenHash String?   @unique(map: "uq_export_download_token") @db.Char(64)
  downloadExpiresAt DateTime? @db.DateTime(3)
  downloadedAt      DateTime? @db.DateTime(3)

  errorMessage String? @db.VarChar(1024)

  createdById String    @db.Char(26)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  @@index([type, status, createdAt], map: "ix_export_job_type_status")
  @@map("export_jobs")
}

// ===========================================================================
// NOTIFICATIONS (transactional outbox)
//
// Business transactions write to notification_outbox in the SAME transaction
// that changes the order/payment. The worker then delivers. That is what stops
// a committed order from silently losing its confirmation email, and stops a
// rolled-back transaction from sending one.
// ===========================================================================

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DEAD
  SUPPRESSED
}

model NotificationOutbox {
  id       String              @id @db.Char(26)
  eventKey String              @db.VarChar(96)
  channel  NotificationChannel @default(EMAIL)

  recipientEmail String? @db.VarChar(320)
  recipientPhone String? @db.VarChar(32)
  recipientName  String? @db.VarChar(255)

  subject     String @db.VarChar(255)
  body        String @db.LongText
  /// Template variables, already redacted of secrets and payment payloads.
  payloadJson Json?

  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  maxAttempts   Int          @default(5)
  nextAttemptAt DateTime     @default(now()) @db.DateTime(3)

  /// Stops a retried business operation from emailing the same person twice.
  dedupeKey String? @unique(map: "uq_outbox_dedupe_key") @db.VarChar(191)

  lastError String? @db.VarChar(1024)

  relatedType String? @db.VarChar(48)
  relatedId   String? @db.Char(26)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  sentAt    DateTime? @db.DateTime(3)

  deliveries NotificationDelivery[]

  @@index([status, nextAttemptAt], map: "ix_outbox_due")
  @@index([eventKey, createdAt], map: "ix_outbox_event_time")
  @@index([relatedType, relatedId], map: "ix_outbox_related")
  @@map("notification_outbox")
}

model NotificationDelivery {
  id       String @id @db.Char(26)
  outboxId String @db.Char(26)

  provider          String  @db.VarChar(48)
  providerMessageId String? @db.VarChar(191)

  status       String  @db.VarChar(32)
  errorMessage String? @db.VarChar(1024)
  /// Milliseconds spent in the provider call, for latency dashboards.
  durationMs   Int?

  createdAt DateTime @default(now()) @db.DateTime(3)

  outbox NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId], map: "ix_delivery_outbox")
  @@index([createdAt], map: "ix_delivery_time")
  @@map("notification_deliveries")
}

// ===========================================================================
// CONSOLE NOTIFICATIONS
//
// The bell in the Admin Panel's top bar. Distinct from `notification_outbox`
// above, which is mail leaving the building: this is one row per thing that
// happened that a member of staff would want to know about without going
// looking for it - a customer placing an order, first of all.
//
// Two properties the outbox does not have and this needs:
//
//   * Read state is per person, not per row. Several people share one console;
//     one of them opening the bell must not clear the badge for the others.
//     Hence the join table rather than a `readAt` column here.
//   * The text is not stored. The row carries its kind and the values that
//     fill it, and the panel renders the sentence in whatever language the
//     reader has chosen. Freezing English prose at write time would leave a
//     Polish or Greek console permanently half-translated.
// ===========================================================================

/// Whether a console row is a PROBLEM or a piece of NEWS.
///
/// The distinction the bell could not previously draw, and the one the whole
/// resolution lifecycle hangs off. "A customer placed an order" is news: it is
/// true forever, nobody can fix it, and the only sensible way to clear it is
/// for somebody to read it. "A consignment went warm" is a problem: it stays
/// worth acting on until the underlying exception is closed, whether or not
/// anybody has glanced at the bell.
///
/// Counting both the same way is what made a bell that either nagged forever
/// or went quiet the moment somebody looked at it.
enum AdminNotificationClass {
  /// Something happened. Cleared by the reader, per reader.
  INFORMATION
  /// Something is wrong. Cleared by the problem being fixed, for everyone.
  ALERT
}

/// Where an alert stands. Shared across every recipient - see the model.
enum AdminNotificationStatus {
  /// Still worth somebody's attention.
  ACTIVE
  /// The underlying problem is no longer actionable. Kept, never deleted:
  /// "this happened and here is what was done about it" is the record.
  RESOLVED
  /// Retained history with no live meaning - the entity it described is gone.
  ARCHIVED
}

/// What closed an alert. Stored because "who says so" is the first question
/// asked when an alert that should be open is not.
enum AdminNotificationResolutionSource {
  /// The domain entity reached a terminal state, in the same transaction that
  /// moved it. The ordinary path, and the only trustworthy one.
  DOMAIN_EVENT
  /// A member of staff closed it by hand, with a reason and an audit row.
  MANUAL
  /// A sweep found the thing it described no longer exists.
  SYSTEM_SWEEP
  /// A newer occurrence of the same problem replaced it.
  SUPERSEDED
}

/// Whether a human may close this alert from the bell.
///
/// The rule the brief is most insistent about: a manual "resolve" must never
/// become a way to hide an unresolved financial, compliance or inventory
/// inconsistency. So an alert backed by a domain entity that has its own
/// terminal state is DOMAIN_ONLY, and the bell refuses to close it - naming
/// the screen where the real decision is made.
enum AdminNotificationResolutionPolicy {
  /// Only the domain event may resolve it. The bell offers no button.
  DOMAIN_ONLY
  /// An authorised member of staff may close it with a reason.
  MANUAL_ALLOWED
}

model AdminNotification {
  id String @id @db.Char(26)

  /// Dotted event kind, e.g. order.placed. The panel maps this to a phrase;
  /// the catalogue lives in AdminNotificationKind.
  kind String @db.VarChar(48)

  /// News or problem. See the enum - this decides how the row leaves the
  /// badge.
  ///
  /// Defaults to INFORMATION so that every row written before this column
  /// existed keeps behaving exactly as it did: cleared by reading it.
  class AdminNotificationClass @default(INFORMATION)

  /// Where an ALERT stands. Meaningless on an INFORMATION row, which is why
  /// it defaults to ACTIVE and is simply never read for one.
  status AdminNotificationStatus @default(ACTIVE)

  /// What this alert is ABOUT, as opposed to what raised it.
  ///
  /// Deliberately not `dedupeKey`. That one is the identity of one OCCURRENCE
  /// - "the bell for exception 01J...". This is the identity of the PROBLEM -
  /// "anything still open about exception 01J...". They are usually the same
  /// string and sometimes are not: a payment alert is deduped on the failed
  /// transaction and resolved by any success against the order, so one
  /// resolution has to be able to close several occurrences at once.
  ///
  /// Null on an INFORMATION row, which has no problem to resolve.
  resolutionKey String? @db.VarChar(191)

  /// Whether a human may close it from the bell. See the enum.
  resolutionPolicy AdminNotificationResolutionPolicy @default(DOMAIN_ONLY)

  resolvedAt       DateTime?                          @db.DateTime(3)
  /// Null for a resolution nobody signed - a domain event or a sweep.
  resolvedByUserId String?                            @db.Char(26)
  resolutionReason String?                            @db.VarChar(512)
  resolutionSource AdminNotificationResolutionSource?

  /// Which time round this is, for a problem that has come back.
  ///
  /// A resolved alert is never reopened - it is history, and editing history
  /// is how "when was this actually fixed" stops being answerable. A problem
  /// that recurs gets a NEW row with the next occurrence number and its own
  /// dedupe key, so the resolution that was recorded stays recorded and the
  /// new one is actionable on its own terms.
  occurrence Int @default(1)

  /// The values that fill the phrase - customer name, order number, total.
  /// Primitives only, and already free of anything that should not be read by
  /// everyone who can open the bell.
  variablesJson Json?

  /// Where the row leads in the Admin Panel, e.g. /orders/<id>. Null for a
  /// notification with no screen to open, which renders as plain text rather
  /// than as a link that goes nowhere.
  linkPath String? @db.VarChar(255)

  /// Deny-by-default, carried on the row rather than on the endpoint. A
  /// notification about an order is shown only to staff who may read orders,
  /// so the bell cannot become a side channel around the permission model.
  /// Null means every member of staff sees it.
  requiredPermission String? @db.VarChar(64)

  relatedType String? @db.VarChar(48)
  relatedId   String? @db.Char(26)

  /// One row per business event even when the operation is retried - the same
  /// guarantee `notification_outbox.dedupeKey` gives outgoing mail.
  dedupeKey String? @unique(map: "uq_admin_notification_dedupe") @db.VarChar(191)

  createdAt DateTime @default(now()) @db.DateTime(3)

  reads      AdminNotificationRead[]
  resolvedBy User?                  @relation("AdminNotificationResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "ix_admin_notification_time")
  @@index([kind, createdAt], map: "ix_admin_notification_kind_time")
  @@index([relatedType, relatedId], map: "ix_admin_notification_related")
  /// The badge's own query: every live alert, newest first.
  @@index([class, status, createdAt], map: "ix_admin_notification_live")
  /// "What is still open about this problem?" - the lookup every resolution
  /// makes, and the one the reopen policy consults before writing a new row.
  @@index([resolutionKey, status], map: "ix_admin_notification_resolution")
  @@index([resolvedByUserId], map: "ix_admin_notification_resolver")
  @@map("admin_notifications")
}

/// One person's own state on one console row.
///
/// The private half of the lifecycle. Reading and dismissing are facts about
/// a reader; resolving is a fact about the world. Several people share one
/// console, so these two must never be stored in the same place - which is
/// why resolution lives on the notification above and this table holds only
/// what belongs to the caller.
model AdminNotificationRead {
  notificationId String   @db.Char(26)
  userId         String   @db.Char(26)
  readAt         DateTime @default(now()) @db.DateTime(3)

  /// This reader has hidden the row without claiming the problem is fixed.
  ///
  /// The escape hatch for an alert that is somebody else's job. It removes the
  /// row from ONE person's bell and changes nothing about the underlying
  /// problem, which is the distinction the brief is built around: an operator
  /// tidying their own view must not be able to make a temperature excursion
  /// look dealt with.
  ///
  /// Dismissing implies reading - there is no way to dismiss something you
  /// have not been shown - so a dismissal writes both.
  dismissedAt DateTime? @db.DateTime(3)

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId], map: "ix_admin_notification_read_user")
  @@map("admin_notification_reads")
}

// ===========================================================================
// JOB QUEUE (MariaDB-backed; Redis driver is an alternative, not a requirement)
//
// Claiming, without SKIP LOCKED:
//   1. SELECT id FROM job_queue WHERE status = PENDING AND runAt <= now
//      ORDER BY priority DESC, runAt ASC LIMIT n
//   2. For each candidate: UPDATE ... SET status = RUNNING, leaseOwner = ?,
//      leaseExpiresAt = ? WHERE id = ? AND status = PENDING
//   3. Proceed only when affectedRows = 1. Losers move to the next candidate.
// A crashed worker leaves an expired lease, which the reaper returns to PENDING.
// ===========================================================================

model JobQueue {
  id      String @id @db.Char(26)
  queue   String @default("default") @db.VarChar(48)
  /// e.g. notification.send, schedule.run, import.process, payment.reconcile.
  jobType String @db.VarChar(64)

  payloadJson Json

  status   JobStatus @default(PENDING)
  priority Int       @default(0)

  runAt DateTime @default(now()) @db.DateTime(3)

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  leaseOwner     String?   @db.VarChar(64)
  leaseExpiresAt DateTime? @db.DateTime(3)

  lastError String? @db.Text

  /// Optional application-level dedupe, e.g. one reconcile job per order.
  dedupeKey String? @unique(map: "uq_job_dedupe_key") @db.VarChar(191)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  startedAt   DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  /// The claim query. Order matters: status first, then runAt.
  @@index([status, runAt, priority], map: "ix_job_claim")
  @@index([queue, status], map: "ix_job_queue_status")
  @@index([leaseExpiresAt], map: "ix_job_lease_reaper")
  @@index([jobType, status], map: "ix_job_type_status")
  @@map("job_queue")
}

model RateLimitBucket {
  /// Composite of scope and subject, e.g. login:ip:203.0.113.7.
  bucketKey String @id @db.VarChar(191)

  counter     Int      @default(0)
  windowStart DateTime @db.DateTime(3)
  expiresAt   DateTime @db.DateTime(3)

  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([expiresAt], map: "ix_rate_limit_expires")
  @@map("rate_limit_buckets")
}

// ===========================================================================
// AUDIT
//
// Append-oriented: the application never issues UPDATE or DELETE here. Grant
// the application database user INSERT and SELECT only on this table in
// production, so a compromised service cannot rewrite its own trail.
// ===========================================================================

model AuditLog {
  id String @id @db.Char(26)

  actorType   ActorType @default(SYSTEM)
  actorUserId String?   @db.Char(26)
  actorEmail  String?   @db.VarChar(320)

  /// Dotted verb, e.g. product.published, refund.created, connector.updated.
  action       String  @db.VarChar(96)
  resourceType String  @db.VarChar(48)
  resourceId   String? @db.Char(26)

  /// Redacted before write: no password hashes, tokens, provider secrets or
  /// raw payment payloads ever reach these columns.
  beforeJson Json?
  afterJson  Json?

  ipAddress     String? @db.VarChar(45)
  userAgent     String? @db.VarChar(512)
  correlationId String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.DateTime(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt], map: "ix_audit_resource")
  @@index([actorUserId, createdAt], map: "ix_audit_actor")
  @@index([action, createdAt], map: "ix_audit_action")
  @@index([createdAt], map: "ix_audit_time")
  @@map("audit_logs")
}

// ===========================================================================
// SEQUENCES
//
// Order numbers must be gap-tolerant but never duplicated. A dedicated counter
// row is incremented with UPDATE ... SET value = value + 1 (an atomic InnoDB
// row lock) and read back inside the same transaction.
// ===========================================================================

model NumberSequence {
  /// e.g. order:2026, invoice:2026.
  key     String @id @db.VarChar(64)
  value   BigInt @default(0)
  prefix  String @db.VarChar(16)
  /// Zero-padding width for the numeric part.
  padding Int    @default(6)

  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@map("number_sequences")
}

// ===========================================================================
// LOCALISATION, CURRENCY & PRICING
//
// The catalogue is genuinely multi-currency: a product carries a real price per
// currency, set by staff, never a rate conversion of a base price. A converted
// figure drifts with the rate and would mean the customer is charged something
// other than the number on the page - the one thing `domain/pricing.ts` exists
// to prevent.
//
// A currency the product has no row for is a currency it cannot be sold in.
// That is deliberate: falling back to the base price would quietly sell a
// ¥5,000 item for $5,000.
// ===========================================================================

model Currency {
  /// ISO-4217 alphabetic code. Must also appear in `domain/money.ts`
  /// CURRENCY_EXPONENT, or every amount in it fails to parse.
  code   String @id @db.Char(3)
  name   String @db.VarChar(64)
  /// Display symbol, e.g. "₹", "$", "€". Prefixed to the formatted amount.
  symbol String @db.VarChar(8)

  /// Minor units per major unit: 2 for INR/USD, 0 for JPY/KRW. Mirrors
  /// CURRENCY_EXPONENT so the database and the money module cannot disagree;
  /// a mismatch is rejected at boot.
  exponent Int @default(2)

  /// The business's own reporting currency. Exactly one row may set this.
  isBase    Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  countries      Country[]
  productPrices  ProductPrice[]
  couponMinimums CouponMinimum[]
  customerLimits CustomerLimit[]

  @@index([isActive, sortOrder], map: "ix_currency_active_sort")
  @@map("currencies")
}

model Country {
  /// ISO-3166-1 alpha-2, upper case. Matches `addresses.country`.
  code String @id @db.Char(2)
  name String @db.VarChar(96)

  /// What a visitor from here is shown by default. They may still switch to any
  /// other active currency - this is a starting point, not a restriction.
  currencyCode String @db.Char(3)

  /// E.164 dialling prefix, e.g. "+91". Display only.
  phonePrefix String? @db.VarChar(8)

  /// The interface language somebody working in this country reads, as a BCP-47
  /// primary subtag. The admin console adopts it for a member of staff whose
  /// sign-in resolved to this country, which is what puts a German panel in
  /// front of somebody signing in from Berlin without them touching a picker.
  ///
  /// A column rather than a hard-coded map, and for the same reason
  /// `currencyCode` is one: it is a starting point a deployment corrects in a
  /// row, not a fact of geography. Belgium is the obvious case - a Brussels
  /// office may read French where an Antwerp one reads Dutch. Null is the
  /// honest answer for a country whose language the panel ships no catalogue
  /// for, and it means "leave this person's own choice alone", never "English".
  languageCode String? @db.VarChar(8)

  /// Whether this country is inside the EU VAT area. Not the same as EU
  /// membership, which is why it is a stored flag rather than a hard-coded
  /// list: the Canary Islands and Ceuta are Spain but outside it, Livigno is
  /// Italy but outside it, Monaco is not the EU but is treated as France for
  /// VAT, and Northern Ireland is a third case again. A deployment that gets
  /// one of these wrong should be able to fix it in a row, not a release.
  isEuVat Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  currency   Currency            @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  warehouses InventoryLocation[]

  @@index([isActive, sortOrder], map: "ix_country_active_sort")
  @@index([currencyCode], map: "ix_country_currency")
  @@map("countries")
}

model ProductPrice {
  id        String  @id @db.Char(26)
  productId String  @db.Char(26)
  variantId String? @db.Char(26)

  /// The variant ULID, or '' for the base product. Never null, because a MySQL
  /// UNIQUE index treats every NULL as distinct and a nullable variantId would
  /// therefore permit duplicate prices for the same SKU and currency.
  variantKey String @default("") @db.VarChar(26)

  currencyCode String @db.Char(3)

  basePriceMinor      BigInt
  /// Optional strike-through price. Must be >= basePriceMinor, enforced in the
  /// service rather than the schema so the message can name the field.
  compareAtPriceMinor BigInt?

  /// True when this figure is maintained by the exchange-rate refresh rather
  /// than typed by a person.
  ///
  /// The whole point of the flag is what it protects: editing a price by hand
  /// clears it, and the refresh only ever touches rows that still carry it. A
  /// deliberate local price - a market where the business undercuts its own
  /// conversion, or absorbs a duty - must never be undone by a rate moving.
  isAutoConverted Boolean @default(false)

  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedById String?  @db.Char(26)

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currency Currency        @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  /// One price per SKU per currency.
  @@unique([productId, variantKey, currencyCode], map: "uq_product_price_sku_currency")
  @@index([currencyCode, basePriceMinor], map: "ix_product_price_currency_amount")
  @@index([variantId], map: "ix_product_price_variant")
  @@map("product_prices")
}

// ===========================================================================
// EXCHANGE RATES
//
// What a rate feed said, kept.
//
// Before these tables the refresh job fetched rates, converted prices with
// them and threw the rates away. That works right up until somebody asks why
// an order was priced the way it was, and then there is no answer: the prices
// moved, nothing recorded what moved them, and a disputed total cannot be
// reconstructed from anything in the database.
//
// TWO TABLES, BECAUSE A FETCH IS THE UNIT OF TRUST
//
// A provider publishes a LIST for a date. Mixing Friday's zloty with Monday's
// dollar produces a cross-rate that never existed anywhere, so the list is the
// thing that gets validated and activated, not the row. `exchange_rate_snapshots`
// is one fetch; `exchange_rates` are its rows; and exactly one snapshot per
// provider is active at a time.
//
// APPEND-ONLY
//
// Nothing updates a rate row, ever. A snapshot's `isActive`/`activeProvider`
// move and its validation verdict is written once; the rates themselves are
// written at insert and never touched. An order that points at a snapshot is
// pointing at a fact, which is the entire reason this exists.
// ===========================================================================

/// Whether the fetch itself worked.
enum FxRetrievalStatus {
  /// The provider answered and the body parsed.
  FETCHED
  /// The provider could not be reached, timed out, or answered unusably.
  FAILED
}

/// Whether the fetched list is fit to price with.
///
/// Separate from retrieval because they fail for different reasons and want
/// different responses. A feed that times out is an operations problem that
/// fixes itself; a feed that answers promptly with a decimal shifted one place
/// is a catalogue-wide mispricing, and the only safe response is to keep the
/// previous list and tell somebody.
enum FxValidationStatus {
  /// Fetched, not yet checked. A row should not stay here long.
  PENDING
  /// Checked against the currencies in use and the previous snapshot.
  VALID
  /// Checked and refused. `failureReason` says why, in words a person reads.
  REJECTED
}

/// One fetch from one provider.
model ExchangeRateSnapshot {
  id String @id @db.Char(26)

  /// Which adapter produced this - "ecb", "json". Stored rather than derived
  /// from configuration, because configuration changes and an order that
  /// points here must still be able to say where its number came from.
  provider String @db.VarChar(32)

  /// What every rate in this snapshot is quoted against. EUR for the ECB, and
  /// not assumed anywhere: `domain/fx.ts` crosses through whatever this says.
  pivotCurrency String @db.Char(3)

  /// The date the PROVIDER says these rates are for.
  ///
  /// Not when we fetched them. The ECB publishes on working days, so a Sunday
  /// fetch legitimately carries Friday's date, and every freshness decision in
  /// the system reads this column rather than `fetchedAt`. Rewriting it to now
  /// would make a stale set look current to the checkout gate, which is the
  /// one place that must never be fooled.
  asOf DateTime @db.DateTime(3)

  /// When UBOSS received it. The pair (asOf, fetchedAt) is what tells an
  /// operator whether the feed is late or the rates are simply old.
  fetchedAt DateTime @default(now()) @db.DateTime(3)

  /// Where it came from, for the audit trail: a URL and the document's date.
  /// Never a credential, never a response body.
  sourceReference String @db.VarChar(512)

  retrievalStatus  FxRetrievalStatus  @default(FETCHED)
  validationStatus FxValidationStatus @default(PENDING)

  /// Why this snapshot was refused or could not be fetched, in words a person
  /// reads on the settings screen. Never carries a key, a header or a body.
  failureReason String? @db.VarChar(512)

  /// How many rates it carries, and how many rows it saw and refused. The
  /// second number is the one that catches a feed degrading quietly.
  rateCount     Int @default(0)
  rejectedCount Int @default(0)

  /// The largest move against the previously active snapshot, as a percentage,
  /// and the currency that moved most. Null on the first snapshot, which has
  /// nothing to compare against.
  maxDriftPercent  Decimal? @db.Decimal(9, 4)
  maxDriftCurrency String?  @db.Char(3)

  /// True for the snapshot currently being priced from.
  isActive Boolean @default(false)

  /// The provider name while this snapshot is active, and NULL once it is not.
  ///
  /// The same mechanism as `LogisticsDriverAssignment.activeShipmentId`, used
  /// for the same reason: MariaDB has no partial indexes but treats every NULL
  /// in a UNIQUE index as distinct, so `uq_fx_snapshot_active_provider` permits
  /// any number of retired snapshots and exactly one live one per provider.
  ///
  /// It is a database constraint rather than a rule in a service because a rule
  /// in a service loses a race: two workers that both read "nothing is active"
  /// would both activate, and the catalogue would be priced from whichever won
  /// the last write - with no record that there had been a contest.
  ///
  /// Written only alongside `isActive`: set together, cleared together.
  activeProvider String? @db.VarChar(32)

  activatedAt DateTime? @db.DateTime(3)
  retiredAt   DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  rates  ExchangeRate[]
  orders Order[]

  @@unique([activeProvider], map: "uq_fx_snapshot_active_provider")
  /// The read path: the live set for a provider.
  @@index([provider, isActive], map: "ix_fx_snapshot_active")
  /// The history screen, and the pruner.
  @@index([provider, asOf], map: "ix_fx_snapshot_provider_asof")
  @@index([validationStatus, fetchedAt], map: "ix_fx_snapshot_validation")
  @@map("exchange_rate_snapshots")
}

/// One quoted pair inside one snapshot. Never updated.
model ExchangeRate {
  id         String @id @db.Char(26)
  snapshotId String @db.Char(26)

  /// Denormalised from the snapshot's pivot so a single row is readable on its
  /// own - an order's audit trail quotes one of these, not a join.
  baseCurrency  String @db.Char(3)
  quoteCurrency String @db.Char(3)

  /// How many `quoteCurrency` one `baseCurrency` buys.
  ///
  /// `Decimal(24, 12)`, matching `RATE_SCALE_DP` in `domain/fx.ts`. Twelve
  /// places rather than eight because a cross-rate is a division and dividing
  /// two eight-place numbers loses a digit; the four spare places keep the
  /// result exact to the eight that are actually quoted with.
  rate Decimal @db.Decimal(24, 12)

  createdAt DateTime @default(now()) @db.DateTime(3)

  snapshot ExchangeRateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// One rate per currency per snapshot.
  @@unique([snapshotId, quoteCurrency], map: "uq_exchange_rate_snapshot_currency")
  @@index([quoteCurrency, createdAt], map: "ix_exchange_rate_currency_time")
  @@map("exchange_rates")
}

// ===========================================================================
// COUPONS
//
// A percentage discount, optionally narrowed to a set of categories, that
// unlocks once the cart is worth enough. Staff author them; the storefront
// lists the public ones on the cart and accepts a typed code for the rest.
//
// Two rules shape the tables:
//
//   * The qualifying threshold is per currency. "Works above 5,000" cannot mean
//     the same thing in INR and USD, and converting one from the other would
//     make the rule drift with the exchange rate. A coupon has no threshold in
//     a currency it was never given one for, and therefore does not apply in it.
//
//   * A redemption is a row, not a counter. `usageCount` on the coupon is a
//     cache for listing screens; `coupon_redemptions` is the truth, with a
//     unique index on orderId so a retried checkout cannot double-count.
// ===========================================================================

enum CouponScope {
  /// Applies to every line in the cart.
  ALL_PRODUCTS
  /// Applies only to lines whose product sits in one of `categories`.
  CATEGORIES
}

enum CouponStatus {
  /// Authored but not yet live. Never matches, never listed.
  DRAFT
  ACTIVE
  /// Switched off by staff. Kept for its redemption history.
  DISABLED
}

model Coupon {
  id String @id @db.Char(26)

  /// What the customer types. Generated on create, then editable by staff.
  /// Compared case-insensitively; stored upper case so the unique index bites.
  code String @unique(map: "uq_coupon_code") @db.VarChar(32)

  /// Internal label for the admin list. Not shown to customers.
  name        String  @db.VarChar(128)
  /// Customer-facing line in the "available coupons" list on the cart.
  description String? @db.VarChar(255)

  /// Percent off, Decimal never Float. 10.00 = 10%. Capped at 100 in the service.
  discountPercent Decimal @db.Decimal(5, 2)

  scope  CouponScope  @default(ALL_PRODUCTS)
  status CouponStatus @default(DRAFT)

  /// Shown in the storefront's coupon list. A false here makes the coupon
  /// code-only: it still works when typed, it just is not advertised.
  isPubliclyListed Boolean @default(true)

  /// Null on either side means open-ended.
  validFrom  DateTime? @db.DateTime(3)
  validUntil DateTime? @db.DateTime(3)

  /// Null = unlimited. `usageCount` is maintained alongside redemptions.
  usageLimit       Int?
  perCustomerLimit Int?
  usageCount       Int  @default(0)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  archivedAt  DateTime? @db.DateTime(3)
  createdById String?   @db.Char(26)
  updatedById String?   @db.Char(26)

  categories  CouponCategory[]
  minimums    CouponMinimum[]
  redemptions CouponRedemption[]
  carts       Cart[]

  @@index([status, validFrom, validUntil], map: "ix_coupon_live")
  @@index([status, isPubliclyListed], map: "ix_coupon_listed")
  @@map("coupons")
}

model CouponCategory {
  couponId   String @db.Char(26)
  categoryId String @db.Char(26)

  /// Include products in descendant categories too. A coupon on "Packaging"
  /// almost always means the whole branch.
  includeDescendants Boolean @default(true)

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId], map: "ix_coupon_category_category")
  @@map("coupon_categories")
}

model CouponMinimum {
  couponId     String @db.Char(26)
  currencyCode String @db.Char(3)

  /// Cart subtotal, before discount and before tax, at or above which the
  /// coupon applies. Zero means no threshold in this currency.
  minOrderMinor BigInt @default(0)

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@id([couponId, currencyCode])
  @@map("coupon_minimums")
}

model CouponRedemption {
  id                String  @id @db.Char(26)
  couponId          String  @db.Char(26)
  orderId           String  @db.Char(26)
  customerProfileId String? @db.Char(26)

  /// Snapshots. The coupon's percent may be edited later; what this order
  /// actually received must not move.
  codeSnapshot            String  @db.VarChar(32)
  discountPercentSnapshot Decimal @db.Decimal(5, 2)
  currencyCode            String  @db.Char(3)
  discountMinor           BigInt

  redeemedAt DateTime @default(now()) @db.DateTime(3)

  coupon          Coupon           @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)

  /// One redemption per order. A retried checkout collides here rather than
  /// counting the coupon twice.
  @@unique([orderId], map: "uq_coupon_redemption_order")
  @@index([couponId, redeemedAt], map: "ix_coupon_redemption_coupon")
  @@index([customerProfileId, couponId], map: "ix_coupon_redemption_customer")
  @@map("coupon_redemptions")
}

/**
 * Purchasing limits, per currency.
 * These are plain amounts, and an amount means nothing without the currency it
 * is counted in: a 5,000 rupee minimum read against a dollar cart becomes a
 * 5,000 dollar one. They used to live as bare columns on `customer_profiles`,
 * implicitly in the base currency, which was correct only while the catalogue
 * sold in one.
 * A row per market a customer is allowed to buy in. No row means no agreed
 * terms in that currency, and an account that carries limits anywhere may only
 * order where it has them - dropping a credit control because the shopper
 * switched currency is worse than refusing the order.
 * `requiresOrderApproval` stays on the profile: whether an account needs
 * sign-off is a policy about the account, not an amount.
 */
model CustomerLimit {
  customerProfileId String @db.Char(26)
  currencyCode      String @db.Char(3)

  /// Null on any of these means that particular rule imposes no limit here.
  perOrderMinMinor       BigInt?
  perOrderMaxMinor       BigInt?
  monthlySpendCapMinor   BigInt?
  /// Order total at or above which approval is required, when approvals are on.
  approvalThresholdMinor BigInt?

  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedById String?  @db.Char(26)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  currency        Currency        @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@id([customerProfileId, currencyCode])
  @@index([currencyCode], map: "ix_customer_limit_currency")
  @@map("customer_limits")
}

// ===========================================================================
// STOREFRONT ASSISTANT
//
// The chat widget asks a visitor for a name, a mobile number and an email
// before it will answer anything, and every conversation is kept: an enquiry
// about a 22G safety cannula from a hospital buyer is a sales lead, and a lead
// that exists only in the visitor's browser is a lead nobody follows up.
//
// Two things this deliberately does NOT do:
//   * It does not create a User or a CustomerProfile. A visitor who typed
//     three fields into a chat panel has not registered, has set no password
//     and has agreed to nothing. `customerProfileId` is filled in only when
//     the address already belongs to a customer, so staff can see the
//     enquiry came from an existing account without one being invented.
//   * It does not trust the browser with the transcript. The widget holds a
//     conversation id and an opaque token; the turns themselves live here, so
//     what an administrator reads is what the model was actually sent and what
//     it actually answered.
// ===========================================================================

model AssistantConversation {
  id String @id @db.Char(26)

  /// HISTORICAL ONLY. The widget used to ask a visitor for a name, a mobile
  /// number and an email before it would answer anything. It no longer does,
  /// and nothing written from here on fills these in.
  ///
  /// Nullable rather than dropped: the rows that already carry them are
  /// somebody's enquiry, and deleting personal data ahead of its retention
  /// window is not a migration's decision to make. The sweep in
  /// `retention.service.ts` is what clears them, on the schedule it always had.
  ///
  /// Never verified even where present - nothing was ever confirmed by an
  /// email or an OTP. Who a conversation belongs to is now `customerProfileId`
  /// below, which is an authenticated fact rather than a typed claim.
  visitorName            String? @db.VarChar(120)
  visitorPhone           String? @db.VarChar(32)
  visitorEmail           String? @db.VarChar(320)
  /// Lowercased/trimmed, for grouping repeat enquiries from one address.
  /// Not unique: the same buyer may come back with a different question.
  visitorEmailNormalized String? @db.VarChar(320)

  /// HISTORICAL ONLY, for the same reason. SHA-256 of the opaque token the old
  /// guest widget held - the one thing that separated one anonymous visitor's
  /// conversation from another's on an endpoint with no session. The endpoint
  /// has a session now, so the owner below is the authorisation and no second
  /// bearer secret is minted.
  sessionTokenHash String? @db.Char(64)

  /// Who this conversation belongs to. Set on every row the signed-in widget
  /// creates, and the only thing `/assistant/chat` authorises against.
  ///
  /// Still nullable, and it has to be: a historical row from the guest widget
  /// has no owner unless the typed address happened to match an account, and
  /// the foreign key is ON DELETE SET NULL so erasing a customer does not take
  /// the record that an enquiry happened with them.
  customerProfileId String? @db.Char(26)

  /// What the customer calls this conversation in their own history list.
  ///
  /// Nullable, and usually stays that way: the AI Mode sidebar falls back to
  /// the opening question, which is a better label than anything generated
  /// and costs no provider call to produce. It is set only when somebody
  /// renames a thread by hand.
  ///
  /// Not indexed. A customer has tens of conversations, not thousands, and the
  /// list is already narrowed to one owner by
  /// `ix_assistant_conversation_customer`.
  title String? @db.VarChar(120)

  /// When the customer removed this conversation from their own history.
  ///
  /// A soft delete, deliberately. The transcript is a record of what this
  /// deployment's AI told a buyer about a medical device; a customer tidying
  /// their sidebar is not a reason to destroy it. Staff still read it under
  /// Enquiries, and the retention sweep is what eventually clears it.
  ///
  /// What the flag does guarantee is exactly what was asked for: the
  /// conversation is gone from every customer-facing read, and the assistant
  /// refuses to continue it. Erasure under Art. 17 is a different act with a
  /// different route, and that one still deletes the rows outright.
  hiddenAt DateTime? @db.DateTime(3)

  /// Denormalised so the enquiry list can be ordered and read without loading
  /// every transcript.
  messageCount  Int       @default(0)
  lastMessageAt DateTime? @db.DateTime(3)

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)

  messages AssistantMessage[]

  @@index([createdAt], map: "ix_assistant_conversation_created")
  @@index([visitorEmailNormalized, createdAt], map: "ix_assistant_conversation_email")
  @@index([customerProfileId], map: "ix_assistant_conversation_customer")
  @@map("assistant_conversations")
}

enum AssistantMessageRole {
  VISITOR
  ASSISTANT
}

model AssistantMessage {
  id             String @id @db.Char(26)
  conversationId String @db.Char(26)

  role    AssistantMessageRole
  content String               @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "ix_assistant_message_conversation")
  @@map("assistant_messages")
}

/// A product's name and copy in one language.
///
/// A side table rather than name_pl, name_el … columns on `products`: a new
/// language is a row here, not a migration, and "no translation yet" is the
/// absence of a row rather than a column full of NULLs. The catalogue falls
/// back to the base row on `products` for anything missing, exactly as the
/// interface falls back to English for a missing key.
///
/// Deliberately not here: `slug` and `sku`. The slug is one URL for all
/// languages - this is an ordering system reached by link, not a public SEO
/// site - and a SKU is an identifier, not prose.
model ProductTranslation {
  id        String @id @db.Char(26)
  productId String @db.Char(26)

  /// BCP-47 primary subtag, matching the interface languages.
  language String @db.VarChar(10)

  name             String  @db.VarChar(255)
  shortDescription String? @db.VarChar(1024)
  description      String? @db.Text

  /// GPSR Art. 19(d) requires warnings "in a language which can be easily
  /// understood by consumers", which for a storefront in eight languages means
  /// the one the reader picked. Null falls back to the base row, exactly like
  /// the description above - and the admin panel reports that fallback as a
  /// gap rather than as a translation.
  safetyWarnings     String? @db.Text
  safetyInstructions String? @db.Text

  /// MDR Art. 10(11): what the device is for. Translated for the same reason
  /// the warnings are - an intended purpose the reader cannot read has not
  /// been stated to them.
  intendedPurpose String? @db.Text

  /// Kept alongside the copy so a translated page can carry its own title.
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(512)

  /// True when a person has checked this row. Machine output ships, but the
  /// admin panel has to be able to show what nobody has read yet.
  isReviewed Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language], map: "uq_product_translation")
  @@index([language], map: "ix_product_translation_language")
  /// Search reads translated names, so the column it filters on is indexed.
  @@index([name], map: "ix_product_translation_name")
  @@map("product_translations")
}

/// A category's name and copy in one language. Same shape and same reasoning
/// as ProductTranslation.
model CategoryTranslation {
  id         String @id @db.Char(26)
  categoryId String @db.Char(26)

  language String @db.VarChar(10)

  name        String  @db.VarChar(255)
  description String? @db.Text

  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(512)

  isReviewed Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language], map: "uq_category_translation")
  @@index([language], map: "ix_category_translation_language")
  @@map("category_translations")
}

// ===========================================================================
// DATA PROTECTION (GDPR)
//
// A data subject request is a clock, not a task list. Art. 12(3) gives the
// controller one month from receipt, so every request carries the date it
// falls due and the console sorts by it - a queue ordered by "oldest first"
// tells you nothing about which one is about to be late.
//
// Fulfilment is a job rather than a request handler. Assembling everything one
// account has ever touched reads a dozen tables, and erasing it rewrites them
// in a single transaction; neither belongs on the end of an HTTP connection.
// ===========================================================================

enum DataRequestType {
  /// Art. 15 access and Art. 20 portability. Two distinct rights that are
  /// satisfied by the same machine-readable bundle, so they share a type.
  EXPORT

  /// Art. 17 erasure. Never a row delete - see `erasure.service.ts` for why
  /// the order history has to survive in pseudonymised form.
  ERASURE
}

enum DataRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  /// Art. 12(5) and 17(3): a refusal has to say why, and the reason is part of
  /// the record because the subject may take it to a supervisory authority.
  REJECTED

  FAILED
}

model DataRequest {
  id String @id @db.Char(26)

  /// The data subject. The email is duplicated out of `users` on purpose: an
  /// erasure scrubs that row, and this record must still name who was erased
  /// well enough to answer "did you action my request?" months later. It is
  /// itself scrubbed to a pseudonym when the erasure runs.
  subjectUserId String @db.Char(26)
  subjectEmail  String @db.VarChar(320)

  type   DataRequestType
  status DataRequestStatus @default(PENDING)

  requestedAt DateTime @default(now()) @db.DateTime(3)

  /// Art. 12(3). Set to requestedAt + one month when the request is opened.
  dueAt DateTime @db.DateTime(3)

  completedAt DateTime? @db.DateTime(3)

  /// Free text from the subject. Never trusted as an instruction - a request
  /// asking for something the law does not grant is still only a request.
  subjectNote String? @db.VarChar(1024)

  /// Why a request was refused, or which exemption was relied on. Required by
  /// the service whenever status is REJECTED.
  decisionNote String? @db.VarChar(1024)

  /// Who actioned it. Null while PENDING, and for exports, which fulfil
  /// themselves - the subject is already authenticated, and making a person
  /// press a button before someone may read their own data adds delay without
  /// adding a check.
  handledById String?   @db.Char(26)
  handledAt   DateTime? @db.DateTime(3)

  /// The export bundle. Same hashed, expiring, single-purpose token as
  /// `export_jobs`: this file is every personal fact the system holds about
  /// one person, so a guessable or permanent URL would be the worst possible
  /// leak.
  fileKey           String?   @db.VarChar(512)
  fileName          String?   @db.VarChar(255)
  downloadTokenHash String?   @unique(map: "uq_data_request_download_token") @db.Char(64)
  downloadExpiresAt DateTime? @db.DateTime(3)
  downloadedAt      DateTime? @db.DateTime(3)

  errorMessage String? @db.VarChar(1024)

  /// What the erasure actually did, per table, as counts. Evidence for Art. 5(2)
  /// accountability: "the account was erased" is a claim, and this is the
  /// record that supports it.
  resultJson Json?

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([status, dueAt], map: "ix_data_request_due")
  @@index([subjectUserId, requestedAt], map: "ix_data_request_subject")
  @@index([type, status], map: "ix_data_request_type_status")
  @@map("data_requests")
}

// ===========================================================================
// EU VAT
//
// The tax model this system started with is a flat percentage per product -
// correct for Indian GST, where the rate travels with the goods. EU VAT does
// not work that way: the rate depends on where the customer is, whether they
// are a business, and whether they hold a VAT number the other member state
// will recognise. The same box of syringes is 21% to a Dutch hospital, 0% to a
// German wholesaler with a valid VAT ID, and 0% again to a buyer in Norway -
// for three different legal reasons, and an invoice has to state which.
//
// So the flat rate stays and is still what a non-EU deployment uses, and this
// section sits beside it. A tax class with no `vatCategory` behaves exactly as
// it always did. One with a category is resolved against the destination
// country at pricing time - see `modules/tax/vat.service.ts`.
// ===========================================================================

/// Which of a member state's rate bands a product falls in.
///
/// Deliberately the bands rather than the numbers. Every member state sets its
/// own percentages and changes them on its own schedule; what is stable is
/// that a given product is "the standard rate here" or "the reduced rate
/// here". Storing the band on the tax class and the percentage per country is
/// what lets one catalogue be sold into twenty-seven of them.
enum VatCategory {
  STANDARD

  /// Annex III of Directive 2006/112/EC. Most member states have one or two.
  REDUCED

  /// The "super-reduced" band a few states kept under Art. 98(2).
  SUPER_REDUCED

  /// Taxable at 0%, with input VAT still recoverable.
  ZERO

  /// Exempt without the right to deduct - e.g. Art. 132 medical care.
  /// Distinct from ZERO because the invoice wording and the seller's own VAT
  /// return differ, even though the customer pays the same nothing.
  EXEMPT
}

/// Why an order was taxed the way it was.
///
/// Recorded on the order rather than derived at read time: rates change, VAT
/// numbers get cancelled, and a member state can leave. What an invoice says
/// must stay true, and the only way to guarantee that is to freeze the
/// reasoning alongside the numbers.
enum TaxTreatment {
  /// No EU VAT resolution ran. The flat tax-class rate applied - Indian GST,
  /// or any deployment that has not configured VAT rates.
  FLAT_RATE

  /// Seller and customer in the same member state. That state's rate.
  DOMESTIC

  /// Intra-Community supply to a business holding a valid VAT number in
  /// another member state. Zero-rated, and the customer accounts for the tax
  /// themselves. Arts. 138 and 196.
  INTRA_EU_REVERSE_CHARGE

  /// Intra-Community distance sale to someone with no valid VAT number.
  /// Charged at the DESTINATION state's rate and declared through the One Stop
  /// Shop. Art. 33.
  INTRA_EU_B2C

  /// Goods leaving the Union. Zero-rated under Art. 146, on the condition that
  /// the seller can prove they left - a paperwork obligation this software
  /// records but cannot discharge.
  EXPORT
}

/// One rate band, in one country, for a period of time.
///
/// Dated rather than a single current value, because a rate change is not an
/// edit. Germany dropped its standard rate to 16% for six months in 2020, and
/// an invoice raised in that window is still correct at 16% forever. Repricing
/// history because a rate moved would falsify every document already issued.
model VatRate {
  id String @id @db.Char(26)

  /// ISO-3166-1 alpha-2, matching `countries.code`. Not a foreign key: VAT
  /// territory and country are not the same thing, and rows exist for codes
  /// the storefront does not sell into.
  countryCode String      @db.Char(2)
  category    VatCategory

  /// Percent, e.g. 21.000000. Decimal, never Float - see money.ts.
  ratePercent Decimal @db.Decimal(9, 6)

  /// A human label for the band, e.g. "Reduced - medical devices". Shown to
  /// staff, so a catalogue manager choosing a tax class can tell which of two
  /// reduced bands they mean.
  label String? @db.VarChar(128)

  validFrom DateTime  @db.Date
  /// Null means "still in force". Exactly one open-ended row per country and
  /// category is the expected shape; the service takes the latest that has
  /// started if that is ever violated.
  validTo   DateTime? @db.Date

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([countryCode, category, validFrom], map: "uq_vat_rate_period")
  @@index([countryCode, category, validFrom], map: "ix_vat_rate_lookup")
  @@map("vat_rates")
}

/// A VAT number that has been checked, and what the check said.
///
/// Cached, because VIES is federated - each member state answers for its own
/// numbers - and is regularly slow or simply down for one country. A checkout
/// must not fail because Italy's node is having an afternoon, so a recent
/// answer is reused and a missing one degrades to "unverified" rather than to
/// an error.
///
/// The consultation number matters more than it looks. Art. 31 of Regulation
/// 904/2010 lets a seller rely on a VIES answer, and the reference VIES
/// returns is the proof they relied on it. Without it, a zero-rated supply to
/// a customer whose number is later found invalid becomes the seller's tax
/// bill.
model VatNumberCheck {
  id String @id @db.Char(26)

  /// The member state prefix and the number, stored apart because VIES takes
  /// them as separate arguments and because the prefix decides which state is
  /// being asked.
  countryCode String @db.Char(2)
  number      String @db.VarChar(32)

  isValid Boolean

  /// What the member state returned for the holder, when it returns anything.
  /// Several answer with a name and address; several answer "---" as a matter
  /// of policy. Both are recorded as given.
  registeredName    String? @db.VarChar(255)
  registeredAddress String? @db.VarChar(512)

  /// The VIES consultation reference. Art. 31 of Reg. 904/2010 evidence.
  consultationNumber String? @db.VarChar(64)

  /// Set when no answer could be obtained at all - a timeout, a member state's
  /// node being down. Distinct from `isValid = false`, which is a real answer
  /// meaning "no such number".
  unavailableReason String? @db.VarChar(255)

  checkedAt DateTime @default(now()) @db.DateTime(3)

  @@unique([countryCode, number], map: "uq_vat_number_check")
  @@index([checkedAt], map: "ix_vat_number_check_time")
  @@map("vat_number_checks")
}

// ===========================================================================
// INVOICING
//
// An invoice is not a view of an order. Art. 226 of Directive 2006/112/EC
// lists what one must contain, national law requires it be kept for six to ten
// years, and it must not change afterwards - not when the customer moves, not
// when a rate changes, not when a product is renamed. So everything it says is
// frozen into this row at the moment it is issued, and nothing here has an
// update path.
// ===========================================================================

model Invoice {
  id String @id @db.Char(26)

  /// Art. 226(2): "a sequential number, based on one or more series, which
  /// uniquely identifies the invoice". Allocated from `number_sequences` under
  /// a row lock, so two concurrent issues cannot collide.
  number String @unique(map: "uq_invoice_number") @db.VarChar(32)
  series String @default("INV") @db.VarChar(16)

  /// Not unique. An order has at most one invoice, but it may also have the
  /// credit note that cancels it, and both point here - a credit note belongs
  /// to the same supply as the document it reverses. "At most one live
  /// invoice" is enforced in the service, where the condition
  /// (creditsInvoiceId IS NULL) can actually be expressed.
  orderId String @db.Char(26)

  /// Art. 226(1). The date of issue, which is not necessarily the date of
  /// supply - both are recorded, because the two can fall in different VAT
  /// periods.
  issuedAt   DateTime @default(now()) @db.DateTime(3)
  suppliedAt DateTime @db.DateTime(3)

  /// Art. 226(3)-(5): the seller's and the customer's identities and VAT
  /// numbers, as they were. Snapshots, because a business that changes its
  /// registered address does not change the invoices it has already issued.
  sellerJson Json
  buyerJson  Json

  sellerVatNumber String? @db.VarChar(32)
  buyerVatNumber  String? @db.VarChar(32)

  /// Why this was taxed the way it was, carried from the order.
  taxTreatment TaxTreatment
  /// The member state whose rates were applied. Null under FLAT_RATE.
  taxCountry   String?      @db.Char(2)

  /// Art. 226(11): where no VAT is charged, the invoice must say which
  /// provision it relies on. Rendered from the treatment and frozen here, so
  /// the wording on a reprint is the wording that was issued.
  exemptionNote String? @db.VarChar(512)

  currency String @db.Char(3)

  /// Art. 226(6)-(10): the lines, with quantity, unit price, rate and amount.
  /// A JSON snapshot rather than a relation to `order_items`, which stay
  /// editable in principle and would silently rewrite an issued document.
  linesJson Json

  /// Art. 226(8)-(10): the taxable amount per rate, and the tax at each. An
  /// invoice mixing a standard-rated and a reduced-rated line must break the
  /// total down by rate rather than state one figure.
  vatBreakdownJson Json

  subtotalMinor   BigInt
  discountMinor   BigInt @default(0)
  taxMinor        BigInt @default(0)
  shippingMinor   BigInt @default(0)
  grandTotalMinor BigInt

  /// Set when this invoice cancels an earlier one. A credit note rather than a
  /// deletion: an issued invoice is never removed, because the sequence it
  /// belongs to must have no gaps anyone can explain away.
  creditsInvoiceId String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  creditsInvoice Invoice?  @relation("InvoiceCredit", fields: [creditsInvoiceId], references: [id], onDelete: Restrict)
  creditedBy     Invoice[] @relation("InvoiceCredit")

  @@index([orderId], map: "ix_invoice_order")
  @@index([issuedAt], map: "ix_invoice_issued")
  @@index([taxTreatment, issuedAt], map: "ix_invoice_treatment")
  @@map("invoices")
}

// ===========================================================================
// PRODUCT SAFETY (GPSR)
//
// Regulation (EU) 2023/988 has applied since 13 December 2024, and Article 19
// is the part a catalogue has to answer to: a product may not be offered
// online unless the listing already carries, before anyone buys,
//
//   (a) the manufacturer's name, postal address and electronic address;
//   (b) where the manufacturer is outside the Union, the same for the
//       responsible person established inside it;
//   (c) information identifying the product, including a picture and any type
//       or model identifier;
//   (d) any warning or safety information, in a language the buyer of that
//       member state readily understands.
//
// Two consequences shape what follows.
//
// The operators are their own table rather than columns on `products`. One
// manufacturer supplies dozens of lines, their registered address changes as a
// company detail rather than as a catalogue edit, and (b) is a legal role that
// several manufacturers can share - an EU representative acting for a group of
// Asian suppliers is the ordinary case, not an exception.
//
// The warnings are translated. Art. 19(d) says "easily understood", which for
// a storefront serving eight languages means the warning follows the language
// the reader chose - not the language the catalogue was written in. So the
// text lives on `product_translations` beside the description, and the base
// row is the fallback exactly as it is for everything else.
// ===========================================================================

/// The roles Union product law recognises for whoever put a product on the
/// market. Named after the law rather than after the supply chain: an
/// "importer" here is the Art. 4 Reg. 2019/1020 economic operator, not
/// whichever company happens to have shipped the container.
enum EconomicOperatorRole {
  MANUFACTURER

  /// The Art. 16 GPSR / Art. 4(2) Reg. 2019/1020 responsible person inside the
  /// Union. Required whenever the manufacturer is not established in it, and
  /// the single most commonly missing piece on a non-EU seller's listing.
  EU_RESPONSIBLE_PERSON

  IMPORTER
}

/// A company named on a product listing under Union product law.
///
/// Deliberately not merged into a generic "supplier" concept. A supplier is a
/// commercial relationship; this is a legal identity that appears on a public
/// page and that a market surveillance authority writes to. The two change for
/// different reasons and at different times.
model EconomicOperator {
  id   String               @id @db.Char(26)
  role EconomicOperatorRole

  /// Art. 19(a): "name, registered trade name or registered trade mark".
  legalName String  @db.VarChar(255)
  /// The trading name, where it differs from the registered one. Shown beside
  /// it rather than instead of it - a buyer looking for who to complain to
  /// needs the name that appears on the register.
  tradeName String? @db.VarChar(255)

  /// Postal address. Shape validated by Zod at the API boundary, like every
  /// other address in this schema.
  addressJson Json
  countryCode String @db.Char(2)

  /// Art. 19(a) again: the "electronic address". Not optional, and not the
  /// shop's own support address - the point of the field is that a buyer can
  /// reach the manufacturer directly.
  email   String  @db.VarChar(320)
  phone   String? @db.VarChar(32)
  website String? @db.VarChar(512)

  /// The Single Registration Number Eudamed issues to an actor under MDR
  /// Art. 31. Distinct from a VAT number and from a company registration:
  /// it identifies this company specifically as a medical-device economic
  /// operator, and a buyer's compliance team will ask for it by name.
  eudamedSrn String? @db.VarChar(64)

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  archivedAt  DateTime? @db.DateTime(3)
  createdById String?   @db.Char(26)

  manufacturedProducts Product[] @relation("ProductManufacturer")
  representedProducts  Product[] @relation("ProductEuResponsible")

  @@index([role, isActive], map: "ix_economic_operator_role")
  @@index([legalName], map: "ix_economic_operator_name")
  @@map("economic_operators")
}

// ===========================================================================
// MEDICAL DEVICES (MDR)
//
// Regulation (EU) 2017/745 governs medical devices placed on the Union market,
// and it is very much larger than a catalogue: a quality management system,
// clinical evaluation, post-market surveillance, periodic safety update
// reports, vigilance reporting. **None of that is here, and none of it can
// be** - see docs/PRODUCT-SAFETY.md.
//
// What a catalogue is responsible for is the part a buyer and a market
// surveillance authority read off the listing: which device this is, what
// class it falls in, who certified it, and what it is for. Those are Art. 27
// (UDI), Annex VI Part C (the identifier structure), Annex VIII (the
// classification rules) and Art. 10(11) (the information supplied with the
// device). This section carries exactly those.
//
// A separate table rather than columns on `products`, because the great
// majority of deployments sell nothing that this applies to and should not
// carry eleven nullable columns to say so. A row exists only for a product
// somebody has marked as a device.
// ===========================================================================

/// Risk class, under the Annex VIII rules.
///
/// Class I is subdivided because the subdivision decides whether a notified
/// body is involved at all: a plain Class I device is self-certified, but one
/// that is supplied sterile, has a measuring function, or is a reusable
/// surgical instrument needs a notified body for that specific aspect. A
/// validator that treated "Class I" as one thing would let a sterile syringe
/// publish with no NB number, which is the exact case it exists to catch.
enum DeviceClass {
  CLASS_I
  CLASS_I_STERILE
  CLASS_I_MEASURING
  CLASS_I_REUSABLE_SURGICAL
  CLASS_IIA
  CLASS_IIB
  CLASS_III
}

/// The MDR facts that belong on a listing.
///
/// One row per product, and only for products that are devices. The presence
/// of the row IS the "this is a medical device" flag - a boolean on `products`
/// saying so, with the data somewhere else, is one more thing that can
/// disagree with itself.
model ProductDeviceInfo {
  id        String @id @db.Char(26)
  productId String @unique(map: "uq_device_info_product") @db.Char(26)

  deviceClass DeviceClass

  /// Art. 27 and Annex VI Part C.
  ///
  /// The Basic UDI-DI is the "main key" for a group of devices sharing a
  /// design and intended purpose - it is what a Eudamed entry and a
  /// declaration of conformity are filed against, and it does NOT appear on
  /// the label. The UDI-DI is the identifier for one specific packaging
  /// configuration, and it does. Two different identifiers for two different
  /// jobs, which is why both are here and neither is derived from the other.
  basicUdiDi String? @db.VarChar(64)
  udiDi      String? @db.VarChar(64)

  /// The four-digit identification number of the notified body that issued
  /// the certificate, e.g. "0123". It appears beside the CE marking, and its
  /// absence on a device that needs one is the most visible sign that
  /// something is wrong with a listing.
  notifiedBodyNumber String? @db.VarChar(8)

  /// Where the declaration of conformity can be read. Art. 19(1) obliges the
  /// manufacturer to draw one up; a distributor who cannot point at it cannot
  /// discharge Art. 14(2)(a).
  declarationOfConformityUrl String? @db.VarChar(1024)

  /// Art. 10(11) / Annex I ch. III. What the device is FOR, in the
  /// manufacturer's own words. Translated like the safety warnings, and for
  /// the same reason: an intended purpose the reader cannot read has not been
  /// stated to them.
  intendedPurpose String? @db.Text

  /// The three properties that change what else is required.
  ///
  /// `isSterile` and `hasMeasuringFunction` are what push a Class I device
  /// into needing a notified body, and `isSingleUse` is what makes
  /// reprocessing unlawful under Art. 17 unless a member state permits it.
  /// They are stored rather than inferred from the class, because a device can
  /// be sterile and Class IIb, and the class alone does not say so.
  isSterile            Boolean @default(false)
  isSingleUse          Boolean @default(false)
  hasMeasuringFunction Boolean @default(false)

  /// Whether the device contains a substance, tissue or cell of human or
  /// animal origin. Not a rule this software enforces - it drives labelling
  /// and, for some combinations, a different conformity route - but a fact a
  /// buyer's own compliance team asks for and nobody wants to chase twice.
  containsBiologicalMaterial Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([deviceClass], map: "ix_device_info_class")
  @@index([basicUdiDi], map: "ix_device_info_basic_udi")
  @@map("product_device_info")
}

/// A country this product may not be delivered to.
///
/// The regulatory half of "can this be shipped there", and separate from
/// `WarehouseCountryExclusion` because it is a fact about the *goods* rather
/// than about a building. A Class III device with no registration in Norway
/// cannot go there from Antwerp, from Gdansk, or from anywhere else, and
/// recording that on each warehouse in turn would mean forgetting it on the
/// one opened next year.
///
/// Checked at checkout: a warehouse whose basket contains a product restricted
/// in the destination is not offered, and the buyer is told which line is the
/// problem rather than being shown an empty list.
///
/// No foreign key to `countries`, for the same reason the warehouse exclusion
/// has none: the list of markets a deployment prices in is much shorter than
/// the list of countries a regulator can close, and an FK would make exactly
/// the countries most worth restricting the ones nobody can name.
model ProductCountryRestriction {
  id        String @id @db.Char(26)
  productId String @db.Char(26)

  /// ISO 3166-1 alpha-2, upper case. Validated against the ISO list in the
  /// service; the CHECK constraint is the backstop for a direct SQL write.
  countryCode String @db.Char(2)

  /// Why, in the operator's own words - "no MDR registration", "import licence
  /// required". Optional, and worth having: the person reading this row in a
  /// year is not the person who wrote it, and the reasons expire at different
  /// times.
  reason String? @db.VarChar(256)

  createdAt DateTime @default(now()) @db.DateTime(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, countryCode], map: "uq_product_country_restriction")
  /// "What may not go to Norway?" - the checkout's own query.
  @@index([countryCode], map: "ix_product_restriction_country")
  @@map("product_country_restrictions")
}

// ===========================================================================
// ERP CONNECTIVITY
//
// The business's own ERP, configured once by an administrator under
// Settings -> ERP, and used for EVERY order.
//
// There is deliberately no per-customer connection here, and the reason is
// worth stating because an earlier draft of this feature had one. A connection
// is a URL plus a credential that this server then calls; letting a buyer
// supply either makes a form field into a server-side request forgery
// primitive, and makes "did this order reach the warehouse" depend on
// something the buyer configured. `BusinessProfile` is a single-row table -
// this deployment serves exactly one business - and its ERP is the same one
// for every order it takes.
//
// What that buys, beyond the security: an order's fate no longer depends on
// whether a particular customer set something up. Every order goes the same
// way, so a failure is a failure of the installation rather than of one
// buyer's configuration, and there is one place to look.
//
// A BUYER connecting their OWN ERP is a separate feature with separate tables,
// and none of the above applies to it - see the BUYER ORGANISATIONS block at
// the end of this file. The distinction is whose system is on the other end:
// here it is the operator's warehouse, there it is a customer's purchasing
// system.
//
// Secrets are AES-256-GCM ciphertext bound by AAD to the row that holds them,
// and no read path in the application decrypts them into a response.
// `credentialHint` is what the screen shows instead.
// ===========================================================================

/// Where the ERP connection stands.
///
/// The order matters and the gaps matter. DRAFT -> TESTING -> CONNECTED is the
/// setup path, and ACTIVE is reachable only from CONNECTED: a connection that
/// has never answered a test cannot start carrying orders. See
/// `erp-connection-state.ts`, which is the only thing allowed to move a row
/// between these.
enum ErpConnectionStatus {
  /// Being filled in. No traffic, no jobs, not selectable by anything.
  DRAFT
  /// A test is in flight. Transient, and held in the row so a second test
  /// started from another tab does not run concurrently with the first.
  TESTING
  /// The last test passed and the mapping validates. Ready to be switched on,
  /// and deliberately NOT yet carrying orders - activation is a decision an
  /// administrator makes, not a side effect of a test that happened to pass.
  CONNECTED
  /// Live. Orders push, inventory syncs, webhooks are accepted. At most one
  /// connection is in this state at a time - see `uq_erp_connection_active`.
  ACTIVE
  /// Switched off deliberately, temporarily. Configuration is intact and
  /// resuming needs no re-test. Inbound webhooks are refused while paused,
  /// because accepting stock updates for a connection somebody deliberately
  /// stopped is the opposite of what pausing means.
  PAUSED
  /// Repeated failures took it out of service. Distinct from PAUSED: nobody
  /// chose this, and the row carries the reason. Recovered by a passing test.
  ERROR
  /// Switched off and kept for its history. Nothing runs; it is not deleted,
  /// so the integration events that reference it still read back.
  DISABLED
}

/// How the ERP authenticates callers.
enum ErpAuthMethod {
  /// A key in a header the ERP names, e.g. `X-API-Key`.
  API_KEY
  /// `Authorization: Bearer <token>`.
  BEARER_TOKEN
  /// `Authorization: Basic base64(user:pass)`.
  BASIC
  /// Client-credentials grant. The only method here that makes a call of its
  /// own before the real one, and the only one whose secret has a lifetime -
  /// see `oauthTokenEnc` and `oauthTokenExpiresAt`.
  OAUTH2
}

/// Who wins when the ERP and this platform disagree about a stock figure.
///
/// A real question with no universally right answer, which is why it is a
/// setting rather than a decision made here. A business whose ERP is the
/// system of record wants ERP; one running this platform as the front of house
/// for a warehouse managed here wants PLATFORM; one mid-migration wants to be
/// asked.
///
/// **None of the three writes `inventory_balances`.** The synced figures land
/// in `erp_inventory_snapshots` and the divergence is reported; moving the
/// real stock ledger is done by a person through the Inventory screens, which
/// record a reason and an actor. See that model's comment.
enum ErpInventoryAuthority {
  /// The ERP's figure is the one shown as authoritative in the snapshot.
  ERP
  /// This platform's figure stands. The ERP's is recorded beside it so the
  /// divergence is visible rather than applied.
  PLATFORM
  /// Neither is preferred. Divergences are flagged for a person to resolve,
  /// which is the only honest answer during a migration.
  MANUAL
}

/// What started a sync.
enum ErpSyncTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  /// A retry of a run that failed. Kept apart from the trigger behind the
  /// original so a retry storm is visible as one.
  RETRY
}

enum ErpSyncRunStatus {
  RUNNING
  SUCCEEDED
  /// Some records read, some not. The common outcome of a real feed, and the
  /// reason a boolean would have been the wrong shape.
  PARTIAL
  FAILED
  /// The ERP asked us to slow down and the run stopped early on purpose. Not a
  /// failure: what was processed is applied, and the rest is taken next pass.
  RATE_LIMITED
}

/// Every kind of thing the integration ledger records.
enum IntegrationEventType {
  CONNECTION_TEST
  DRY_RUN
  ORDER_PUSH
  INVENTORY_SYNC
  INVENTORY_WEBHOOK
  ORDER_STATUS_POLL
  AUTOPAY_CHARGE
}

enum IntegrationEventStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  /// Failed for a reason that may pass. `nextRetryAt` is set.
  RETRY_SCHEDULED
  /// Failed for a reason that will not pass on its own - a 400, a mapping the
  /// ERP rejects, a credential it refuses. Never retried automatically; it is
  /// shown to an administrator, who may retry it once the cause is fixed.
  FAILED
  /// Retries exhausted. A person has to look.
  ABANDONED
}

/// Whether a customer has authorised charges made without them present.
enum AutoPayStatus {
  /// The default, and what a customer who never opted in has. No stored
  /// instrument is charged off-session while a row says this.
  DISABLED
  ACTIVE
  /// Opted in, consent intact, temporarily stopped. Resuming does NOT ask for
  /// consent again, because it was never withdrawn - which is exactly why pause
  /// and disable are two different things.
  PAUSED
}

/// What a customer wants done when an off-session charge fails.
enum AutoPayRetryPreference {
  /// Fail immediately and tell them. The choice of somebody who would rather
  /// pay by hand than have a card retried behind their back.
  NONE
  /// One further attempt, a day later.
  ONCE
  /// The platform's own bounded schedule.
  STANDARD
}

/// The business's connection to its ERP.
///
/// Several rows may exist - a sandbox and a live one is the ordinary case -
/// but **at most one is ACTIVE**, and that one carries every order. The
/// constraint is enforced in `activateConnection`; the schema cannot express
/// "unique where status = ACTIVE" on MariaDB 10.4, which has no partial index.
model ErpConnection {
  id   String @id @db.Char(26)
  name String @unique(map: "uq_erp_connection_name") @db.VarChar(128)

  /// Scheme + host + optional port + optional base path. Validated on write by
  /// `assertSafeErpUrl`, and again on every request: DNS moves, and a hostname
  /// that resolved publicly at save time can resolve to 169.254.169.254 an hour
  /// later. The guard is kept even though only an administrator types here -
  /// it costs nothing and the alternative is trusting a text box for ever.
  baseUrl String @db.VarChar(1024)

  status          ErpConnectionStatus @default(DRAFT)
  /// Why it is in ERROR, in words safe to show on screen. Never a provider
  /// body, never a header.
  statusReason    String?             @db.VarChar(512)
  statusChangedAt DateTime            @default(now()) @db.DateTime(3)

  // --- Endpoints -----------------------------------------------------------
  //
  // Paths relative to `baseUrl`, or absolute URLs on the same origin. A path
  // pointing anywhere else is refused at save time.
  productEndpoint     String? @db.VarChar(512)
  inventoryEndpoint   String? @db.VarChar(512)
  warehouseEndpoint   String? @db.VarChar(512)
  orderCreateEndpoint String? @db.VarChar(512)
  orderStatusEndpoint String? @db.VarChar(512)

  /// HTTP method per endpoint, because ERPs disagree. Shape:
  /// `{"product":"GET","inventory":"POST"}`. Validated against a closed set -
  /// GET, POST, PUT, PATCH - on write.
  methodsJson Json?

  /// Extra headers every request carries: a tenant id, an API version. Header
  /// NAMES and non-secret values only. A header carrying a secret belongs in
  /// `credentialsEnc`, not in a column the API returns.
  customHeadersJson Json?

  /// Per-request ceiling. Bounded on write (1s - 60s): a ten-minute timeout
  /// would hold a worker slot hostage.
  timeoutMs Int @default(15000)

  // --- Authentication ------------------------------------------------------
  authMethod ErpAuthMethod @default(API_KEY)

  /// AES-256-GCM over a JSON object whose keys depend on `authMethod`. Never
  /// decrypted into any response, log line or error message. AAD binds it to
  /// `erp_connection:<id>`, so the ciphertext is useless in another row.
  credentialsEnc String? @db.Text

  /// What the edit screen shows instead: `X-API-Key: sk_live...9f2a`. Derived
  /// from the secret at save time, and safe to return.
  credentialHint String? @db.VarChar(128)

  /// --- OAuth 2.0 only ---
  oauthTokenUrl       String?   @db.VarChar(1024)
  oauthScope          String?   @db.VarChar(512)
  /// The access token last obtained, encrypted like any other secret. Cached
  /// rather than fetched per request: a client-credentials round trip before
  /// every stock read would double both the traffic and the failure surface.
  oauthTokenEnc       String?   @db.Text
  oauthTokenExpiresAt DateTime? @db.DateTime(3)

  // --- Inbound webhooks ----------------------------------------------------
  //
  // The ERP calls US. `webhookSecretEnc` is what proves it did: HMAC-SHA256
  // over the raw bytes, compared in constant time. A connection with no secret
  // accepts no webhooks - there is no "unsigned" mode, because an
  // unauthenticated endpoint that rewrites stock is not a feature.
  webhookEnabled         Boolean @default(false)
  webhookSecretEnc       String? @db.Text
  /// The header the ERP puts its signature in. Configurable, because every ERP
  /// chose differently.
  webhookSignatureHeader String  @default("X-UBOSS-Signature") @db.VarChar(64)
  /// Public, unguessable path segment for this connection's webhook URL: 32
  /// bytes of CSPRNG, base64url. Not a secret on its own - the signature is the
  /// authentication - but it keeps the endpoint from being discoverable by
  /// iterating ids.
  webhookSlug            String  @unique(map: "uq_erp_webhook_slug") @db.VarChar(64)

  // --- Polling fallback ----------------------------------------------------
  //
  // For an ERP with no outbound webhooks, which is most of them. Minutes rather
  // than a cron expression: the question being answered is "how fresh does
  // stock need to be", and every cron field beyond that is a way to get it
  // wrong.
  pollingEnabled         Boolean   @default(false)
  pollingIntervalMinutes Int       @default(60)
  lastPolledAt           DateTime? @db.DateTime(3)
  nextPollAt             DateTime? @db.DateTime(3)

  // --- Field mapping -------------------------------------------------------
  //
  // Dotted paths into the ERP's own JSON, keyed by the platform field they
  // answer. Validated by `validateFieldMapping` before the connection may leave
  // DRAFT, and re-validated against a real response during a dry run.
  fieldMappingJson  Json?
  /// Set once the mapping has been checked against a real response. Activation
  /// requires it: a mapping that only validates structurally is a guess about
  /// somebody else's JSON.
  mappingVerifiedAt DateTime? @db.DateTime(3)

  // --- Inventory policy ----------------------------------------------------
  inventoryAuthority  ErpInventoryAuthority @default(ERP)
  /// Allow a synced figure to be overridden by hand in the snapshot. Off by
  /// default: with ERP as the authority a manual edit is replaced by the next
  /// sync, and a control that undoes itself is worse than no control at all.
  allowManualOverride Boolean               @default(false)

  // --- Order push ----------------------------------------------------------
  /// Whether orders are pushed at all. A business may connect an ERP purely for
  /// stock and keep taking orders here.
  orderPushEnabled  Boolean @default(true)
  /// The header this ERP reads an idempotency key from.
  idempotencyHeader String  @default("Idempotency-Key") @db.VarChar(64)

  // --- Test and health -----------------------------------------------------
  lastTestAt         DateTime? @db.DateTime(3)
  lastTestOk         Boolean?
  /// HTTP status and round-trip of the last test. Safe to show; neither is a
  /// credential.
  lastTestHttpStatus Int?
  lastTestDurationMs Int?
  lastTestMessage    String?   @db.VarChar(512)

  consecutiveFailures Int       @default(0)
  circuitOpenedAt     DateTime? @db.DateTime(3)

  lastSyncSuccessAt DateTime? @db.DateTime(3)
  lastSyncFailureAt DateTime? @db.DateTime(3)

  /// Who set it up. Kept for the trail: these rows record somebody pointing
  /// this server at an outbound address and giving it a credential.
  createdById String?   @db.Char(26)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.DateTime(3)
  /// Soft delete. A connection with integration events behind it is retired
  /// rather than removed, so the ledger still explains what became of an order
  /// that went through it.
  deletedAt   DateTime? @db.DateTime(3)

  syncRuns          ErpInventorySyncRun[]
  snapshots         ErpInventorySnapshot[]
  integrationEvents IntegrationEvent[]
  webhookReceipts   ErpWebhookReceipt[]

  @@index([status], map: "ix_erp_connection_status")
  /// The polling sweep: active, polling on, due.
  @@index([status, pollingEnabled, nextPollAt], map: "ix_erp_connection_poll_due")
  @@map("erp_connections")
}

/// One pass over the ERP's inventory feed, and what it did.
model ErpInventorySyncRun {
  id           String @id @db.Char(26)
  connectionId String @db.Char(26)

  trigger  ErpSyncTrigger
  status   ErpSyncRunStatus @default(RUNNING)
  /// A dry run reads, maps and reports, and writes no snapshot. The rehearsal
  /// that lets somebody check a mapping without moving a number.
  isDryRun Boolean          @default(false)

  /// Shared with every log line, audit row and integration event this run
  /// produces, so one incident reads back as one story.
  correlationId String @db.VarChar(64)

  startedAt  DateTime  @default(now()) @db.DateTime(3)
  finishedAt DateTime? @db.DateTime(3)

  processedCount Int @default(0)
  appliedCount   Int @default(0)
  skippedCount   Int @default(0)
  failedCount    Int @default(0)
  /// Records where the ERP and this platform disagreed. Counted apart from
  /// failures: nothing went wrong, a difference was found.
  conflictCount  Int @default(0)

  /// Set when the ERP asked us to slow down. Rendered as "paused until", which
  /// is the only part of a 429 anybody needs.
  rateLimitedUntil DateTime? @db.DateTime(3)

  errorCode    String? @db.VarChar(64)
  errorMessage String? @db.VarChar(1024)

  connection ErpConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade, map: "fk_erp_sync_connection")
  records    ErpSyncRecordError[]

  @@index([connectionId, startedAt], map: "ix_erp_sync_connection_time")
  @@index([status, startedAt], map: "ix_erp_sync_status_time")
  @@map("erp_inventory_sync_runs")
}

/// One record a sync could not read, and why.
///
/// Capped per run by the service. A feed that fails wholesale should produce a
/// run marked FAILED with one reason, not fifty thousand rows nobody reads.
model ErpSyncRecordError {
  id        String @id @db.Char(26)
  syncRunId String @db.Char(26)

  /// The SKU or external id the record claimed to be about, when it had one.
  externalRef  String? @db.VarChar(191)
  field        String? @db.VarChar(128)
  errorCode    String  @db.VarChar(64)
  /// Already safe for display. Redaction happens before the write, not before
  /// the read - a value reaching this column has been through
  /// `safeErrorMessage`.
  errorMessage String  @db.VarChar(1024)

  createdAt DateTime @default(now()) @db.DateTime(3)

  syncRun ErpInventorySyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade, map: "fk_erp_sync_record_run")

  @@index([syncRunId], map: "ix_erp_sync_record_run")
  @@map("erp_sync_record_errors")
}

/// What the ERP last said it holds, per SKU and warehouse.
///
/// **This is not `inventory_balances`, and the distinction is deliberate.**
/// `inventory_balances` is derived from `inventory_movements`, which is an
/// append-only ledger with an actor and a reason on every row - that is what
/// makes "why did on-hand change" answerable. A feed that overwrote balances
/// directly would move real stock with no movement behind it, and the first
/// time a mapping was wrong it would do so silently and irreversibly.
///
/// So a sync writes HERE, and the two figures are shown side by side. Acting on
/// a difference is a person's decision, taken through the Inventory screens,
/// which record who did it and why.
model ErpInventorySnapshot {
  id           String @id @db.Char(26)
  connectionId String @db.Char(26)

  /// The SKU as the ERP spells it. Matched against this platform's catalogue
  /// where it can be, and kept either way - an ERP holding stock of something
  /// this business does not list is ordinary, not an error.
  sku          String @db.VarChar(191)
  /// This platform's inventory location code the ERP warehouse maps to, or ''
  /// when the mapping names none.
  ///
  /// NOT NULL with a '' sentinel rather than a nullable column: a MySQL UNIQUE
  /// index treats every NULL as distinct, so a nullable column inside the
  /// composite unique below would let the same SKU be inserted without a
  /// warehouse any number of times - turning every redelivered webhook into a
  /// duplicate row.
  warehouseKey String @db.VarChar(64)

  /// Resolved from `sku` at sync time, and null when nothing here matches. Kept
  /// as a link rather than looked up on read so the join is done once per sync
  /// instead of once per page view.
  productId String? @db.Char(26)
  variantId String? @db.Char(26)

  availableQuantity Int     @default(0)
  reservedQuantity  Int     @default(0)
  unitOfMeasure     String? @db.VarChar(32)

  /// What the ERP called it, for a screen that has to be recognisable to
  /// somebody who works in that ERP all day.
  erpProductId   String? @db.VarChar(191)
  erpProductName String? @db.VarChar(255)

  /// The ERP's own price, when the mapping supplies one. Minor units, like
  /// every other amount in this schema, with its currency beside it - a bare
  /// number is not a price.
  priceMinor BigInt? @db.BigInt
  currency   String? @db.Char(3)

  /// What this platform's own balances said at the moment of the sync. Stored
  /// so a divergence can be SHOWN rather than merely resolved: "your ERP says
  /// 12, we hold 40" is the useful sentence, and it cannot be reconstructed
  /// after the fact.
  platformQuantityAtSync Int?

  /// Set when the two disagreed. Cleared by the next sync that agrees.
  conflictDetectedAt DateTime? @db.DateTime(3)

  /// A figure a person typed, which survives the next sync.
  ///
  /// Only usable where the connection allows manual override. Without that flag
  /// the next sync would replace it, and a control that silently undoes itself
  /// is worse than no control.
  manualQuantity    Int?
  manualSetAt       DateTime? @db.DateTime(3)
  manualSetByUserId String?   @db.Char(26)

  lastSyncedAt  DateTime @default(now()) @db.DateTime(3)
  lastSyncRunId String?  @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)

  connection ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, map: "fk_erp_snapshot_connection")

  /// One row per SKU per warehouse per connection. This is what makes a sync an
  /// upsert rather than an append, and what stops a redelivered webhook adding
  /// a second row for stock that has not moved.
  @@unique([connectionId, sku, warehouseKey], map: "uq_erp_snapshot_sku_warehouse")
  @@index([sku], map: "ix_erp_snapshot_sku")
  @@index([productId], map: "ix_erp_snapshot_product")
  @@index([connectionId, conflictDetectedAt], map: "ix_erp_snapshot_conflicts")
  @@map("erp_inventory_snapshots")
}

/// The integration ledger: one row per thing attempted against the ERP.
///
/// This is what the Activity screen reads, what a retry consults, and what
/// answers "why has this order not reached the warehouse". It holds the
/// correlation id and the idempotency key precisely so those questions have one
/// answer each rather than a reconstruction.
///
/// `idempotencyKey` is unique where present. That is the structural reason a
/// duplicate webhook or a re-run job cannot produce a second ERP order: the
/// insert collides, instead of the code being careful.
model IntegrationEvent {
  id           String  @id @db.Char(26)
  /// Nullable so the row outlives a deleted connection.
  connectionId String? @db.Char(26)

  eventType IntegrationEventType
  status    IntegrationEventStatus @default(PENDING)

  /// The platform's order, when this event is about one.
  orderId           String? @db.Char(26)
  /// What the ERP called it back.
  erpOrderReference String? @db.VarChar(191)

  correlationId  String  @db.VarChar(64)
  /// Stable across every attempt at the same logical operation. NULL for events
  /// that are not operations against the ERP's state - a connection test, say,
  /// which may be run as often as anybody likes.
  idempotencyKey String? @unique(map: "uq_integration_event_idempotency") @db.VarChar(191)

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime? @db.DateTime(3)
  nextRetryAt   DateTime? @db.DateTime(3)

  httpStatus Int?
  durationMs Int?

  errorCode    String? @db.VarChar(64)
  /// Safe to read: no credential, no Authorization header, no verbatim provider
  /// body. `safeErrorMessage` is the only thing that writes here.
  errorMessage String? @db.VarChar(1024)
  /// The provider's answer with credentials stripped and size capped. Kept
  /// because a disagreement about an order is settled by what was actually
  /// exchanged, and reconstructed evidence is not evidence.
  responseJson Json?

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)

  connection ErpConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, map: "fk_integration_event_connection")

  @@index([createdAt], map: "ix_integration_event_time")
  @@index([eventType, status], map: "ix_integration_event_kind")
  @@index([orderId], map: "ix_integration_event_order")
  /// The retry sweep.
  @@index([status, nextRetryAt], map: "ix_integration_event_retry")
  @@map("integration_events")
}

/// An inbound webhook we have already seen.
///
/// The duplicate guard for stock updates. An ERP that retries - and they all
/// retry - must not apply the same movement twice, and the honest place to stop
/// that is at the door, keyed on whatever identifier the ERP sends.
///
/// When an ERP sends no event id the service hashes the raw body and uses that.
/// Two genuinely identical bodies inside the dedupe window are indistinguishable
/// from a redelivery, and for a full-quantity stock snapshot treating them as
/// one is the safe direction to be wrong in.
model ErpWebhookReceipt {
  id           String @id @db.Char(26)
  connectionId String @db.Char(26)

  /// The ERP's event id, or `sha256:<hex>` of the raw body when it sent none.
  externalEventId String @db.VarChar(191)

  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)
  /// Null until processed. Set to the run that applied it, so a redelivery can
  /// answer "already applied, in run X" rather than merely "seen before".
  syncRunId   String?   @db.Char(26)

  connection ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, map: "fk_erp_webhook_connection")

  @@unique([connectionId, externalEventId], map: "uq_erp_webhook_receipt")
  @@index([receivedAt], map: "ix_erp_webhook_time")
  @@map("erp_webhook_receipts")
}

/// One customer's authority to be charged without being present.
///
/// The one thing in this block that is genuinely the CUSTOMER's rather than the
/// business's, and it has to be: an administrator cannot consent on somebody
/// else's behalf to money leaving their account. That is not a design
/// preference, it is what makes the charge lawful.
///
/// Separate from `customer_payment_methods` because the two answer different
/// questions. That table says "this instrument exists and may be used"; this one
/// says "and the account holder has asked us to use it, up to this much, under
/// these rules". A saved card is not consent to charge it.
///
/// A row with `status = DISABLED` is, for charging purposes, the same as no row
/// at all. It still exists so a customer's limits and preferences survive a
/// disable/enable cycle.
model CustomerAutoPaySetting {
  id                String @id @db.Char(26)
  customerProfileId String @unique(map: "uq_autopay_customer") @db.Char(26)

  status AutoPayStatus @default(DISABLED)

  /// The instrument to charge. Nullable in the schema and enforced in the
  /// service: enabling with no usable instrument is refused rather than stored.
  paymentMethodId String? @db.Char(26)

  /// The most this may charge in one transaction, in minor units of
  /// `limitCurrency`. NULL means the customer set no ceiling of their own; the
  /// platform's own limits still apply either way.
  maxTransactionMinor    BigInt? @db.BigInt
  /// Above this, nothing is charged automatically - the customer is asked
  /// first. NULL means never ask. Held apart from the maximum because they are
  /// different instructions: one refuses, the other defers.
  approvalThresholdMinor BigInt? @db.BigInt
  /// The currency both amounts are in, required whenever either is set. A bare
  /// number is not a limit, and comparing 5000 JPY against a EUR total is the
  /// kind of bug that charges somebody eighty times what they agreed to.
  limitCurrency          String? @db.Char(3)

  retryPreference AutoPayRetryPreference @default(STANDARD)

  notifyOnCharge  Boolean @default(true)
  notifyOnFailure Boolean @default(true)

  /// --- Consent. The same evidence shape as CustomerPaymentMethod. ---
  consentAcceptedAt  DateTime? @db.DateTime(3)
  consentVersion     String?   @db.VarChar(32)
  consentIpHash      String?   @db.VarChar(64)
  consentUserAgent   String?   @db.VarChar(256)
  /// When consent was taken back. Set on disable, cleared on a fresh opt-in.
  consentWithdrawnAt DateTime? @db.DateTime(3)

  enabledAt DateTime? @db.DateTime(3)
  pausedAt  DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)

  customerProfile CustomerProfile        @relation(fields: [customerProfileId], references: [id], onDelete: Cascade, map: "fk_autopay_customer")
  paymentMethod   CustomerPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull, map: "fk_autopay_payment_method")

  @@index([status], map: "ix_autopay_status")
  @@index([paymentMethodId], map: "ix_autopay_payment_method")
  @@map("customer_autopay_settings")
}

// ===========================================================================
// SAVED FOR LATER
// ===========================================================================

/**
 * A line somebody has kept without buying it.
 * The whole model, deliberately: a link to a person, a link to a product, and
 * when. No quantity, no note, no ordering column. A wishlist that carries a
 * quantity is a second basket with none of a basket's rules — no minimum, no
 * increment, no stock reservation, no price — and the moment one exists
 * somebody will try to check it out.
 * `variantKey` is the same device the cart and the schedule items use, and for
 * the same MariaDB reason recorded in this file's header: a UNIQUE index here
 * treats every NULL as distinct, so a nullable `variantId` inside the
 * composite unique would NOT stop the same variant being saved twice. The key
 * is the variant ULID, or `''` for the base product, and is never null.
 * There is no `variant` relation and that is not an omission. A variant can be
 * deleted while a wishlist row still names it, and the alternative — a foreign
 * key with ON DELETE RESTRICT — would make somebody else's saved item a reason
 * an administrator cannot tidy up a product. The reader resolves the key if it
 * still resolves, and shows the base product if it does not.
 */
model WishlistItem {
  id                String @id @db.Char(26)
  customerProfileId String @db.Char(26)
  productId         String @db.Char(26)

  /// The variant ULID, or '' for the base product. Never null - see above.
  variantKey String @default("") @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade, map: "fk_wishlist_customer")
  /// Cascade, not Restrict. A product being removed from the catalogue should
  /// not be blocked by somebody having saved it, and a saved line pointing at
  /// a product that no longer exists is not worth keeping.
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_wishlist_product")

  @@unique([customerProfileId, productId, variantKey], map: "uq_wishlist_item")
  @@index([customerProfileId, createdAt], map: "ix_wishlist_customer_time")
  @@index([productId], map: "ix_wishlist_product")
  @@map("wishlist_items")
}

// ===========================================================================
// INSTRUCTIONS LEFT ON A PRODUCT WITHOUT BUYING IT
// ===========================================================================

/**
 * What a shopper needs done to a product, said before there is an order.
 *
 * `cart_items.note` already lets a buyer say "the 316 grade, not 304" or
 * "engrave both ends" — but only once the thing is in their basket, and only
 * where it survives to checkout. That is the wrong moment for most of what a
 * trade buyer actually wants to say. The questions that decide whether there
 * will be an order at all — "do you do this in 8mm?", "can you supply with a
 * calibration certificate?", "we need 400 a month, can you hold stock?" —
 * arrive while somebody is still looking, and until now there was nowhere to
 * put them. They went into an email nobody could tie back to a product, or
 * they went nowhere and the sale did not happen.
 *
 * So this is the same fact as the cart line's note, standing free of a basket:
 * one shopper, one product, in their own words, readable by whoever sells it.
 *
 * ONE STANDING INSTRUCTION PER SHOPPER PER PRODUCT, NOT A THREAD
 *
 * The unique index is the whole design decision. This is deliberately NOT a
 * comment section: a public thread under a product is a different feature with
 * different problems (ranking, moderation at volume, brigading), and it is not
 * what was asked for. A shopper has one standing instruction about a product,
 * and editing it replaces what they said rather than appending to it — exactly
 * how the basket's note behaves, which is where this shape comes from.
 *
 * It also settles the abuse question without a moderation queue. A signed-in
 * shopper can hold at most one row per product, so there is no flood to
 * moderate; the worst case is one sentence from one identified account, which
 * the seller can read and ignore.
 *
 * `variantKey` is the same device the cart, the schedule and the wishlist use,
 * for the MariaDB reason in this file's header: a UNIQUE index treats every
 * NULL as distinct, so a nullable `variantId` in the composite would not stop
 * the same shopper filing two rows against the same version. It is the variant
 * ULID, or `''` for "this product in general", and is never null. There is no
 * `variant` relation, for the reason WishlistItem states: a variant must stay
 * deletable, and the reader resolves the key only if it still resolves.
 *
 * WHY 500 AND NOT `TEXT`
 *
 * The same ceiling `cart_items.note` carries, and the same reasoning. This is
 * a few sentences about one product, read by a seller working through a list
 * of them. The API enforces the same number, so going over is a message rather
 * than a silent truncation — which matters more here than almost anywhere,
 * because MariaDB 10.4 is not strict and WOULD truncate.
 *
 * WHO CAN READ IT
 *
 * The shopper who wrote it, and any seller with a live, unarchived offer on
 * that product. Not the public: a storefront that printed these under the
 * product would be publishing one buyer's requirements to their competitors,
 * and a buyer who knew that would stop writing anything worth reading.
 */
model ProductInstruction {
  id                String @id @db.Char(26)
  productId         String @db.Char(26)
  customerProfileId String @db.Char(26)

  /// The variant this is about, or '' for the product in general. Never null.
  variantKey String @default("") @db.Char(26)

  /// The shopper's own words. Stored and returned as plain text, never as
  /// HTML: nothing renders this with `dangerouslySetInnerHTML`, and the
  /// column exists so a seller can read a sentence, not so a buyer can style
  /// one.
  body String @db.VarChar(500)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade, map: "fk_product_instruction_customer")
  /// Cascade, like the wishlist's. A product leaving the catalogue should not
  /// be blocked by somebody having asked a question about it, and an
  /// instruction pointing at a product that no longer exists is not worth
  /// keeping.
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_product_instruction_product")

  @@unique([customerProfileId, productId, variantKey], map: "uq_product_instruction")
  /// The seller hub's read: every instruction on one product, newest first.
  @@index([productId, createdAt], map: "ix_product_instruction_product_time")
  /// The shopper's own read, and the erasure sweep.
  @@index([customerProfileId, createdAt], map: "ix_product_instruction_customer_time")
  @@map("product_instructions")
}

// ===========================================================================
// BUYER ORGANISATIONS AND THEIR OWN ERP
//
// Everything above this line about ERP connectivity is the SELLER's: the
// business running this installation configures one ERP under Settings -> ERP
// and every order it takes goes there. That stays exactly as it was.
//
// This block is the other direction, and it is a different feature with a
// different owner. A buyer is itself a business - a hospital group, a
// distributor - running SAP, or monday.com, or something written in-house.
// What it wants is for the things it buys HERE to appear THERE: a purchase
// order when an order is confirmed, a goods receipt when the crate is signed
// for, an invoice when one is issued, a payment reference when it settles.
//
// Three facts shape every model below.
//
//   1. **The tenant owns the connection, not the person.** A buyer is an
//      organisation with staff who come and go. A connection configured by
//      somebody who has since left must keep working, and the person who
//      replaces them must be able to fix it. So the owner column is
//      `organizationId` and never `customerProfileId`, and every query in the
//      services is scoped by it - see `assertOrganizationAccess`.
//
//   2. **A credential is never a column anybody reads back.** Secrets live in
//      `customer_erp_credentials` as AES-256-GCM envelopes with AAD binding
//      them to their row, are decrypted in exactly one module, and no read
//      path in the application - customer, admin or support - returns one.
//      What a screen shows is `hint`, which is `X-API-Key: sk_live...9f2a`.
//
//   3. **The buyer types the address.** That is the whole point of the
//      feature and it is also, unavoidably, a server-side request forgery
//      primitive with a form field in front of it. `assertSafeErpUrl` and
//      `resolveSafeTarget` in `outbound-http.ts` are what make it safe to
//      offer: https only, DNS resolved by us, private and link-local
//      addresses refused, the socket pinned to the address that passed, and
//      every redirect target re-checked. On top of that a deployment may
//      restrict buyers to an operator-approved host policy - see
//      `CUSTOMER_ERP_ALLOWED_HOST_SUFFIXES`.
//
// The ORDER of what happens to stock is the part most easily got wrong, so it
// is stated here as well as in the service: an order confirmed on this
// platform raises a PURCHASE ORDER in the buyer's ERP and moves the quantity
// to ON ORDER. It does not touch on-hand stock. On-hand only moves when the
// goods are receipted - by a delivery this platform records, or by a goods
// receipt the buyer's own ERP tells us about - and even then only if the
// buyer's policy says to write it automatically rather than ask.
// ===========================================================================

/// What somebody may do inside a buyer organisation.
///
/// Three levels rather than a permission matrix, because there are exactly
/// three questions a buyer's IT department actually has: who owns this, who
/// may change the credentials, and who may look. A fourth role would have to
/// be explained to somebody, and nobody has asked for one.
enum BuyerOrgRole {
  /// Everything, including handing ownership on and archiving the
  /// organisation. At least one OWNER exists at all times - `removeMember`
  /// refuses to take the last one out.
  OWNER
  /// May configure connections, credentials, endpoints, mappings and policies,
  /// and may run tests, dry runs and syncs. May not change who is in the
  /// organisation. This is the role a buyer gives to the person who actually
  /// knows their SAP landscape, who is very often not the person who signs the
  /// purchase orders.
  INTEGRATION_MANAGER
  /// Read-only over connection health, sync history and the audit log. Sees no
  /// credential, no hint, and none of the endpoints the connection calls - see
  /// `toHealthView`, which is a different shape rather than the same shape
  /// with fields blanked.
  MEMBER
}

/// A buyer business, as a tenant.
///
/// Created lazily - the first time somebody in an account opens the
/// integrations area, an organisation is provisioned for them and they become
/// its OWNER. That is deliberately NOT a match on
/// `customer_profiles.organization`, which is free text somebody typed:
/// joining a tenant by typing its name is not an access-control decision, it
/// is an invitation to read a competitor's purchase orders. Additional people
/// join by invitation only, and an invitation is addressed to an email address
/// and accepted by whoever controls it.
model BuyerOrganization {
  id String @id @db.Char(26)

  /// What the buyer calls itself. Seeded from `customer_profiles.organization`
  /// where there is one, and from the account holder's own name where there is
  /// not, because "Organisation" as a heading over somebody's own screen is
  /// worse than their own name.
  name String @db.VarChar(255)

  /// Lowercased, punctuation-stripped `name`. Not unique, and deliberately so:
  /// two unrelated buyers may both be "City Medical Supplies", and refusing
  /// the second one to protect a namespace nobody navigates by would be
  /// absurd. It exists so support can find an organisation by name.
  nameNormalized String @db.VarChar(255)

  /// The profile that caused the organisation to exist. Kept for the trail;
  /// ownership itself lives in `buyer_organization_members`, because the
  /// founder can leave.
  createdByProfileId String? @db.Char(26)

  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)
  /// Soft delete. Connections, events and audit rows still read back.
  archivedAt DateTime? @db.DateTime(3)

  members     BuyerOrganizationMember[]
  invites     BuyerOrganizationInvite[]
  connections CustomerErpConnection[]
  auditLogs   CustomerErpAuditLog[]

  @@index([nameNormalized], map: "ix_buyer_org_name")
  @@map("buyer_organizations")
}

/// One person's place in one buyer organisation.
///
/// `customerProfileId` is UNIQUE: a profile belongs to at most one
/// organisation. That is a real restriction and it is the right one for now -
/// an account that could act for two buyers would need every screen in the
/// storefront to ask "as whom?", including the cart. When a buyer genuinely
/// needs that, the answer is a second account.
model BuyerOrganizationMember {
  id             String @id @db.Char(26)
  organizationId String @db.Char(26)

  customerProfileId String @unique(map: "uq_buyer_org_member_profile") @db.Char(26)

  role BuyerOrgRole @default(MEMBER)

  /// The member who brought them in. Null for the founder.
  invitedByProfileId String? @db.Char(26)

  joinedAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  organization    BuyerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile   @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, role], map: "ix_buyer_org_member_role")
  @@map("buyer_organization_members")
}

/// An outstanding invitation to join a buyer organisation.
///
/// Addressed to an email address rather than to an account: the person a buyer
/// wants to add very often has no account here yet. The token is stored as a
/// SHA-256 hash for the same reason a password-reset token is - a leaked
/// database must not hand somebody a working invitation.
model BuyerOrganizationInvite {
  id             String @id @db.Char(26)
  organizationId String @db.Char(26)

  /// Lowercased and trimmed. Compared against `users.emailNormalized` when the
  /// invitation is accepted, so an invitation sent to one address cannot be
  /// redeemed by somebody signed in as another.
  emailNormalized String       @db.VarChar(320)
  role            BuyerOrgRole @default(MEMBER)

  tokenHash String   @unique(map: "uq_buyer_org_invite_token") @db.Char(64)
  expiresAt DateTime @db.DateTime(3)

  invitedByProfileId  String?   @db.Char(26)
  acceptedAt          DateTime? @db.DateTime(3)
  acceptedByProfileId String?   @db.Char(26)
  revokedAt           DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)

  organization BuyerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, acceptedAt], map: "ix_buyer_org_invite_org")
  @@index([emailNormalized], map: "ix_buyer_org_invite_email")
  @@map("buyer_organization_invites")
}

// ---------------------------------------------------------------------------
// The buyer's ERP: what kind, where, and how it is spoken to
// ---------------------------------------------------------------------------

/// Which system is on the other end.
///
/// Three, and only three, because each one is a different piece of code with
/// different defaults, a different authentication story and a different idea of
/// what a purchase order looks like. "Generic connector with a dropdown" is how
/// an integration ends up half-working against everything.
enum CustomerErpSystem {
  /// SAP S/4HANA (cloud or on-premise) and older SAP ERP releases, spoken to
  /// over OData or the REST APIs a communication arrangement exposes. Carries
  /// company code, purchasing organisation and plant, which nothing else does.
  SAP
  /// monday.com. Not an ERP by pedigree, and genuinely used as one by a lot of
  /// buyers: boards for purchase orders, groups for status, columns for
  /// quantity and SKU. Spoken to over its GraphQL API.
  MONDAY
  /// Odoo. Its own member rather than a CUSTOM preset because JSON-RPC is a
  /// genuinely different protocol: one address, the method and model inside
  /// the body, integer ids instead of codes, and a fault that arrives with
  /// HTTP 200. Everything else in the catalogue that speaks REST or OData
  /// rides CUSTOM with a vendor preset - see `vendor-presets.ts`.
  ODOO
  /// Anything else with a documented HTTP API. REST/JSON by default, with
  /// OData and GraphQL available where the buyer's system speaks them.
  ///
  /// Most named ERPs land here: NetSuite, Dynamics 365, Zoho, Acumatica,
  /// Epicor, TCS iON and the rest are all REST or OData over OAuth 2.0, so
  /// they are a preset on top of this rather than a connector of their own.
  CUSTOM
}

/// The wire format of a custom connection.
///
/// Only meaningful for CUSTOM: SAP and monday are decided by their connectors.
enum CustomerErpApiStyle {
  REST_JSON
  ODATA
  GRAPHQL
}

/// Which of the buyer's landscapes this connection points at.
///
/// Not cosmetic. A SANDBOX connection is refused the automatic inventory write
/// - it may raise purchase orders in a test system all day, but it must never
/// be the thing that decides how much stock the buyer believes it has.
enum CustomerErpEnvironment {
  SANDBOX
  PRODUCTION
}

/// How the buyer's ERP authenticates us.
///
/// Deliberately not "API key, and everything else is an API key with a funny
/// name". A production SAP connection is a client-credentials grant against a
/// communication arrangement; a production monday connection is an OAuth
/// authorisation-code flow with named scopes; a personal token is a testing
/// convenience and is refused on a PRODUCTION connection for that reason.
enum CustomerErpAuthMethod {
  /// OAuth 2.0 client credentials. Machine-to-machine, no user present. The
  /// right answer for SAP, and for any custom ERP that offers it.
  OAUTH2_CLIENT_CREDENTIALS
  /// OAuth 2.0 authorisation code with PKCE. A person authorises us against
  /// their own ERP account. What monday.com production connections use, and
  /// available to custom connections whose ERP supports it.
  OAUTH2_AUTHORIZATION_CODE
  /// A key in a header or a query parameter the ERP names. `apiKeyLocation`
  /// and `apiKeyName` say which and what.
  API_KEY
  /// `Authorization: Bearer <token>`.
  BEARER_TOKEN
  /// `Authorization: Basic base64(user:pass)`. Offered because some SAP
  /// on-premise landscapes and some in-house APIs still require it, and
  /// refusing would mean telling a customer their system cannot be connected.
  /// Never a default, and never offered first in the UI.
  BASIC
  /// monday.com personal API token. Restricted to SANDBOX connections: it
  /// carries one person's full account authority, cannot be scoped, and does
  /// not die when they leave.
  MONDAY_PERSONAL_TOKEN
}

/// Where an API key goes.
enum CustomerErpApiKeyLocation {
  HEADER
  QUERY
}

/// How this platform reaches the buyer's ERP at all.
///
/// A description of the customer's network, recorded so that the instructions
/// their IT team needs can be shown back to them, and so that support has an
/// answer to "why can we not reach it". None of these change what the code
/// does except SAP_CLOUD_CONNECTOR and VPN_GATEWAY, which both mean the
/// address we are given is a gateway the customer runs, not the ERP itself.
enum CustomerErpNetworkMode {
  /// The ERP is on the public internet behind TLS. The ordinary case for SaaS.
  PUBLIC_HTTPS
  /// Public, but the customer's firewall admits only known source addresses.
  /// The connection screen shows them which to allow.
  IP_ALLOWLIST
  /// The customer terminates a VPN or private link at a gateway host and gives
  /// us that host's public name.
  VPN_GATEWAY
  /// SAP Cloud Connector or a comparable reverse proxy in front of an
  /// on-premise SAP. The address is the connector's, the virtual host mapping
  /// is the customer's business.
  SAP_CLOUD_CONNECTOR
}

/// Where a connection stands. The names the specification asked for, and the
/// transitions live in `customer-erp-state.ts`, which is the only thing allowed
/// to move a row between them.
enum CustomerErpConnectionState {
  /// Being filled in. Nothing runs, nothing is called, no event is queued.
  DRAFT
  /// A test or a dry run is in flight. Transient, and held in the row so a
  /// second test started from another tab does not run alongside the first.
  TESTING
  /// Live. Events dispatch, polling runs, webhooks are accepted.
  ACTIVE
  /// Stopped on purpose. Configuration intact; resuming needs no re-test.
  /// **Automatic writes stop immediately** - queued events are held, not
  /// dropped, and webhooks are refused, because accepting stock updates for a
  /// connection somebody deliberately stopped is the opposite of pausing.
  PAUSED
  /// Something needs a person: an expired refresh token, a mapping the ERP has
  /// started rejecting, an approval waiting. Distinct from FAILED because the
  /// connection is not broken - it is waiting.
  ACTION_REQUIRED
  /// Repeated failures took it out of service. Nobody chose this; the row
  /// carries the reason. Recovered by a passing test.
  FAILED
  /// Switched off and kept for its history. Credentials are destroyed on the
  /// way in - see `disconnectConnection` - and the row remains so the events
  /// that reference it still read back.
  DISCONNECTED
}

/// Where one unit of work stands. Also the names the specification asked for.
enum CustomerErpEventState {
  QUEUED
  PROCESSING
  SUCCEEDED
  /// Failed for a reason that may pass. `nextRetryAt` is set and the attempt
  /// count has not run out.
  RETRYING
  /// Retries exhausted, or a failure no retry can fix. The dead-letter state.
  /// A person retries it by hand once the cause is fixed, under the SAME
  /// idempotency key.
  FAILED
  /// Deliberately not done: the connection is paused, the policy says outbound
  /// only, the buyer's approval was refused, or the ERP already had it. Not a
  /// failure, and counted apart from one.
  SKIPPED
}

/// Every kind of thing that can be sent to, or read from, a buyer's ERP.
enum CustomerErpEventType {
  /// A test call. Never idempotency-keyed: a test may be run as often as
  /// anybody likes and changes nothing on the other side.
  CONNECTION_TEST
  /// A rehearsal. Reads, maps, reports and writes nothing anywhere.
  DRY_RUN
  /// An order was confirmed here. Raises the purchase order there.
  PURCHASE_ORDER_CREATE
  /// The order changed - cancelled, amended - and the ERP is told.
  PURCHASE_ORDER_UPDATE
  /// The order shipped. Carries carrier and tracking.
  SHIPMENT_STATUS
  /// The goods arrived. The ONLY event that may move on-hand stock.
  GOODS_RECEIPT
  /// An availability figure, pushed to or pulled from the ERP.
  INVENTORY_UPDATE
  /// An invoice was issued here: number, amounts, tax, due date, document URL.
  INVOICE_SYNC
  /// A payment settled. Carries the provider's reference and status, and
  /// nothing whatsoever about the instrument.
  PAYMENT_REFERENCE
  /// A scheduled read of the ERP, for a connection with no webhooks.
  INBOUND_POLL
  /// An inbound webhook, once it has been verified and accepted.
  INBOUND_WEBHOOK
}

/// Which way data is allowed to move on a connection.
enum CustomerErpSyncMode {
  /// We read the ERP and never write to it.
  INBOUND
  /// We write to the ERP and never read from it.
  OUTBOUND
  /// Both. Requires a conflict policy, which is why it is not the default:
  /// bidirectional sync without an answer to "who wins" is a data-loss bug
  /// waiting for its first disagreement.
  BIDIRECTIONAL
}

/// Whose figure is believed when the two systems disagree.
enum CustomerErpSourceOfTruth {
  ERP
  PLATFORM
}

/// What to do about a disagreement.
enum CustomerErpConflictPolicy {
  ERP_WINS
  PLATFORM_WINS
  /// Whichever record was updated most recently. Honest only where both sides
  /// carry a trustworthy timestamp, which is why it is not the default.
  NEWEST_WINS
  /// Neither. The divergence is recorded and a person is asked.
  MANUAL
}

/// Whether a stock write happens on its own.
enum CustomerErpWriteMode {
  /// The write goes through as soon as its event is processed.
  AUTOMATIC
  /// An approval is raised and the event holds at SKIPPED until somebody in
  /// the organisation decides. What a buyer mid-migration wants, and what the
  /// approval threshold produces once an order is large enough.
  APPROVAL_REQUIRED
}

/// What a connection's endpoint is for.
enum CustomerErpEndpointPurpose {
  PRODUCTS
  WAREHOUSES
  INVENTORY
  PURCHASE_ORDER_CREATE
  PURCHASE_ORDER_UPDATE
  GOODS_RECEIPT
  SHIPMENT_STATUS
  INVOICE
  PAYMENT_REFERENCE
  /// Not something we call. The address the buyer's ERP calls US on is derived
  /// from `webhookSlug`; this row records the ERP-side registration so the
  /// screen can tell somebody what they configured.
  WEBHOOK
}

/// How an endpoint pages.
enum CustomerErpPagination {
  NONE
  /// `?page=1&pageSize=100`, names configurable.
  PAGE_NUMBER
  /// `?offset=0&limit=100`, names configurable.
  OFFSET_LIMIT
  /// A cursor the previous response handed back, found at `cursorPath`.
  CURSOR
  /// OData's `@odata.nextLink`, followed as an absolute URL - and re-checked
  /// against the SSRF guard before it is, because it is a URL somebody else
  /// chose.
  ODATA_NEXT_LINK
}

/// Which side of the integration a mapped field belongs to.
enum CustomerErpMappingEntity {
  PRODUCT
  WAREHOUSE
  ORDER
  INVENTORY
  INVOICE
  PAYMENT
  /// Status vocabulary: what the ERP calls "released", "posted", "goods
  /// issued", against what this platform calls it.
  STATUS
}

/// What kind of secret a credential row holds.
///
/// One row per kind rather than one row with every column, because the kinds
/// have different lifetimes: an access token is replaced every hour, a client
/// secret every year or two, and a webhook secret when somebody rotates it.
enum CustomerErpCredentialKind {
  /// The long-lived thing the buyer typed: an API key, a bearer token, a
  /// username and password, an OAuth client id and secret.
  PRIMARY
  /// The short-lived thing an OAuth flow produced: access token, refresh
  /// token, expiry, granted scopes.
  OAUTH_TOKENS
  /// The HMAC key inbound webhooks are verified with.
  WEBHOOK_SIGNING
  /// A client certificate and private key for mutual TLS.
  CLIENT_CERTIFICATE
}

/// What an approval is asking permission for.
enum CustomerErpApprovalKind {
  /// A purchase order whose value is over the organisation's threshold.
  PURCHASE_ORDER
  /// A stock write on a connection whose policy is APPROVAL_REQUIRED.
  INVENTORY_WRITE
}

enum CustomerErpApprovalState {
  PENDING
  APPROVED
  REJECTED
  /// Nobody decided in time. The event stays SKIPPED and the connection says
  /// so, rather than a purchase order appearing three weeks late.
  EXPIRED
}

/// One buyer organisation's connection to one of its own systems.
///
/// An organisation may hold several - a sandbox and a production SAP, or SAP
/// for purchase orders and monday for visibility. The count is capped by
/// `CUSTOMER_ERP_MAX_CONNECTIONS_PER_ORG`.
model CustomerErpConnection {
  id             String @id @db.Char(26)
  organizationId String @db.Char(26)

  /// What the buyer calls this connection. Unique inside the organisation and
  /// nowhere else - two buyers may both call theirs "Production SAP".
  name String @db.VarChar(128)

  system      CustomerErpSystem
  apiStyle    CustomerErpApiStyle    @default(REST_JSON)
  environment CustomerErpEnvironment @default(SANDBOX)

  /// Which named ERP the buyer picked: `sap-s4hana`, `netsuite`, `tcs-ion`.
  ///
  /// The brand, where `system` is the protocol. Several brands share one
  /// protocol - NetSuite, Zoho and TCS iON are all CUSTOM - so without this a
  /// screen could only ever say "Custom", and support could not tell a
  /// misconfigured Dynamics from a misconfigured QuickBooks.
  ///
  /// Free text rather than an enum, deliberately: the catalogue in
  /// `vendor-presets.ts` is data that grows, and widening a MariaDB ENUM means
  /// a MODIFY COLUMN over every row to record something none of them said.
  /// An id that is no longer in the catalogue reads back as the raw string,
  /// which is worse than a label and far better than a failed query.
  vendorPreset String? @db.VarChar(48)

  /// The release the buyer says they are on: "S/4HANA 2023", "ECC 6.0 EhP8".
  /// Free text, shown back to support, and used by the SAP connector only to
  /// decide default paths.
  erpVersion String? @db.VarChar(64)

  state          CustomerErpConnectionState @default(DRAFT)
  /// Why it is where it is, in words safe to show on a screen. Never a
  /// provider body, never a header, never a credential.
  stateReason    String?                    @db.VarChar(512)
  stateChangedAt DateTime                   @default(now()) @db.DateTime(3)

  // --- Where -------------------------------------------------------------
  /// Scheme + host + optional port + optional base path. Re-validated on every
  /// request, not only on save: DNS moves, and a hostname that resolved
  /// publicly an hour ago can resolve to 169.254.169.254 now.
  baseUrl String @db.VarChar(1024)

  /// The API version segment or header value the ERP wants, where it wants
  /// one. Kept apart from `baseUrl` so it can be changed without retyping the
  /// address.
  apiVersion String? @db.VarChar(32)

  networkMode  CustomerErpNetworkMode @default(PUBLIC_HTTPS)
  /// Free text from the buyer's IT team: which virtual host the Cloud
  /// Connector maps, which VPN the gateway terminates. Shown back to them and
  /// to support. Never interpreted.
  networkNotes String?                @db.VarChar(1024)

  /// The buyer's own identifier for itself inside its ERP - a tenant id, a
  /// customer number, a monday account slug. Sent where the connector needs
  /// it. Not a secret, and treated as one anyway in logs.
  tenantIdentifier String? @db.VarChar(191)

  /// Extra headers every request carries. Names and NON-SECRET values only; a
  /// header carrying a secret goes in `customer_erp_credentials`, not in a
  /// column the API returns. Shape: `{"X-Company-Code":"1000"}`.
  customHeadersJson Json?

  /// Per-request ceiling, bounded on write (1s - 60s).
  timeoutMs Int @default(20000)

  // --- SAP-specific organisational keys ----------------------------------
  //
  // Null on every other system. Present here rather than in a JSON blob
  // because a purchase order that names the wrong plant is a real operational
  // failure and these deserve to be typed, indexed and validated.
  sapCompanyCode           String? @db.VarChar(8)
  sapPurchasingOrg         String? @db.VarChar(8)
  sapPurchasingGroup       String? @db.VarChar(8)
  sapPlant                 String? @db.VarChar(8)
  sapStorageLocation       String? @db.VarChar(8)
  /// The communication arrangement or scenario id, where the buyer set one up.
  sapCommunicationScenario String? @db.VarChar(64)

  // --- monday.com-specific placement --------------------------------------
  mondayWorkspaceId String? @db.VarChar(64)
  mondayBoardId     String? @db.VarChar(64)
  /// The group new purchase orders are created in.
  mondayGroupId     String? @db.VarChar(64)

  // --- Authentication ------------------------------------------------------
  authMethod CustomerErpAuthMethod @default(OAUTH2_CLIENT_CREDENTIALS)

  /// API_KEY only: where the key goes and what it is called.
  apiKeyLocation CustomerErpApiKeyLocation?
  apiKeyName     String?                    @db.VarChar(64)

  /// OAuth only. The URLs are the buyer's; the CLIENT SECRET is the
  /// operator's for monday (a registered app) and the buyer's for SAP and
  /// custom. Both live in `customer_erp_credentials` - never here.
  oauthAuthorizationUrl String? @db.VarChar(1024)
  oauthTokenUrl         String? @db.VarChar(1024)
  /// Space-separated, least-privilege, and shown to the buyer before they
  /// authorise so they can see what they are granting.
  oauthScope            String? @db.VarChar(512)
  /// True when the client secret comes from this deployment's configuration
  /// rather than from the buyer - which is how a registered monday app works.
  oauthUsesPlatformApp  Boolean @default(false)

  /// Whether requests present a client certificate. The certificate and its
  /// key live in `customer_erp_credentials`.
  mutualTlsEnabled Boolean @default(false)

  // --- Inbound webhooks ----------------------------------------------------
  //
  // The buyer's ERP calls US. There is no unsigned mode: an unauthenticated
  // endpoint that moves somebody's stock is not a feature.
  webhookEnabled          Boolean @default(false)
  /// Public, unguessable path segment: 32 bytes of CSPRNG, base64url. Not the
  /// authentication - the signature is - but it keeps the endpoint from being
  /// found by iterating ids.
  webhookSlug             String  @unique(map: "uq_customer_erp_webhook_slug") @db.VarChar(64)
  /// The header the ERP puts its signature in.
  webhookSignatureHeader  String  @default("X-UBOSS-Signature") @db.VarChar(64)
  /// The header carrying the signed timestamp, for replay protection. Where an
  /// ERP signs the timestamp into the signature header itself, this is null
  /// and the connector parses it out.
  webhookTimestampHeader  String? @db.VarChar(64)
  /// How far out of step with our clock an inbound webhook may be, in seconds.
  /// Outside it the delivery is refused: a signature stays valid for ever, so
  /// without this a captured request is a replay for ever too.
  webhookToleranceSeconds Int     @default(300)

  // --- Polling fallback ----------------------------------------------------
  pollingEnabled         Boolean   @default(false)
  /// Minutes rather than a cron expression: the question is "how fresh does
  /// this need to be", and every cron field beyond that is a way to get it
  /// wrong.
  pollingIntervalMinutes Int       @default(60)
  /// The IANA zone the buyer reads their own schedule in. Stored so a
  /// "hourly during business hours" answer stays possible, and shown on the
  /// dashboard so "next sync" is a time they recognise.
  pollingTimezone        String    @default("UTC") @db.VarChar(64)
  lastPolledAt           DateTime? @db.DateTime(3)
  nextPollAt             DateTime? @db.DateTime(3)
  /// Where the last incremental read got to. An opaque string - a timestamp, a
  /// change token, an OData delta link - whose meaning belongs to the
  /// connector. Null means "read everything next time".
  pollCursor             String?   @db.VarChar(512)

  // --- Test, verification and health ---------------------------------------
  lastTestAt         DateTime? @db.DateTime(3)
  lastTestOk         Boolean?
  lastTestHttpStatus Int?
  lastTestDurationMs Int?
  lastTestMessage    String?   @db.VarChar(512)

  /// Set when the mapping has been checked against a REAL response from this
  /// connection. Activation requires it, and any change to endpoints, mappings
  /// or authentication clears it: what the last check proved, it proved about
  /// a configuration that has since been replaced.
  mappingVerifiedAt DateTime? @db.DateTime(3)

  consecutiveFailures Int       @default(0)
  circuitOpenedAt     DateTime? @db.DateTime(3)

  lastSuccessAt DateTime? @db.DateTime(3)
  lastFailureAt DateTime? @db.DateTime(3)

  createdByProfileId String?   @db.Char(26)
  createdAt          DateTime  @default(now()) @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @db.DateTime(3)
  /// Soft delete. A connection with events behind it is retired rather than
  /// removed, so the ledger still explains what became of an order.
  deletedAt          DateTime? @db.DateTime(3)

  organization BuyerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  credentials    CustomerErpCredential[]
  endpoints      CustomerErpEndpoint[]
  fieldMappings  CustomerErpFieldMapping[]
  warehouseMaps  CustomerErpWarehouseMap[]
  policy         CustomerErpSyncPolicy?
  events         CustomerErpSyncEvent[]
  jobs           CustomerErpSyncJob[]
  webhookEvents  CustomerErpWebhookEvent[]
  orderLinks     CustomerErpOrderLink[]
  invoiceLinks   CustomerErpInvoiceLink[]
  inventoryLinks CustomerErpInventoryLink[]
  productCodes   CustomerErpProductCode[]
  approvals      CustomerErpApproval[]
  oauthStates    CustomerErpOAuthState[]

  @@unique([organizationId, name], map: "uq_customer_erp_connection_name")
  @@index([organizationId, state], map: "ix_customer_erp_connection_org_state")
  /// The polling sweep: active, polling on, due.
  @@index([state, pollingEnabled, nextPollAt], map: "ix_customer_erp_connection_poll_due")
  @@map("customer_erp_connections")
}

/// One encrypted secret belonging to one connection.
///
/// This table is the reason no other table has a secret column. Everything in
/// it is AES-256-GCM ciphertext with AAD binding it to
/// `customer_erp_credential:<connectionId>:<kind>`, so a row copied into
/// another connection fails authentication instead of decrypting into a
/// working credential. `payloadEnc` is a JSON object whose keys depend on
/// `kind`, and it is decrypted in exactly one module - `credential.service.ts`
/// - for the duration of one call.
///
/// **Nothing here is ever returned by any API.** `hint` is what a screen
/// shows: enough to recognise which key is configured, never enough to use it.
model CustomerErpCredential {
  id           String                    @id @db.Char(26)
  connectionId String                    @db.Char(26)
  kind         CustomerErpCredentialKind

  /// The envelope. `v1:<iv>:<tag>:<ciphertext>`, all base64url.
  payloadEnc String @db.Text

  /// `X-API-Key: sk_live...9f2a`, or `client 8f21...` - safe to return.
  hint String? @db.VarChar(191)

  /// When the secret this row holds stops working, where that is knowable: an
  /// OAuth access token's expiry, a certificate's notAfter. Null for a secret
  /// with no stated lifetime.
  expiresAt DateTime? @db.DateTime(3)

  /// What an OAuth grant actually came back with, which is not always what was
  /// asked for. Recorded so a buyer can be told "your ERP granted read but not
  /// write" rather than discovering it at the first purchase order.
  grantedScope String? @db.VarChar(512)

  rotatedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, kind], map: "uq_customer_erp_credential")
  @@index([kind, expiresAt], map: "ix_customer_erp_credential_expiry")
  @@map("customer_erp_credentials")
}

/// One address on the buyer's ERP, and how to talk to it.
///
/// A table rather than a JSON column on the connection because these are
/// edited one at a time, validated one at a time, and shown one per row on a
/// screen - and because "which endpoints has this buyer configured" is a
/// question support asks.
model CustomerErpEndpoint {
  id           String                     @id @db.Char(26)
  connectionId String                     @db.Char(26)
  purpose      CustomerErpEndpointPurpose

  /// Relative to the connection's base URL, or an absolute URL on the SAME
  /// origin. An endpoint free to leave the authorised host is an SSRF
  /// primitive with a form field in front of it, so off-origin is refused at
  /// save time and again before every call.
  path String @db.VarChar(512)

  method String @default("GET") @db.VarChar(8)

  /// Set on an endpoint the buyer has configured but does not want used yet.
  enabled Boolean @default(true)

  pagination           CustomerErpPagination @default(NONE)
  /// Query parameter names for the paging style in use, and where the records
  /// and the next cursor are found in the response. Shape depends on
  /// `pagination`; validated against a closed set of keys on write.
  paginationConfigJson Json?

  /// A dotted path to the array of records inside the response body. Null
  /// means the body IS the array, which is how about half of them answer.
  recordsPath String? @db.VarChar(191)

  /// A request body template for a POST/PUT endpoint, as JSON with
  /// `{{placeholder}}` markers filled from the mapping. Null means the
  /// connector builds the body itself, which is what SAP and monday do.
  requestTemplateJson Json?

  /// Query parameters sent on every call to this endpoint. Non-secret only.
  queryParamsJson Json?

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, purpose], map: "uq_customer_erp_endpoint")
  @@map("customer_erp_endpoints")
}

/// One platform field, and where it lives in the buyer's ERP.
///
/// `platformField` is from a closed list the service publishes - a buyer
/// cannot invent one, because nothing would read it. `erpPath` is a dotted
/// path into the ERP's own JSON for reads, and the field name to write for
/// writes; for monday it is a column id.
model CustomerErpFieldMapping {
  id           String                   @id @db.Char(26)
  connectionId String                   @db.Char(26)
  entity       CustomerErpMappingEntity

  /// e.g. `sku`, `quantity`, `unitOfMeasure`, `purchaseOrderNumber`.
  platformField String @db.VarChar(64)
  erpPath       String @db.VarChar(191)

  /// A constant used when the ERP has no field for this and wants one anyway -
  /// a fixed document type, a fixed currency. Mutually exclusive with
  /// `erpPath` being meaningful, and the service refuses both empty.
  constantValue String? @db.VarChar(191)

  /// For STATUS mappings: what the ERP calls a state, against what this
  /// platform calls it. `platformField` holds the platform status and this
  /// holds the ERP's word for it.
  erpValue String? @db.VarChar(128)

  /// A named, closed-set transform applied on the way through: `TRIM`,
  /// `UPPERCASE`, `MINOR_TO_DECIMAL`, `DECIMAL_TO_MINOR`, `ISO_DATE`. Not an
  /// expression language - a mapping that can run arbitrary code is a remote
  /// code execution primitive somebody types into a form.
  transform String? @db.VarChar(32)

  required Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, entity, platformField, erpValue], map: "uq_customer_erp_field_mapping")
  @@index([connectionId, entity], map: "ix_customer_erp_field_mapping_entity")
  @@map("customer_erp_field_mappings")
}

/// A warehouse here against a plant, storage location or board group there.
///
/// `inventoryLocationId` has no foreign key on purpose, and this is the same
/// choice `integration_events.orderId` makes: a buyer's mapping row must not
/// be able to stop an operator archiving a warehouse, and a mapping naming a
/// location that no longer exists is a mapping error to report rather than a
/// referential integrity failure to crash on.
model CustomerErpWarehouseMap {
  id           String @id @db.Char(26)
  connectionId String @db.Char(26)

  /// The platform warehouse, or NULL for the fallback used when an order ships
  /// from somewhere unmapped. At most one fallback per connection, enforced in
  /// the service - a MariaDB UNIQUE treats every NULL as distinct, so the
  /// index below could not express it.
  inventoryLocationId String? @db.Char(26)

  /// The ERP's word for the same place.
  erpPlant           String? @db.VarChar(32)
  erpStorageLocation String? @db.VarChar(32)
  /// monday: the board and group this warehouse's lines are created in, where
  /// the buyer splits them by site.
  erpBoardId         String? @db.VarChar(64)
  erpGroupId         String? @db.VarChar(64)

  isFallback Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, inventoryLocationId], map: "uq_customer_erp_warehouse_map")
  @@map("customer_erp_warehouse_maps")
}

/// What this connection is allowed to do, and when.
///
/// One row per connection. Separate from the connection itself because these
/// are the answers a buyer's finance function gives, the connection is the
/// answer their IT function gives, and the two are edited by different people
/// on different days.
model CustomerErpSyncPolicy {
  id           String @id @db.Char(26)
  connectionId String @unique(map: "uq_customer_erp_policy_connection") @db.Char(26)

  sourceOfTruth  CustomerErpSourceOfTruth  @default(PLATFORM)
  mode           CustomerErpSyncMode       @default(OUTBOUND)
  conflictPolicy CustomerErpConflictPolicy @default(MANUAL)

  /// Whether an on-hand stock write happens by itself or waits for somebody.
  inventoryWriteMode CustomerErpWriteMode @default(APPROVAL_REQUIRED)

  /// Whether a delivery recorded on this platform is enough to receipt goods,
  /// or whether the buyer's own ERP must say so.
  ///
  /// Default false, and that is the conservative direction: a buyer whose
  /// warehouse scans everything in wants their own goods receipt to be the
  /// trigger, and a platform "delivered" status that moved their stock before
  /// the crate was opened would be worse than useless.
  receiptOnPlatformDelivery Boolean @default(false)

  /// Purchase orders at or above this are held for approval before they reach
  /// the ERP. Minor units, in `approvalCurrency`. Null means no threshold.
  approvalThresholdMinor BigInt?
  approvalCurrency       String? @db.Char(3)

  /// How long an approval request waits before it expires.
  approvalExpiryHours Int @default(72)

  /// Which events this connection actually sends. A buyer may want purchase
  /// orders and nothing else, and switching an event off is not the same as
  /// having no endpoint for it.
  sendPurchaseOrders    Boolean @default(true)
  sendShipmentStatus    Boolean @default(true)
  sendGoodsReceipts     Boolean @default(true)
  sendInvoices          Boolean @default(true)
  sendPaymentReferences Boolean @default(true)
  syncInventory         Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("customer_erp_sync_policies")
}

// ---------------------------------------------------------------------------
// The ledger: what was sent, what came back, and what it became
// ---------------------------------------------------------------------------

/// One unit of work against a buyer's ERP. The outbox.
///
/// Everything that touches a buyer's ERP goes through a row here, including
/// the things that turn out not to need a call at all. That is what makes
/// "why did my purchase order not appear" answerable: there is always a row,
/// and it always says what happened.
///
/// **`idempotencyKey` is the duplicate guard and it is unique across the whole
/// table.** It is built from
/// `organizationId:orderId:eventType:eventVersion` - a value derived entirely
/// from the thing that happened, never from the clock and never from a random
/// source - so a retry, a redelivered payment webhook and a second worker all
/// derive the same key and only one of them creates the row. The others find
/// it. That is the single most important property in this feature: an ERP that
/// received a purchase order and then received it again has a duplicate
/// liability on its books.
model CustomerErpSyncEvent {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  /// Denormalised from the connection so every tenant-scoped query is one
  /// index lookup rather than a join, and so a query that FORGETS to scope by
  /// tenant is a query that fails review rather than one that quietly works.
  organizationId String @db.Char(26)

  eventType CustomerErpEventType
  state     CustomerErpEventState @default(QUEUED)

  /// `<organizationId>:<subject>:<eventType>:v<n>`. See the model comment.
  idempotencyKey String @unique(map: "uq_customer_erp_event_idempotency") @db.VarChar(191)

  /// Bumped when the platform-side facts behind an event change in a way the
  /// ERP needs to hear about - an order amended after its purchase order was
  /// raised. A new version is a new key, and therefore a new event, which is
  /// exactly right: it is a different thing to tell them.
  eventVersion Int @default(1)

  // --- What it is about ---------------------------------------------------
  //
  // No foreign keys, deliberately. A ledger row must outlive the thing it
  // describes, and an ON DELETE RESTRICT here would make a buyer's integration
  // history a reason an operator cannot tidy up an order.
  orderId      String? @db.Char(26)
  occurrenceId String? @db.Char(26)
  invoiceId    String? @db.Char(26)
  productId    String? @db.Char(26)

  /// Shared with every log line, audit row and child event this operation
  /// produces, so one incident reads back as one story. This is the id the
  /// dashboard's log search is keyed on.
  correlationId String @db.VarChar(64)

  /// The mapped request as it was actually sent, with every credential
  /// redacted and the size capped. Kept because a disagreement about a
  /// purchase order is settled by what was exchanged, and reconstructed
  /// evidence is not evidence.
  requestJson  Json?
  /// The ERP's answer, same treatment.
  responseJson Json?

  /// What the ERP called the thing it created. The reason the next event about
  /// the same order knows what to update.
  erpReference String? @db.VarChar(191)

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime? @db.DateTime(3)
  nextRetryAt   DateTime? @db.DateTime(3)

  httpStatus Int?
  durationMs Int?

  errorCode    String? @db.VarChar(64)
  /// Safe to read: no credential, no Authorization header, no verbatim
  /// provider body. `safeErrorMessage` is the only thing that writes here.
  errorMessage String? @db.VarChar(1024)

  /// Why this was SKIPPED, when it was. A different question from why
  /// something failed, and a buyer asks it just as often.
  skipReason String? @db.VarChar(255)

  /// The approval this event is waiting on, where it is waiting on one.
  approvalId String? @db.Char(26)

  /// The lease that stops two workers processing the same event. The same
  /// device the job queue uses, and for the same MariaDB 10.4 reason: there is
  /// no `SKIP LOCKED`, so claiming is a conditional UPDATE plus an
  /// affected-rows check.
  leaseOwner     String?   @db.VarChar(64)
  leaseExpiresAt DateTime? @db.DateTime(3)

  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt], map: "ix_customer_erp_event_org_time")
  @@index([connectionId, state, createdAt], map: "ix_customer_erp_event_conn_state")
  @@index([orderId], map: "ix_customer_erp_event_order")
  /// The dispatch sweep: due now, not yet claimed.
  @@index([state, nextRetryAt], map: "ix_customer_erp_event_due")
  @@map("customer_erp_sync_events")
}

/// One pass of scheduled or manual work, and what it did.
///
/// A job groups events: "sync now" produces one job and however many events it
/// turns out to need. Kept apart from the events themselves so the dashboard
/// can say "last sync: 14:05, 312 records, 2 failed" without counting rows.
model CustomerErpSyncJob {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  organizationId String @db.Char(26)

  /// MANUAL, SCHEDULED, WEBHOOK or RETRY. A closed set validated in the
  /// service; a string here rather than a fifteenth enum, because nothing
  /// branches on it - it is reported, not decided upon.
  trigger String @db.VarChar(16)

  /// RUNNING, SUCCEEDED, PARTIAL, FAILED or RATE_LIMITED. Same reasoning.
  status String @default("RUNNING") @db.VarChar(16)

  /// A dry run reads, maps and reports, and writes nothing on either side.
  isDryRun Boolean @default(false)

  correlationId String @db.VarChar(64)

  startedAt  DateTime  @default(now()) @db.DateTime(3)
  finishedAt DateTime? @db.DateTime(3)

  processedCount Int @default(0)
  succeededCount Int @default(0)
  skippedCount   Int @default(0)
  failedCount    Int @default(0)
  conflictCount  Int @default(0)

  /// Set when the ERP asked us to slow down. Rendered as "paused until", which
  /// is the only part of a 429 anybody needs.
  rateLimitedUntil DateTime? @db.DateTime(3)

  /// Where this pass got to, written back to the connection only when the pass
  /// finishes cleanly. A cursor advanced by a run that failed halfway is how
  /// records get skipped for ever.
  cursorAfter String? @db.VarChar(512)

  errorCode    String? @db.VarChar(64)
  errorMessage String? @db.VarChar(1024)

  /// The member who pressed the button, for a manual run.
  startedByProfileId String? @db.Char(26)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt], map: "ix_customer_erp_job_conn_time")
  @@index([organizationId, startedAt], map: "ix_customer_erp_job_org_time")
  @@map("customer_erp_sync_jobs")
}

/// An inbound webhook, once it has been through the door.
///
/// The row is written BEFORE the payload is acted on and the unique index is
/// what makes a redelivery a no-op. An ERP that retries - and they all retry -
/// must not apply the same goods receipt twice, and the honest place to stop
/// that is at the door, keyed on whatever identifier the ERP sends. Where it
/// sends none, the service uses `sha256:<hex>` of the raw body: two genuinely
/// identical bodies inside the window are indistinguishable from a redelivery,
/// and for a stock movement treating them as one is the safe direction to be
/// wrong in.
model CustomerErpWebhookEvent {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  organizationId String @db.Char(26)

  /// The ERP's event id, or `sha256:<hex>` of the raw body.
  externalEventId String @db.VarChar(191)

  /// What the ERP said this was about, as it named it. Not interpreted before
  /// the signature has verified.
  externalEventType String? @db.VarChar(128)

  /// Whether the signature, the timestamp and the replay window all passed.
  /// A row exists either way: a rejected delivery is exactly the thing an
  /// operator needs to see, and dropping it silently is how a buyer spends a
  /// week wondering why nothing arrives.
  verified        Boolean @default(false)
  /// Why it was refused, in words safe to show. Never says WHICH check failed
  /// in a response - an endpoint that distinguishes "wrong signature" from "no
  /// secret configured" is an oracle - but the row itself may record it,
  /// because the row is only ever read by the buyer who owns it.
  rejectionReason String? @db.VarChar(255)

  /// The signed timestamp the ERP sent, where it sent one.
  signedAt DateTime? @db.DateTime(3)

  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)

  /// The event this delivery produced, once it produced one. Null for a
  /// duplicate, a rejection, or a payload the connection had no rule for.
  syncEventId String? @db.Char(26)

  /// The body, redacted and capped. The evidence behind "we did receive it".
  payloadJson Json?

  correlationId String @db.VarChar(64)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId], map: "uq_customer_erp_webhook_event")
  @@index([connectionId, receivedAt], map: "ix_customer_erp_webhook_conn_time")
  @@map("customer_erp_webhook_events")
}

/// A platform order against whatever the buyer's ERP made of it.
///
/// One row per order per connection. This is the row that answers "did my
/// purchase order get raised, and what is it called over there" - the single
/// most-asked question this feature has to answer - and it is also what stops
/// the second attempt raising a second purchase order.
model CustomerErpOrderLink {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  organizationId String @db.Char(26)

  orderId      String  @db.Char(26)
  /// Set when a scheduled delivery caused this. Every occurrence of a schedule
  /// goes through the same pipeline as an instant purchase and gets its own
  /// link row, because each one is a separate delivery the buyer receipts
  /// separately.
  occurrenceId String? @db.Char(26)

  /// What the ERP calls the purchase order it created.
  erpPurchaseOrderId     String? @db.VarChar(191)
  /// The human-readable number, where the ERP has both.
  erpPurchaseOrderNumber String? @db.VarChar(64)
  /// The ERP's own status word for it, kept verbatim so support can quote it.
  erpOrderStatus         String? @db.VarChar(64)

  /// The ERP's goods receipt, once there is one. Its presence is what makes an
  /// on-hand stock write legitimate.
  erpGoodsReceiptId String?   @db.VarChar(191)
  goodsReceiptedAt  DateTime? @db.DateTime(3)

  /// Where the quantities stand in the buyer's ERP, as we last knew. Not a
  /// stock ledger - it is a record of what we told them and what they told us,
  /// so a divergence is visible rather than silently reconciled.
  onOrderQty  Int @default(0)
  receivedQty Int @default(0)

  /// The carrier and tracking last synced.
  shipmentStatus String? @db.VarChar(64)
  trackingNumber String? @db.VarChar(128)

  pushedAt     DateTime? @db.DateTime(3)
  lastSyncedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, orderId], map: "uq_customer_erp_order_link")
  @@index([organizationId, createdAt], map: "ix_customer_erp_order_link_org")
  @@index([erpPurchaseOrderId], map: "ix_customer_erp_order_link_erp_po")
  @@map("customer_erp_order_links")
}

/// A platform invoice against the buyer's copy of it.
///
/// Amounts are BigInt minor units here as everywhere. An invoice total that
/// crossed this boundary as a float would eventually disagree with the
/// document by a unit, and a buyer whose accounts payable disagrees with the
/// PDF by a unit will not pay either of them.
model CustomerErpInvoiceLink {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  organizationId String @db.Char(26)

  invoiceId String  @db.Char(26)
  orderId   String? @db.Char(26)

  erpInvoiceId     String? @db.VarChar(191)
  erpInvoiceNumber String? @db.VarChar(64)

  /// What we told them it was for. Frozen at sync time rather than read back
  /// from the invoice, so a later credit note does not silently rewrite what
  /// was sent.
  currency        String    @db.Char(3)
  grandTotalMinor BigInt
  taxMinor        BigInt    @default(0)
  dueAt           DateTime? @db.DateTime(3)
  /// Where the buyer's own systems can fetch the document. A URL on THIS
  /// platform - we do not send them somebody else's.
  documentUrl     String?   @db.VarChar(1024)

  /// The provider's reference for the money, once it has moved. A reference
  /// and a status: never a card number, never a bank account, never a token.
  /// The buyer's ERP has no business holding an instrument and this platform
  /// has no business handing one over.
  paymentReference String?   @db.VarChar(191)
  paymentStatus    String?   @db.VarChar(32)
  paymentSyncedAt  DateTime? @db.DateTime(3)

  syncedAt  DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, invoiceId], map: "uq_customer_erp_invoice_link")
  @@index([organizationId, createdAt], map: "ix_customer_erp_invoice_link_org")
  @@map("customer_erp_invoice_links")
}

/// A product here against a material number there, and the quantities each
/// side believes.
///
/// The row that makes "on order" a real number rather than an inference.
/// `variantKey` is the same device the cart, the schedule and the wishlist use
/// and for the same MariaDB reason recorded in this file's header: a UNIQUE
/// index treats every NULL as distinct, so a nullable variantId inside the
/// composite unique would not stop a duplicate.
model CustomerErpInventoryLink {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  organizationId String @db.Char(26)

  productId  String @db.Char(26)
  /// The variant ULID, or '' for the base product. Never null.
  variantKey String @default("") @db.Char(26)

  /// The ERP's identifier for the same thing: a material number, a SKU, a
  /// monday item id.
  erpMaterialNumber String? @db.VarChar(191)
  /// The warehouse this row is about, where the buyer keeps stock per site.
  erpPlant          String? @db.VarChar(32)

  /// Quantities as the buyer's ERP last reported them, or as we last asked it
  /// to record. NOT a stock ledger for this platform - `inventory_balances` is
  /// that, and nothing here writes it.
  onOrderQty  Int @default(0)
  incomingQty Int @default(0)
  onHandQty   Int @default(0)

  /// The unit the ERP counts in, where it differs from ours. Recorded rather
  /// than converted: a box of 10 quietly treated as 10 boxes is the classic
  /// integration disaster, and the mapping's `unitOfMeasure` is where a
  /// conversion is stated deliberately.
  erpUnitOfMeasure String? @db.VarChar(16)

  /// The last event whose figures were applied, so a webhook that arrives out
  /// of order can be recognised as stale rather than applied over a newer one.
  lastAppliedEventId String?   @db.Char(26)
  lastSyncedAt       DateTime? @db.DateTime(3)

  /// Set when the two sides disagreed and the policy said MANUAL. Cleared when
  /// somebody resolves it.
  divergenceNote String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, productId, variantKey, erpPlant], map: "uq_customer_erp_inventory_link")
  @@index([organizationId, updatedAt], map: "ix_customer_erp_inventory_link_org")
  @@index([erpMaterialNumber], map: "ix_customer_erp_inventory_link_material")
  @@map("customer_erp_inventory_links")
}

/// "Their code X is our product Y."
///
/// The answer to the problem every buyer meets on their first real sync, and
/// the one thing the rest of this feature could not solve on its own: the two
/// catalogues are keyed differently and nothing in either of them says how they
/// correspond.
///
/// A worked example from a live connection. The buyer's monday board holds 708
/// finished-goods codes (`FG/1BZ1B1-G`); the store's catalogue holds 247
/// products (`EV-CANNULA-WP`). Both carry a barcode column, which would have
/// been the obvious join - and the catalogue's is empty on every row. There is
/// no identifier in common. A sync therefore read 708 records and recorded one,
/// which was a coincidence.
///
/// `reconcile.service.ts` already said matching is on SKU "exactly... until
/// somebody says otherwise". This table is where somebody says otherwise.
///
/// WHY PER CONNECTION AND NOT ON THE PRODUCT
///
/// The obvious shortcut is a `supplierCode` column on `Product`. It is wrong
/// here for a reason that is structural rather than stylistic: **this software
/// is sold to companies who run it themselves**, and one product is bought by
/// many organisations who each call it something different in their own ERP.
/// A code on the product row can hold exactly one of those answers.
///
/// NO `createdByProfileId`
///
/// Deliberately absent. Who created a mapping is a question the org audit log
/// already answers - `recordOrgAudit` writes `mapping.linked` with the actor -
/// and copying a person's id into a table of catalogue mappings would put
/// personal data somewhere the Art. 15 export would then have to account for,
/// to record something already recorded properly elsewhere.
model CustomerErpProductCode {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  organizationId String @db.Char(26)

  /// Their code, byte for byte as their system sends it.
  ///
  /// Never trimmed of punctuation, never case-folded, never normalised. The
  /// whole value of this table is that it is an exact statement somebody made;
  /// a lookup that guessed would attach a stock figure to the wrong item and
  /// be believed. `FG/1BZ1B1-G` and `fg/1bz1b1-g` are two different codes
  /// until a person maps both.
  erpCode String @db.VarChar(191)

  productId String @db.Char(26)

  /// The variant ULID, or '' for the base product.
  ///
  /// Never null, and that is the MariaDB rule rather than a preference: a
  /// UNIQUE index treats every NULL as distinct, so a nullable column here
  /// would let the same code be mapped twice and the unique below would not
  /// notice. Same convention as `CustomerErpInventoryLink`.
  variantKey String @default("") @db.Char(26)

  /// Why this mapping exists, for whoever reads it in a year.
  note String? @db.VarChar(512)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, map: "fk_customer_erp_product_code_connection")

  /// One product per code, per connection. Their system cannot mean two of our
  /// products by one code; if it does, that is two codes.
  ///
  /// The reverse is deliberately NOT unique: a buyer whose ERP holds the same
  /// item under an old code and a new one maps both to the one product here,
  /// and both should resolve.
  @@unique([connectionId, erpCode], map: "uq_customer_erp_product_code")
  @@index([connectionId, productId], map: "ix_customer_erp_product_code_product")
  @@index([organizationId], map: "ix_customer_erp_product_code_org")
  @@map("customer_erp_product_codes")
}

/// Somebody in the buyer's organisation being asked before a write happens.
///
/// Raised when a purchase order is over the organisation's threshold, or when
/// the policy says stock writes need a person. The event that raised it holds
/// at SKIPPED and names this row; approving it re-queues the SAME event under
/// the SAME idempotency key, which is what stops an approval producing a
/// second purchase order.
model CustomerErpApproval {
  id             String @id @db.Char(26)
  connectionId   String @db.Char(26)
  organizationId String @db.Char(26)

  kind  CustomerErpApprovalKind
  state CustomerErpApprovalState @default(PENDING)

  /// The event waiting on this decision.
  syncEventId String @db.Char(26)

  orderId String? @db.Char(26)

  /// What is being approved, in money, where money is what makes it need
  /// approving. Minor units.
  amountMinor BigInt?
  currency    String? @db.Char(3)

  /// A sentence the approver can act on: "Purchase order for order UB-2026-
  /// 000123, EUR 14,200.00, above your EUR 10,000.00 threshold."
  summary String @db.VarChar(512)

  requestedAt DateTime @default(now()) @db.DateTime(3)
  expiresAt   DateTime @db.DateTime(3)

  decidedByProfileId String?   @db.Char(26)
  decidedAt          DateTime? @db.DateTime(3)
  decisionNote       String?   @db.VarChar(512)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([syncEventId], map: "uq_customer_erp_approval_event")
  @@index([organizationId, state, requestedAt], map: "ix_customer_erp_approval_org_state")
  /// The expiry sweep.
  @@index([state, expiresAt], map: "ix_customer_erp_approval_expiry")
  @@map("customer_erp_approvals")
}

/// An OAuth authorisation-code flow in flight.
///
/// Exists for the ninety seconds between "the buyer pressed Connect" and "the
/// ERP redirected them back", and holds the two things that make the callback
/// safe: the `state` that proves the callback belongs to this flow and this
/// member, and the PKCE verifier that proves the code is being redeemed by
/// whoever asked for it. The verifier is encrypted like any other secret,
/// because for its short life it is one.
///
/// Rows are consumed on use and swept on expiry. A callback for a state that
/// is not here - or is here and already used - is refused without saying
/// which.
model CustomerErpOAuthState {
  id           String @id @db.Char(26)
  connectionId String @db.Char(26)

  /// The `state` parameter, unguessable, unique, and single-use.
  stateToken String @unique(map: "uq_customer_erp_oauth_state") @db.VarChar(64)

  /// PKCE `code_verifier`, encrypted with AAD binding it to this row.
  codeVerifierEnc String @db.Text

  /// The exact redirect URI sent to the authorisation server. Sent again at
  /// token exchange, where the spec requires it to match.
  redirectUri String @db.VarChar(1024)

  /// Who started it. The callback is refused unless the session belongs to the
  /// same member - otherwise a leaked authorisation URL lets somebody else
  /// bind their ERP account to this buyer's connection.
  startedByProfileId String @db.Char(26)

  expiresAt  DateTime  @db.DateTime(3)
  consumedAt DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)

  connection CustomerErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "ix_customer_erp_oauth_state_expiry")
  @@map("customer_erp_oauth_states")
}

/// The buyer's own audit trail over their own integration.
///
/// Separate from `audit_logs`, which is the OPERATOR's and is readable only by
/// staff holding `audit.read`. A buyer must be able to answer "who changed our
/// SAP credentials last Tuesday" without asking their supplier, and must not
/// be able to read anybody else's answer to the same question. Two tables is
/// the honest way to have both.
///
/// Values are redacted on the way in by the same rules the operator trail
/// uses: a secret's KEY is recorded so "the client secret was rotated" stays
/// visible, and its VALUE never is.
model CustomerErpAuditLog {
  id             String @id @db.Char(26)
  organizationId String @db.Char(26)

  connectionId String? @db.Char(26)

  /// `connection.created`, `credential.rotated`, `mapping.updated`,
  /// `connection.activated`, `event.retried`. A closed set in the service.
  action String @db.VarChar(64)

  /// Which member did it. Null for something the system did on its own - a
  /// token refresh, a circuit opening.
  actorProfileId String? @db.Char(26)
  /// Their email as it was, so the row still reads after they leave.
  actorEmail     String? @db.VarChar(320)

  resourceType String  @db.VarChar(48)
  resourceId   String? @db.Char(26)

  beforeJson Json?
  afterJson  Json?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  correlationId String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.DateTime(3)

  organization BuyerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt], map: "ix_customer_erp_audit_org_time")
  @@index([connectionId, createdAt], map: "ix_customer_erp_audit_conn_time")
  @@index([action], map: "ix_customer_erp_audit_action")
  @@map("customer_erp_audit_logs")
}

// ===========================================================================
// SELLER HUB — third-party sellers on the marketplace
//
// One decision shapes everything below it: a seller is a TENANT, not a flag on
// a user. `SellerAccount` is the tenant, `SellerMember` puts a person in it,
// and every seller-owned row carries `sellerAccountId`. That is what makes
// "one seller cannot read another seller's orders" a property of the schema
// rather than a line in a code review.
//
// The second decision is the split between a CATALOGUE PRODUCT and a SELLER
// OFFER. Ten sellers offering the same infusion pump produce one `Product` row
// and ten `SellerOffer` rows. Putting a price on the product would make "the
// same product" mean "the same price", which is the one thing a marketplace
// cannot say.
//
// Money here obeys the same rule as everywhere else in this schema: BigInt
// minor units, never a Float, including commission and payout figures.
// ===========================================================================

/// Where a seller's application has got to.
///
/// The order matters: this is a state machine, enforced in
/// `domain/seller-state.ts`, and nothing writes this column directly - the
/// same rule `OrderStatus` and `ScheduleStatus` follow, for the same reason.
/// An application decides whether a business may put medical devices in front
/// of hospitals, so "how did it get to APPROVED" must always have an answer.
enum SellerApplicationStatus {
  /// Being filled in. The only state the seller may edit freely.
  DRAFT
  /// Handed to the operator. The seller can look but not change.
  SUBMITTED
  /// An administrator has picked it up.
  UNDER_REVIEW
  /// Sent back with a reason. Editable again, and the reason is seller-visible.
  ACTION_REQUIRED
  /// May sell. The only state in which a listing can be submitted.
  APPROVED
  /// Refused. Resubmission is allowed only if the operator left it open.
  REJECTED
  /// Was approved, now stopped. Existing orders stay; new listings and new
  /// orders do not. Distinct from REJECTED because the history is different
  /// and so is the way back.
  SUSPENDED
}

/// What a seller is, commercially. Decides which compliance evidence the
/// onboarding asks for - a manufacturer needs a Declaration of Conformity, a
/// reseller needs an authorisation from whoever does.
enum SellerKind {
  MANUFACTURER
  AUTHORISED_DISTRIBUTOR
  WHOLESALER
  RESELLER
}

/// Who somebody is inside one seller organisation.
///
/// Seven, from the brief, and they are not interchangeable with the operator's
/// admin roles in `domain/permissions.ts`: these grant authority over ONE
/// seller's own data and nothing else. A Seller Owner is not an administrator
/// of this marketplace and must never be able to become one.
enum SellerMemberRole {
  /// Everything, including inviting people, accepting the agreement and
  /// handing ownership on. At least one exists at all times.
  OWNER
  /// Everything except changing who is in the organisation and the legal
  /// agreements.
  ADMIN
  /// Listings, brands, media, product data. No payouts, no team.
  CATALOGUE_MANAGER
  /// Stock, warehouses, reorder thresholds, ERP inventory sync.
  INVENTORY_MANAGER
  /// Orders, shipments, returns.
  ORDER_MANAGER
  /// Settlements, payouts, statements. Read-only - a marketplace seller does
  /// not move their own money from here.
  FINANCE_VIEWER
  /// Reads orders and returns to answer a buyer. No money, no catalogue.
  SUPPORT_MEMBER
}

/// A seller business, as a tenant.
///
/// Created the moment somebody presses "Become a seller" and completes
/// authentication - not when they are approved. An application has to live
/// somewhere while it is being written, and giving a half-finished application
/// its own tenant from the start means the resume-later path is just "read
/// your own rows" rather than a second storage mechanism for drafts.
///
/// `displayName` is the public shopfront name and is UNIQUE through
/// `displayNameNormalized`, because a buyer choosing between two offers needs
/// the seller names to mean something. `legalName` is not unique: two
/// unrelated businesses genuinely can be registered under the same name in
/// different countries.
model SellerAccount {
  id String @id @db.Char(26)

  /// The registered business name, as it appears on the registration document.
  legalName String @db.VarChar(255)

  /// What buyers see. Chosen by the seller, checked for availability, and
  /// changeable only while the application is not yet approved - afterwards it
  /// is an operator action, because it appears on orders already placed.
  displayName           String @db.VarChar(160)
  /// Lowercased, punctuation-stripped `displayName`. UNIQUE - this is the
  /// public namespace.
  displayNameNormalized String @unique(map: "uq_seller_display_name") @db.VarChar(160)

  /// URL fragment for the public seller page. Derived from `displayName`.
  slug String @unique(map: "uq_seller_slug") @db.VarChar(180)

  kind SellerKind @default(RESELLER)

  status SellerApplicationStatus @default(DRAFT)

  /// ISO-3166-1 alpha-2. Decides which onboarding requirements apply - see
  /// `SellerOnboardingRequirement`. NOT a hard-coded list of Indian fields:
  /// this product is sold to companies who operate in their own countries.
  registrationCountry String @db.Char(2)

  /// What the seller trades in. Shown on the public seller page.
  description String? @db.Text

  /// The seller's own mark, for their own shop front.
  ///
  /// An object key, like `SellerDocument.storageKey`, and deliberately NOT a
  /// `MediaAsset` relation: that table is the operator's catalogue library,
  /// reachable from their media picker and counted in their reports, and a
  /// seller's brand mark does not belong in it.
  ///
  /// Null is a working state, not missing data. A seller who has not uploaded
  /// one gets a shop front rendering their initial, which is better than
  /// showing the operator's logo above a seller's name.
  logoStorageKey String? @db.VarChar(512)

  /// Seller-visible reason for the current status, when there is one. Written
  /// on ACTION_REQUIRED, REJECTED and SUSPENDED. Kept apart from
  /// `internalNotes`, which the seller never sees - conflating the two is how
  /// an operator's private assessment ends up on a seller's screen.
  statusReason  String? @db.Text
  /// Operator-only. Never serialised to a seller route.
  internalNotes String? @db.Text

  /// Whether a rejected application may be started again. False means the
  /// operator closed the door and a new attempt needs them to reopen it.
  resubmissionAllowed Boolean @default(true)

  /// The commission the operator takes, in basis points (250 = 2.50%). A
  /// SETTING with a null default meaning "use the platform rate", never a
  /// hard-coded percentage: what a marketplace charges is a business decision
  /// each deployment makes for itself.
  commissionBasisPoints Int? @db.SmallInt

  /// Rolled-up performance, recomputed by the worker. Nullable because a
  /// seller with no orders has no score, which is different from a score of
  /// zero.
  qualityScore Decimal? @db.Decimal(5, 2)

  submittedAt DateTime? @db.DateTime(3)
  reviewedAt  DateTime? @db.DateTime(3)
  approvedAt  DateTime? @db.DateTime(3)
  suspendedAt DateTime? @db.DateTime(3)

  /// The profile that pressed "Become a seller". Kept for the trail; authority
  /// lives in `seller_members`, because a founder can leave.
  createdByProfileId String? @db.Char(26)

  /// Optimistic concurrency. Two tabs editing one application is a real case -
  /// onboarding is long and people open it twice.
  version Int @default(0)

  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)
  /// Soft delete. Settlements, orders and audit rows still read back.
  archivedAt DateTime? @db.DateTime(3)

  members            SellerMember[]
  invitations        SellerInvitation[]
  onboarding         SellerOnboardingProgress?
  businessProfile    SellerBusinessProfile?
  verificationCases  SellerVerificationCase[]
  documents          SellerDocument[]
  agreements         SellerAgreementAcceptance[]
  payoutAccount      SellerPayoutAccountReference?
  locations          SellerLocation[]
  brandRequests      BrandRequest[]
  listingDrafts      SellerListingDraft[]
  offers             SellerOffer[]
  inventory          SellerInventory[]
  inventoryMovements SellerInventoryMovement[]
  bulkImports        SellerBulkImportJob[]
  orderGroups        SellerOrderGroup[]
  shipments          SellerShipment[]
  returns            SellerReturn[]
  settlements        SellerSettlement[]
  payouts            SellerPayout[]
  notifications      SellerNotification[]
  auditLogs          SellerAuditLog[]
  createdProducts    Product[]

  @@index([status, createdAt], map: "ix_seller_status")
  @@index([registrationCountry], map: "ix_seller_country")
  @@map("seller_accounts")
}

/// One person's place in one seller organisation.
///
/// `customerProfileId` is UNIQUE for the same reason it is on
/// `BuyerOrganizationMember`: an account that could act for two sellers would
/// need every screen in the Seller Hub to ask "as whom?", including the one
/// that ships an order. A person who genuinely sells for two businesses opens
/// a second account.
model SellerMember {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  customerProfileId String @unique(map: "uq_seller_member_profile") @db.Char(26)

  role SellerMemberRole @default(SUPPORT_MEMBER)

  /// The second lock: this person's password for the Seller Hub.
  ///
  /// Selling uses the same ACCOUNT as buying - one email, one identity, one
  /// order history - and a separate password in front of the Hub. The two are
  /// different questions and the product now answers them separately: "is this
  /// their account" is the sign-in, "are they here to sell" is this. Changing
  /// one never changes the other.
  ///
  /// Argon2, the same as `users.passwordHash`, and never returned by any
  /// endpoint. Null means this person has not chosen one yet, which is not the
  /// same as having no lock: the Hub asks them to choose before it opens, the
  /// way the carrier portal asks for a second factor.
  ///
  /// On the member rather than the user, because standing inside a seller
  /// organisation is what it guards. A person who sells for two businesses
  /// holds two of these, and neither opens the other.
  passwordHash  String?   @db.VarChar(255)
  passwordSetAt DateTime? @db.DateTime(3)

  invitedByProfileId String? @db.Char(26)

  joinedAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  /// Set instead of deleting the row, so historical actions still resolve to a
  /// person. A removed member fails the guard.
  removedAt DateTime? @db.DateTime(3)

  sellerAccount   SellerAccount   @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, role], map: "ix_seller_member_role")
  @@index([sellerAccountId, removedAt], map: "ix_seller_member_active")
  @@map("seller_members")
}

/// An outstanding invitation to join a seller organisation.
///
/// Token stored as a SHA-256 hash, single-use, expiring - the same treatment a
/// password reset gets, and for the same reason: an invitation grants standing
/// inside a business that ships medical devices.
model SellerInvitation {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  emailNormalized String           @db.VarChar(320)
  role            SellerMemberRole @default(SUPPORT_MEMBER)

  tokenHash String   @unique(map: "uq_seller_invitation_token") @db.Char(64)
  expiresAt DateTime @db.DateTime(3)

  invitedByProfileId  String?   @db.Char(26)
  acceptedAt          DateTime? @db.DateTime(3)
  acceptedByProfileId String?   @db.Char(26)
  revokedAt           DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, acceptedAt], map: "ix_seller_invitation_account")
  @@index([emailNormalized], map: "ix_seller_invitation_email")
  @@map("seller_invitations")
}

/// How far through onboarding a seller is, step by step.
///
/// One row per seller, with a JSON map of step -> state rather than a column
/// per step. The steps a country requires are configurable - see
/// `SellerOnboardingRequirement` - so a fixed column list would be wrong the
/// first time a deployment turned one off.
///
/// `completedSteps` is derived, recomputed on every save, and stored anyway:
/// the dashboard and the header progress indicator both read it on pages that
/// have no other reason to load the whole application.
model SellerOnboardingProgress {
  id              String @id @db.Char(26)
  sellerAccountId String @unique(map: "uq_seller_onboarding_account") @db.Char(26)

  /// Step key -> `{ state, updatedAt, message }`. States are NOT_STARTED,
  /// IN_PROGRESS, COMPLETE, ERROR and UNDER_REVIEW.
  stepsJson Json

  /// Denormalised counters for the progress bar. Derived from `stepsJson`.
  completedSteps Int @default(0)
  requiredSteps  Int @default(0)

  /// Where the seller was when they last stopped, so "continue setup" lands on
  /// the right screen rather than at the beginning.
  lastStepKey String? @db.VarChar(64)

  updatedAt DateTime @updatedAt @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@map("seller_onboarding_progress")
}

/// Which onboarding steps and documents a country demands.
///
/// This table is the whole reason the brief says "do not hard-code GSTIN or
/// PAN for every seller". A deployment in Germany needs a VAT number and an
/// EORI; one in India needs a GSTIN; one selling class IIb devices in the EU
/// needs a notified-body certificate and the others do not. Seeded with
/// defaults and edited by the operator.
///
/// `countryCode` NULL means "applies everywhere" - and because MariaDB treats
/// every NULL in a UNIQUE index as distinct, the unique key uses `countryKey`,
/// which is the country code or '*', never null.
model SellerOnboardingRequirement {
  id String @id @db.Char(26)

  /// ISO-3166-1 alpha-2, or null for a rule that applies to every country.
  countryCode String? @db.Char(2)
  /// `countryCode` or '*'. Never null - see the note above about MariaDB
  /// UNIQUE indexes and NULL.
  countryKey  String  @db.VarChar(2)

  /// Which step of onboarding this belongs to, e.g. `business_identity`.
  stepKey  String @db.VarChar(64)
  /// Which field or document inside that step, e.g. `vat_number`.
  fieldKey String @db.VarChar(64)

  /// Shown to the seller beside the field.
  label    String  @db.VarChar(160)
  helpText String? @db.VarChar(512)

  isRequired Boolean @default(true)
  /// A document upload rather than a typed value.
  isDocument Boolean @default(false)

  /// Regex the value must match, when the identifier has a published format.
  /// Applied server-side; the frontend gets it only as a hint.
  validationPattern String? @db.VarChar(255)

  /// Only applies to sellers of this kind. Null means all kinds - and since
  /// that null sits inside the unique key below, two rows differing only by a
  /// null kind would both be accepted on MariaDB. `uq_seller_requirement` is
  /// therefore advisory for that one case and the service checks it too.
  appliesToKind SellerKind?

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([countryKey, stepKey, fieldKey, appliesToKind], map: "uq_seller_requirement")
  @@index([countryKey, stepKey], map: "ix_seller_requirement_step")
  @@map("seller_onboarding_requirements")
}

/// The business behind a seller account: who it is, where it is registered,
/// what it is registered as.
///
/// Split from `SellerAccount` rather than widening it because these are the
/// fields an administrator reviews and a seller changes rarely, while the
/// parent row carries state that changes constantly. It also keeps the
/// identifiers - tax numbers, registration numbers - in one table that can be
/// treated as sensitive in its own right.
model SellerBusinessProfile {
  id              String @id @db.Char(26)
  sellerAccountId String @unique(map: "uq_seller_business_profile_account") @db.Char(26)

  /// Whoever signs for the business. A person, so this row is personal data
  /// and is disclosed in the Art. 15 export.
  representativeName  String? @db.VarChar(160)
  representativeEmail String? @db.VarChar(320)
  representativePhone String? @db.VarChar(32)
  representativeRole  String? @db.VarChar(120)

  supportEmail String? @db.VarChar(320)
  supportPhone String? @db.VarChar(32)

  preferredLanguage String? @db.VarChar(12)
  timezone          String? @db.VarChar(64)

  companyRegistrationNumber String? @db.VarChar(64)
  /// VAT, GST or whichever registration the country uses. One column, because
  /// a business holds one registration per jurisdiction and the jurisdiction is
  /// `SellerAccount.registrationCountry`.
  taxRegistrationNumber     String? @db.VarChar(64)
  /// EU Economic Operators Registration and Identification, where it applies.
  eoriNumber                String? @db.VarChar(32)
  /// Single Registration Number under EUDAMED, for actors in the EU medical
  /// device system.
  eudamedSrn                String? @db.VarChar(64)

  websiteUrl      String? @db.VarChar(512)
  yearsInBusiness Int?    @db.SmallInt

  registeredAddressLine1 String? @db.VarChar(255)
  registeredAddressLine2 String? @db.VarChar(255)
  registeredCity         String? @db.VarChar(120)
  registeredRegion       String? @db.VarChar(120)
  registeredPostcode     String? @db.VarChar(24)
  registeredCountry      String? @db.Char(2)

  /// Null means "same as registered". Stored separately rather than copied, so
  /// changing the registered address does not silently change where invoices
  /// go.
  billingAddressLine1 String? @db.VarChar(255)
  billingAddressLine2 String? @db.VarChar(255)
  billingCity         String? @db.VarChar(120)
  billingRegion       String? @db.VarChar(120)
  billingPostcode     String? @db.VarChar(24)
  billingCountry      String? @db.Char(2)

  /// Additional country-specific identifiers, keyed by the `fieldKey` of the
  /// `SellerOnboardingRequirement` that asked for them. JSON because the set of
  /// them is configuration, not schema.
  extraIdentifiersJson Json?

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@map("seller_business_profiles")
}

/// What is being checked, and by what.
///
/// One enum rather than a boolean per check because the set grows: the brief
/// alone names business registration, identity, tax registration, bank account
/// and medical compliance, and a deployment in a new country will want more.
enum SellerVerificationKind {
  /// The business exists and is registered where it says it is.
  BUSINESS_REGISTRATION
  /// The authorised representative is who they say they are.
  REPRESENTATIVE_IDENTITY
  /// The tax number is live and belongs to this business. Where a public
  /// register exists - VIES for EU VAT - it is consulted; where one does not,
  /// this is a human review.
  TAX_REGISTRATION
  /// The payout account belongs to the business. See the note on
  /// `SellerPayoutAccountReference` about what this repository can and cannot
  /// do here.
  BANK_ACCOUNT
  /// ISO 13485, CE/MDR/IVDR, notified body, Declaration of Conformity.
  MEDICAL_COMPLIANCE
  /// The seller is entitled to sell the brands it has claimed.
  BRAND_AUTHORISATION
}

/// How a verification ended.
enum SellerVerificationState {
  /// Nothing has been attempted.
  NOT_STARTED
  /// Waiting on the seller to supply something.
  AWAITING_INPUT
  /// Handed to a provider or a reviewer, no answer yet.
  IN_PROGRESS
  /// Passed.
  VERIFIED
  /// Failed, with a reason the seller can act on.
  FAILED
  /// Could not be attempted because the deployment has no provider configured.
  ///
  /// This state exists precisely so that "we cannot check this" never renders
  /// as "checked and fine". A seller sees a configuration-required message and
  /// an operator sees which environment variable is missing.
  PROVIDER_UNCONFIGURED
  /// Passed once, now stale - a certificate expired, a registration lapsed.
  EXPIRED
}

/// One verification attempt against one seller.
///
/// Rows accumulate rather than being overwritten: a seller whose tax check
/// failed twice before passing is a different risk from one that passed first
/// time, and an operator reviewing an application needs to see both.
/// `isCurrent` marks the latest per kind so the common read is one indexed row.
model SellerVerificationCase {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  kind  SellerVerificationKind
  state SellerVerificationState @default(NOT_STARTED)

  /// Which adapter answered, e.g. `vies`, `stripe_connect`, `manual_review`.
  /// Null while nothing has been attempted.
  provider String? @db.VarChar(48)

  /// The provider's own reference, for tracing a decision back to them.
  providerReference String? @db.VarChar(128)

  /// Seller-visible. Says what to do about a failure, not what went wrong
  /// internally.
  failureReason  String? @db.Text
  /// Operator-only detail. Never serialised to a seller route.
  internalDetail String? @db.Text

  /// Set when the evidence has a shelf life - a certificate, a licence. The
  /// worker raises a document-expiry notification before this date.
  expiresAt DateTime? @db.DateTime(3)

  /// The newest case for this seller and kind. Exactly one per pair, enforced
  /// by the service rather than the index: MariaDB cannot express "at most one
  /// true per group" without a generated column, and the extra column would
  /// have to be maintained anyway.
  isCurrent Boolean @default(true)

  /// The administrator who decided it, for a manual review. Null for an
  /// automated answer.
  decidedByUserId String?   @db.Char(26)
  decidedAt       DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, kind, isCurrent], map: "ix_seller_verification_current")
  @@index([state, expiresAt], map: "ix_seller_verification_expiry")
  @@map("seller_verification_cases")
}

/// What a document is evidence of.
enum SellerDocumentKind {
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  IDENTITY_PROOF
  ADDRESS_PROOF
  ISO_13485
  CE_CERTIFICATE
  DECLARATION_OF_CONFORMITY
  NOTIFIED_BODY_CERTIFICATE
  REGULATORY_LICENCE
  BRAND_AUTHORISATION
  TRADEMARK_EVIDENCE
  INSTRUCTIONS_FOR_USE
  STERILISATION_EVIDENCE
  BANK_STATEMENT
  OTHER
}

/// Where a stored file has got to in the checks every upload goes through.
///
/// `PENDING_SCAN` is the default and it matters: a file that has been accepted
/// but not scanned is not yet readable by anybody but the seller who uploaded
/// it. No malware scanner is configured in this repository, so nothing leaves
/// this state automatically - which is the honest behaviour, not a bug.
enum SellerDocumentScanState {
  PENDING_SCAN
  CLEAN
  INFECTED
  SCAN_FAILED
  /// No scanner is configured for this deployment. The operator decides
  /// whether to approve by eye; the state records that no machine did.
  SCANNER_UNCONFIGURED
}

/// A file a seller uploaded as evidence.
///
/// The bytes are NOT here. `storageKey` names an object in the configured
/// store, read back through a short-lived signed URL issued per request by
/// somebody who has passed the ownership check. A document proving a
/// director's identity must not be reachable by guessing a URL, and a
/// permanent link is a guessable URL that never expires.
model SellerDocument {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  kind SellerDocumentKind

  /// Which onboarding requirement this satisfies, when it was uploaded to
  /// satisfy one. Null for documents attached to a listing or supplied
  /// unprompted.
  requirementFieldKey String? @db.VarChar(64)

  /// Opaque key in the object store. Never a path a browser can construct.
  storageKey String @db.VarChar(512)

  /// The name the seller's own file had. Shown back to them, never used to
  /// build a path - see `safeFileName`.
  originalFileName String @db.VarChar(255)
  contentType      String @db.VarChar(128)
  byteSize         Int

  /// SHA-256 of the bytes, so the same file uploaded twice is recognisable and
  /// a stored file can be proved unmodified.
  contentHash String @db.Char(64)

  scanState SellerDocumentScanState @default(PENDING_SCAN)
  scannedAt DateTime?               @db.DateTime(3)

  /// An operator approved this as evidence. Separate from `scanState`: a clean
  /// file can still be the wrong document.
  approvedAt       DateTime? @db.DateTime(3)
  approvedByUserId String?   @db.Char(26)
  rejectedReason   String?   @db.Text

  /// For certificates. Drives the expiry warnings on the dashboard.
  issuedOn  DateTime? @db.Date
  expiresOn DateTime? @db.Date

  uploadedByProfileId String? @db.Char(26)

  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
  /// Superseded by a newer upload of the same kind. Kept, not deleted: the
  /// document an approval was granted against must stay readable.
  supersededAt DateTime? @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, kind, supersededAt], map: "ix_seller_document_kind")
  @@index([expiresOn], map: "ix_seller_document_expiry")
  @@map("seller_documents")
}

/// Which agreement a seller accepted.
enum SellerAgreementKind {
  MARKETPLACE_AGREEMENT
  COMMISSION_SCHEDULE
  RETURNS_POLICY
  PRIVACY_POLICY
  INTELLECTUAL_PROPERTY_DECLARATION
}

/// How the acceptance was captured.
///
/// The distinction this enum draws is the point of the whole model, and it is
/// the one the brief is emphatic about: a signature drawn with a mouse is NOT
/// a verified legal signature. It is evidence that somebody at that session
/// drew something, and it is recorded as `DRAWN_CONSENT` accordingly. A real
/// e-signature requires a provider that can bind the act to an identity, and
/// this repository has none configured.
enum SellerConsentMethod {
  /// A checkbox with a policy version and a timestamp. Legally the same weight
  /// as any click-through, which is what it is.
  CLICKWRAP
  /// A drawing, or a typed name rendered as one. Stored as evidence alongside
  /// the clickwrap record, never instead of it, and never described in the
  /// interface as a verified signature.
  DRAWN_CONSENT
  /// An approved e-signature provider bound the acceptance to a verified
  /// identity. No provider is configured here; this member exists so the
  /// adapter has something to write when one is.
  QUALIFIED_ESIGNATURE
}

/// A seller accepting one agreement, once, at a version.
///
/// Immutable. A new acceptance is a new row, because "which version of the
/// commission schedule was this seller on in March" is a question that gets
/// asked when money is disputed.
model SellerAgreementAcceptance {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  kind    SellerAgreementKind
  /// The published version of the document that was accepted, e.g.
  /// `2026-09-01`. Meaningless to compare across kinds; meaningful within one.
  version String              @db.VarChar(32)

  method SellerConsentMethod @default(CLICKWRAP)

  /// The person who clicked. Personal data, and disclosed in the Art. 15
  /// export.
  acceptedByProfileId String? @db.Char(26)
  acceptedName        String? @db.VarChar(160)

  /// Where the drawn signature image lives, for `DRAWN_CONSENT`. An object key
  /// like `SellerDocument.storageKey`, not the bytes.
  signatureStorageKey String? @db.VarChar(512)

  /// Evidence of the act itself. IP and user agent are the usual minimum for a
  /// click-through to be worth anything later.
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  acceptedAt DateTime @default(now()) @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, kind, acceptedAt], map: "ix_seller_agreement_kind")
  @@map("seller_agreement_acceptances")
}

/// How far a payout account has got with the provider.
enum SellerPayoutAccountState {
  /// Nothing started.
  NOT_STARTED
  /// The provider has an account and wants more from the seller.
  REQUIREMENTS_DUE
  /// The provider is checking.
  PENDING_VERIFICATION
  /// Money can be sent.
  ENABLED
  /// The provider has stopped payouts on this account.
  RESTRICTED
  /// No payout provider is configured for this deployment.
  ///
  /// The screens that would collect an account number render a
  /// configuration-required state instead of a form. Collecting bank details
  /// into a database that has nowhere to send them would be worse than useless:
  /// it would be a liability.
  PROVIDER_UNCONFIGURED
}

/// The marketplace's pointer to a payout account held somewhere else.
///
/// READ THE COLUMN LIST: there is no account number, no sort code, no IBAN and
/// no cardholder name anywhere in it, and that is deliberate. A marketplace
/// does not need to hold bank details to pay a seller - it needs a connected
/// account identifier at a provider that does. Storing the details here would
/// put this deployment inside the scope of rules it has no reason to be in,
/// to no benefit.
///
/// `last4` and `bankName` are the exceptions, and only because a seller
/// looking at their own payout settings has to be able to tell which account
/// it is. Both come back from the provider; neither is enough to move money.
model SellerPayoutAccountReference {
  id              String @id @db.Char(26)
  sellerAccountId String @unique(map: "uq_seller_payout_account") @db.Char(26)

  /// Which provider holds the account, e.g. `stripe_connect`. Null while the
  /// deployment has none configured.
  provider String? @db.VarChar(48)

  /// The provider's account identifier, e.g. a Stripe `acct_...`. This is the
  /// only credential-shaped thing in the table and it is not a credential: it
  /// names an account, it does not authorise anything against it.
  providerAccountId String? @db.VarChar(128)

  state SellerPayoutAccountState @default(NOT_STARTED)

  /// What the provider still wants, as it said it. Shown to the seller so
  /// "pending" is never a dead end.
  pendingRequirementsJson Json?

  /// Enough to recognise the account, not enough to use it.
  bankName       String? @db.VarChar(120)
  accountLast4   String? @db.VarChar(4)
  payoutCurrency String? @db.Char(3)
  payoutCountry  String? @db.Char(2)

  /// Whether the provider will currently send money. Distinct from `state`:
  /// an account can be ENABLED and still have payouts paused by the operator.
  payoutsEnabled Boolean @default(false)

  /// The operator has paused payouts to this seller, regardless of what the
  /// provider thinks. Used while a dispute is open.
  payoutsHeldByOperator Boolean @default(false)
  payoutHoldReason      String? @db.Text

  lastSyncedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([state], map: "ix_seller_payout_account_state")
  @@map("seller_payout_account_references")
}

/// What a seller location is for. A place can be more than one, which is why
/// these are booleans on the row rather than a kind enum.
model SellerLocation {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  /// Seller-chosen, unique within the seller. Appears on every stock movement
  /// ever recorded against the place, which is why it cannot be reused.
  code String @db.VarChar(32)
  name String @db.VarChar(160)

  addressLine1 String  @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  city         String  @db.VarChar(120)
  region       String? @db.VarChar(120)
  postcode     String  @db.VarChar(24)
  countryCode  String  @db.Char(2)

  /// Where the place actually is. Null when nobody has geocoded it yet - which
  /// is not the same as 0,0, a point in the Atlantic that several systems have
  /// shipped to.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  /// IANA zone, e.g. `Europe/Amsterdam`. Dispatch cutoffs are wall-clock times
  /// at the warehouse, so they are meaningless without it.
  timezone String @default("UTC") @db.VarChar(64)

  isPickupLocation Boolean @default(true)
  isReturnLocation Boolean @default(true)

  /// `HH:MM` in `timezone`. An order placed after this ships the next working
  /// day.
  dispatchCutoff   String? @db.VarChar(5)
  /// Bitmask, Monday = 1. 31 is Mon-Fri. Stored as an int because a seven-way
  /// boolean set is what a bitmask is for and MariaDB has no array type.
  workingDaysMask  Int     @default(31)
  /// Working days between an order and its dispatch.
  handlingTimeDays Int     @default(1)

  /// ISO-3166-1 alpha-2 codes this location will ship to. Empty means "no
  /// restriction beyond the marketplace's own".
  shipsToCountriesJson Json?

  /// Cold chain, controlled substances, sterile storage. Drives which products
  /// may be stocked here.
  hasColdChain         Boolean @default(false)
  hasControlledStorage Boolean @default(false)
  hasSterileStorage    Boolean @default(false)

  /// Whether stock here can be sold at all. A closed location keeps its
  /// history and its balances and offers none of it.
  isOperational Boolean @default(true)
  closedReason  String? @db.VarChar(255)

  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)
  archivedAt DateTime? @db.DateTime(3)

  sellerAccount SellerAccount             @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  inventory     SellerInventory[]
  movements     SellerInventoryMovement[]
  shipments     SellerShipment[]

  @@unique([sellerAccountId, code], map: "uq_seller_location_code")
  @@index([sellerAccountId, isOperational], map: "ix_seller_location_operational")
  @@index([countryCode], map: "ix_seller_location_country")
  @@map("seller_locations")
}

// ---------------------------------------------------------------------------
// BRANDS
//
// A brand is marketplace-wide, not seller-owned. Three distributors selling
// the same manufacturer's catheters must all attach to ONE brand row, or the
// buyer's brand filter returns three of everything and the manufacturer
// appears three times in a facet.
// ---------------------------------------------------------------------------

/// Whether a brand may be used on a listing.
enum BrandStatus {
  /// Usable.
  APPROVED
  /// Somebody asked for it and nobody has decided yet. Usable on a DRAFT
  /// listing so the seller is not blocked, never on a published one.
  PENDING
  /// Refused, with a reason.
  REJECTED
  /// Was approved, withdrawn. Existing listings keep it and cannot be
  /// republished until they change it.
  RETIRED
}

/// A manufacturer or brand name, marketplace-wide.
model Brand {
  id String @id @db.Char(26)

  name           String @db.VarChar(160)
  /// Lowercased, punctuation and whitespace stripped. UNIQUE, and the reason
  /// the duplicate check works: "B.Braun", "B Braun" and "b. braun" are one
  /// brand and three strings.
  nameNormalized String @unique(map: "uq_brand_name_normalized") @db.VarChar(160)
  slug           String @unique(map: "uq_brand_slug") @db.VarChar(180)

  status BrandStatus @default(PENDING)

  /// The legal manufacturer behind the brand, when it differs from the brand
  /// name - "Aesculap" is a brand of "B. Braun Melsungen AG".
  manufacturerLegalName String? @db.VarChar(255)
  manufacturerCountry   String? @db.Char(2)

  description String? @db.Text
  websiteUrl  String? @db.VarChar(512)

  /// Object key for the brand mark. Optional; a brand with no logo renders as
  /// its initials rather than as a broken image.
  logoStorageKey String? @db.VarChar(512)

  rejectedReason String? @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  requests BrandRequest[]
  offers   SellerOffer[]
  drafts   SellerListingDraft[]

  @@index([status, name], map: "ix_brand_status_name")
  @@map("brands")
}

enum BrandRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// The operator wants evidence before deciding.
  INFORMATION_REQUESTED
}

/// A seller asking for a brand they cannot find.
///
/// Kept apart from `Brand` because the two answer different questions. The
/// brand row is "does this name exist in the catalogue"; the request is "did
/// THIS seller ask for it, when, with what evidence, and what did we say". A
/// brand approved for one seller's request is then available to every seller,
/// which is correct - a brand is not owned by whoever asked first.
model BrandRequest {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  /// Set once a brand row exists for this request - either matched to an
  /// existing one or created on approval.
  brandId String? @db.Char(26)

  /// What the seller typed. Kept verbatim even after a match, because "we
  /// approved 'Braun' when they asked for 'Brawn'" is a thing that needs to be
  /// visible.
  requestedName String @db.VarChar(160)

  manufacturerLegalName String? @db.VarChar(255)
  websiteUrl            String? @db.VarChar(512)
  /// Why this seller is entitled to sell it - "we manufacture it", "we are the
  /// authorised distributor for Benelux".
  justification         String? @db.Text

  status BrandRequestStatus @default(PENDING)

  decisionReason  String?   @db.Text
  decidedByUserId String?   @db.Char(26)
  decidedAt       DateTime? @db.DateTime(3)

  requestedByProfileId String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([sellerAccountId, status], map: "ix_brand_request_seller")
  @@index([status, createdAt], map: "ix_brand_request_queue")
  @@map("brand_requests")
}

// ---------------------------------------------------------------------------
// THE LISTING SCHEMA
//
// The wizard renders itself from these rows. That is the difference between a
// form that works for one category and a marketplace: an infusion pump needs a
// flow rate and a connector type, a surgical glove needs a size and a powder
// state, and neither list belongs in a React component.
//
// The completion counters the seller sees - "Product Description (8/8)" - are
// counted over these definitions, server-side. The frontend never decides what
// "complete" means.
// ---------------------------------------------------------------------------

/// What kind of control an attribute is, and therefore how its value is
/// validated and stored.
enum ListingAttributeType {
  TEXT
  LONG_TEXT
  /// Sanitised HTML. Stored post-sanitisation, never rendered raw - the same
  /// rule `Product.descriptionHtml` follows.
  RICH_TEXT
  NUMBER
  DECIMAL
  /// A number and a unit, e.g. `120 mm`. The unit is constrained to
  /// `allowedUnitsJson`, because "12 cm" and "120 mm" sorting apart in a facet
  /// is what unconstrained units produce.
  MEASUREMENT
  DROPDOWN
  MULTI_SELECT
  BOOLEAN
  DATE
  /// A repeating group of key/value rows - "In the box: 1 x mask, 2 x filter".
  KEY_VALUE_LIST
  /// A file the seller uploads against this attribute, e.g. an IFU PDF.
  DOCUMENT
}

/// Which section of the listing workspace an attribute appears in.
///
/// These are the sections the seller sees a completion count for, so the enum
/// is the contract between the wizard's left-hand progress and the server's
/// counting.
enum ListingSection {
  PRODUCT_PHOTOS
  PRICE_STOCK_SHIPPING
  PRODUCT_DESCRIPTION
  ADDITIONAL_INFORMATION
  MEDICAL_COMPLIANCE
}

/// One field the listing wizard renders, for one category.
///
/// Scoped to a category, and inherited down the category tree by the service
/// rather than duplicated per leaf: a definition on "Infusion" applies to
/// "Infusion > Pumps" unless a definition with the same key overrides it.
/// Duplicating them would mean adding a field to a top-level category meant
/// editing forty rows.
model CategoryAttributeDefinition {
  id String @id @db.Char(26)

  /// Null means "every category" - the fields every product has regardless of
  /// what it is. `categoryKey` carries the same value as a non-null string for
  /// the unique index, because MariaDB treats NULLs in a UNIQUE index as
  /// distinct and two global definitions of `brand` would both be accepted.
  categoryId  String? @db.Char(26)
  categoryKey String  @db.VarChar(26)

  /// Stable machine name, e.g. `sterile_status`. Appears in the draft JSON and
  /// in the import template header, so renaming one is a migration.
  attributeKey String @db.VarChar(64)

  label    String  @db.VarChar(160)
  helpText String? @db.VarChar(512)

  section ListingSection
  type    ListingAttributeType

  isRequired Boolean @default(false)

  /// The unit shown beside a NUMBER or DECIMAL that always has the same one.
  /// For MEASUREMENT the seller picks from `allowedUnitsJson` instead.
  unit             String? @db.VarChar(24)
  allowedUnitsJson Json?

  /// Options for DROPDOWN and MULTI_SELECT, as `[{ value, label }]`.
  allowedValuesJson Json?

  /// Server-side bounds. Applied in `listing-validation.ts`; sent to the
  /// frontend so it can say the same thing sooner, never so it can decide.
  minNumber Decimal? @db.Decimal(18, 6)
  maxNumber Decimal? @db.Decimal(18, 6)
  minLength Int?
  maxLength Int?
  /// Regex, for identifiers with a published format - UDI-DI, GTIN.
  pattern   String?  @db.VarChar(255)

  /// Buyers can filter on it. Drives which attributes get indexed.
  isSearchable       Boolean @default(false)
  /// Two listings differing only in this attribute are variants of one
  /// another - size, length, gauge, pack quantity.
  isVariantDimension Boolean @default(false)
  /// Contributes to the generated product title, in `titleOrder`.
  isTitleComponent   Boolean @default(false)
  titleOrder         Int?    @db.SmallInt

  /// Only asked when the product is a regulated device - carries a device
  /// class, a UDI, a CE mark. Lets one category serve both a sterile implant
  /// and a waiting-room chair.
  isRegulatoryOnly Boolean @default(false)

  sortOrder Int @default(0)

  /// Turned off without deleting. A definition that has values stored against
  /// it on live listings cannot be deleted without losing them.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryKey, attributeKey], map: "uq_category_attribute_key")
  @@index([categoryId, section, sortOrder], map: "ix_category_attribute_section")
  @@map("category_attribute_definitions")
}

// ---------------------------------------------------------------------------
// THE LISTING DRAFT
//
// A draft is not a Product. It is the seller's working copy, and it is allowed
// to be invalid, half-finished and contradictory for as long as they need. A
// `Product` row is created only when a draft is approved, which is what keeps
// an abandoned wizard from leaving an unpublishable product in the catalogue
// forever.
// ---------------------------------------------------------------------------

/// Where a listing is in its journey from "started" to "buyable".
///
/// Enforced by `assertListingTransition` in `domain/seller-state.ts`. Nothing
/// writes this column directly, for the same reason nothing writes
/// `Order.status`: the step from READY_FOR_SUBMISSION to PENDING_REVIEW is what
/// hands a medical device to a moderator, and the step from APPROVED is what
/// puts it in front of a hospital.
enum ListingDraftStatus {
  /// Being written. Autosaves land here.
  DRAFT
  /// The seller pressed submit and the automated checks refused it. Editable,
  /// and every refusal is attached to a field.
  VALIDATION_FAILED
  /// Every required section passes. The submit button is live.
  READY_FOR_SUBMISSION
  /// With the moderators. Read-only for the seller.
  PENDING_REVIEW
  /// A moderator sent it back. Editable, with comments attached to fields.
  ACTION_REQUIRED
  /// Approved. A `Product` and a `SellerOffer` now exist; the draft is kept as
  /// the record of what was approved.
  APPROVED
  /// Refused outright.
  REJECTED
  /// The seller abandoned it.
  ARCHIVED
}

/// A seller's working copy of a listing.
///
/// The bulk of it is `attributesJson` rather than a column per field, and that
/// is forced by the same thing that makes `CategoryAttributeDefinition` exist:
/// the fields are configuration. What is NOT in the JSON is anything the
/// database has to index, constrain or join on - category, brand, status, the
/// seller's SKU - because those are queries, not content.
model SellerListingDraft {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  status ListingDraftStatus @default(DRAFT)

  /// Chosen at step one. Null only for the brief moment before the seller has
  /// picked one, which is a real state the wizard renders.
  categoryId String? @db.Char(26)
  brandId    String? @db.Char(26)

  /// Set when the seller matched an existing catalogue product instead of
  /// describing a new one. The offer then attaches to that product and the
  /// product's own specifications are not editable here - which is the point
  /// of matching.
  matchedProductId String? @db.Char(26)

  /// The product this draft produced, once approved. Null until then.
  publishedProductId String? @db.Char(26)
  publishedOfferId   String? @db.Char(26)

  /// The seller's own code for the item. Unique within the seller, checked
  /// against live offers as well as other drafts - a duplicate SKU is one of
  /// the automated quality checks.
  sellerSku String? @db.VarChar(64)

  /// Attribute key -> value, validated against the category's definitions.
  attributesJson Json?

  /// The commercial terms: price, currency, MOQ, increments, tiers, handling.
  /// Separate from `attributesJson` because these are the OFFER, not the
  /// product, and they survive into `SellerOffer` unchanged.
  offerJson Json?

  /// Per-location stock the seller typed in the wizard, applied to
  /// `SellerInventory` on approval.
  stockJson Json?

  /// Pack hierarchy: base unit, units per pack, packs per box, and so on, with
  /// the calculated total sellable units. Decimal-safe arithmetic lives in
  /// `packaging.ts`; this stores what the seller entered and what it worked
  /// out to, so a later change to the arithmetic is visible rather than silent.
  packagingJson Json?

  /// The axes this listing sells along, and the values the seller offers on
  /// each: `{ axes: [{ axisKey, values: [{ label, amount?, unit? }] }] }`.
  ///
  /// Null on a listing with one configuration, which is most of them, and an
  /// empty `axes` means the seller was asked and said no. Those two are
  /// deliberately different: the wizard shows the variant question again to
  /// the first and not to the second.
  variantAxesJson Json?

  /// The combinations the seller actually approved, each with its own SKU,
  /// price, stock and pack - the matrix, as they last left it.
  ///
  /// Not the Cartesian product of `variantAxesJson`. A seller who offers
  /// black in four sizes and white in two has six rows here and not eight,
  /// because the two the factory does not make are the ones a buyer must be
  /// told are "not offered" rather than "out of stock".
  variantsJson Json?

  /// The title the rules generated, and the fields that produced it. Null
  /// until every title-component attribute is valid - which is exactly when
  /// "Preview title" becomes pressable.
  generatedTitle       String? @db.VarChar(512)
  generatedTitleSource Json?
  /// A title the seller edited, where policy allows it. Null means the
  /// generated one stands.
  sellerEditedTitle    String? @db.VarChar(512)

  /// Section key -> `{ complete, required, state }`, recomputed server-side on
  /// every save. Stored rather than derived on read because the listings table
  /// shows a quality column for hundreds of rows at a time.
  sectionStateJson Json?

  /// Moderator's decision text, seller-visible.
  reviewComment    String?   @db.Text
  reviewedByUserId String?   @db.Char(26)
  reviewedAt       DateTime? @db.DateTime(3)
  submittedAt      DateTime? @db.DateTime(3)

  /// Optimistic concurrency. The wizard autosaves from a long-lived tab and
  /// sellers leave two open; this is what stops one overwriting the other.
  version Int @default(0)

  /// The value of `version` at the moment the seller pressed submit.
  ///
  /// What the moderator is actually looking at. `version` alone cannot answer
  /// that: it moves every time the seller saves, and a seller whose listing
  /// came back as ACTION_REQUIRED edits it while the queue still holds a row
  /// for the revision they sent. An approval carries this number back, and the
  /// decision is refused if it no longer matches - so an approval of revision
  /// N can never land on revision N+1.
  ///
  /// Null on a draft that has never been submitted.
  submittedVersion Int?

  createdByProfileId String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount             @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  category      Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         Brand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  media         SellerListingDraftMedia[]
  issues        SellerListingIssue[]

  @@index([sellerAccountId, status, updatedAt], map: "ix_listing_draft_seller_status")
  @@index([status, submittedAt], map: "ix_listing_draft_review_queue")
  @@index([sellerAccountId, sellerSku], map: "ix_listing_draft_sku")
  @@map("seller_listing_drafts")
}

/// Which photograph this is meant to be.
///
/// Named slots rather than a free gallery, because the required set is
/// category-driven and a moderator checking "is there a readable UDI label"
/// needs to know which image claims to be one. The slots the brief lists, plus
/// OTHER for anything else the seller wants to include.
enum ListingMediaSlot {
  FRONT_VIEW
  BACK_VIEW
  SIDE_VIEW
  PACKAGING
  PRODUCT_LABEL
  UDI_LABEL
  DIMENSIONS_REFERENCE
  CONNECTOR_VIEW
  STERILE_SEAL
  INSTRUCTIONS_VIEW
  OTHER
  /// A PDF rather than a photograph - an IFU, a certificate.
  DOCUMENT
  /// A short video of the product. Its own slot rather than a flag on OTHER,
  /// because a buyer looking for "is there a video" and a moderator checking
  /// the photographs are both asking about a specific thing.
  VIDEO
}

/// Picture or video.
enum SellerMediaKind {
  IMAGE
  VIDEO
}

/// A file attached to a draft listing.
///
/// Uploaded straight to object storage with a presigned URL: the bytes never
/// pass through this API, which is what keeps a 12 MB photograph from
/// occupying a request worker. The row is written when the seller asks for the
/// presigned URL and confirmed when the upload finishes, so an abandoned
/// upload leaves a row marked incomplete rather than a file nobody can find.
model SellerListingDraftMedia {
  id      String @id @db.Char(26)
  draftId String @db.Char(26)

  slot ListingMediaSlot @default(OTHER)

  storageKey       String  @db.VarChar(512)
  originalFileName String  @db.VarChar(255)
  contentType      String  @db.VarChar(128)
  byteSize         Int     @default(0)
  contentHash      String? @db.Char(64)

  /// Whether these bytes are a picture or a video. Decides how the gallery
  /// renders it and which size limit the upload was held to - see
  /// `assertWithinMediaSizeLimit`.
  kind SellerMediaKind @default(IMAGE)

  widthPx  Int?
  heightPx Int?

  /// Length of a video, where it could be read. Null for a picture, and null
  /// for a video whose container did not say - which is not an error, just an
  /// unknown, and the gallery shows the clip without a duration.
  durationSeconds Int?

  /// Alt text. Required before submission for the primary image, because a
  /// catalogue a screen-reader cannot describe is a catalogue some buyers
  /// cannot use.
  altText String? @db.VarChar(255)

  /// The image shown first. Exactly one per draft, enforced in the service.
  isPrimary Boolean @default(false)

  sortOrder Int @default(0)

  /// The upload was confirmed as finished. Rows that never get here are swept.
  uploadedAt DateTime? @db.DateTime(3)

  scanState SellerDocumentScanState @default(PENDING_SCAN)

  /// A moderator looked at it. Distinct from the scan: a clean file can still
  /// be a photograph of the wrong thing, or carry a watermark.
  moderationState String? @db.VarChar(24)
  moderationNote  String? @db.VarChar(512)

  /// Why an automated check refused it - too small, blurred, duplicate of
  /// another slot. Shown beside the slot with the action that fixes it.
  rejectionCode String? @db.VarChar(48)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  draft SellerListingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, sortOrder], map: "ix_listing_media_order")
  @@index([draftId, kind], map: "ix_listing_media_kind")
  @@index([draftId, slot], map: "ix_listing_media_slot")
  @@map("seller_listing_draft_media")
}

/// How badly an issue blocks a listing.
enum ListingIssueSeverity {
  /// Submission is refused until it is fixed.
  BLOCKER
  /// Submission is allowed; the moderator will see it.
  WARNING
  /// Advice. Improves the listing, blocks nothing.
  ADVISORY
}

/// One thing wrong with a listing, tied to the field it is wrong in.
///
/// The tie to a field is the entire value of this table. "Your listing failed
/// validation" is not a message anybody can act on; "Pack quantity must divide
/// into units per box - Price, Stock and Shipping - Units per box" is, and it
/// is what lets the wizard put the error beside the input and the submit
/// button explain itself.
model SellerListingIssue {
  id      String @id @db.Char(26)
  draftId String @db.Char(26)

  severity ListingIssueSeverity @default(BLOCKER)

  /// Stable code, e.g. `MISSING_REQUIRED_IMAGE`. The frontend translates it;
  /// the stored `message` is the fallback.
  code String @db.VarChar(64)

  section      ListingSection?
  attributeKey String?         @db.VarChar(64)

  message String @db.VarChar(512)

  /// Raised by the automated checks, or written by a moderator. Both end up
  /// beside the same field, which is what the seller needs; the source decides
  /// whether re-running validation clears it.
  isFromModerator Boolean @default(false)

  resolvedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)

  draft SellerListingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, resolvedAt], map: "ix_listing_issue_open")
  @@map("seller_listing_issues")
}

// ---------------------------------------------------------------------------
// THE OFFER
//
// What a particular seller will sell a particular catalogue product for. This
// is the row a buyer actually buys from, and the reason the marketplace can
// show three prices for one product without three product pages.
// ---------------------------------------------------------------------------

enum SellerOfferStatus {
  /// Approved but not switched on by the seller.
  INACTIVE
  /// Buyable.
  ACTIVE
  /// The seller paused it - holidays, a recall, a supplier problem.
  PAUSED
  /// Something is wrong that the seller must fix: an expired certificate, a
  /// retired brand, a compliance document nobody renewed. Not buyable, and the
  /// listings page says why.
  NEEDS_CHANGES
  /// Withdrawn. Kept because orders reference it.
  ARCHIVED
}

/// One seller's terms for one catalogue product.
///
/// The `variantKey` trick is the one from the top of this file, and it is here
/// for exactly the reason described there: a nullable `variantId` inside the
/// unique key would let MariaDB accept two base-product offers from one seller,
/// because it treats every NULL as distinct. `variantKey` is the variant ULID
/// or '', never null, so the uniqueness actually holds.
model SellerOffer {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  productId  String  @db.Char(26)
  variantId  String? @db.Char(26)
  /// `variantId`, or '' for the base product. Never null. See the note above.
  variantKey String  @default("") @db.VarChar(26)

  /// The seller's own code. Unique within the seller: it is what their
  /// warehouse, their ERP and their invoices all key on, so two products
  /// sharing one would make a picking list ambiguous.
  sellerSku String @db.VarChar(64)

  brandId String? @db.Char(26)

  status SellerOfferStatus @default(INACTIVE)

  /// Minor units. BigInt, like every other money column in this schema - a
  /// price crossing the API as a JS number is how a 19-digit paise figure
  /// silently loses its last digit.
  priceMinor BigInt
  currency   String @db.Char(3)

  /// Strike-through price. Must be at or above `priceMinor`; checked in the
  /// service and by a CHECK constraint.
  compareAtPriceMinor BigInt?

  /// Which tax class the operator files this under. Reuses the existing
  /// `TaxClass` rows rather than inventing a seller-specific tax system.
  taxClassId String? @db.Char(26)

  /// The unit a buyer orders in - piece, pack, box, carton. Reuses the
  /// existing `OrderingUnit` enum so a marketplace line and an operator line
  /// behave identically in a cart.
  orderingUnit OrderingUnit @default(PIECE)

  minimumOrderQuantity Int  @default(1)
  /// Quantities must be a multiple of this. 1 means no restriction.
  orderIncrement       Int  @default(1)
  maximumOrderQuantity Int?

  /// Working days from order to dispatch, when it differs from the location's
  /// default. Null means "use the location".
  handlingTimeDays Int?

  /// Months of shelf life the seller guarantees will remain on dispatch. A
  /// hospital that receives a reagent expiring next week cannot use it, so
  /// this is a commercial term, not a product fact.
  guaranteedShelfLifeMonths Int? @db.SmallInt

  warrantyMonths Int? @db.SmallInt

  /// ISO-3166-1 alpha-2 codes the seller will ship this to. Empty means
  /// "wherever the locations reach".
  sellingRegionsJson Json?

  /// Denormalised from `SellerInventory` so the listings table and the buyer's
  /// product page do not each sum a ledger. Recomputed inside the same
  /// transaction as the movement that changed it.
  availableQuantity Int @default(0)
  reservedQuantity  Int @default(0)

  /// Quality, as the automated checks scored it at the last save. 0-100.
  qualityScore Int? @db.SmallInt

  /// Why it is NEEDS_CHANGES, seller-visible.
  statusReason String? @db.Text

  /// When this was last taken off sale, and by whom.
  ///
  /// The trail beside the status, rather than an audit query per row: the
  /// listings table draws forty rows and "who paused this, and when" is asked
  /// of most of them. It matters because pausing is no longer only a way to
  /// hide something - "Pause & Edit" takes a live listing off sale so its
  /// structure can be changed without a buyer watching the page rearrange
  /// itself, and a colleague finding it paused needs to know that is what
  /// happened.
  ///
  /// Null on every row that has never been paused, and on every row paused
  /// before these columns existed. Nothing reads them to decide whether
  /// something can be sold; `status` alone still does that.
  ///
  /// Deliberately not a foreign key - see the migration.
  pausedAt          DateTime? @db.DateTime(3)
  pausedByProfileId String?   @db.Char(26)

  /// The draft this came from, kept so "what exactly was approved" has an
  /// answer.
  sourceDraftId String? @db.Char(26)

  publishedAt DateTime? @db.DateTime(3)

  version Int @default(0)

  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)
  archivedAt DateTime? @db.DateTime(3)

  sellerAccount SellerAccount     @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  brand         Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  priceTiers    SellerPriceTier[]
  inventory     SellerInventory[]
  orderLines    SellerOrderLine[]
  /// Baskets and orders that chose THIS seller's offer. Both are RESTRICT on
  /// delete: an offer somebody has bought is evidence of what was sold, and
  /// removing it would leave the line pointing at nothing. Archive instead.
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([sellerAccountId, productId, variantKey], map: "uq_seller_offer_product")
  @@unique([sellerAccountId, sellerSku], map: "uq_seller_offer_sku")
  @@index([productId, status, priceMinor], map: "ix_seller_offer_product_price")
  @@index([sellerAccountId, status, updatedAt], map: "ix_seller_offer_seller_status")
  @@index([status, availableQuantity], map: "ix_seller_offer_stock")
  @@map("seller_offers")
}

/// "Cheaper if you take more."
///
/// A band, not a step: `minQuantity` starts a band that runs until the next
/// one begins. Overlapping bands are refused in the service, because a
/// quantity matching two prices has no answer a buyer would accept.
model SellerPriceTier {
  id      String @id @db.Char(26)
  offerId String @db.Char(26)

  minQuantity Int
  priceMinor  BigInt

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  offer SellerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, minQuantity], map: "uq_seller_price_tier")
  @@index([offerId, minQuantity], map: "ix_seller_price_tier_band")
  @@map("seller_price_tiers")
}

/// Stock of one offer at one of the seller's locations.
///
/// Separate from the operator's `InventoryBalance` rather than sharing it: the
/// two are different ledgers with different owners, and a seller adjusting
/// their own stock must never write a row the operator's warehouse team reads
/// as theirs. The discipline is the same - movements are the truth, the
/// balance is a running total, and both move inside one transaction.
model SellerInventory {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)
  offerId         String @db.Char(26)
  locationId      String @db.Char(26)

  /// On hand and sellable.
  availableQuantity   Int @default(0)
  /// Held for orders that are not yet dispatched.
  reservedQuantity    Int @default(0)
  /// Present, unsellable: damaged, quarantined, past its date.
  quarantinedQuantity Int @default(0)

  /// Below this, the dashboard raises a low-stock alert. 0 disables it.
  reorderThreshold Int @default(0)

  /// Batch or lot, where the product's regulatory class requires traceability.
  /// Nullable, because not every product does - a dressing pack does, a
  /// waiting-room chair does not.
  batchNumber String? @db.VarChar(64)

  manufacturedOn DateTime? @db.Date
  expiresOn      DateTime? @db.Date

  /// Optimistic concurrency, and the thing that makes concurrent reservation
  /// safe on MariaDB 10.4 without `SKIP LOCKED`: a decrement is a conditional
  /// UPDATE checking this, and a zero-row result means somebody else got there
  /// first.
  version Int @default(0)

  /// What the seller's own ERP last said, and when. Null when no ERP is
  /// connected. Kept beside the balance rather than in the sync log because
  /// "these numbers disagree" is a thing the inventory screen shows.
  erpQuantity Int?
  erpSyncedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount  @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  offer         SellerOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  location      SellerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([offerId, locationId], map: "uq_seller_inventory_offer_location")
  @@index([sellerAccountId, availableQuantity], map: "ix_seller_inventory_low")
  @@index([expiresOn], map: "ix_seller_inventory_expiry")
  @@map("seller_inventory")
}

/// Why stock moved. Mirrors `InventoryMovementType` in shape but not in
/// membership: a seller receives, adjusts, reserves and ships, and does not do
/// the operator-only movements.
enum SellerInventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  DISPATCH
  RETURN
  QUARANTINE
  QUARANTINE_RELEASE
  /// An ERP sync overwrote the balance. Recorded as a movement so the ledger
  /// still adds up afterwards.
  ERP_RECONCILIATION
}

/// Every change to seller stock, ever.
///
/// Append-only. The balance is derived from these and cached on
/// `SellerInventory`; when the two disagree the movements win, which is only
/// true if nothing ever edits a movement.
model SellerInventoryMovement {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)
  offerId         String @db.Char(26)
  locationId      String @db.Char(26)

  type SellerInventoryMovementType

  /// Signed. Negative takes stock away. Stored signed rather than as a
  /// magnitude plus a direction so that summing the column is the balance.
  quantityDelta Int

  /// The balance after this movement, for auditing without replaying
  /// everything.
  balanceAfter Int

  /// What caused it - an order id, an import job id, a sync run id.
  referenceType String? @db.VarChar(48)
  referenceId   String? @db.Char(26)

  /// Required for ADJUSTMENT. An adjustment with no reason is how stock
  /// quietly disappears.
  reason String? @db.VarChar(255)

  batchNumber String? @db.VarChar(64)

  /// The person, when a person did it. Null for worker and ERP movements.
  actorProfileId String? @db.Char(26)

  /// Makes a retried write harmless. A sync that times out and is repeated
  /// must not move the same stock twice.
  idempotencyKey String? @db.VarChar(128)

  createdAt DateTime @default(now()) @db.DateTime(3)

  sellerAccount SellerAccount  @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  location      SellerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, idempotencyKey], map: "uq_seller_movement_idempotency")
  @@index([offerId, createdAt], map: "ix_seller_movement_offer")
  @@index([sellerAccountId, createdAt], map: "ix_seller_movement_seller")
  @@map("seller_inventory_movements")
}

/// A spreadsheet of listings, being processed.
///
/// The dry run is not optional decoration: a seller uploading 900 rows needs
/// to be told which 12 are wrong BEFORE anything is created, because the
/// alternative is 888 live listings and a cleanup job. `isDryRun` distinguishes
/// the two passes over the same file.
model SellerBulkImportJob {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  /// Reuses the existing `JobStatus` enum rather than adding a parallel one.
  status JobStatus @default(PENDING)

  isDryRun Boolean @default(true)

  /// The category the template was generated for. A template is
  /// category-specific because the columns are the category's attributes.
  categoryId String? @db.Char(26)

  originalFileName String @db.VarChar(255)
  storageKey       String @db.VarChar(512)

  /// Seller's column header -> attribute key, when they did not use the
  /// template unchanged.
  columnMappingJson Json?

  totalRows   Int @default(0)
  validRows   Int @default(0)
  invalidRows Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)

  /// Where the downloadable correction file went - the seller's own rows with
  /// an error column appended, so they fix and re-upload rather than retype.
  errorReportStorageKey String? @db.VarChar(512)

  failureReason String? @db.Text

  startedAt  DateTime? @db.DateTime(3)
  finishedAt DateTime? @db.DateTime(3)

  requestedByProfileId String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount              @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  rowErrors     SellerBulkImportRowError[]

  @@index([sellerAccountId, createdAt], map: "ix_seller_import_seller")
  @@map("seller_bulk_import_jobs")
}

/// One row of one upload that could not be accepted.
model SellerBulkImportRowError {
  id    String @id @db.Char(26)
  jobId String @db.Char(26)

  /// 1-based, as the spreadsheet numbers them. Off-by-one here means a seller
  /// looking at the wrong line in their own file.
  rowNumber Int

  columnName String? @db.VarChar(128)
  code       String  @db.VarChar(64)
  message    String  @db.VarChar(512)

  /// The offending cell, so the report is readable without the original file
  /// open beside it.
  rawValue String? @db.VarChar(512)

  createdAt DateTime @default(now()) @db.DateTime(3)

  job SellerBulkImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber], map: "ix_seller_import_error_row")
  @@map("seller_bulk_import_row_errors")
}

// ---------------------------------------------------------------------------
// ORDERS, SPLIT BY SELLER
//
// A buyer places ONE order. That order may contain lines from three sellers
// dispatched from four warehouses. `Order` is untouched - it still belongs to
// the buyer and still moves through `assertTransition` - and the seller's view
// of it is a GROUP over its lines.
//
// The alternative, an order row per seller, was rejected: it would give the
// buyer three order numbers for one checkout, three payment intents and three
// invoices, and would mean touching every existing order path.
// ---------------------------------------------------------------------------

/// Where a seller's part of an order has got to.
///
/// Deliberately NOT the same enum as `OrderStatus`. The buyer's order is
/// "confirmed" when it is paid; the seller's part of it is "new" until they
/// accept it, and one seller shipping does not make the buyer's order shipped.
enum SellerOrderGroupStatus {
  NEW
  ACCEPTED
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  DISPUTED
}

/// One seller's part of one buyer order.
model SellerOrderGroup {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)
  orderId         String @db.Char(26)

  /// Sequential per seller, so a seller's own paperwork has its own numbering
  /// and does not leak how many orders the marketplace as a whole took.
  sellerOrderNumber String @db.VarChar(32)

  status SellerOrderGroupStatus @default(NEW)

  /// Where it ships from. Chosen by the seller when they accept, or allocated
  /// automatically where only one location holds the stock.
  locationId String? @db.Char(26)

  /// The money, as it concerns this seller. Minor units, BigInt, in
  /// `currency`. Computed once when the group is created and never recomputed
  /// from a live price - a seller's settlement must not move because they
  /// edited an offer afterwards.
  goodsTotalMinor    BigInt @default(0)
  taxTotalMinor      BigInt @default(0)
  shippingTotalMinor BigInt @default(0)
  /// What the marketplace keeps. Derived from the commission rate in force at
  /// the moment the order was placed, stored so it stays that.
  commissionMinor    BigInt @default(0)
  /// What the seller is owed before deductions.
  sellerNetMinor     BigInt @default(0)
  currency           String @db.Char(3)

  /// The rate actually used, kept beside the figure it produced. Without it a
  /// disputed settlement cannot be recomputed.
  commissionBasisPointsApplied Int @default(0) @db.SmallInt

  /// When the seller must dispatch by, from the location's handling time and
  /// cutoff. The dashboard's SLA warnings read this.
  dispatchDueAt DateTime? @db.DateTime(3)

  acceptedAt         DateTime? @db.DateTime(3)
  dispatchedAt       DateTime? @db.DateTime(3)
  deliveredAt        DateTime? @db.DateTime(3)
  cancelledAt        DateTime? @db.DateTime(3)
  /// Why, when a seller rejected it. Counts against their performance.
  cancellationReason String?   @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount   SellerAccount          @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines           SellerOrderLine[]
  shipments          SellerShipment[]
  returns            SellerReturn[]
  settlementLines    SellerSettlementLine[]
  /// The carrier-grade shipments raised for this seller's part of the order.
  logisticsShipments LogisticsShipment[]

  @@unique([sellerAccountId, sellerOrderNumber], map: "uq_seller_order_number")
  @@unique([orderId, sellerAccountId], map: "uq_seller_order_group")
  @@index([sellerAccountId, status, createdAt], map: "ix_seller_order_group_status")
  @@index([sellerAccountId, dispatchDueAt], map: "ix_seller_order_group_sla")
  @@map("seller_order_groups")
}

/// One line of a buyer order, attributed to one seller's offer.
///
/// A join row rather than a duplicate of `OrderItem`: quantity and price live
/// on the order item, which is the record the buyer was charged against.
/// What this adds is which offer fulfilled it and what the seller earns from
/// it, both of which the buyer's line has no business knowing.
model SellerOrderLine {
  id           String @id @db.Char(26)
  orderGroupId String @db.Char(26)
  orderItemId  String @db.Char(26)
  offerId      String @db.Char(26)

  quantity Int

  unitPriceMinor  BigInt
  lineTotalMinor  BigInt
  commissionMinor BigInt @default(0)
  sellerNetMinor  BigInt @default(0)
  currency        String @db.Char(3)

  /// Dispatched so far. Less than `quantity` while a partial fulfilment is
  /// open.
  fulfilledQuantity Int @default(0)
  returnedQuantity  Int @default(0)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  orderGroup SellerOrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  offer      SellerOffer      @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([orderItemId], map: "uq_seller_order_line_item")
  @@index([orderGroupId], map: "ix_seller_order_line_group")
  @@index([offerId], map: "ix_seller_order_line_offer")
  @@map("seller_order_lines")
}

/// A parcel a seller sent.
///
/// Separate from the operator's `Shipment` for the same reason seller stock is
/// separate from operator stock: different owner, different ledger. The
/// tracking number a seller types must not appear on an operator's dispatch
/// screen as though the warehouse sent it.
model SellerShipment {
  id              String  @id @db.Char(26)
  sellerAccountId String  @db.Char(26)
  orderGroupId    String  @db.Char(26)
  locationId      String? @db.Char(26)

  /// Reuses the existing `ShipmentStatus` enum.
  status ShipmentStatus @default(CREATED)

  carrierName    String? @db.VarChar(120)
  trackingNumber String? @db.VarChar(128)
  trackingUrl    String? @db.VarChar(512)

  /// What went in the box, as `[{ orderItemId, quantity }]`. JSON because a
  /// shipment line has no identity of its own and nothing joins to it.
  contentsJson Json?

  dispatchedAt DateTime? @db.DateTime(3)
  deliveredAt  DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount    @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  orderGroup    SellerOrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  location      SellerLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([sellerAccountId, status], map: "ix_seller_shipment_status")
  @@index([orderGroupId], map: "ix_seller_shipment_group")
  @@map("seller_shipments")
}

/// A buyer sending something back to a seller.
///
/// Reuses `ReturnStatus`. What it adds over the operator's `ReturnRequest` is
/// the seller's own response and the platform's decision when the two disagree,
/// because a marketplace return is a three-party conversation and a two-party
/// model loses the arbitration.
model SellerReturn {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)
  orderGroupId    String @db.Char(26)

  status ReturnStatus @default(REQUESTED)

  /// Stable code plus the buyer's own words.
  reasonCode String  @db.VarChar(48)
  reasonText String? @db.Text

  /// Object keys for photographs the buyer supplied.
  evidenceJson Json?

  /// What the seller said about it.
  sellerResponse    String?   @db.Text
  sellerRespondedAt DateTime? @db.DateTime(3)

  /// The operator's decision when the seller and the buyer disagree.
  platformDecision       String?   @db.VarChar(24)
  platformDecisionReason String?   @db.Text
  decidedByUserId        String?   @db.Char(26)
  decidedAt              DateTime? @db.DateTime(3)

  /// Minor units, deducted from the seller's settlement when the return is
  /// upheld.
  refundAmountMinor BigInt?
  currency          String? @db.Char(3)

  returnTrackingNumber String?   @db.VarChar(128)
  receivedAt           DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount    @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  orderGroup    SellerOrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, status, createdAt], map: "ix_seller_return_status")
  @@map("seller_returns")
}

// ---------------------------------------------------------------------------
// MONEY OWED, AND MONEY SENT
//
// Two tables, not one, because they answer different questions and move at
// different times. A SETTLEMENT is arithmetic over a period: this is what you
// earned, this is what we kept, this is what is left. A PAYOUT is a transfer
// that either happened or did not. Merging them means a failed transfer
// destroys the record of what was owed.
// ---------------------------------------------------------------------------

enum SellerSettlementStatus {
  /// The period is still open; lines are still being added.
  OPEN
  /// Closed and totalled, not yet paid.
  PENDING_PAYOUT
  /// A payout covering it has succeeded.
  PAID
  /// The operator is holding it - an open dispute, a compliance question.
  ON_HOLD
}

/// What a seller earned over one period.
model SellerSettlement {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  /// Human-readable, e.g. `STL-2026-09-0007`. From `NumberSequence`, so it is
  /// gapless and the seller's statements are numbered like documents rather
  /// than like rows.
  reference String @db.VarChar(32)

  status SellerSettlementStatus @default(OPEN)

  periodStart DateTime @db.DateTime(3)
  periodEnd   DateTime @db.DateTime(3)

  currency String @db.Char(3)

  /// Every figure minor units, BigInt. The identity that must hold:
  /// gross - commission - processingFee - refunds + adjustments = net.
  /// Checked in the service and asserted in a test, because a settlement that
  /// does not add up is a dispute nobody can settle.
  grossMinor         BigInt @default(0)
  taxMinor           BigInt @default(0)
  shippingMinor      BigInt @default(0)
  commissionMinor    BigInt @default(0)
  processingFeeMinor BigInt @default(0)
  refundsMinor       BigInt @default(0)
  adjustmentsMinor   BigInt @default(0)
  netPayableMinor    BigInt @default(0)

  /// Where the downloadable statement went.
  statementStorageKey String? @db.VarChar(512)

  closedAt DateTime? @db.DateTime(3)

  holdReason String? @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount          @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  lines         SellerSettlementLine[]
  payouts       SellerPayout[]

  @@unique([reference], map: "uq_seller_settlement_reference")
  @@index([sellerAccountId, status, periodEnd], map: "ix_seller_settlement_period")
  @@map("seller_settlements")
}

/// What a settlement line is for. Determines its sign.
enum SellerSettlementLineKind {
  SALE
  COMMISSION
  PROCESSING_FEE
  REFUND
  RETURN_DEDUCTION
  SHIPPING_CHARGE
  /// Anything the operator adds by hand, always with a reason.
  MANUAL_ADJUSTMENT
}

/// One entry on a statement.
model SellerSettlementLine {
  id           String  @id @db.Char(26)
  settlementId String  @db.Char(26)
  orderGroupId String? @db.Char(26)

  kind SellerSettlementLineKind

  /// Signed minor units. A commission is negative. Summing the column gives
  /// `netPayableMinor`, which is the only reason the identity above can be
  /// asserted rather than hoped for.
  amountMinor BigInt
  currency    String @db.Char(3)

  description String  @db.VarChar(255)
  /// Required for MANUAL_ADJUSTMENT.
  reason      String? @db.Text

  occurredAt DateTime @db.DateTime(3)

  createdByUserId String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)

  settlement SellerSettlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderGroup SellerOrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: SetNull)

  @@index([settlementId, kind], map: "ix_seller_settlement_line_kind")
  @@index([orderGroupId], map: "ix_seller_settlement_line_group")
  @@map("seller_settlement_lines")
}

enum SellerPayoutStatus {
  /// Created, nothing sent.
  PENDING
  /// Handed to the provider.
  IN_TRANSIT
  PAID
  /// The provider refused or the transfer bounced. An actionable state with a
  /// reason - NOT a reason to delete anything. The settlement it covers stays
  /// exactly as it was and can be paid again.
  FAILED
  CANCELLED
}

/// One transfer to a seller.
model SellerPayout {
  id              String  @id @db.Char(26)
  sellerAccountId String  @db.Char(26)
  settlementId    String? @db.Char(26)

  reference String @db.VarChar(32)

  status SellerPayoutStatus @default(PENDING)

  amountMinor BigInt
  currency    String @db.Char(3)

  /// Which provider moved it, and its own id for the transfer. The pair is how
  /// a seller's bank statement is reconciled against this table.
  provider         String? @db.VarChar(48)
  providerPayoutId String? @db.VarChar(128)

  /// Signed webhooks drive this column. A redirect never does - the same rule
  /// order confirmation follows, for the same reason.
  providerStatusRaw String? @db.VarChar(64)

  failureCode     String? @db.VarChar(64)
  failureReason   String? @db.Text
  /// What the operator or the seller must do about a failure. Written rather
  /// than inferred, so a failed payout is never a dead end.
  remediationHint String? @db.VarChar(512)

  scheduledFor DateTime? @db.DateTime(3)
  paidAt       DateTime? @db.DateTime(3)

  /// Makes a retried payout request harmless. The one guarantee that matters
  /// here: a retry must never pay a seller twice.
  idempotencyKey String? @db.VarChar(128)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sellerAccount SellerAccount     @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  settlement    SellerSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@unique([reference], map: "uq_seller_payout_reference")
  @@unique([sellerAccountId, idempotencyKey], map: "uq_seller_payout_idempotency")
  @@index([sellerAccountId, status, createdAt], map: "ix_seller_payout_status")
  @@map("seller_payouts")
}

/// What a seller is being told about.
enum SellerNotificationKind {
  APPLICATION_STATUS
  LISTING_DECISION
  NEW_ORDER
  DISPATCH_SLA_WARNING
  LOW_STOCK
  ERP_SYNC_FAILURE
  DOCUMENT_EXPIRING
  PAYOUT_RESULT
  RETURN_OR_DISPUTE
  SECURITY_EVENT
  BRAND_REQUEST_DECISION
}

/// An in-app notification for a seller organisation.
///
/// Addressed to the ORGANISATION, with an optional member, because most of
/// these concern the business rather than a person: a low-stock warning is for
/// whoever is looking. Read state is per member, in `readByJson`, rather than
/// one row per member - a seller with twelve staff would otherwise get twelve
/// rows per event.
model SellerNotification {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  kind SellerNotificationKind

  title String @db.VarChar(200)
  body  String @db.Text

  /// Where pressing it goes, as an in-app path.
  linkPath String? @db.VarChar(255)

  /// What it is about, for deduplication - one low-stock notice per offer per
  /// day rather than one per stock movement.
  subjectType String? @db.VarChar(48)
  subjectId   String? @db.Char(26)

  severity String @default("INFO") @db.VarChar(16)

  /// `{ "<profileId>": "<iso timestamp>" }`.
  readByJson Json?

  createdAt DateTime  @default(now()) @db.DateTime(3)
  /// Swept after this. Notifications are not a record; the audit log is.
  expiresAt DateTime? @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, createdAt], map: "ix_seller_notification_feed")
  @@index([sellerAccountId, kind, subjectId], map: "ix_seller_notification_subject")
  @@map("seller_notifications")
}

/// Everything that happened to one seller account, and who did it.
///
/// Separate from the operator's `AuditLog` because a seller can read this one.
/// An operator's audit trail contains internal notes, other sellers' ids and
/// staff names, none of which belong on a seller's own screen; giving the
/// seller a filtered view of it is the kind of filter that fails open once.
model SellerAuditLog {
  id              String @id @db.Char(26)
  sellerAccountId String @db.Char(26)

  /// `seller.listing.submitted`, `seller.member.invited`.
  action String @db.VarChar(96)

  /// Which side acted. A seller reading "your listing was paused" needs to
  /// know whether they did it.
  actorType   ActorType
  actorUserId String?   @db.Char(26)
  /// Shown to the seller. For an operator action this is a role, never a
  /// staff member's name.
  actorLabel  String?   @db.VarChar(120)

  resourceType String  @db.VarChar(48)
  resourceId   String? @db.Char(26)

  beforeJson Json?
  afterJson  Json?

  /// Seller-visible summary. Written deliberately rather than derived from the
  /// JSON, because the JSON is a diff and a diff is not a sentence.
  summary String? @db.VarChar(512)

  correlationId String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.DateTime(3)

  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId, createdAt], map: "ix_seller_audit_time")
  @@index([sellerAccountId, action], map: "ix_seller_audit_action")
  @@map("seller_audit_logs")
}

// ===========================================================================
// LOGISTICS PARTNER PORTAL
//
// Third-party carriers who collect consignments from a warehouse and deliver
// them to the business that bought them.
//
// THE TENANT BOUNDARY
//
// `LogisticsPartner` is the tenant. `LogisticsPartnerUser` joins a `User` of
// type LOGISTICS to it with a role. Every row below carries the partner it
// belongs to, and no route anywhere accepts a partner id: it is resolved from
// the session by `resolveLogisticsMembership` and every query filters on it.
// The same discipline `SellerAccount` and `BuyerOrganization` already follow,
// and it is what makes cross-carrier access impossible to express rather than
// merely checked for.
//
// There is a SECOND boundary on top of it, which the marketplace tenants do
// not have: a partner may only reach a shipment an `LogisticsShipmentAssignment`
// currently joins to it. Tenancy answers "whose rows"; assignment answers
// "which parcel", and a carrier that has finished a job must not keep reading
// the consignee's address for ever.
//
// WHY `LogisticsShipment` AND NOT `Shipment`
//
// `Shipment` already exists and is the OPERATOR's dispatch note against an
// order; `SellerShipment` is a seller's. Both are read by the orders module,
// the reports module and the customer's own order page. Widening either into a
// carrier-grade record would change what those screens mean, so this is a new
// table that LINKS to them. An order behaves exactly as it does today whether
// or not a logistics partner ever touches it.
//
// WHAT MARIADB 10.4 FORCED
//
//   * No native UUID. Every id is a ULID in CHAR(26), like the rest of this
//     schema.
//   * A UNIQUE index treats every NULL as distinct. Two places would have been
//     silently broken by that and each carries a NOT NULL surrogate:
//     `logistics_shipment_events.externalEventKey` (the event's own ULID where
//     no carrier supplied one) and `.idempotencyKey` (the same). Without them
//     a redelivered webhook would write a second event and a hospital would be
//     told twice that its consignment arrived.
//   * No SKIP LOCKED. Nothing here claims work in a loop; the carrier poller
//     leases through `JobQueue`, which already solves it.
//
// MONEY is BigInt minor units, as everywhere. COORDINATES are Decimal(9,6),
// for the same reason money is not a float: a stored fact has to read back
// exactly as it was written.
// ===========================================================================

enum LogisticsPartnerStatus {
  /// Created by the marketplace, nobody has activated an account yet.
  PENDING_ACTIVATION
  ACTIVE
  /// Suspended: no NEW assignment may be offered, and the shipments already in
  /// its hands stay readable and workable so they can be finished or handed
  /// over. Stopping a suspended carrier from updating a parcel it is holding
  /// would leave that parcel untrackable.
  SUSPENDED
  DEACTIVATED
}

enum LogisticsContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

/// Roles inside one carrier. Mirrors `domain/logistics-permissions.ts`; a
/// member added here without a grant there holds nothing, which is the safe
/// direction to fail.
///
/// `UBOSS_LOGISTICS_ADMIN` from the brief is deliberately NOT here: that is the
/// OPERATOR's own role, held by a member of staff, and it lives in the admin
/// permission catalogue as `logistics.*`. See that file's header.
enum LogisticsPartnerRole {
  LOGISTICS_PARTNER_OWNER
  LOGISTICS_PARTNER_ADMIN
  DISPATCHER
  DRIVER
  OPERATIONS_AGENT
  READ_ONLY_TRACKING_USER
}

enum LogisticsMemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// How wide one approved service region is.
///
/// Four scopes rather than a polygon, because this is a CONTRACT rather than a
/// geofence: what a carrier is licensed and insured to cover is written in
/// words like "Belgium" or "postcodes beginning 1" and has to be readable by
/// the person who negotiated it. Warehouse delivery radius, which genuinely is
/// a geofence, is modelled elsewhere and with turf.
enum LogisticsRegionScope {
  COUNTRY
  STATE
  CITY
  POSTCODE_PREFIX
}

/// What a carrier is approved to carry.
///
/// Medical freight is the reason this is an approval rather than a claim. A
/// carrier declaring it can move reagents at 2-8C is a sales statement; a
/// carrier APPROVED for it has shown the marketplace its equipment and its
/// certification, and only an approved capability is matched against a
/// consignment that needs it.
enum LogisticsCapabilityKind {
  TEMPERATURE_CONTROLLED
  COLD_CHAIN_2_8
  FROZEN
  STERILE_HANDLING
  DANGEROUS_GOODS
  FRAGILE_HANDLING
  OVERSIZED
  PALLET
  TAIL_LIFT
  WHITE_GLOVE
  SAME_DAY
  NEXT_DAY
  INTERNATIONAL
  CUSTOMS_BROKERAGE
  PROOF_OF_DELIVERY_PHOTO
  PROOF_OF_DELIVERY_OTP
}

enum LogisticsCapabilityState {
  REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

/// Every status a consignment can hold.
///
/// The canonical list. Carriers each have their own vocabulary and
/// `domain/carrier-status-map.ts` translates every one of them into a member of
/// this enum; a provider code nothing maps to is preserved verbatim and
/// flagged, and never becomes a status.
///
/// Nothing writes this column except through `assertShipmentTransition`.
enum LogisticsShipmentStatus {
  CREATED
  AWAITING_ASSIGNMENT
  ASSIGNED
  ACCEPTANCE_PENDING
  ACCEPTED
  PICKUP_SCHEDULED
  READY_FOR_PICKUP
  PICKED_UP
  DISPATCHED
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  DELIVERED
  DELAYED
  ON_HOLD
  ADDRESS_ISSUE
  CUSTOMS_HOLD
  DAMAGED
  TEMPERATURE_EXCEPTION
  DELIVERY_FAILED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURNED
  LOST
  CANCELLED
}

enum LogisticsServiceType {
  STANDARD
  EXPRESS
  SAME_DAY
  ECONOMY
  FREIGHT
  WHITE_GLOVE
}

enum LogisticsSlaState {
  NOT_APPLICABLE
  ON_TRACK
  AT_RISK
  BREACHED
}

enum LogisticsAssignmentState {
  /// Put to the partner and waiting for an answer.
  OFFERED
  ACCEPTED
  REJECTED
  /// The marketplace took it back before it was answered.
  WITHDRAWN
  /// Nobody answered inside the window.
  EXPIRED
  /// The job is finished. Kept, rather than deleted, because a finished
  /// assignment is the evidence of who carried what - and because it is what
  /// makes the shipment readable as history while refusing every write.
  COMPLETED
}

/// Where a tracking event came from.
///
/// Stored on every event and never inferred, because it is the first question
/// asked when two events disagree: a driver's phone and a carrier's API can
/// both report the same parcel, minutes apart, in different states.
enum LogisticsEventSource {
  LOGISTICS_PORTAL
  DRIVER_APP
  UBOSS_ADMIN
  CARRIER_API
  INBOUND_WEBHOOK
  SYSTEM_AUTOMATION
}

enum LogisticsExceptionType {
  PICKUP_MISSED
  PACKAGE_NOT_READY
  ADDRESS_INCORRECT
  RECIPIENT_UNAVAILABLE
  CUSTOMS_DELAY
  WEATHER_DELAY
  VEHICLE_BREAKDOWN
  PRODUCT_DAMAGED
  PACKAGE_LOST
  TEMPERATURE_EXCURSION
  DELIVERY_ATTEMPT_FAILED
  DOCUMENTATION_MISSING
  SLA_RISK
  SLA_BREACH
  /// A carrier sent a code this software does not recognise.
  ///
  /// An exception rather than a log line, deliberately. The original event is
  /// stored verbatim, the shipment's status is left alone, and a person is
  /// asked to decide what the code means - which is the only safe answer to
  /// "the carrier said something we have never seen" on a consignment of
  /// medical goods.
  UNMAPPED_EXTERNAL_EVENT
}

enum LogisticsExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  /// Reaches the marketplace's operations desk immediately, whatever the hour.
  /// Cold-chain excursions and lost consignments are always this.
  CRITICAL
}

enum LogisticsExceptionState {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum LogisticsDocumentKind {
  SHIPPING_LABEL
  PACKING_LIST
  COMMERCIAL_INVOICE
  CUSTOMS_DOCUMENT
  DELIVERY_INSTRUCTIONS
  PROOF_OF_DELIVERY
  DELIVERY_SIGNATURE
  DELIVERY_PHOTO
  DAMAGE_EVIDENCE
  RETURN_DOCUMENT
  MANIFEST
  OTHER
}

/// What the malware scanner said.
///
/// `SKIPPED` is the important member and it is not a synonym for `CLEAN`. A
/// deployment with no scanner configured records SKIPPED and the operator's
/// own policy decides whether such a file may be served. Marking an unscanned
/// file clean is the one outcome this enum exists to make impossible.
enum LogisticsDocumentScanState {
  PENDING
  CLEAN
  INFECTED
  FAILED
  SKIPPED
}

/// Who may read one document.
///
/// A commercial invoice carries prices, which a carrier has no business
/// reading on a domestic movement and genuinely needs at a customs post. So
/// visibility is per document rather than per kind, and the default for
/// anything priced is OPERATOR.
enum LogisticsDocumentAudience {
  PARTNER
  OPERATOR
  BOTH
}

enum LogisticsPickupState {
  REQUESTED
  SCHEDULED
  CONFIRMED
  COMPLETED
  FAILED
  CANCELLED
}

enum LogisticsManifestState {
  OPEN
  CLOSED
  HANDED_OVER
  CANCELLED
}

enum LogisticsDriverState {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LogisticsVehicleKind {
  VAN
  TRUCK
  BIKE
  CAR
  REFRIGERATED_VAN
  REFRIGERATED_TRUCK
}

enum LogisticsTripState {
  ACTIVE
  PAUSED
  COMPLETED
  /// Started and never ended. The sweep closes these, because a trip that
  /// stays ACTIVE is a device that keeps being allowed to send positions.
  ABANDONED
}

enum CarrierProvider {
  /// A logistics company working entirely inside this portal, typing its own
  /// events. Needs no credential and is the only provider fully working out of
  /// the box.
  MANUAL
  /// A carrier with an API this operator wired up through the generic adapter
  /// and the mapping table.
  CUSTOM
  DHL
  FEDEX
  UPS
}

enum CarrierIntegrationState {
  /// Declared, and missing the credentials it needs. Every call answers
  /// CARRIER_PROVIDER_UNCONFIGURED naming the environment variables - never a
  /// fabricated success.
  UNCONFIGURED
  CONFIGURED
  ACTIVE
  /// Taken out of service after consecutive failures, until a test passes.
  ERROR
  DISABLED
}

enum CarrierWebhookState {
  RECEIVED
  PROCESSED
  FAILED
  /// Out of attempts. Kept for ever and surfaced on the integrations screen:
  /// a dead-lettered tracking event is a parcel whose customer is being told
  /// something out of date.
  DEAD_LETTER
  /// Verified, understood, and deliberately changing nothing.
  IGNORED
}

enum LogisticsNotificationKind {
  SHIPMENT_ASSIGNED
  /// A driver was put on a consignment. Distinct from SHIPMENT_ASSIGNED, which
  /// is the marketplace offering the job to the CARRIER - this is the carrier
  /// deciding which of their own people carries it, and the two are read by
  /// different people for different reasons.
  DRIVER_ASSIGNED
  /// The consignment changed hands between two of the carrier's own drivers,
  /// with a reason. Its own kind rather than a second DRIVER_ASSIGNED, because
  /// "somebody was taken off this" is the line a dispatcher scans for.
  DRIVER_REASSIGNED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_REJECTED
  PICKUP_SCHEDULED
  PICKUP_COMPLETED
  SHIPMENT_DISPATCHED
  SHIPMENT_IN_TRANSIT
  OUT_FOR_DELIVERY
  SHIPMENT_DELIVERED
  DELIVERY_ATTEMPTED
  SHIPMENT_DELAYED
  EXCEPTION_RAISED
  SLA_AT_RISK
  SLA_BREACHED
  POD_AVAILABLE
  RETURN_INITIATED
  INTEGRATION_FAILURE
  USER_INVITED
  SECURITY_EVENT
}

// ---------------------------------------------------------------------------
// The tenant
// ---------------------------------------------------------------------------

/// One logistics company.
///
/// Created by the MARKETPLACE and never by self-registration. There is no
/// public sign-up route and no endpoint anywhere that creates one of these
/// without an admin permission, which is the first of the portal's access
/// rules and the easiest one to lose by accident.
model LogisticsPartner {
  id String @id @db.Char(26)

  /// Sequential-ish operator-facing reference, e.g. LP-000123.
  partnerCode String @unique(map: "uq_logistics_partner_code") @db.VarChar(32)

  legalName   String @db.VarChar(255)
  displayName String @db.VarChar(160)
  /// Lowercased, punctuation-stripped. The UNIQUE index is here rather than on
  /// `displayName`, so "Swift Freight", "SwiftFreight" and "swift-freight." are
  /// one carrier rather than three on the assignment dropdown.
  displayNameNormalized String @unique(map: "uq_logistics_partner_name") @db.VarChar(160)

  /// Company registration, as the carrier's own jurisdiction spells it. Free
  /// text because twenty-seven member states disagree about its shape, and a
  /// format this software invented would be wrong in most of them.
  registrationNumber String? @db.VarChar(64)
  taxNumber          String? @db.VarChar(64)
  /// Transport licence, and when it lapses. The operator's own compliance
  /// question; the portal shows it and nothing automatic depends on it,
  /// because "stop this carrier at midnight" is a business decision.
  licenceNumber   String?   @db.VarChar(64)
  licenceExpiresAt DateTime? @db.Date

  registrationCountry String @db.Char(2)

  /// The operations desk, not a person. A named individual here becomes stale
  /// the week they change jobs and the parcel still has to be chased.
  contactEmail String  @db.VarChar(320)
  contactPhone String? @db.VarChar(32)
  /// A second line for out-of-hours, which is when cold-chain exceptions
  /// actually happen.
  emergencyPhone String? @db.VarChar(32)
  websiteUrl     String? @db.VarChar(512)

  addressJson Json?

  status         LogisticsPartnerStatus  @default(PENDING_ACTIVATION)
  contractStatus LogisticsContractStatus @default(DRAFT)
  contractReference String? @db.VarChar(64)
  contractStartsAt  DateTime? @db.Date
  contractEndsAt    DateTime? @db.Date

  /// Why the marketplace suspended them, in the operator's own words. Shown to
  /// the partner, because a carrier told only "suspended" cannot fix anything.
  suspensionReason String? @db.VarChar(512)
  suspendedAt      DateTime? @db.DateTime(3)

  /// How many consignments may be open with this carrier at once, and how many
  /// may be offered in a day. Null means no ceiling.
  ///
  /// A setting rather than a rule, and per partner rather than per deployment:
  /// a national carrier and a two-van courier are not the same risk, and the
  /// operator is the only party who knows which one they are dealing with.
  maxOpenShipments  Int?
  maxDailyAssignments Int?

  /// Whether new work may be offered automatically, or only by a person.
  ///
  /// False by default. Automatic assignment moves medical freight to a company
  /// nobody looked at that morning, and an operator should choose that rather
  /// than inherit it.
  autoAssignEnabled Boolean @default(false)

  /// Which carrier API this partner's shipments are tracked through, where
  /// they are tracked through one at all. Null means the partner works
  /// entirely inside this portal - which is the MANUAL provider and the
  /// ordinary case.
  carrierIntegrationId String? @db.Char(26)

  /// Free-text, operator-only. Never shown to the partner: it routinely names
  /// other people, exactly like `CustomerProfile.internalNotes`.
  internalNotes String? @db.Text

  createdById String?  @db.Char(26)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  /// Soft delete. Shipments keep referencing the row.
  archivedAt  DateTime? @db.DateTime(3)

  carrierIntegration CarrierIntegration? @relation(fields: [carrierIntegrationId], references: [id], onDelete: SetNull)

  users        LogisticsPartnerUser[]
  invitations  LogisticsPartnerInvitation[]
  regions      LogisticsServiceRegion[]
  capabilities LogisticsCapability[]
  slaPolicies  LogisticsSlaPolicy[]
  assignments  LogisticsShipmentAssignment[]
  shipments    LogisticsShipment[]
  pickups      LogisticsPickupRequest[]
  manifests    LogisticsDispatchManifest[]
  drivers      LogisticsDriverProfile[]
  vehicles     LogisticsVehicle[]
  exceptions   LogisticsShipmentException[]
  notifications LogisticsNotification[]
  auditLogs    LogisticsAuditLog[]

  @@index([status, createdAt], map: "ix_logistics_partner_status")
  @@index([registrationCountry], map: "ix_logistics_partner_country")
  @@index([carrierIntegrationId], map: "ix_logistics_partner_integration")
  @@map("logistics_partners")
}

/// One person inside one logistics company.
///
/// `userId` is UNIQUE, not merely indexed. A person drives for one carrier at
/// a time, and a second membership would make "which tenant is this request
/// for?" a question with two answers - which is how a courier ends up reading
/// a competitor's consignments.
model LogisticsPartnerUser {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)
  userId             String @unique(map: "uq_logistics_partner_user_account") @db.Char(26)

  role   LogisticsPartnerRole
  status LogisticsMemberStatus @default(INVITED)

  /// Display name inside the portal. Held here rather than read from `users`
  /// because a carrier's dispatcher list is the carrier's own record of who
  /// works there.
  fullName String  @db.VarChar(160)
  jobTitle String? @db.VarChar(120)
  phone    String? @db.VarChar(32)

  /// Which of the partner's approved regions this person may work. Empty means
  /// all of them, which is the ordinary case for an office role.
  ///
  /// JSON rather than a join table: it is a short list of region ids read as a
  /// whole on every request and never queried across rows.
  regionScopeJson Json?

  /// Why access was taken away, and when. A disabled member keeps their row so
  /// past events still name a person.
  disabledAt     DateTime? @db.DateTime(3)
  disabledReason String?   @db.VarChar(255)

  lastActiveAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  partner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  driverProfile     LogisticsDriverProfile?
  invitationsSent   LogisticsPartnerInvitation[] @relation("LogisticsInvitationInviter")
  notifications     LogisticsNotification[]

  @@index([logisticsPartnerId, status], map: "ix_logistics_partner_user_status")
  @@index([logisticsPartnerId, role], map: "ix_logistics_partner_user_role")
  @@map("logistics_partner_users")
}

/// An emailed invitation to join a carrier's portal account.
///
/// Short-lived, single-use, and it carries NO password. The token is 32 bytes
/// of CSPRNG output stored as a SHA-256, redeemed once inside a transaction -
/// the same machinery `AuthToken` uses, and this row is the invitation's
/// business record beside it: who was asked, to what role, by whom.
///
/// A permanent password has never been emailed by this software and must not
/// start being emailed by this feature.
model LogisticsPartnerInvitation {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  email           String @db.VarChar(320)
  emailNormalized String @db.VarChar(320)
  fullName        String @db.VarChar(160)
  role            LogisticsPartnerRole

  /// SHA-256 of the raw token. The raw value goes into exactly one email.
  tokenHash String @unique(map: "uq_logistics_invitation_token") @db.Char(64)

  expiresAt  DateTime  @db.DateTime(3)
  acceptedAt DateTime? @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)

  /// Null when the marketplace itself sent it - which is how the first owner
  /// of every carrier account is created.
  invitedByPartnerUserId String? @db.Char(26)
  invitedByAdminUserId   String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)

  partner   LogisticsPartner      @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  invitedBy LogisticsPartnerUser? @relation("LogisticsInvitationInviter", fields: [invitedByPartnerUserId], references: [id], onDelete: SetNull)

  /// One live invitation per address per carrier. `acceptedAt`/`revokedAt` are
  /// what retire an old one, and re-inviting supersedes rather than duplicates.
  @@index([logisticsPartnerId, emailNormalized], map: "ix_logistics_invitation_email")
  @@index([expiresAt], map: "ix_logistics_invitation_expiry")
  @@map("logistics_partner_invitations")
}

/// Somewhere this carrier is approved to work.
///
/// Set by the OPERATOR, never by the partner. A carrier that could widen its
/// own approved regions could assign itself work it is not licensed to carry,
/// and this is medical freight.
model LogisticsServiceRegion {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  scope       LogisticsRegionScope
  countryCode String               @db.Char(2)

  /// The value the scope names: a state, a city, or a postcode prefix. Empty
  /// string for COUNTRY, and empty rather than NULL because MariaDB treats
  /// every NULL in a UNIQUE index as distinct - a nullable column here would
  /// let one carrier hold two "the whole of Belgium" rows.
  regionValue String @default("") @db.VarChar(120)

  /// Whether this region can be a source, a destination, or both. A carrier
  /// licensed to deliver into a country it may not collect from is ordinary.
  supportsPickup   Boolean @default(true)
  supportsDelivery Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  partner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  @@unique([logisticsPartnerId, scope, countryCode, regionValue], map: "uq_logistics_region")
  @@index([countryCode, isActive], map: "ix_logistics_region_country")
  @@map("logistics_service_regions")
}

/// Something this carrier is approved to handle.
///
/// An approval with evidence behind it, not a claim. Only an APPROVED
/// capability is matched against a consignment that needs it, and a carrier
/// whose cold-chain approval was suspended stops being offered reagents that
/// afternoon rather than at the next contract review.
model LogisticsCapability {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  kind  LogisticsCapabilityKind
  state LogisticsCapabilityState @default(REQUESTED)

  /// The certificate or accreditation behind it, and when it lapses.
  evidenceReference String?   @db.VarChar(255)
  evidenceExpiresAt DateTime? @db.Date

  /// The band this carrier can actually hold, where the capability is a
  /// temperature. Decimal rather than Float for the same reason coordinates
  /// are: a stored fact has to read back as it was written.
  temperatureMinC Decimal? @db.Decimal(5, 2)
  temperatureMaxC Decimal? @db.Decimal(5, 2)

  decidedByUserId String?   @db.Char(26)
  decidedAt       DateTime? @db.DateTime(3)
  decisionNote    String?   @db.VarChar(512)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  partner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  @@unique([logisticsPartnerId, kind], map: "uq_logistics_capability")
  @@index([kind, state], map: "ix_logistics_capability_kind")
  @@map("logistics_capabilities")
}

/// What this carrier promised, and what counts as proof that it delivered.
///
/// One policy may be the partner's default and others may be named per service
/// type, which is why `serviceType` is part of the key and carries a NOT NULL
/// surrogate: `STANDARD` is the default row rather than a nullable one, on the
/// same NULL-in-a-UNIQUE reasoning as everywhere else in this schema.
model LogisticsSlaPolicy {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  name        String               @db.VarChar(120)
  serviceType LogisticsServiceType @default(STANDARD)

  /// Hours from acceptance to collection, and from collection to delivery.
  ///
  /// Hours rather than working days, deliberately. A working-day promise needs
  /// a public-holiday calendar per country and this software is installed in
  /// twenty-seven of them; being approximately right about a complicated
  /// promise is worse than being exactly right about a simple one. A
  /// deployment that contracts in working days sets the hours to match.
  pickupHours   Int?
  deliveryHours Int?

  /// How long before a deadline a consignment starts counting as at risk.
  /// Two hours is right for a city courier and useless for an air freight
  /// movement, which is why it is a figure rather than a constant.
  riskWindowMinutes Int @default(120)

  /// What this deployment accepts as Proof of Delivery.
  ///
  /// Every one of these is a business decision rather than a technical one.
  /// A pharmacy wants a signature and a named recipient; a hospital loading
  /// bay wants a photograph; a controlled-drugs movement wants an OTP. The
  /// software supports all of them and chooses none.
  podRequiresRecipientName Boolean @default(true)
  podRequiresSignature     Boolean @default(false)
  podRequiresPhoto         Boolean @default(false)
  podRequiresOtp           Boolean @default(false)
  podRequiresDesignation   Boolean @default(false)

  /// How many delivery attempts before the consignment goes back.
  maxDeliveryAttempts Int @default(3)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  partner   LogisticsPartner    @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  shipments LogisticsShipment[]

  @@unique([logisticsPartnerId, serviceType, name], map: "uq_logistics_sla_policy")
  @@index([logisticsPartnerId, isDefault], map: "ix_logistics_sla_default")
  @@map("logistics_sla_policies")
}

// ---------------------------------------------------------------------------
// The consignment
// ---------------------------------------------------------------------------

/// A consignment moving from a warehouse to a business.
///
/// The record a logistics partner works. It LINKS to an order, a seller's part
/// of one, a warehouse and the operator's own dispatch note rather than
/// replacing any of them - see the banner at the top of this section.
///
/// WHAT IS COPIED RATHER THAN JOINED, AND WHY
///
/// Company names, addresses, contacts and the category summary are snapshots,
/// the same way `Order.shippingAddressJson` is. A carrier holding a parcel has
/// to be able to read the address it is going to even if the buyer edits their
/// address book that afternoon, and the record of where a consignment was
/// actually sent must not change afterwards.
///
/// WHAT IS DELIBERATELY ABSENT
///
/// Prices, order lines, payment state, the buyer's purchasing history, the
/// seller's margin. Not masked - ABSENT. A column that is never populated
/// cannot be leaked by a query somebody forgets to narrow, which is a stronger
/// control than redacting it on the way out. `declaredValueMinor` is the one
/// exception and exists for customs and insurance; it is disclosed to a
/// carrier only on a movement that crosses a border.
model LogisticsShipment {
  id String @id @db.Char(26)

  /// Human-facing reference, e.g. LS-2026-000123. What a person quotes on the
  /// telephone, and unique across the deployment.
  shipmentReference String @unique(map: "uq_logistics_shipment_reference") @db.VarChar(32)

  /// Where it came from in the commerce side of this system. All nullable:
  /// a consignment can be raised for a movement that has no order behind it
  /// at all - a warehouse transfer, a sample, a replacement.
  orderId            String? @db.Char(26)
  sellerOrderGroupId String? @db.Char(26)
  /// The operator's own dispatch note, where one exists. This is the join that
  /// keeps the two records from drifting into two versions of one parcel.
  operatorShipmentId String? @db.Char(26)
  originLocationId   String? @db.Char(26)

  /// The carrier currently holding it, denormalised from the live assignment.
  ///
  /// Denormalised deliberately, and it is the one place in this feature where
  /// that is done. The shipment list is the portal's busiest query and it
  /// filters on exactly this column; resolving it through the assignment table
  /// on every row would make the list a join nobody can index well. It is
  /// written ONLY inside the same transaction that writes the assignment - see
  /// `assignment.service.ts` - so the two cannot disagree.
  ///
  /// Null while the shipment is waiting to be assigned.
  assignedPartnerId String? @db.Char(26)

  status      LogisticsShipmentStatus @default(CREATED)
  serviceType LogisticsServiceType    @default(STANDARD)

  /// The tracking number a customer is given. Ours, not the carrier's: a
  /// consignment re-assigned to a second carrier keeps this one, so a customer
  /// who bookmarked a tracking page does not lose it.
  trackingNumber String @unique(map: "uq_logistics_shipment_tracking") @db.VarChar(64)

  /// The CARRIER's own number, where an integrated carrier issued one.
  ///
  /// Unique per integration and not globally: two carriers can and do issue
  /// the same string, and a global UNIQUE here would reject the second one
  /// months after nobody remembers this column exists.
  carrierIntegrationId   String? @db.Char(26)
  carrierTrackingNumber  String? @db.VarChar(128)
  carrierTrackingUrl     String? @db.VarChar(1024)

  // --- Who it is between -------------------------------------------------

  /// The seller whose goods these are, where the movement came from a
  /// marketplace order. Name copied; the id is kept so the operator can join
  /// back, and is never disclosed to the carrier.
  sellerAccountId   String? @db.Char(26)
  sellerCompanyName String  @db.VarChar(255)

  /// The business receiving it. Same treatment as the seller: the profile id
  /// is the operator's link and the name is what the carrier sees.
  receivingCustomerProfileId String? @db.Char(26)
  receivingCompanyName       String  @db.VarChar(255)

  // --- Where it goes -----------------------------------------------------

  pickupAddressJson   Json
  deliveryAddressJson Json

  /// Contacts, stored whole and MASKED ON THE WAY OUT by
  /// `domain/logistics-masking.ts`. Stored whole because a driver standing at
  /// a locked loading bay needs the real number and the platform has to be
  /// able to place that call; masked on the way out because nobody else does.
  pickupContactName    String? @db.VarChar(160)
  pickupContactPhone   String? @db.VarChar(32)
  pickupContactEmail   String? @db.VarChar(320)
  deliveryContactName  String? @db.VarChar(160)
  deliveryContactPhone String? @db.VarChar(32)
  deliveryContactEmail String? @db.VarChar(320)

  /// Denormalised from the addresses so the list can filter and group on them
  /// without opening JSON. Upper-case alpha-2.
  originCountry         String  @db.Char(2)
  destinationCountry    String  @db.Char(2)
  destinationCity       String? @db.VarChar(120)
  destinationPostalCode String? @db.VarChar(24)

  /// Kilometres, where both ends could be located. Information, never a rule.
  distanceKm Decimal? @db.Decimal(9, 2)

  // --- What is in it -----------------------------------------------------

  packageCount     Int    @default(1)
  totalWeightGrams Int    @default(0)
  /// Longest side, girth and volume, for a carrier deciding whether it fits on
  /// a van. Grams and millimetres, integers, because a fractional millimetre
  /// is not a fact anybody measured.
  totalVolumeCm3   Int?

  /// What is in the boxes, in words a carrier may read: "sterile consumables,
  /// diagnostic reagents". Never the product names, never the quantities,
  /// never the prices - a packing list is a document with its own audience.
  productCategorySummary String? @db.VarChar(512)

  /// Handling. These are what the assignment engine matches against a
  /// carrier's APPROVED capabilities, and what the portal shows in red at the
  /// top of the shipment.
  requiresColdChain        Boolean @default(false)
  requiresTemperatureRange Boolean @default(false)
  temperatureMinC          Decimal? @db.Decimal(5, 2)
  temperatureMaxC          Decimal? @db.Decimal(5, 2)
  requiresSterileHandling  Boolean @default(false)
  isFragile                Boolean @default(false)
  isDangerousGoods         Boolean @default(false)
  dangerousGoodsClass      String?  @db.VarChar(24)
  handlingNotes            String?  @db.VarChar(1024)

  /// Customs and insurance value. BigInt minor units with its own currency
  /// column, like every other amount in this schema - never a float, and never
  /// a JS number.
  declaredValueMinor BigInt? @db.BigInt
  currency           String? @db.Char(3)

  // --- The promise -------------------------------------------------------

  slaPolicyId String? @db.Char(26)

  expectedPickupAt    DateTime? @db.DateTime(3)
  pickupDueAt         DateTime? @db.DateTime(3)
  estimatedDeliveryAt DateTime? @db.DateTime(3)
  deliveryDueAt       DateTime? @db.DateTime(3)

  /// Maintained by the SLA sweep from `domain/logistics-sla.ts`, so the
  /// dashboard can count without recomputing a window over every open row.
  /// The detail page recomputes live, and the two agree because they call the
  /// same function.
  slaState        LogisticsSlaState @default(NOT_APPLICABLE)
  slaEvaluatedAt  DateTime?         @db.DateTime(3)

  // --- What actually happened -------------------------------------------

  acceptedAt   DateTime? @db.DateTime(3)
  pickedUpAt   DateTime? @db.DateTime(3)
  dispatchedAt DateTime? @db.DateTime(3)
  deliveredAt  DateTime? @db.DateTime(3)
  closedAt     DateTime? @db.DateTime(3)

  deliveryAttemptCount Int @default(0)

  /// When the last event of any kind landed, and when a carrier feed was last
  /// read. Two columns because they answer different questions: the first is
  /// "is this parcel moving", the second is "is our integration working", and
  /// a shipment can be healthy on one and stale on the other.
  lastEventAt       DateTime? @db.DateTime(3)
  lastCarrierSyncAt DateTime? @db.DateTime(3)

  /// Optimistic concurrency. A dispatcher and a webhook can touch one
  /// consignment in the same second; the conditional UPDATE against this
  /// column is what makes the loser retry instead of overwriting.
  version Int @default(0)

  createdById String?  @db.Char(26)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sellerOrderGroup   SellerOrderGroup?   @relation(fields: [sellerOrderGroupId], references: [id], onDelete: SetNull)
  originLocation     InventoryLocation?  @relation(fields: [originLocationId], references: [id], onDelete: Restrict)
  assignedPartner    LogisticsPartner?   @relation(fields: [assignedPartnerId], references: [id], onDelete: Restrict)
  slaPolicy          LogisticsSlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  carrierIntegration CarrierIntegration? @relation(fields: [carrierIntegrationId], references: [id], onDelete: SetNull)

  packages        LogisticsShipmentPackage[]
  assignments     LogisticsShipmentAssignment[]
  events          LogisticsShipmentEvent[]
  exceptions      LogisticsShipmentException[]
  documents       LogisticsShipmentDocument[]
  proofOfDelivery LogisticsProofOfDelivery?
  pickupRequests  LogisticsPickupRequest[]
  manifestEntries LogisticsDispatchManifestEntry[]
  driverAssignments LogisticsDriverAssignment[]
  trips           LogisticsActiveTrip[]
  notifications   LogisticsNotification[]

  /// The portal's own list query: this carrier's shipments, newest first,
  /// narrowed by status. Leading column is the tenant, always.
  @@index([assignedPartnerId, status, createdAt], map: "ix_logistics_shipment_partner_status")
  /// The SLA sweep and the dashboard's at-risk counter.
  @@index([assignedPartnerId, slaState, deliveryDueAt], map: "ix_logistics_shipment_sla")
  /// Deliveries due today, and the pickup board.
  @@index([assignedPartnerId, expectedPickupAt], map: "ix_logistics_shipment_pickup_due")
  @@index([assignedPartnerId, estimatedDeliveryAt], map: "ix_logistics_shipment_delivery_due")
  /// The operator's own list, which is not filtered by carrier.
  @@index([status, createdAt], map: "ix_logistics_shipment_status")
  @@index([orderId], map: "ix_logistics_shipment_order")
  @@index([sellerOrderGroupId], map: "ix_logistics_shipment_seller_group")
  @@index([originLocationId], map: "ix_logistics_shipment_origin")
  @@index([receivingCustomerProfileId], map: "ix_logistics_shipment_receiver")
  @@index([sellerAccountId], map: "ix_logistics_shipment_seller")
  @@index([destinationCountry, destinationCity], map: "ix_logistics_shipment_destination")
  /// The carrier poller: everything still moving on one integration, oldest
  /// sync first.
  @@index([carrierIntegrationId, lastCarrierSyncAt], map: "ix_logistics_shipment_carrier_sync")
  @@index([carrierIntegrationId, carrierTrackingNumber], map: "ix_logistics_shipment_carrier_tracking")
  @@map("logistics_shipments")
}

/// One box, pallet or carton inside a consignment.
///
/// Its own rows rather than JSON, unlike `SellerShipment.contentsJson`, and
/// the difference is that these are SCANNED. A driver reads a barcode off a
/// carton at a loading bay and the system has to find that carton; a JSON blob
/// cannot be indexed by the thing a scanner emits.
model LogisticsShipmentPackage {
  id         String @id @db.Char(26)
  shipmentId String @db.Char(26)

  /// What is printed on the label and what a scanner reads. Unique across the
  /// deployment because a barcode that means two things is worse than no
  /// barcode.
  packageReference String @unique(map: "uq_logistics_package_reference") @db.VarChar(64)

  sequence Int @default(1)

  weightGrams Int  @default(0)
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?

  /// Pallet, carton, cool box - the operator's own vocabulary rather than an
  /// enum, because packing formats differ by trade and this is a general
  /// marketplace.
  packagingType String? @db.VarChar(64)

  isFragile           Boolean @default(false)
  requiresColdChain   Boolean @default(false)

  /// Batch or lot, where the goods carry one.
  ///
  /// Disclosed to a carrier ONLY where the shipment's handling requirements
  /// make it operationally necessary - a recall, a cold-chain consignment -
  /// because a lot number plus a category is enough to identify a product and
  /// a product is commercially sensitive. The read path decides; the column
  /// simply holds it.
  batchReference String? @db.VarChar(64)

  /// Set when a driver scans it at collection and again at delivery. Two
  /// columns rather than a status, because a carton can be collected and never
  /// arrive and the gap between the two timestamps is the whole story.
  scannedOutAt DateTime? @db.DateTime(3)
  scannedInAt  DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, sequence], map: "uq_logistics_package_sequence")
  @@index([shipmentId], map: "ix_logistics_package_shipment")
  @@map("logistics_shipment_packages")
}

/// The offer of one consignment to one carrier, and what they said.
///
/// A row per offer rather than a column on the shipment, because reassignment
/// has to leave a trail: "who was asked, when, what they said and why" is the
/// question a disputed delivery turns into, and a column that is overwritten
/// answers none of it.
///
/// `state` is what authorises a partner. A COMPLETED or WITHDRAWN assignment
/// leaves the shipment readable as history and refuses every write - a carrier
/// that has finished a job must not keep the consignee's address live for ever.
model LogisticsShipmentAssignment {
  id                 String @id @db.Char(26)
  shipmentId         String @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  state LogisticsAssignmentState @default(OFFERED)

  /// Why this carrier. `AUTO` where the engine chose on coverage and
  /// capability, `MANUAL` where a person did. Stored because an operator
  /// reviewing a bad delivery needs to know whether anybody looked.
  assignedAutomatically Boolean @default(false)

  offeredAt   DateTime  @default(now()) @db.DateTime(3)
  /// How long the carrier has to answer before it lapses back to the pool.
  respondBy   DateTime? @db.DateTime(3)
  respondedAt DateTime? @db.DateTime(3)

  /// Mandatory on a rejection - enforced in the service, not merely here. A
  /// refusal with no reason is a refusal the operator cannot act on, and it
  /// counts against the carrier's record.
  responseReason String? @db.VarChar(512)

  withdrawnAt     DateTime? @db.DateTime(3)
  withdrawnReason String?   @db.VarChar(512)
  completedAt     DateTime? @db.DateTime(3)

  /// Who did it, on each side.
  offeredByUserId     String? @db.Char(26)
  respondedByPartnerUserId String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  partner  LogisticsPartner  @relation(fields: [logisticsPartnerId], references: [id], onDelete: Restrict)

  /// The authorisation query: is this shipment live for this carrier right now.
  @@index([logisticsPartnerId, state, shipmentId], map: "ix_logistics_assignment_authz")
  @@index([shipmentId, state], map: "ix_logistics_assignment_shipment")
  /// The sweep that expires unanswered offers.
  @@index([state, respondBy], map: "ix_logistics_assignment_expiry")
  @@map("logistics_shipment_assignments")
}

/// One thing that happened to a consignment.
///
/// APPEND-ONLY. Nothing updates one of these rows, and
/// `LogisticsShipment.status` is maintained from them inside the same
/// transaction that writes them - so the timeline is the record and the column
/// is the index over it.
///
/// DUPLICATE SUPPRESSION IS A CONSTRAINT, NOT A CODE PATH
///
/// Two UNIQUE indexes do the work, because a check-then-insert loses to a
/// carrier that redelivers a webhook twice in the same second:
///
///   - `(shipmentId, idempotencyKey)` - a client that retries a status update
///     under the same key writes at most one event.
///   - `externalEventKey` - a carrier that sends the same event id twice
///     writes at most one event.
///
/// Both columns are NOT NULL and carry the event's own ULID where nothing
/// better exists, because MariaDB treats every NULL in a UNIQUE index as
/// distinct and a nullable column here would enforce precisely nothing.
model LogisticsShipmentEvent {
  id         String @id @db.Char(26)
  shipmentId String @db.Char(26)

  /// What it moved from and to. `previousStatus` is null only on the first
  /// event of a consignment's life.
  previousStatus LogisticsShipmentStatus?
  status         LogisticsShipmentStatus

  /// The sentence a customer reads on the tracking page. Deliberately separate
  /// from the note below: one is published and one is not, and a single field
  /// means an operations note about a difficult receptionist ends up on a
  /// buyer's screen.
  publicDescription String? @db.VarChar(512)
  /// The carrier's and the operator's own words. Never leaves the portal.
  internalNote      String? @db.Text

  /// When it happened, and when we were told. Two instants because they differ
  /// by hours on a polled integration, and a timeline sorted by the wrong one
  /// reads as though the parcel went backwards.
  occurredAt DateTime @db.DateTime(3)
  recordedAt DateTime @default(now()) @db.DateTime(3)

  /// Where it happened, as a place name and as coordinates where the source
  /// gave them.
  locationLabel     String?  @db.VarChar(255)
  locationCountry   String?  @db.Char(2)
  locationLatitude  Decimal? @db.Decimal(9, 6)
  locationLongitude Decimal? @db.Decimal(9, 6)

  source LogisticsEventSource

  /// Who, where a person did it. Both nullable: a carrier feed has neither.
  actorUserId            String? @db.Char(26)
  actorLogisticsPartnerId String? @db.Char(26)

  /// The carrier's own identifiers, kept verbatim for audit even after the
  /// code has been mapped. An operator arguing with a carrier about a scan
  /// needs their reference, not our translation of it.
  externalEventId   String? @db.VarChar(128)
  externalStatusCode String? @db.VarChar(64)
  carrierIntegrationId String? @db.Char(26)

  /// `"<provider>:<their id>"`, or this event's own ULID where no carrier
  /// supplied one. NOT NULL - see the note in this model's header.
  externalEventKey String @unique(map: "uq_logistics_event_external") @db.VarChar(200)

  /// The caller's key, or this event's own ULID. NOT NULL, same reason.
  idempotencyKey String @db.Char(64)

  /// An operator correction rather than a movement. Rendered differently on
  /// the timeline, because a corrected record that looks like an ordinary one
  /// is a record nobody can audit.
  isCorrection Boolean @default(false)

  /// Set where the event names a reason - every transition the matrix marks
  /// `requiresReason`.
  reason String? @db.VarChar(512)

  /// The exception this event raised or resolved, and the document it points
  /// at. Both SetNull: deleting a document must not delete the fact that one
  /// was attached.
  exceptionId String? @db.Char(26)
  documentId  String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// The timeline itself: one shipment, in the order it happened.
  @@unique([shipmentId, idempotencyKey], map: "uq_logistics_event_idempotency")
  @@index([shipmentId, occurredAt], map: "ix_logistics_event_timeline")
  @@index([shipmentId, recordedAt], map: "ix_logistics_event_recorded")
  @@index([source, recordedAt], map: "ix_logistics_event_source")
  @@index([carrierIntegrationId, recordedAt], map: "ix_logistics_event_carrier")
  @@map("logistics_shipment_events")
}

/// Something went wrong and somebody has to do something about it.
///
/// Distinct from an exception STATUS on the shipment. The status says where the
/// parcel is; this says who owns the problem, by when, and what has been tried
/// - which is a work item with a lifecycle of its own, and a consignment can
/// carry two at once.
model LogisticsShipmentException {
  id                 String  @id @db.Char(26)
  shipmentId         String  @db.Char(26)
  /// Null where the marketplace raised it before anybody was assigned.
  logisticsPartnerId String? @db.Char(26)

  type     LogisticsExceptionType
  severity LogisticsExceptionSeverity @default(MEDIUM)
  state    LogisticsExceptionState    @default(OPEN)

  /// What happened, in the words of whoever raised it.
  reason String @db.VarChar(512)
  detail String? @db.Text

  /// Who owns it. A partner user, or the marketplace's own desk once it is
  /// escalated. Both nullable, and an exception with neither is an unassigned
  /// one - which the queue shows first.
  ownerPartnerUserId String? @db.Char(26)
  ownerAdminUserId   String? @db.Char(26)

  /// When it should be fixed by, and whether it was.
  resolutionDueAt DateTime? @db.DateTime(3)
  resolvedAt      DateTime? @db.DateTime(3)
  closedAt        DateTime? @db.DateTime(3)
  resolutionNotes String?   @db.Text

  escalatedAt     DateTime? @db.DateTime(3)
  escalationNote  String?   @db.VarChar(512)

  /// The new promise, where the exception moved it.
  revisedEtaAt DateTime? @db.DateTime(3)

  /// Whether the buyer has been told. A separate fact from the exception being
  /// open: most exceptions are resolved before anybody needs to know, and the
  /// ones that are not are the ones that generate a complaint.
  customerNotifiedAt DateTime? @db.DateTime(3)

  /// The carrier's own payload, where this came from an UNMAPPED_EXTERNAL_EVENT.
  /// Kept whole so a person can read what the carrier actually said.
  externalPayloadJson Json?

  raisedByUserId String?  @db.Char(26)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  partner  LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  /// The exception queue, as the portal renders it: this carrier's open ones,
  /// worst first.
  @@index([logisticsPartnerId, state, severity], map: "ix_logistics_exception_queue")
  @@index([shipmentId, state], map: "ix_logistics_exception_shipment")
  /// The operator's queue, which is not filtered by carrier, and the sweep
  /// that chases overdue resolutions.
  @@index([state, severity, createdAt], map: "ix_logistics_exception_operator")
  @@index([state, resolutionDueAt], map: "ix_logistics_exception_due")
  @@index([type, createdAt], map: "ix_logistics_exception_type")
  @@map("logistics_shipment_exceptions")
}

/// A file attached to a consignment.
///
/// The bytes live in object storage under the PRIVATE prefix and are read back
/// only through a short-lived signed token - never a guessable URL, and never
/// a public one. A delivery signature is a person's handwriting; a commercial
/// invoice is a price list.
model LogisticsShipmentDocument {
  id         String @id @db.Char(26)
  shipmentId String @db.Char(26)

  kind     LogisticsDocumentKind
  audience LogisticsDocumentAudience @default(PARTNER)

  fileName    String @db.VarChar(255)
  contentType String @db.VarChar(128)
  sizeBytes   Int

  /// The object key, not a URL. A URL stored in a database is a URL that
  /// outlives whatever made it temporary.
  storageKey String @db.VarChar(512)

  /// SHA-256 of the bytes, so a document can be shown to be the one that was
  /// uploaded. A delivery photograph is evidence.
  contentHash String? @db.Char(64)

  scanState  LogisticsDocumentScanState @default(PENDING)
  scannedAt  DateTime?                  @db.DateTime(3)
  scanDetail String?                    @db.VarChar(255)

  uploadedByUserId String?  @db.Char(26)
  uploadedBySource LogisticsEventSource @default(LOGISTICS_PORTAL)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  /// Soft delete: a document withdrawn from a consignment stays as evidence
  /// that it once existed.
  deletedAt DateTime? @db.DateTime(3)

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, kind], map: "ix_logistics_document_shipment")
  @@index([scanState, createdAt], map: "ix_logistics_document_scan")
  @@map("logistics_shipment_documents")
}

/// Evidence that a consignment was handed over.
///
/// One per shipment, which is why `shipmentId` is UNIQUE: a parcel is
/// delivered once, and a second POD is a correction rather than an addition -
/// corrections go on the event timeline where they can be read as such.
///
/// WHAT IS NOT HERE
///
/// The signature and the photograph. Those are `LogisticsShipmentDocument`
/// rows under the private storage prefix, and this row points at them. A
/// signature image inline in an API response is a signature image in a browser
/// cache.
model LogisticsProofOfDelivery {
  id         String @id @db.Char(26)
  shipmentId String @unique(map: "uq_logistics_pod_shipment") @db.Char(26)

  /// Who took it. Masked on the way out for everybody except the driver who
  /// captured it and the marketplace.
  recipientName        String? @db.VarChar(160)
  recipientDesignation String? @db.VarChar(120)

  deliveredAt       DateTime @db.DateTime(3)
  deliveryLatitude  Decimal? @db.Decimal(9, 6)
  deliveryLongitude Decimal? @db.Decimal(9, 6)
  deliveryLocationLabel String? @db.VarChar(255)

  /// Whether each element of the deployment's POD policy was actually
  /// satisfied. Stored as facts rather than inferred from the presence of a
  /// document, so a policy tightened next year does not retroactively
  /// invalidate last year's deliveries.
  hasSignature     Boolean @default(false)
  hasPhoto         Boolean @default(false)
  otpVerified      Boolean @default(false)
  businessStamped  Boolean @default(false)

  signatureDocumentId String? @db.Char(26)
  photoDocumentId     String? @db.Char(26)

  /// Anything the driver had to write down: left with security, signed by a
  /// colleague, one carton refused.
  exceptionNote String? @db.VarChar(512)

  capturedByPartnerUserId String?              @db.Char(26)
  capturedBySource        LogisticsEventSource @default(DRIVER_APP)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([deliveredAt], map: "ix_logistics_pod_delivered")
  @@map("logistics_proof_of_delivery")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/// A request for a carrier to collect from a warehouse.
///
/// Separate from the shipment because one van call collects several
/// consignments and one consignment can survive a failed collection and be
/// collected the next day. A column on the shipment would model neither.
model LogisticsPickupRequest {
  id                 String  @id @db.Char(26)
  logisticsPartnerId String  @db.Char(26)
  /// Null for a standing collection that is not about one parcel.
  shipmentId         String? @db.Char(26)
  locationId         String? @db.Char(26)

  state LogisticsPickupState @default(REQUESTED)

  /// The window, in the WAREHOUSE's own zone, which is carried beside it.
  ///
  /// A wall-clock fact carries its own zone - the same rule
  /// `RecurringSchedule.timezone` follows. "Collect between 14:00 and 16:00"
  /// means the clock on the wall of the building the van drives to, and a
  /// deployment whose warehouses span Madrid and the Canaries needs the two to
  /// disagree.
  windowStartAt DateTime  @db.DateTime(3)
  windowEndAt   DateTime  @db.DateTime(3)
  timezone      String?   @db.VarChar(64)

  /// What the warehouse needs the driver to know: which gate, which bell,
  /// whether there is a tail lift.
  warehouseInstructions String? @db.VarChar(1024)

  /// Has the warehouse said the goods are actually ready? A carrier arriving
  /// at an unready dock is the single most common pickup failure, and this is
  /// the handshake that prevents it.
  readinessConfirmedAt DateTime? @db.DateTime(3)

  driverProfileId String? @db.Char(26)
  vehicleId       String? @db.Char(26)

  scheduledAt DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  failedAt    DateTime? @db.DateTime(3)
  failureReason String? @db.VarChar(512)

  /// How many packages the driver actually took. Less than the consignment's
  /// count is a partial collection and raises an exception.
  packagesCollected Int?

  /// The key the completion call was made under, so a driver's phone
  /// retrying on a flaky connection completes one pickup rather than two.
  completionIdempotencyKey String? @db.VarChar(64)

  createdByUserId String?  @db.Char(26)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)

  partner  LogisticsPartner        @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  shipment LogisticsShipment?      @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  location InventoryLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  driver   LogisticsDriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)
  vehicle  LogisticsVehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([logisticsPartnerId, completionIdempotencyKey], map: "uq_logistics_pickup_idempotency")
  @@index([logisticsPartnerId, state, windowStartAt], map: "ix_logistics_pickup_board")
  @@index([shipmentId], map: "ix_logistics_pickup_shipment")
  @@index([locationId, windowStartAt], map: "ix_logistics_pickup_location")
  @@index([driverProfileId, windowStartAt], map: "ix_logistics_pickup_driver")
  @@map("logistics_pickup_requests")
}

/// The paperwork for one handover: a list of consignments leaving together.
model LogisticsDispatchManifest {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  manifestNumber String @db.VarChar(32)

  state LogisticsManifestState @default(OPEN)

  driverProfileId String? @db.Char(26)
  vehicleId       String? @db.Char(26)

  /// Where it leaves from and where it is bound, as free text: a hub name is
  /// not a warehouse this deployment knows about.
  originLabel      String? @db.VarChar(160)
  destinationLabel String? @db.VarChar(160)

  plannedDepartureAt DateTime? @db.DateTime(3)
  closedAt           DateTime? @db.DateTime(3)
  handedOverAt       DateTime? @db.DateTime(3)
  /// Who signed for the whole load at the far end.
  handoverSignedBy   String?   @db.VarChar(160)

  notes String? @db.VarChar(1024)

  createdByPartnerUserId String?  @db.Char(26)
  createdAt              DateTime @default(now()) @db.DateTime(3)
  updatedAt              DateTime @updatedAt @db.DateTime(3)

  partner LogisticsPartner        @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  driver  LogisticsDriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)
  vehicle LogisticsVehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  entries LogisticsDispatchManifestEntry[]

  /// Per carrier, so a manifest number is the carrier's own numbering and does
  /// not leak how much work the marketplace as a whole is moving - the same
  /// reasoning as `SellerOrderGroup.sellerOrderNumber`.
  @@unique([logisticsPartnerId, manifestNumber], map: "uq_logistics_manifest_number")
  @@index([logisticsPartnerId, state, plannedDepartureAt], map: "ix_logistics_manifest_board")
  @@map("logistics_dispatch_manifests")
}

model LogisticsDispatchManifestEntry {
  id         String @id @db.Char(26)
  manifestId String @db.Char(26)
  shipmentId String @db.Char(26)

  /// How many of the consignment's packages went on this load. A consignment
  /// split across two vans is unusual and real.
  packageCount Int @default(0)

  addedAt   DateTime  @default(now()) @db.DateTime(3)
  removedAt DateTime? @db.DateTime(3)

  manifest LogisticsDispatchManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  shipment LogisticsShipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// A consignment appears on a manifest once. Re-adding a removed one is an
  /// update of this row, not a second one.
  @@unique([manifestId, shipmentId], map: "uq_logistics_manifest_entry")
  @@index([shipmentId], map: "ix_logistics_manifest_entry_shipment")
  @@map("logistics_dispatch_manifest_entries")
}

/// Somebody who drives.
///
/// Hangs off `LogisticsPartnerUser` rather than off `User`, so a driver is by
/// construction a member of exactly one carrier and cannot be looked up
/// across tenants.
model LogisticsDriverProfile {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  /// The driver's name, typed by whoever runs the fleet.
  ///
  /// **On the driver record, not read through a login.** A carrier employs
  /// people who will never open this software - a subcontracted van driver, an
  /// agency stand-in for a week - and a fleet register that could only hold
  /// people with an account is a register that does not describe the fleet.
  /// Somebody has to be able to type a name and get on with the day.
  ///
  /// It is therefore the source of truth for every screen that names a driver:
  /// the consignment, the timeline, the manifest, the carrier's list and the
  /// marketplace's. `partnerUser` below is a link, not the answer.
  fullName String @db.VarChar(160)

  /// How to reach them. The number a dispatcher rings when a van is late, and
  /// the one masked out of everything the marketplace or a buyer can see.
  phone String? @db.VarChar(32)
  email String? @db.VarChar(320)

  /// Their account, where they have one.
  ///
  /// **Nullable, and null is the ordinary case.** A driver record and an
  /// authenticated user are separate concepts: this is filled only for a
  /// driver who signs in to `/driver/tasks` on a phone, and that is what gates
  /// every device feature - the task list, the scanner, proof of delivery, the
  /// trip that permits a location ping. A record-only driver can be put on a
  /// consignment and appear on every screen, and can do none of those things,
  /// because there is nobody to do them as.
  ///
  /// UNIQUE, so one account maps to one driver record - and NULL is distinct
  /// in a MariaDB unique index, so any number of record-only drivers sit
  /// happily beside each other. The same property `activeShipmentId` uses on
  /// the assignment table.
  partnerUserId String? @unique(map: "uq_logistics_driver_user") @db.Char(26)

  state LogisticsDriverState @default(ACTIVE)

  /// The carrier's own reference for this person. Free text; every fleet
  /// numbers its drivers its own way.
  employeeReference String? @db.VarChar(64)

  licenceNumber    String?   @db.VarChar(64)
  licenceExpiresAt DateTime? @db.Date

  /// What this driver is certified to carry. Checked against the shipment's
  /// handling requirements before an assignment is accepted, which is why
  /// dangerous goods and cold chain are columns rather than a note.
  canCarryDangerousGoods Boolean @default(false)
  canCarryColdChain      Boolean @default(false)
  canCarrySterile        Boolean @default(false)

  /// Where they usually work, as region ids. Same shape and reasoning as
  /// `LogisticsPartnerUser.regionScopeJson`.
  regionScopeJson Json?

  /// Whether this driver's device may send positions at all.
  ///
  /// Consent, recorded. Off by default and set only when the person has agreed
  /// in the app, because location data about an employee is the most sensitive
  /// thing this feature collects and "the employer switched it on" is not
  /// consent. Withdrawing it stops collection immediately and does not delete
  /// what was already gathered - that is the retention sweep's job.
  locationConsentAt        DateTime? @db.DateTime(3)
  locationConsentWithdrawnAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  partner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  /// SetNull rather than Cascade, and that is a change worth naming.
  ///
  /// It used to delete the driver record when the member was deleted, which
  /// took the record of who carried what with it. Now that the name lives on
  /// this row, removing somebody's account leaves the driver - and every
  /// assignment naming them - intact, and only the login link goes. A fleet
  /// register that forgets who drove last month is a register that cannot
  /// answer the one question asked after a bad delivery.
  partnerUser LogisticsPartnerUser? @relation(fields: [partnerUserId], references: [id], onDelete: SetNull)

  assignments LogisticsDriverAssignment[]
  pickups     LogisticsPickupRequest[]
  manifests   LogisticsDispatchManifest[]
  trips       LogisticsActiveTrip[]
  pings       LogisticsLocationPing[]

  @@index([logisticsPartnerId, state], map: "ix_logistics_driver_state")
  /// The fleet list, and the picker on a consignment: this carrier's drivers,
  /// by name. Without it both are a filesort on every open.
  @@index([logisticsPartnerId, fullName], map: "ix_logistics_driver_name")
  @@map("logistics_driver_profiles")
}

model LogisticsVehicle {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  registration String               @db.VarChar(32)
  kind         LogisticsVehicleKind @default(VAN)

  /// What it can take. Checked the same way a driver's certifications are.
  hasRefrigeration  Boolean @default(false)
  hasTailLift       Boolean @default(false)
  temperatureMinC   Decimal? @db.Decimal(5, 2)
  temperatureMaxC   Decimal? @db.Decimal(5, 2)
  maxWeightGrams    Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  partner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)

  assignments LogisticsDriverAssignment[]
  pickups     LogisticsPickupRequest[]
  manifests   LogisticsDispatchManifest[]
  trips       LogisticsActiveTrip[]

  @@unique([logisticsPartnerId, registration], map: "uq_logistics_vehicle_registration")
  @@index([logisticsPartnerId, isActive], map: "ix_logistics_vehicle_active")
  @@map("logistics_vehicles")
}

/// This driver, on this consignment.
///
/// The row that makes `/logistics/driver/tasks` answer with one person's stops
/// and nobody else's. A driver holds no permission that can list shipments, so
/// this join is the ONLY path from a driver session to a consignment.
model LogisticsDriverAssignment {
  id              String @id @db.Char(26)
  shipmentId      String @db.Char(26)
  driverProfileId String @db.Char(26)
  vehicleId       String? @db.Char(26)

  /// The shipment id while this assignment is LIVE, and NULL once it is not.
  ///
  /// The whole mechanism behind "one driver per consignment at a time", and it
  /// is a column rather than a rule in a service because a rule in a service
  /// loses a race. Two dispatchers pressing Assign in the same second both read
  /// "no live assignment", both write one, and the consignment ends up on two
  /// vans - which is the failure nobody discovers until both drivers arrive.
  ///
  /// MariaDB has no partial indexes, but it treats **every NULL in a UNIQUE
  /// index as distinct** - the same property `variantKey` exists to work
  /// around elsewhere in this schema, used here the other way up. So
  /// `uq_logistics_driver_active` permits any number of finished assignments
  /// per shipment and exactly one live one, and the loser of a race gets a
  /// P2002 rather than a second van.
  ///
  /// Written only alongside `unassignedAt`: set together, cleared together.
  /// `assignment.service.ts` is the only place that does either.
  activeShipmentId String? @db.Char(26)

  /// What this driver is doing with it. A consignment can have two driver
  /// assignments - one to collect and one to deliver - and the task list has
  /// to be able to show the right stop to the right person.
  isPickupLeg   Boolean @default(false)
  isDeliveryLeg Boolean @default(true)

  /// Where this stop sits on the day's run. Null until a round is sequenced.
  routeSequence Int?

  assignedAt   DateTime  @default(now()) @db.DateTime(3)
  unassignedAt DateTime? @db.DateTime(3)
  completedAt  DateTime? @db.DateTime(3)

  assignedByPartnerUserId String? @db.Char(26)

  /// Who made this assignment, in words.
  ///
  /// The id above names somebody in the CARRIER's own team and is the only
  /// answer it can give. The marketplace's operations desk can assign a driver
  /// too - a carrier goes quiet and their parcels are still on vans - and an
  /// operator has no row in that table, so the id stays null and this is what
  /// keeps the chain readable.
  ///
  /// Null already meant "written before the column existed", so overloading it
  /// with "the marketplace did this" would make the history ambiguous in
  /// exactly the situation it gets read: after a bad delivery, with somebody
  /// asking who moved it.
  assignedByLabel String? @db.VarChar(160)

  /// Why this driver was taken off, in the dispatcher's words.
  ///
  /// Required by the service on a reassignment and null on a completion,
  /// which is the distinction it exists to record: a driver who finished the
  /// job and a driver who was pulled off it halfway are the same row shape and
  /// very different facts. Without it, "why did three drivers have this
  /// parcel?" is a question the history cannot answer.
  unassignedReason String? @db.VarChar(512)

  /// The assignment this one replaced, where it replaced one.
  ///
  /// A self-relation rather than a recomputed ordering, because the chain is
  /// what an operator reads after a bad delivery: A handed to B handed to C,
  /// each with the reason it moved. Deriving it from timestamps would be
  /// guesswork the moment two rows share a millisecond.
  previousAssignmentId String? @db.Char(26)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  shipment LogisticsShipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver   LogisticsDriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle  LogisticsVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  previousAssignment LogisticsDriverAssignment?  @relation("DriverAssignmentChain", fields: [previousAssignmentId], references: [id], onDelete: SetNull)
  replacedBy         LogisticsDriverAssignment[] @relation("DriverAssignmentChain")

  /// One live driver per consignment, enforced by the database. See
  /// `activeShipmentId`.
  @@unique([activeShipmentId], map: "uq_logistics_driver_active")
  /// The task-list query: this driver's live stops, in route order.
  @@index([driverProfileId, unassignedAt, routeSequence], map: "ix_logistics_driver_task")
  @@index([shipmentId, unassignedAt], map: "ix_logistics_driver_assignment_shipment")
  /// The admin tracking filter: every consignment this driver is carrying.
  @@index([driverProfileId, assignedAt], map: "ix_logistics_driver_assignment_driver_time")
  @@index([previousAssignmentId], map: "ix_logistics_driver_assignment_previous")
  @@map("logistics_driver_assignments")
}

/// A driver on the road with the app open.
///
/// The gate on location collection. A device may only send positions while a
/// trip of its own is ACTIVE, the token it sends them with is scoped to this
/// row, and ending the trip stops collection - which is what "no background
/// tracking outside active duty" means in a schema rather than in a policy
/// document.
model LogisticsActiveTrip {
  id              String  @id @db.Char(26)
  driverProfileId String  @db.Char(26)
  vehicleId       String? @db.Char(26)
  /// The consignment being worked, where the trip is about one. A multi-drop
  /// round has none and its stops are the driver assignments.
  shipmentId      String? @db.Char(26)

  state LogisticsTripState @default(ACTIVE)

  startedAt DateTime  @default(now()) @db.DateTime(3)
  endedAt   DateTime? @db.DateTime(3)

  /// SHA-256 of the device-scoped token this trip's pings must carry. Short
  /// lived and single-purpose: it authorises location ingestion for this trip
  /// and nothing else, so a token lifted off a phone cannot read a shipment.
  deviceTokenHash String    @unique(map: "uq_logistics_trip_device_token") @db.Char(64)
  deviceTokenExpiresAt DateTime @db.DateTime(3)

  /// How often the device should report, in seconds. Sent to the phone rather
  /// than decided by it, so an operator can slow every device down at once and
  /// a battery-aware client can be told to.
  pingIntervalSeconds Int @default(60)

  /// The last accepted position, denormalised so the dispatcher's map is one
  /// indexed read rather than a sort over a ping table that grows by a row a
  /// minute per driver.
  lastLatitude   Decimal?  @db.Decimal(9, 6)
  lastLongitude  Decimal?  @db.Decimal(9, 6)
  lastAccuracyM  Int?
  lastPingAt     DateTime? @db.DateTime(3)
  /// The highest sequence number accepted, so a replayed or reordered ping is
  /// rejected by a comparison rather than by a scan.
  lastSequence   Int       @default(0)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  driver   LogisticsDriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle  LogisticsVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  shipment LogisticsShipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  pings LogisticsLocationPing[]

  @@index([driverProfileId, state], map: "ix_logistics_trip_driver")
  @@index([state, startedAt], map: "ix_logistics_trip_sweep")
  @@index([shipmentId], map: "ix_logistics_trip_shipment")
  @@map("logistics_active_trips")
}

/// One position report.
///
/// THE HIGHEST-VOLUME TABLE IN THIS SCHEMA, by a wide margin: a ping a minute
/// per driver on duty. It is kept apart from every audit and event table on
/// purpose - mixing a row-per-minute feed into a table an operator queries for
/// evidence makes both of them slow, and it is the one table a deployment at
/// scale will want to move to partitioned or dedicated storage. Nothing else
/// joins to it, so moving it is a change to one service.
///
/// IT IS ALSO THE MOST SENSITIVE PERSONAL DATA THIS FEATURE COLLECTS. It is
/// one employee's movements, minute by minute. It is collected only while a
/// trip is ACTIVE and the driver has consented, it is readable only by roles
/// holding `logistics.trip.location.read`, and it is deleted by the retention
/// sweep on the deployment's own window.
model LogisticsLocationPing {
  id     String @id @db.Char(26)
  tripId String @db.Char(26)
  /// Denormalised from the trip so the retention sweep and an Art. 15 export
  /// can find one person's pings without a join across a table this size.
  driverProfileId String @db.Char(26)
  /// The account, for the same two reasons. Nullable only so an erasure can
  /// sever the link without deleting the row's operational value.
  driverUserId String? @db.Char(26)

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  /// Metres. A wifi fix is a few hundred and a GPS fix single digits; shown
  /// beside the position so a coarse fix is not read as a precise one.
  accuracyM Int?
  /// Degrees from north, and metres per second. Both optional - a stationary
  /// device reports neither.
  headingDeg Int?
  speedMps   Decimal? @db.Decimal(6, 2)

  /// When the DEVICE says it took the fix, and when we received it. Both,
  /// because the gap is how a queued offline batch is recognised, and because
  /// a device clock is not a fact about the world.
  deviceTimestamp DateTime @db.DateTime(3)
  receivedAt      DateTime @default(now()) @db.DateTime(3)

  /// Monotonic per trip. What makes a duplicate or reordered ping cheap to
  /// reject.
  sequence Int

  /// The caller's key. UNIQUE with the trip, so an offline queue flushing
  /// twice writes each position once.
  idempotencyKey String @db.VarChar(64)

  trip   LogisticsActiveTrip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver LogisticsDriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  user   User?                  @relation(fields: [driverUserId], references: [id], onDelete: SetNull)

  @@unique([tripId, idempotencyKey], map: "uq_logistics_ping_idempotency")
  @@unique([tripId, sequence], map: "uq_logistics_ping_sequence")
  /// The map's read, and the retention sweep's delete.
  @@index([tripId, deviceTimestamp], map: "ix_logistics_ping_trip_time")
  @@index([driverProfileId, deviceTimestamp], map: "ix_logistics_ping_driver_time")
  @@index([receivedAt], map: "ix_logistics_ping_retention")
  @@map("logistics_location_pings")
}

// ---------------------------------------------------------------------------
// Carrier integration
// ---------------------------------------------------------------------------

/// A connection to a carrier's API.
///
/// Credentials live in the ENVIRONMENT or in the encrypted column below, never
/// in plaintext and never in a log. An integration with no credentials is
/// UNCONFIGURED, and every call against it answers
/// CARRIER_PROVIDER_UNCONFIGURED naming the variables it needs - it never
/// returns a fabricated success, which is the whole reason this state exists.
model CarrierIntegration {
  id String @id @db.Char(26)

  provider CarrierProvider
  /// An operator's own name for it: "DHL Express - Benelux". Unique, because
  /// it is what a person picks from a list.
  name     String @unique(map: "uq_carrier_integration_name") @db.VarChar(120)

  state CarrierIntegrationState @default(UNCONFIGURED)

  /// Where to call. Empty for MANUAL, which calls nothing.
  baseUrl String @default("") @db.VarChar(512)

  /// AES-256-GCM envelopes, bound to this row's id as additional authenticated
  /// data - so a credential copied into another integration fails to decrypt
  /// rather than working somewhere it was never meant to.
  ///
  /// Never returned by any endpoint. The admin screen shows
  /// `maskSecret(...)` and nothing more.
  credentialsEnc String? @db.Text
  /// The secret an inbound webhook's signature is verified against, same
  /// treatment.
  webhookSecretEnc String? @db.Text

  /// How the carrier signs a webhook, and in which headers. Configuration
  /// rather than code, because carriers disagree about this more than about
  /// anything else and an operator must be able to correct it without a
  /// release.
  webhookSignatureHeader String @default("x-signature") @db.VarChar(64)
  webhookTimestampHeader String @default("x-timestamp") @db.VarChar(64)
  webhookAlgorithm       String @default("sha256") @db.VarChar(24)
  /// How far a webhook's own timestamp may be from ours before it is refused
  /// as a replay. Five minutes, the same window the payment webhooks use.
  webhookToleranceSeconds Int @default(300)

  /// The unguessable path segment this integration's webhook is mounted at, so
  /// the endpoint is not merely signed but also not enumerable.
  webhookPathToken String @unique(map: "uq_carrier_integration_webhook_path") @db.Char(32)

  /// Polling, for carriers with no webhooks - which is most of them.
  pollingEnabled         Boolean   @default(false)
  pollingIntervalMinutes Int       @default(30)
  nextPollAt             DateTime? @db.DateTime(3)
  lastPollAt             DateTime? @db.DateTime(3)

  /// Rate limiting the CARRIER imposes on us, respected by the poller.
  rateLimitPerMinute Int @default(60)

  /// Health. `consecutiveFailures` is what takes a connection out of service
  /// at the threshold, so a carrier that has been down for a fortnight is not
  /// called every half hour for a fortnight.
  consecutiveFailures Int       @default(0)
  lastSuccessAt       DateTime? @db.DateTime(3)
  lastFailureAt       DateTime? @db.DateTime(3)
  lastFailureMessage  String?   @db.VarChar(512)

  isActive Boolean @default(true)

  createdById String?  @db.Char(26)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  partners       LogisticsPartner[]
  shipments      LogisticsShipment[]
  statusMappings CarrierStatusMapping[]
  webhookEvents  CarrierWebhookEvent[]

  @@index([provider, state], map: "ix_carrier_integration_provider")
  @@index([pollingEnabled, nextPollAt], map: "ix_carrier_integration_poll")
  @@map("carrier_integrations")
}

/// An operator's override of what one carrier code means.
///
/// The built-in table in `domain/carrier-status-map.ts` is what a deployment
/// gets for free and is versioned with the software. These rows win over it,
/// because a carrier can change a code on a Tuesday and an operator has to be
/// able to fix it that afternoon without waiting for a release.
///
/// `canonicalStatus` NULL means "deliberately ignore this code", which is a
/// real answer and a common one: a label-created scan must not start the
/// transit clock.
model CarrierStatusMapping {
  id                   String @id @db.Char(26)
  carrierIntegrationId String @db.Char(26)

  /// The carrier's own code, lower-cased on the way in so a feed that changes
  /// case does not silently stop matching.
  providerCode String @db.VarChar(64)

  canonicalStatus LogisticsShipmentStatus?

  /// Whether this code should raise an exception as well as move the status -
  /// a customs hold and a temperature excursion both should.
  raisesExceptionType LogisticsExceptionType?

  /// What the customer is told when this code arrives. Null falls back to the
  /// canonical status's own wording, which every locale already translates.
  publicDescription String? @db.VarChar(255)

  note String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  integration CarrierIntegration @relation(fields: [carrierIntegrationId], references: [id], onDelete: Cascade)

  @@unique([carrierIntegrationId, providerCode], map: "uq_carrier_status_mapping")
  @@map("carrier_status_mappings")
}

/// One inbound webhook, as it arrived.
///
/// Stored BEFORE it is understood and kept whether or not it could be. Two
/// reasons, and the second is the important one:
///
///   1. `providerEventId` is UNIQUE per integration, so a carrier that
///      redelivers an event - which every carrier does - processes it once.
///      The constraint is the deduplication; there is no check-then-insert to
///      lose a race in.
///   2. An event this software could not map is EVIDENCE. The payload is kept
///      verbatim, an `UNMAPPED_EXTERNAL_EVENT` exception is raised, and a
///      person decides. Discarding it - or guessing at it - on a consignment
///      of medical goods is not an acceptable failure mode.
model CarrierWebhookEvent {
  id                   String @id @db.Char(26)
  carrierIntegrationId String @db.Char(26)

  /// The carrier's own id for this event. NOT NULL and carrying this row's own
  /// ULID where the carrier sent none, for the usual MariaDB reason: a NULL in
  /// a UNIQUE index is distinct from every other NULL, so a nullable column
  /// would deduplicate nothing.
  providerEventId String @db.VarChar(160)

  state CarrierWebhookState @default(RECEIVED)

  /// What it was about, where we could tell. Null on a payload we could not
  /// parse, which is itself worth keeping.
  trackingNumber String? @db.VarChar(128)
  shipmentId     String? @db.Char(26)

  providerStatusCode String? @db.VarChar(64)
  /// What the code resolved to, or null where nothing did.
  resolvedStatus     LogisticsShipmentStatus?

  /// The bytes, as received. Never edited.
  payloadJson Json

  /// Whether the signature verified. Stored rather than inferred from the
  /// state, because "we accepted an unsigned event" is a question somebody
  /// will ask after an incident.
  signatureVerified Boolean @default(false)

  attempts       Int       @default(0)
  nextRetryAt    DateTime? @db.DateTime(3)
  lastError      String?   @db.VarChar(512)
  processedAt    DateTime? @db.DateTime(3)
  deadLetteredAt DateTime? @db.DateTime(3)

  receivedAt DateTime @default(now()) @db.DateTime(3)

  integration CarrierIntegration @relation(fields: [carrierIntegrationId], references: [id], onDelete: Cascade)

  @@unique([carrierIntegrationId, providerEventId], map: "uq_carrier_webhook_event")
  @@index([state, nextRetryAt], map: "ix_carrier_webhook_retry")
  @@index([carrierIntegrationId, receivedAt], map: "ix_carrier_webhook_recent")
  @@index([trackingNumber], map: "ix_carrier_webhook_tracking")
  @@map("carrier_webhook_events")
}

// ---------------------------------------------------------------------------
// Records
// ---------------------------------------------------------------------------

/// Something the portal should tell somebody about.
///
/// The partner's own feed, and the row an email is sent from. Deduplicated on
/// `(shipmentId, kind, dedupeKey)` so a carrier redelivering the same tracking
/// event twice does not produce two emails - which is the whole of requirement
/// 16 in the brief, expressed as a constraint rather than as a code path.
model LogisticsNotification {
  id                 String  @id @db.Char(26)
  logisticsPartnerId String  @db.Char(26)
  /// Null for something the whole organisation should see.
  partnerUserId      String? @db.Char(26)
  shipmentId         String? @db.Char(26)

  kind LogisticsNotificationKind

  title String  @db.VarChar(200)
  body  String? @db.VarChar(1000)

  /// Variables for the translated template, so the same row renders in any of
  /// the interface languages rather than freezing one.
  variablesJson Json?

  /// What makes two of these the same notification. The event id, the
  /// assignment id, the exception id - whatever the caller considers the
  /// identity of the thing being announced.
  dedupeKey String @db.VarChar(120)

  /// News or problem, and where a problem stands. Exactly the split the
  /// operator's own bell carries - see `AdminNotificationClass`. A carrier
  /// watching a delivery failure needs it to leave their list when the
  /// delivery is re-attempted, not when somebody scrolled past it.
  class  AdminNotificationClass  @default(INFORMATION)
  status AdminNotificationStatus @default(ACTIVE)

  /// What this alert is about, so one domain resolution can close every
  /// occurrence of it. Null on an INFORMATION row. See the note on
  /// `AdminNotification.resolutionKey` for why this is not `dedupeKey`.
  resolutionKey String? @db.VarChar(120)

  resolvedAt       DateTime?                          @db.DateTime(3)
  /// The platform user who closed it, where a person did. Carriers and the
  /// marketplace both write here, so it is `users.id` and not a partner user.
  resolvedByUserId String?                            @db.Char(26)
  resolutionReason String?                            @db.VarChar(512)
  resolutionSource AdminNotificationResolutionSource?

  readAt      DateTime? @db.DateTime(3)
  emailedAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  partner     LogisticsPartner      @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  partnerUser LogisticsPartnerUser? @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  shipment    LogisticsShipment?    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([logisticsPartnerId, kind, dedupeKey], map: "uq_logistics_notification_dedupe")
  @@index([logisticsPartnerId, readAt, createdAt], map: "ix_logistics_notification_feed")
  @@index([partnerUserId, readAt], map: "ix_logistics_notification_user")
  /// The carrier's live-alert query, and the resolution lookup.
  @@index([logisticsPartnerId, class, status, createdAt], map: "ix_logistics_notification_live")
  @@index([resolutionKey, status], map: "ix_logistics_notification_resolution")
  @@map("logistics_notifications")
}

/// What was done inside one logistics organisation.
///
/// Its own table rather than rows in `AuditLog`, for exactly the reason
/// `SellerAuditLog` is its own table: the operator's audit trail describes the
/// whole marketplace and a tenant must not be able to read it. This one is
/// scoped to a carrier and is readable by that carrier's OWNER and ADMIN.
///
/// The rows an OPERATOR writes about a carrier - suspending it, correcting a
/// status, rotating a credential - go in `AuditLog` as well, so the operator's
/// own trail is complete without the carrier reading it.
model LogisticsAuditLog {
  id                 String @id @db.Char(26)
  logisticsPartnerId String @db.Char(26)

  /// Who. Null for the system. `actorUserId` rather than a partner-user id, so
  /// an action a member of the marketplace's staff took inside a carrier's
  /// account still names a person.
  actorUserId String? @db.Char(26)
  actorLabel  String  @db.VarChar(160)

  action       String  @db.VarChar(64)
  resourceType String  @db.VarChar(48)
  resourceId   String? @db.Char(26)

  beforeJson Json?
  afterJson  Json?

  /// A sentence, written deliberately rather than derived from the JSON.
  /// A diff is not a sentence, and this is the column a person reads.
  summary String? @db.VarChar(512)

  /// Whether this row records somebody unmasking a contact detail.
  ///
  /// Its own column rather than a value of `action`, because it is the one
  /// thing a data-protection review looks for and a review should not have to
  /// know which action strings mean "a person read a telephone number".
  isContactReveal Boolean @default(false)

  ipAddress     String? @db.VarChar(45)
  correlationId String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.DateTime(3)

  partner LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  actor   User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([logisticsPartnerId, createdAt], map: "ix_logistics_audit_time")
  @@index([logisticsPartnerId, action], map: "ix_logistics_audit_action")
  @@index([logisticsPartnerId, isContactReveal, createdAt], map: "ix_logistics_audit_reveal")
  @@index([resourceType, resourceId], map: "ix_logistics_audit_resource")
  @@map("logistics_audit_logs")
}

// ===========================================================================
// DEMO CATALOGUE
//
// A deployment that has just been installed has an empty shop front, and an
// empty shop front cannot be reviewed, demonstrated or tested end to end. The
// demonstration seed plants a broad catalogue - every department, every
// sub-category - so that somebody evaluating this software sees a marketplace
// rather than a search box with nothing behind it.
//
// The whole safety of that rests on ONE table. A product the seed created has
// a row here; a product a person created does not, and nothing else
// distinguishes them. That is deliberate and it is the point:
//
//   - **The seed only ever writes products named in this table.** It cannot
//     overwrite a genuine product by accident, because it has no way to name
//     one. A re-run reads `seedKey`, finds the product it made last time and
//     updates that row.
//   - **Removing the demonstration catalogue is removing these rows and the
//     products they name.** There is no heuristic, no SKU prefix to trust and
//     no "everything created on the day we ran the seed".
//   - **`ENABLE_DEMO_CATALOG=false` hides every one of them** from the public
//     catalogue in one place - `publicProductWhere()` - rather than in each
//     route that reads products.
//
// It carries no personal data of any kind and is therefore out of scope for
// the Art. 15 export; see `tests/unit/export-bundle-completeness.test.ts`.
// ===========================================================================

model DemoCatalogEntry {
  id String @id @db.Char(26)

  /// The blueprint this product was generated from, and the identity a re-run
  /// matches on. Stable across runs, which is what makes the seed idempotent:
  /// the same blueprint always converges on the same product row rather than
  /// creating a second one beside it.
  seedKey String @unique(map: "uq_demo_catalog_seed_key") @db.VarChar(128)

  /// One product per entry, and one entry per product.
  productId String @unique(map: "uq_demo_catalog_product") @db.Char(26)

  /// Which generator wrote it - `demo-catalog` today. A second generator (a
  /// trade-show set, a load-test set) would use its own value, so one can be
  /// re-run or removed without touching the other.
  seedSource String @default("demo-catalog") @db.VarChar(64)

  /// Bumped when the blueprint registry changes shape in a way that should
  /// rewrite existing rows rather than leave them as they are.
  seedVersion Int @default(1)

  /// The sub-category slug this was generated for, kept so coverage can be
  /// reported without walking the category tree.
  subcategorySlug String @db.VarChar(255)

  /// Where the photograph came from: `unsplash-api`, `verified-library`,
  /// `local-upload` or `placeholder`. A report reads this rather than trying
  /// to infer a provenance from a URL.
  imageSource String @default("placeholder") @db.VarChar(32)

  /// Attribution, in the form the Unsplash API terms require it to be
  /// displayable. Null for an image that did not come from Unsplash.
  imagePhotoId      String? @db.VarChar(64)
  imagePhotographer String? @db.VarChar(255)
  imageProfileUrl   String? @db.VarChar(512)
  imagePhotoPageUrl String? @db.VarChar(512)

  /// True when no genuinely relevant photograph could be found and a neutral
  /// stand-in was used instead. An honest placeholder beats a misleading
  /// photograph, and this is what puts the product on the review report.
  imageNeedsReview Boolean @default(false)

  generatedAt DateTime @default(now()) @db.DateTime(3)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  /// `@default(now())` as well as `@updatedAt`, because the migration gave the
  /// column `DEFAULT CURRENT_TIMESTAMP(3)`. Without it the schema describes a
  /// column with no default, the drift check sees that difference, and CI
  /// fails. Same shape as every other `updatedAt` here - see
  /// `docs/DATABASE-MIGRATION.md` section 5.
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)

  /// The constraint is named in the migration, so it is named here too.
  /// Unmapped, Prisma expects `demo_catalog_entries_productId_fkey` and the
  /// drift check reports the foreign key as removed and re-added.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_demo_catalog_product")

  @@index([seedSource, seedVersion], map: "ix_demo_catalog_source")
  @@index([subcategorySlug], map: "ix_demo_catalog_subcategory")
  @@index([imageNeedsReview], map: "ix_demo_catalog_image_review")
  @@map("demo_catalog_entries")
}
