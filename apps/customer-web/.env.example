# The API base URL. No trailing slash.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional, and only for sharing this dev server over an ngrok tunnel.
#
# A hostname the dev server should answer to besides localhost. Without it Vite
# refuses the tunnel's hostname outright - "Blocked request. This host is not
# allowed." - because answering only to localhost is its DNS-rebinding defence.
#
# Bare hostname: no https://, no trailing slash, no path. Belongs in
# `.env.local`, which is gitignored, because the domain is per-machine.
# TUNNEL_HOST=your-reserved-name.ngrok-free.dev

# The public address this storefront is served from, e.g.
# https://shop.example.com — no trailing slash.
#
# Used only for search engines, and only in a build. It makes the canonical
# URL and the eight language alternates absolute, and it rewrites the
# `Sitemap:` line in robots.txt, which crawlers ignore unless it is a fully
# qualified URL.
#
# Unset is safe and is the right answer on a developer's machine: the app
# falls back to whatever origin the browser is on, and the build leaves
# robots.txt alone rather than writing a hostname nobody uses.
#
# NOT a secret. Everything prefixed VITE_ is compiled into the bundle and is
# readable by every visitor. Never put a key here.
VITE_PUBLIC_SITE_URL=
