{"name":"order-tracking","signIn":true,"pathFrom":"(async()=>{const r=await fetch('/api/v1/orders?limit=20',{credentials:'include'});const j=await r.json();const list=j.items||j.orders||j.data||[];const o=list.find(x=>['SHIPPED','DELIVERED','OUT_FOR_DELIVERY','IN_TRANSIT','PARTIALLY_SHIPPED'].includes(x.status))||list[0];return o?'/account/orders/'+(o.id||o.orderId):null})()","after":"(async()=>{for(let i=0;i<40;i++){const t=document.querySelector('main')?.innerText||'';if(/track|deliver|shipment|on its way/i.test(t))return {ok:true,text:t.slice(0,300)};await new Promise(r=>setTimeout(r,250))}return {ok:false}})()"},
