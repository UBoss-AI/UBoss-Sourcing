{"name":"team-draft","path":"/account/companies/01M3KFB5VB078FKZAHP1D6BWMN","signIn":true,"after":"(async()=>{for(let i=0;i<40;i++){const h=document.getElementById('company-team-heading');const s=h&&h.closest('section');if(s&&s.innerText.includes('verified')){return {notApproved:s.innerText.includes('once the company is verified'),invite:!![...s.querySelectorAll('button')].find(b=>b.textContent==='Send invitation')}}await new Promise(r=>setTimeout(r,250))}return {team:false}})()"},
