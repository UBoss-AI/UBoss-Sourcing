# =============================================================================
# MariaDB settings for UBOSS on a 4 vCPU / 16 GB machine.
#
#   sudo cp deploy/mariadb/uboss.cnf /etc/mysql/mariadb.conf.d/99-uboss.cnf
#   sudo systemctl restart mariadb
#
# A drop-in with a high number, so it loads last and wins over the packaged
# defaults. Nothing here is clever; the defaults MariaDB ships are sized for a
# machine with far less memory than this, and leaving them is how a 16 GB
# server ends up reading every query off the disk.
#
# -----------------------------------------------------------------------------
# WHICH MARIADB THIS IS FOR
#
#   Target series : 11.4 LTS
#   Tested on     : 11.4.13  (mariadb:11.4.13, digest in deploy/compat/docker-compose.yml)
#   Why           : docs/DATABASE-PRODUCTION.md section 3 has the decision and
#                   the numbers behind it. The short version: 11.4 is supported
#                   until May 2029, which is longer than 11.8, and it has had
#                   two years and thirteen patch releases to settle.
#
# Development still runs XAMPP MariaDB 10.4.32, which went out of support in
# June 2024. Every behavioural difference that matters between the two is
# listed in docs/DATABASE-MIGRATION.md section 4, and three of them are
# configured explicitly below rather than left to a default.
#
# CHECK YOUR VERSION BEFORE COPYING THIS ANYWHERE ELSE, and re-read
# docs/DATABASE-PRODUCTION.md section 7 before changing a number in it. Every
# setting here has a reason, a memory cost and a way to check whether it was
# the right call.
# =============================================================================

[mysqld]

# --- Behaviour, not speed ---------------------------------------------------
#
# The three settings in this section change what a query DOES. Everything below
# them changes only how fast it does it. If you are reading this file to tune
# something, skip this section; if you are reading it because production and
# development disagree about an answer, it is almost certainly one of these.

# STRICT MODE, SPELLED OUT.
#
# This is 11.4's default and it is NOT XAMPP 10.4's. On XAMPP a string longer
# than its column is truncated and a warning nobody reads is raised; here the
# INSERT fails. Written out in full so that it is visible in this file, and so
# that a future MariaDB changing its default cannot change this database's
# behaviour without anybody editing anything.
#
# NO_ZERO_DATE and NO_ZERO_IN_DATE are carried over from the XAMPP default so
# that the two servers agree about '0000-00-00'.
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,NO_ZERO_DATE,NO_ZERO_IN_DATE

# CHARACTER SET AND COLLATION, PINNED.
#
# Must match the schema, and in 11.4 that now has to be said out loud: MariaDB
# changed the server default collation to utf8mb4_uca1400_ai_ci. Every table
# this schema's migrations create is utf8mb4_unicode_ci. Leaving the default
# alone would mean a CREATE DATABASE without an explicit COLLATE - a restore, a
# scratch copy, a shadow database - silently getting the other one, and a join
# across the two raises "Illegal mix of collations" at runtime, in whichever
# query happens to touch both first.
#
# utf8mb4 rather than utf8: this storefront runs in eight languages, sells into
# Europe and holds Greek, Polish and German product text. Anything short of
# utf8mb4 truncates silently at the first character outside the BMP - which
# includes every emoji a customer types into a delivery note.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# UTC, AND THE SCHEMA DEPENDS ON IT.
#
# Every instant is a DATETIME(3) holding UTC; wall-clock recurrence carries its
# own IANA timezone column and is resolved in the application. A server running
# in local time applies an offset on the way in and out, and every scheduled
# delivery drifts - twice a year, by an hour, in a way that looks like a bug in
# the scheduler.
#
# The driver pins its session to UTC too (backend/src/infra/prisma.ts). This
# setting is what makes NOW() inside a migration, and anybody at a mariadb
# prompt, agree with it.
default_time_zone = '+00:00'

# --- Memory -----------------------------------------------------------------
#
# The single most important number in this file, and the one most often left at
# its default.
#
# 6 GB of 16, not the 70-80% a dedicated database server would get, because
# this box is not a dedicated database server. Three API instances at up to
# 1 GB each, a worker at up to 1.5 GB, nginx, and the OS page cache all live
# here too. 6 GB holds this catalogue, its indexes and the hot order rows
# entirely in memory, which is the point at which more stops helping.
#
#   Check before raising it:  free -m          (the box must not be swapping)
#   Check whether it helps:   SHOW GLOBAL STATUS LIKE 'Innodb_buffer_pool_read%';
#                             reads / read_requests under 0.1% means the working
#                             set already fits and more memory buys nothing.
#   Rollback:                 128M, the packaged default.
#
# A database with a buffer pool it cannot keep resident is slower than one with
# a small pool.
innodb_buffer_pool_size = 6G

# NOT HERE, DELIBERATELY: innodb_buffer_pool_instances.
#
# It was in this file when the target was 10.4. MariaDB removed it in 10.6 -
# the server still ACCEPTS the option so that old configuration files do not
# break it, and then ignores it completely; `SHOW VARIABLES` does not list it
# at all. A setting that is accepted and ignored is worse than one that errors,
# because it reads as configuration and is not. The same is true of
# innodb_thread_concurrency, also removed and also gone from this file.

# Temporary tables. A GROUP BY or a DISTINCT that exceeds the smaller of these
# two is written to disk instead of held in memory, and the report that does it
# goes from milliseconds to seconds. 128 MB is sized for the admin reports on
# this schema; both must be set, because MariaDB uses the lower of the pair.
#
#   Check:    SHOW GLOBAL STATUS LIKE 'Created_tmp_disk_tables';
#             growing steadily under normal load means this is too small.
#   Rollback: 16M each.
tmp_table_size = 128M
max_heap_table_size = 128M

# --- Durability -------------------------------------------------------------
#
# DO NOT CHANGE EITHER OF THESE TWO. They are the difference between "the order
# is committed" meaning it and meaning it probably.
#
# `innodb_flush_log_at_trx_commit = 1` flushes the log to disk on every commit.
# 2 is measurably faster and loses up to a second of committed transactions if
# the machine loses power. For a system where a commit is "this customer's card
# was charged and this order exists", losing a second of them is not a
# performance trade-off, it is a reconciliation nightmare somebody discovers
# three weeks later.
innodb_flush_log_at_trx_commit = 1

# The same argument. `sync_binlog = 1` costs write throughput and is what makes
# the binary log - and therefore point-in-time recovery - actually trustworthy.
sync_binlog = 1

# --- Write path -------------------------------------------------------------
#
# 1 GB of redo. Large, deliberately: the checkout path and the catalogue
# importer both write in bursts, and a small log means InnoDB stops to
# checkpoint in the middle of them. The cost is a longer crash recovery, which
# happens rarely and is bounded.
#
#   Disk cost: the redo files are this size on disk, permanently.
#   Rollback:  96M, the packaged default.
innodb_log_file_size = 1G
innodb_log_buffer_size = 64M

# Bypass the OS page cache. The buffer pool above is already caching this data;
# letting the kernel cache it a second time wastes memory caching a copy of
# what is already in memory.
innodb_flush_method = O_DIRECT

# NVMe. The default of 200 is a number from the era of spinning disks and it
# throttles InnoDB's background flushing to a fraction of what this storage can
# do. Hostinger's KVM plans are NVMe-backed; on anything else, lower this.
#
#   Check: iostat -x 5 - if %util sits near 100 with these values, the storage
#          is slower than they assume and they are making things worse.
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000

# Four cores. More I/O threads than cores means context switching, not
# throughput.
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# One tablespace per table. Without it, a deleted table's space is never
# returned to the filesystem - it stays inside one ever-growing ibdata1 that
# can only be reclaimed by dumping and reloading the entire database. It is the
# default in 11.4; set explicitly because it is load-bearing for the recovery
# procedure in docs/DATABASE-RECOVERY.md.
innodb_file_per_table = 1

# --- Connections ------------------------------------------------------------
#
# The arithmetic, which has to be done rather than guessed. The full budget,
# including the worker and the migration job, is in
# docs/DATABASE-PRODUCTION.md section 11:
#
#   3 API instances  x DB_POOL_SIZE (12) = 36
#   1 worker         x DB_POOL_SIZE (12) = 12
#   migration job, backup, monitoring, a DBA at a prompt ~ 12
#                                          -------
#                                            60 in normal use
#
# 200 leaves room for a rolling restart - where old and new instances briefly
# overlap and both hold full pools - without the new ones being refused, and
# leaves the database with capacity to accept an administrative connection when
# the application has exhausted its own. Raise `DB_POOL_SIZE` or the instance
# count and redo this sum; a pool that cannot get a connection surfaces as a
# timeout in the middle of a checkout.
#
#   Check: SHOW GLOBAL STATUS LIKE 'Max_used_connections';
#          within 20 of this number means the next rolling restart will fail.
max_connections = 200

# A connection abandoned by a crashed client holds its locks until it is
# reaped. Eight hours - the default - is long enough for a stale lock to block
# the order table all morning.
wait_timeout = 600
interactive_timeout = 600

# Threads are kept rather than created per connection. With pooled clients this
# matters less than it used to, but the migration job, the backup and the
# monitor all connect briefly and often.
thread_cache_size = 64

# 171 tables, most of them touched by any given request, times the connections
# above. Too small and MariaDB reopens table handles constantly.
#
#   Check: SHOW GLOBAL STATUS LIKE 'Opened_tables'; a number that climbs
#          steadily after warm-up means this is too small.
#   Note:  this needs file descriptors - see open_files_limit below.
table_open_cache = 4000

# Docker networks and some VPS providers have no reverse DNS, and without this
# every new connection waits for a lookup that will fail. It also removes
# host-based authentication as a concept, which is fine here: every account is
# @'localhost' over the loopback interface.
skip-name-resolve = 1

# File descriptors. table_open_cache and max_connections both consume them, and
# the failure when there are not enough is "Too many open files" on a random
# query rather than anything that names the cause. systemd also caps this - see
# LimitNOFILE in the MariaDB unit - and the lower of the two wins.
open_files_limit = 32768

# --- Query handling ---------------------------------------------------------
#
# The query cache is OFF, and this is not an oversight. It serialises writes
# behind a single global mutex, which on a schema where orders, stock and
# schedules are written constantly makes it a net loss. It is off by default in
# 11.4 and is on its way out of MariaDB entirely; set explicitly so that
# nobody "optimises" by turning it on.
query_cache_type = 0
query_cache_size = 0

# Large enough for a catalogue import and a GDPR export bundle, both of which
# move rows well above the 1 MB default. It must be at least as large here as
# the largest single row the application writes, and at least as large as on any
# client that connects.
max_allowed_packet = 64M

# REPEATABLE READ, the default, stated because the application depends on it.
# Stock reservation reads a balance with SELECT ... FOR UPDATE and writes it in
# the same transaction; under READ COMMITTED the gap locks that make that safe
# behave differently, and the failure mode is overselling under load.
transaction_isolation = REPEATABLE-READ

# --- Logging ----------------------------------------------------------------
#
# Anything over a second is worth a look on a schema this well indexed.
#
# NOTE WHAT IS NOT LOGGED: the slow log records the statement, and Prisma sends
# parameters separately, so bound values do not appear in it. Do not turn on
# the general log to "see what is happening" - that one logs everything,
# including the parameters, which on this schema means customer names,
# addresses and order amounts in a file with different permissions from the
# database. docs/DATABASE-PRODUCTION.md section 18 covers what may be logged.
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1

# The ones that will eventually be a problem, caught before they are. A query
# with no index is fast on a catalogue of 250 products and a tablescan on one
# of 250,000.
log_queries_not_using_indexes = 1
# ...but capped, or a chatty unindexed query fills the disk with its own log.
min_examined_row_limit = 1000

log_error = /var/log/mysql/error.log

# Performance Schema is OFF, which is MariaDB's default and is deliberate here.
# It costs roughly 400 MB of the memory budgeted above and its instrumentation
# is not free on a box that is also running the application. The slow log, the
# InnoDB status output and `SHOW GLOBAL STATUS` answer every question in the
# monitoring section without it. Turn it on temporarily, with a restart, when
# investigating something specific - and turn it off again.
performance_schema = 0

# --- Binary log -------------------------------------------------------------
#
# Point-in-time recovery, and the thing that makes a nightly dump into a real
# backup: the dump gets you to midnight, the binary log gets you to the minute
# before the mistake.
#
# deploy/scripts/ship-binlogs.sh copies these off the machine. A binary log
# that only exists on the server it protects is not a recovery plan.
log_bin = /var/log/mysql/mysql-bin.log
binlog_format = ROW
max_binlog_size = 256M

# `binlog_expire_logs_seconds`, NOT `expire_logs_days`.
#
# The day-based name was deprecated in 10.6. 11.4 still accepts it, and if both
# are set the behaviour depends on which was parsed last - which is exactly the
# kind of thing that is discovered when a week of binary logs turns out to have
# been deleted after one day. Seven days, matching the fourteen nightly dumps
# kept by backup.sh with room to spare.
#
#   Disk cost: seven days of write volume. Watch it; a catalogue import can
#              produce several GB of binary log in an afternoon.
binlog_expire_logs_seconds = 604800

# --- Network ----------------------------------------------------------------
#
# Loopback only, and this is the one line here that is a security control
# rather than a tuning knob: the API and the worker are on this machine, so
# nothing legitimate connects from anywhere else, and 3306 open to the internet
# is how a database is found by somebody scanning for it.
#
# This is belt and braces with the firewall - bootstrap.sh does not open 3306 -
# and both are needed: a firewall rule added by mistake would otherwise expose
# a listening socket.
#
# Moving the database to its own host later means changing this AND adding a
# firewall rule AND turning on TLS - not just this.
bind-address = 127.0.0.1
