# ==========================================================================
# UBOSS - local COMPATIBILITY TEST database
#
#   cp .env.database.example .env
#
# then replace the four placeholders. This file is a template and is in git;
# the `.env` you make from it is not, and must never be.
#
# THIS IS NOT THE PRODUCTION DATABASE ENVIRONMENT. The production VPS gets its
# credentials from /srv/uboss/shared/.env, generated by
# `deploy/scripts/bootstrap.sh` on the machine itself. Nothing here is ever
# copied there; see docs/DATABASE-PRODUCTION.md section 6.
# ==========================================================================

# --- Passwords ----------------------------------------------------------
#
# Four accounts, four different passwords, because the whole point of splitting
# the accounts is lost if one leaked credential opens all of them.
#
# Generate each one separately, in PowerShell:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# The compose file refuses to start if any of these is empty rather than
# falling back to a default, because a default password on a database that
# publishes a port is how "it is only local" stops being true.

# Administrative account. Used by the init script and by nothing else.
COMPAT_DB_ROOT_PASSWORD=

# The account `prisma migrate deploy` uses. Database-level DDL.
COMPAT_DB_MIGRATE_PASSWORD=

# The account the API and the worker use. SELECT/INSERT/UPDATE/DELETE only.
COMPAT_DB_APP_PASSWORD=

# The account the backup rehearsal uses. Read plus FLUSH.
COMPAT_DB_BACKUP_PASSWORD=

# --- Port ----------------------------------------------------------------
#
# 3307, not 3306. XAMPP owns 3306 and this container must never be able to be
# mistaken for it - or, worse, take its port while XAMPP happens to be stopped
# and have a migration run against the wrong database.
#
# Published on 127.0.0.1 only. Changing that to 0.0.0.0 publishes this database
# to every machine on the network you are connected to, and Docker writes its
# own Windows firewall rule to make sure of it.
COMPAT_DB_PORT=3307

# --- Connection strings --------------------------------------------------
#
# Paste these into backend/.env when you want the application, the test suite
# or the Prisma CLI to run against the compat database instead of XAMPP. Fill
# in the passwords you generated above; a password containing a reserved URL
# character must be percent-encoded.
#
#   DATABASE_URL="mysql://uboss_app:<app-password>@127.0.0.1:3307/uboss"
#   TEST_DATABASE_URL="mysql://uboss_app:<app-password>@127.0.0.1:3307/uboss_test"
#   SHADOW_DATABASE_URL="mysql://uboss_migrate:<migrate-password>@127.0.0.1:3307/uboss_shadow"
#   MIGRATE_DATABASE_URL="mysql://uboss_migrate:<migrate-password>@127.0.0.1:3307/uboss"
#
# `scripts/db/compat-test.ps1` builds these itself from this file, so a full
# rehearsal needs none of the above pasted anywhere.
