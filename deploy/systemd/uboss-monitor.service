# Runs deploy/scripts/monitor.sh once. Driven by uboss-monitor.timer.
#
# A failed run means at least one check failed. `systemctl --failed` will list
# this unit, and monitor.sh will additionally have run UBOSS_ALERT_COMMAND for
# each finding if one is configured.
#
# THIS IS NOT EXTERNAL MONITORING. It runs on the machine it watches, so it
# cannot report the one failure that matters most - the machine being gone. See
# docs/DEPLOYMENT.md section 18.
[Unit]
Description=UBOSS self-checks (queue, worker, backups, disk, certificates)
Documentation=file:/srv/uboss/current/docs/DEPLOYMENT.md

[Service]
Type=oneshot
User=uboss
Group=uboss

# Optional, and read from the same root-owned file as the backup's secrets
# because an alerting webhook URL is a credential:
#
#   UBOSS_ALERT_COMMAND=/usr/local/bin/uboss-alert
#
# plus any threshold override named in monitor.sh. `-` so that a machine with no
# alerting configured still runs the checks rather than failing to start.
EnvironmentFile=-/etc/uboss/backup.env
EnvironmentFile=-/etc/uboss/monitor.env

ExecStart=/srv/uboss/repo/deploy/scripts/monitor.sh

TimeoutStartSec=120

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

# --- Sandbox, measured -------------------------------------------------------
#
# Added after `systemd-analyze security` scored these units. Re-run it after
# any change:
#
#   systemd-analyze security uboss-backup.service
#
# A short-lived shell script is not a reason to run unconfined. This one holds
# the backup encryption passphrase and read access to the whole database, which
# makes it the most valuable environment file on the box. What it actually runs
# - mariadb-dump, gpg, tar, rclone, curl - is ordinary userspace: no
# capabilities, no new namespaces, no kernel tuning.
#
# AF_NETLINK is in the address-family list because glibc's getaddrinfo() uses
# it; without it every hostname lookup fails and the off-site copy silently
# stops working.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
PrivateMounts=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=uboss-monitor
